---
/** Inline SVG so the logo costs no request and renders before fonts load. */
interface Props { class?: string; light?: boolean }
const { class: cls = '', light = false } = Astro.props;
const wordColor = light ? '#ffffff' : '#123143';
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg width="38" height="38" viewBox="0 0 38 38" role="img" aria-label="RL Property Management" class="shrink-0">
    <rect width="38" height="38" rx="11" fill="#a60530" />
    <text x="19" y="24.5" text-anchor="middle" fill="#fff"
          font-family="Inter, system-ui, sans-serif" font-size="14" font-weight="800" letter-spacing="-.02em">RL</text>
  </svg>
  <span class="font-serif text-[17px] font-semibold tracking-[-.01em] leading-tight" style={`color:${wordColor}`}>
    RL Property Management
  </span>
</span>
