---
/**
 * The real brand lockup, replacing the placeholder square that stood in while
 * the artwork was unavailable.
 *
 * Served as webp at 2x for the size it actually renders, which is about 6KB.
 * Width and height are set so the header never reflows as it loads, and it is
 * eager because it sits at the very top of every page.
 */
interface Props { class?: string; light?: boolean }
const { class: cls = '', light = false } = Astro.props;
const file = light ? 'logo-wide-light' : 'logo-wide-dark';
---
<img
  src={`/images/brand/${file}-280.webp`}
  srcset={`/images/brand/${file}-280.webp 280w, /images/brand/${file}-560.webp 560w`}
  sizes="212px"
  alt="RL Property Management"
  width="280"
  height="51"
  loading="eager"
  decoding="sync"
  fetchpriority="high"
  class={`h-[38px] w-auto ${cls}`.trim()}
/>
