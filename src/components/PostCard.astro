---
import type { Post } from '../lib/blog';
import { slugify, excerpt } from '../lib/blog';
import { longDate } from '../lib/format';
interface Props { post: Post; showExcerpt?: boolean }
const { post, showExcerpt = true } = Astro.props;
const d = post.data;
const desc = d.description?.trim() || excerpt(post.body ?? '');
---
<article class="card card-hover flex flex-col h-full">
  <div class="flex flex-wrap items-center gap-2.5 mb-3">
    {d.categories.slice(0, 2).map((c) => (
      <a href={`/blog/category/${slugify(c)}/`}
         class="font-sans text-[11px] font-bold tracking-[.1em] uppercase text-crimson no-underline hover:underline">{c}</a>
    ))}
    <time datetime={d.pubDate.toISOString()} class="font-sans text-[12.5px] text-faint">{longDate(d.pubDate)}</time>
  </div>
  <h3 class="text-[20px] leading-[1.2] mb-2">
    <a href={`/blog/${d.slug}/`} class="no-underline hover:text-crimson">{d.title}</a>
  </h3>
  {showExcerpt && <p class="text-[15px] text-muted m-0 flex-1">{desc}</p>}
  <a href={`/blog/${d.slug}/`} class="font-sans text-[14px] font-semibold text-crimson no-underline hover:underline mt-3.5">Read the article →</a>
</article>
