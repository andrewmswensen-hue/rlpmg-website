---
import { company } from '../data/facts';
interface Props {
  heading: string;
  body: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const {
  heading, body,
  primary = { label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' },
  secondary,
} = Astro.props;
---
<section class="relative overflow-hidden bg-maroon text-white text-center py-[88px]">
  <!--
    Decorative only. The rooflines read as texture behind the maroon, so the
    image carries an empty alt rather than describing itself to a screen reader
    that is trying to get to the call to action.
  -->
  <img src="/images/photos/rooflines-band-1100.webp"
       srcset="/images/photos/rooflines-band-1100.webp 1100w, /images/photos/rooflines-band-1700.webp 1700w, /images/photos/rooflines-band-2400.webp 2400w"
       sizes="100vw" alt="" aria-hidden="true" width="2400" height="686"
       loading="lazy" decoding="async"
       class="absolute inset-0 w-full h-full object-cover opacity-[.14] pointer-events-none" />
  <div class="wrap relative">
    <h2 class="!text-white text-[clamp(30px,3.8vw,46px)] max-w-[17em] mx-auto mb-4">{heading}</h2>
    <p class="text-[#e2c8cc] text-[18px] max-w-[36em] mx-auto mb-7">{body}</p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href={primary.href} class="btn btn-on-dark">{primary.label}</a>
      <a href={secondary?.href ?? `tel:${company.phoneE164}`} class="btn btn-outline-light">
        {secondary?.label ?? `Call ${company.phone}`}
      </a>
    </div>
  </div>
</section>
