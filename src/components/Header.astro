---
/**
 * Site header with mega-menu navigation, modelled on croskeypm.com.
 *
 * ZERO JAVASCRIPT, which is the whole design constraint. Panels open on
 * :hover for pointers and on :focus-within for keyboards, so tabbing walks
 * straight through every link. Because the markup is always in the DOM, a
 * screen reader and a crawler both see the full navigation whatever happens
 * with CSS, which is better than a scripted menu that hides its contents.
 *
 * Each top-level item is a real link to its own hub page, not a dead button, so
 * clicking it always goes somewhere. Hover reveals the detail; the click still
 * works.
 *
 * Below the lg breakpoint the same data renders as nested <details> accordions.
 */
import Logo from './Logo.astro';
import { company } from '../data/facts';
import { nav, navDirect } from '../data/nav';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
/** A top-level item is current when the page sits anywhere inside its panel. */
const sectionActive = (item: (typeof nav)[number]) =>
  isActive(item.href) || item.groups.some((g) => g.links.some((l) => isActive(l.href)));
---
<a class="block bg-crimson text-white text-center no-underline hover:underline underline-offset-4" href="/2026-columbus-market-report/">
  <span class="inline-block px-5 py-2.5 text-[13.5px] font-semibold tracking-[.02em]">
    <span class="inline-block bg-white/25 text-[11px] font-extrabold tracking-[.1em] px-2 py-0.5 rounded-full mr-2 align-middle">New</span>
    The 2026 Columbus Single-Family Rental Market Report is out. Read it
  </span>
</a>

<header class="sticky top-0 z-50 bg-white border-b border-line">
  <div class="wrap-wide flex items-center gap-6 h-[78px]">
    <a href="/" class="no-underline shrink-0" aria-label={`${company.name} home`}><Logo /></a>

    <!-- Desktop navigation -->
    <nav class="ml-auto hidden lg:flex items-stretch" aria-label="Main">
      {nav.map((item) => (
        <div class="megawrap">
          <a
            href={item.href}
            class={`megatrigger ${sectionActive(item) ? 'is-current' : ''}`}
            aria-current={sectionActive(item) ? 'true' : undefined}
          >
            {item.label}
            <svg class="megachev" width="11" height="7" viewBox="0 0 11 7" aria-hidden="true">
              <path d="M1 1l4.5 4.5L10 1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </a>

          <div class="megapanel">
            <div class="megainner">
              <div class={`megagrid ${item.promo ? 'has-promo' : ''}`}>
                {item.groups.map((g) => (
                  <div>
                    <p class="megagroup">{g.heading}</p>
                    <ul>
                      {g.links.map((l) => (
                        <li>
                          <a href={l.href} class={`megalink ${isActive(l.href) ? 'is-current' : ''}`}>
                            <span class="megalink-t">{l.label}</span>
                            {l.note && <span class="megalink-d">{l.note}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}

                {item.promo && (
                  <aside class="megapromo">
                    <p class="megapromo-e">{item.promo.eyebrow}</p>
                    <p class="megapromo-h">{item.promo.heading}</p>
                    <p class="megapromo-b">{item.promo.body}</p>
                    <a href={item.promo.cta.href} class="megapromo-c">
                      {item.promo.cta.label}
                      <svg width="15" height="10" viewBox="0 0 15 10" aria-hidden="true">
                        <path d="M1 5h12M9 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </a>
                  </aside>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}

      {navDirect.map((l) => (
        <a href={l.href} class={`megatrigger ${isActive(l.href) ? 'is-current' : ''}`}>{l.label}</a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-4 shrink-0">
      <a href="/free-rent-evaluation/" class="btn btn-primary !py-2.5 !px-5 !text-[14px]">Free rent evaluation</a>
      <a href={`tel:${company.phoneE164}`} class="hidden xl:flex items-center gap-2 no-underline text-[14.5px] font-semibold text-navy hover:text-crimson">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M14.5 11.3v2a1.3 1.3 0 01-1.5 1.3 13 13 0 01-5.6-2 12.8 12.8 0 01-4-4 13 13 0 01-2-5.7A1.3 1.3 0 012.7 1.5h2a1.3 1.3 0 011.3 1.2c.1.6.2 1.3.5 1.9a1.3 1.3 0 01-.3 1.4l-.9.8a10.7 10.7 0 004 4l.8-.9a1.3 1.3 0 011.4-.3c.6.3 1.2.4 1.9.5a1.3 1.3 0 011.2 1.3z" />
        </svg>
        {company.phone}
      </a>
    </div>

    <!-- Mobile navigation: the same data, as nested accordions. Still no JavaScript. -->
    <details class="lg:hidden ml-auto mobilenav">
      <summary aria-label="Open menu">
        <span class="mobilenav-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </summary>
      <div class="mobilenav-panel">
        <div class="wrap py-4">
          {nav.map((item) => (
            <details class="mobilenav-sect">
              <summary>
                {item.label}
                <svg width="12" height="8" viewBox="0 0 11 7" aria-hidden="true">
                  <path d="M1 1l4.5 4.5L10 1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              </summary>
              <div class="mobilenav-body">
                <a href={item.href} class="mobilenav-all">All {item.label.toLowerCase()}</a>
                {item.groups.map((g) => (
                  <div class="mt-3">
                    <p class="megagroup">{g.heading}</p>
                    <ul>
                      {g.links.map((l) => (
                        <li><a href={l.href} class="mobilenav-link">{l.label}</a></li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </details>
          ))}
          {navDirect.map((l) => (
            <a href={l.href} class="mobilenav-direct">{l.label}</a>
          ))}
          <a href="/free-rent-evaluation/" class="btn btn-primary block text-center mt-4">Free rent evaluation</a>
          <a href={`tel:${company.phoneE164}`} class="block text-center mt-3 py-2 text-[15px] font-semibold text-crimson no-underline">{company.phone}</a>
        </div>
      </div>
    </details>
  </div>
</header>
