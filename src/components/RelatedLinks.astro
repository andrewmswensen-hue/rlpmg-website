---
/** Onward links. Every page ends with somewhere useful to go next. */
interface Props { links: { href: string; label: string; note?: string }[]; heading?: string }
const { links, heading = 'Where to go next' } = Astro.props;
---
{links.length > 0 && (
  <section class="band-tight border-t border-line">
    <div class="wrap max-w-[880px]">
      <h2 class="text-[21px] mb-5">{heading}</h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {links.map((l) => (
          <li>
            <a href={l.href} class="block card !p-4 no-underline card-hover">
              <span class="block font-serif text-[17px] font-semibold text-navy">{l.label}</span>
              {l.note && <span class="block text-[14px] text-muted mt-1">{l.note}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
