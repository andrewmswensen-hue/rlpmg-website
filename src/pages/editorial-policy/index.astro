---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { company } from '../../data/facts';

/**
 * NOT a legal page. This says who writes the content and who checks it.
 *
 * It exists because answer engines weight authorship and review signals when
 * deciding whose page to quote, and almost no property management company
 * publishes one. The previous draft drifted into legal framing; this version
 * states no legal position and asks nothing of counsel.
 */
const title = `How We Write and Check Our Content | ${company.name}`;
const description =
  `Who writes the guides and market data on this site, who reviews them, and how we handle a correction.`;
const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Editorial policy', path: '/editorial-policy/' }];
---
<Base {title} {description} {breadcrumbs}>
  <PageHero
    eyebrow="How we work"
    title="How we write and check our content"
    answer={`Everything on this site is written and reviewed by the ${company.name} team in Columbus. Anything covering pricing, process or local rules is checked by ${company.brokerOfRecord.name}, our ${company.brokerOfRecord.title}, before it publishes.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Read the guides', href: '/guides/' }}
    secondaryCta={{ label: 'Contact us', href: '/contact-us/' }}
  />

  <section class="band-tight">
    <div class="wrap max-w-[760px]">
      <div class="prose-rl">
        <h2>Who writes this</h2>
        <p>
          Our own team, in Columbus. We manage {company.unitsManaged} units here,
          so most of what you read comes out of doing the work rather than
          researching it. Where a page describes how we operate, it describes how
          we actually operate.
        </p>

        <h2>Who checks it</h2>
        <p>
          {company.brokerOfRecord.name}, our {company.brokerOfRecord.title},
          reviews anything that touches pricing, our process, or local rules
          before it goes live.
        </p>

        <h2>Where the numbers come from</h2>
        <p>
          Every figure on this site is kept in one place and read from there, so
          a price or a metric cannot say one thing on one page and something else
          on another. Our operating numbers come from our own portfolio and are
          refreshed quarterly on the
          <a href="/key-performance-indicators/">scorecard</a>. Outside data is
          attributed to its source with the year attached.
        </p>

        <h2>Dates, and why they matter</h2>
        <p>
          Pages carry a "last verified" date. Costs and local rules change, so
          check the date on anything you are about to act on. If a page has not
          been verified recently, treat its numbers as a starting point and ask us.
        </p>

        <h2>Corrections</h2>
        <p>
          If something here is wrong, tell us and we will fix it. Email
          {' '}<a href={`mailto:${company.email}`}>{company.email}</a>. We would
          rather be corrected than be confidently out of date.
        </p>
      </div>
      <div class="mt-9"><Verified date="2026-09-10" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/key-performance-indicators/', label: 'Our scorecard', note: 'The operating numbers, refreshed quarterly' },
    { href: '/guides/', label: 'In-depth guides', note: 'The long answers' },
    { href: '/ai-content-policy/', label: 'How we use AI', note: 'Where it helps, and who reviews it' },
    { href: '/about/', label: 'About us', note: 'Who we are' },
  ]} />
</Base>
