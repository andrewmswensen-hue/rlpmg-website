---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, pricing, rentPolicy, usd } from '../../data/facts';
import { canPublishOwnRent } from '../../data/markets';
import { serviceNode } from '../../lib/schema';

/**
 * Johnstown, Ohio. Target query: "property management johnstown ohio".
 *
 * The differentiating fact: Johnstown is the Licking County community sitting
 * closest to Intel's Ohio One site, and it is the one market in our footprint
 * where owners are underwriting on a story rather than on current rent. The
 * honest page is the one that states the confirmed timeline with its dates
 * attached, states that Intel's own filings raised the possibility of slowing
 * or pausing construction, and then tells an owner to underwrite the rent the
 * house earns today.
 *
 * DELIBERATE RESTRAINT: nothing on this page projects job counts, population
 * growth, rent growth or a completion date beyond what Intel itself has stated.
 * A wrong claim about Intel is worse than a gap.
 *
 * SOURCES (verified 2026-09-09):
 *  - Johnstown is a city in Licking County. Population 5,182 at the 2020 census,
 *    estimated 5,310 in 2023: en.wikipedia.org/wiki/Johnstown,_Ohio.
 *  - Intel's Ohio One campus is a stated $28 billion investment in two fabs,
 *    physically in Licking County, carrying a New Albany address, immediately
 *    south of Johnstown: Intel newsroom "Ohio One Construction Timeline Update"
 *    and siliconheartland.newalbanyohio.org.
 *  - 28 February 2025: Naga Chandrasekaran, EVP and chief global operations
 *    officer, Intel Foundry Manufacturing, notified Ohio employees of revised
 *    completion dates. Reported as Mod 1 construction complete 2030 and
 *    operational by end of 2031; Mod 2 complete 2031 and operational 2032:
 *    Intel newsroom, and abc6onyourside.com and datacenterdynamics.com coverage
 *    of that notice.
 *  - Intel's 2025 quarterly SEC filings stated the company could slow, pause or
 *    discontinue construction at Ohio One absent a significant external customer
 *    for its Intel 14A node: reported by abc6onyourside.com, July and August 2025.
 *  - Johnstown-Monroe Local School District completed a six-classroom high
 *    school expansion, adding capacity for roughly 150 students, citing expected
 *    growth: 10tv.com and spectrumnews1.com, March 2025.
 *  - A Municipal Utility Coalition of Licking County including Alexandria,
 *    Granville and Johnstown sought Ohio EPA designation as the water and sewer
 *    service provider for western Licking County, in competition with another
 *    utility: thereportingproject.org.
 *  - Eviction jurisdiction follows the county under R.C. 1901.02. Licking County
 *    goes to Licking County Municipal Court (docs/area-research-verified.md).
 *  - R.C. 5323.01(E) limits "residential rental property" to counties of more
 *    than 200,000 people at the last decennial census, so the 5323.02 auditor
 *    filing does not apply in Licking County (178,519 in 2020). Verified on
 *    codes.ohio.gov 2026-11-05: https://codes.ohio.gov/ohio-revised-code/section-5323.01
 *
 * NO qualifying entry in rentByMarketAndBedroom for Johnstown. No rent median is
 * published here. No door counts. No per-market days on market.
 */

const CITY = 'Johnstown';
const PATH = '/property-management-johnstown-ohio/';

const title = 'Johnstown Property Management | RL Property Management';
const description =
  `Flat-fee property management for Johnstown, Ohio rentals from ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} ` +
  `per unit per month with a ${usd(pricing.leasingFee)} leasing fee. Johnstown is Licking County, and closest to the Intel site.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/areas-we-serve/' },
  { name: 'Johnstown', path: PATH },
];

const publishesOwnRent = canPublishOwnRent(CITY);

const keyFacts = [
  `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, not a percentage of rent`,
  `${usd(pricing.leasingFee)} leasing fee every time a Johnstown unit turns`,
  'Johnstown is in Licking County, not Franklin County',
  'Evictions are filed at Licking County Municipal Court in Newark',
  'No state county auditor rental filing: Licking County is under the 200,000-person line',
  'Intel Ohio One sits in Licking County immediately south of Johnstown',
];

const faq = [
  { q: 'What county is Johnstown, Ohio in?',
    a: 'Licking County. The eviction complaint, the property tax bill and the deed all run through Licking County, not Franklin, even though many owners arrive from New Albany listings assuming otherwise.' },
  { q: 'Which court hears an eviction in Johnstown, Ohio?',
    a: 'Licking County Municipal Court, in Newark, because R.C. 1901.02 ties jurisdiction to territory. A Johnstown complaint filed at Franklin County Municipal Court in Columbus is dismissed, the fee is lost, and you restart about three weeks behind.' },
  { q: 'Where exactly is the Intel site in relation to Johnstown?',
    a: 'Intel Ohio One sits in Licking County immediately south of Johnstown but carries a New Albany address. So coverage calls it a New Albany project, while the property tax, school and water and sewer pressure land on Licking County communities like Johnstown.' },
  { q: 'What is the current status of Intel Ohio One?',
    a: 'On 28 February 2025 Intel told Ohio employees the first fab would complete in 2030 with operations by the end of 2031, and the second would complete in 2031 with operations in 2032, as reported. Its 2025 quarterly SEC filings said it could slow, pause or discontinue Ohio construction without a significant external customer for its Intel 14A process.' },
  { q: 'Should I underwrite a Johnstown rental on Intel?',
    a: 'No. Underwrite a Johnstown rental on the rent it earns today, with normal Licking County vacancy and repair assumptions, and treat Intel as upside. A date that has moved once is not a rent forecast, and buying on the story can leave you holding a negative-cash-flow house in a market of 5,000 people.' },
  { q: 'Do I have to register a Johnstown rental property?',
    a: 'Not with the county. The state’s county auditor rental registration (R.C. 5323.02) applies only in counties of more than 200,000 people, so it does not apply to a Licking County rental. We track which rules apply to each address and handle the filings that do.' },
  { q: 'What does a rental in Johnstown rent for?',
    a: 'We do not publish a Johnstown rent median, because our sample is below our five-unit floor and two or three units would mislead. Send an address and we will price it against live comparables.' },
  { q: 'How much does property management cost in Johnstown?',
    a: `A flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, a ${usd(pricing.leasingFee)} leasing fee and ${usd(pricing.leaseRenewalFee)} per lease renewal, with no distance surcharge for Licking County. Photography is billed separately at $250 to $450.` },
];

const schemaNodes = [
  {
    ...serviceNode({
      path: PATH,
      name: 'Residential property management in Johnstown, Ohio',
      description,
    }),
    areaServed: {
      '@type': 'City',
      name: 'Johnstown, Ohio',
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Licking County, Ohio' },
    },
  },
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="Where we work"
    title="Property management in Johnstown, Ohio"
    answer={`${company.name} manages Johnstown rentals for a flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month with a ${usd(pricing.leasingFee)} leasing fee. Johnstown is a Licking County city, so evictions go to Licking County Municipal Court.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondaryCta={{ label: 'See the full fee schedule', href: '/pricing/' }}
  />

  <KeyFacts items={keyFacts} heading="Johnstown, at a glance" />

  <!-- COURT: county first, because owners arrive here from New Albany listings. -->
  <section class="band-tight" aria-labelledby="court-h">
    <div class="wrap max-w-[880px]">
      <h2 id="court-h" class="text-[clamp(26px,3.2vw,38px)]">Which court hears an eviction in Johnstown, Ohio?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Licking County Municipal Court, in Newark, not Franklin County Municipal Court at 375 S. High St. in
        Columbus. Ohio Revised Code 1901.02 ties jurisdiction to territory, and Johnstown is Licking County.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Owners get this wrong here more than almost anywhere we work, because they arrive by way of New Albany
        (Franklin County) and the Intel campus carries a New Albany address. A complaint in the wrong court is
        dismissed, the fee is gone, and you restart about three weeks behind. The three-day notice under
        R.C. 1923.04, with its statutory wording and service, is the same statewide.
      </p>
      <div class="card mt-7">
        <h3 class="text-[19px] mt-0 mb-3">What an eviction costs an owner</h3>
        <ul class="grid gap-2 text-[15.5px] text-muted mb-0 list-none pl-0">
          <li><strong class="text-navy">{usd(pricing.eviction.attorneyFee)}</strong> to the eviction attorney, filing plus up to two appearances</li>
          <li><strong class="text-navy">{usd(pricing.eviction.countyFilingFee)}</strong> county filing fee for the eviction complaint</li>
          <li><strong class="text-navy">{usd(pricing.eviction.rlpmProcessFee)}</strong> to us to run the process end to end</li>
          <li><strong class="text-navy">{usd(pricing.eviction.typicalTotal)}</strong> typical total before any setout</li>
        </ul>
        <p class="text-[14px] text-faint mt-4 mb-0">
          The {usd(pricing.eviction.countyFilingFee)} figure is the Franklin County eviction complaint fee from
          our published schedule. A Licking County parcel files in Newark instead: Licking County Municipal Court in Newark charges $110 for a forcible entry and detainer, which includes regular mail and bailiff service for up to two defendants, with a further $50 if a writ of restitution is needed.
        </p>
      </div>
    </div>
  </section>

  <!-- THE HOOK: Intel, stated precisely and no further. -->
  <section class="band band-wash" aria-labelledby="intel-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The thing everyone asks about</span>
      <h2 id="intel-h" class="text-[clamp(26px,3.2vw,38px)]">What is happening with Intel near Johnstown?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Intel's Ohio One campus, a stated $28 billion project of two semiconductor fabs, sits in Licking County
        immediately south of Johnstown under a New Albany address. The dates have moved:
      </p>
      <ul class="text-[17px] text-muted mt-3 list-disc pl-6 grid gap-1.5">
        <li>On 28 February 2025 Intel told its Ohio employees of revised dates. As reported, the first fab now completes construction in 2030 with operations by the end of 2031, the second in 2031 with operations in 2032.</li>
        <li>Intel's 2025 quarterly SEC filings said it could slow, pause or discontinue Ohio construction if it does not secure a significant external customer for its Intel 14A process.</li>
      </ul>
      <p class="text-[17.5px] text-muted mt-5">
        We say nothing beyond those two facts: no job number, population projection or rent forecast. Local
        officials have called the delays hard to plan around, and so will you.
      </p>
      <div class="card mt-7">
        <h3 class="text-[19px] mt-0 mb-3">What has already happened in Johnstown</h3>
        <p class="text-[16px] text-muted mt-0">
          The Johnstown-Monroe Local School District added a six-classroom high school expansion for roughly 150
          more students, citing expected growth. A Municipal Utility Coalition of Licking County (Alexandria,
          Granville and Johnstown) has sought Ohio EPA designation as western Licking County's water and sewer
          provider, against another utility. Funded local decisions like these are a better read than any
          construction schedule.
        </p>
      </div>
    </div>
  </section>

  <!-- THE OWNER ADVICE -->
  <section class="band-tight" aria-labelledby="underwrite-h">
    <div class="wrap max-w-[880px]">
      <h2 id="underwrite-h" class="text-[clamp(26px,3.2vw,38px)]">Should you underwrite a Johnstown rental on Intel?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        No. Underwrite it on today's rent, with the vacancy, turn and repair assumptions you would use on any
        outer-ring Licking County property, and treat the project as upside.
      </p>
      <ul class="text-[17px] text-muted mt-4 list-disc pl-6 grid gap-1.5">
        <li><strong>It is a small market.</strong> Johnstown had 5,182 residents in the 2020 census and an estimated 5,310 in 2023. One buyer paying a growth premium moves the comps, and if the schedule slips again, whoever holds that premium bought the story.</li>
        <li><strong>Comparables are thin.</strong> A listing priced 8% high sits a month longer, and a month of vacancy here costs more than a year of management. We price off live comparables and tell you when your number is not there.</li>
      </ul>
    </div>
  </section>

  <!-- REGISTRATION AND PRICING -->
  <section class="band band-wash" aria-labelledby="reg-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Compliance and cost</span>
      <h2 id="reg-h" class="text-[clamp(26px,3.2vw,38px)]">Do you have to register a Johnstown rental, and what does management cost?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Not with the county. The state's county auditor rental registration (R.C. 5323.02) applies only in
        counties of more than 200,000 people, so it does not apply to a Licking County rental. City programs are
        separate (Columbus added a registry in April 2026 under City Code Chapter 4515), and we track which
        rules apply to each address and handle the filings that do.
      </p>
      <div class="grid gap-5 sm:grid-cols-3 mt-8">
        {pricing.plans.map((p) => (
          <div class="card text-center">
            <div class="font-sans text-[12px] font-bold tracking-[.13em] uppercase text-faint mb-2">{p.name}</div>
            <div class="font-sans text-[42px] font-extrabold tracking-[-.045em] text-navy leading-none">{usd(p.monthly)}</div>
            <div class="font-sans text-[13px] text-faint mt-2">per unit, per month</div>
            <p class="text-[14.5px] text-muted mt-4 mb-0">{usd(p.repairApprovalLimit)} per-item repair approval limit</p>
          </div>
        ))}
      </div>
      <p class="text-[16.5px] text-muted mt-7">
        {publishesOwnRent
          ? 'Our portfolio sample in Johnstown now supports a published median. Update this page before relying on it.'
          : 'No Johnstown rent median is published here: our sample is below our five-unit floor.'}
        {' '}Photography is not included in the {usd(pricing.leasingFee)} leasing fee and is billed separately at
        $250 to $450.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/pricing/" class="btn btn-navy">See every fee we charge</a>
        <a href="/free-rent-evaluation/" class="btn btn-ghost">Price my Johnstown rental</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band-tight" aria-labelledby="faq-section">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <h2 id="faq-section" class="sr-only">Johnstown property management questions</h2>
      <Faq items={faq} heading="Johnstown property management questions" id="johnstown-faq" />
      <p class="mt-7 text-[15.5px] text-muted">
        Rent is due {rentPolicy.dueDate}, late fees start after {rentPolicy.lateFeesAfter}, and owners are paid on
        the {rentPolicy.ownerDisbursementDay}th. More answers on the
        {' '}<a href="/owner-faqs/" class="text-crimson font-semibold no-underline hover:underline">owner FAQs page</a>.
      </p>
      <div class="mt-6"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/property-management-pataskala-ohio/', label: 'Pataskala property management', note: 'South, same county and same court, very different housing stock.' },
    { href: '/property-management-westerville-ohio/', label: 'Westerville property management', note: 'West, Franklin County, and its own municipal electric utility.' },
    { href: '/property-management-gahanna-ohio/', label: 'Gahanna property management', note: 'Southwest, established suburban stock inside Franklin County.' },
    { href: '/property-management-columbus-ohio/', label: 'Columbus property management', note: 'The anchor page, with rents, the registry and the court.' },
    { href: '/pricing/', label: 'Pricing and the full fee schedule', note: 'Every charge that can appear on an owner statement.' },
  ]} heading="Nearby markets and what to read next" />

  <Cta
    heading="Find out what your Johnstown rental should earn today"
    body="Send the address. We will price it on what the market pays now, not what a construction schedule implies. No charge."
    primary={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondary={{ label: 'Get a portfolio quote', href: '/property-management-consultation/' }}
  />
</Base>
