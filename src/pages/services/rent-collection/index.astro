---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import Faq from '../../../components/Faq.astro';
import Verified from '../../../components/Verified.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import Cta from '../../../components/Cta.astro';
import { company, pricing, kpis, rentPolicy, usd } from '../../../data/facts';
import { serviceNode } from '../../../lib/schema';
import LegalNote from '../../../components/LegalNote.astro';

/**
 * Intent: "rent collection service", "what happens if my tenant does not pay".
 * Policy pattern from CONTENT_STYLE: stated policy, real-world nuance, the number.
 */

const kpi = (id: string) => kpis.metrics.find((m) => m.id === id)?.value ?? '';

const title = 'Rent Collection for Columbus Rental Owners | RL Property Management';
const description =
  `Rent is due ${rentPolicy.dueDate}, late fees are assessed after ${rentPolicy.lateFeesAfter}, and owner funds are ` +
  `disbursed on the ${rentPolicy.ownerDisbursementDay}th. ${kpi('collectedBy5')} of rent is collected by the 5th. What happens when a resident stops paying.`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: 'Rent collection', path: '/services/rent-collection/' },
];

const answer =
  `Rent is due ${rentPolicy.dueDate}, most residents pay by ${rentPolicy.lateFeesAfter}, and late fees are ` +
  `assessed after ${rentPolicy.lateFeesAfter}. ${company.name} collects ${kpi('collectedBy5')} of rent by the 5th ` +
  `and disburses owner funds on the ${rentPolicy.ownerDisbursementDay}th.`;

const facts = [
  `Rent due ${rentPolicy.dueDate} of the month`,
  `Late fees assessed after ${rentPolicy.lateFeesAfter}`,
  `${kpi('collectedBy5')} of rent collected by the 5th`,
  `Owner disbursement on the ${rentPolicy.ownerDisbursementDay}th, ${rentPolicy.disbursementNote}`,
  'Online payment, with automated late notices',
  `${usd(0)} to post a 3-day or 30-day notice to vacate`,
  `Month-to-month tenancy carries a ${rentPolicy.monthToMonthIncreasePct}% rent increase`,
  `${kpi('occupancy')} portfolio occupancy`,
];

const timeline = [
  { when: `${rentPolicy.dueDate.replace(/^the/, 'The')}`, what: 'Rent is due in full. Residents pay online, and most of the portfolio is on autopay or pays within the first few days.' },
  { when: 'The 2nd to the 5th', what: `The practical payment window. A payment on the 3rd reflects a pay cycle, not a problem. Automated reminders go out.` },
  { when: `After ${rentPolicy.lateFeesAfter}`, what: 'Late fees are assessed. Contact escalates from automated notice to direct outreach, to learn whether this is one bad month or the start of a pattern.' },
  { when: 'Notice stage', what: `If rent stays unpaid, a notice to vacate is posted at the property, at no charge for a 3-day or 30-day notice. R.C. 1923.04 requires at least three days before an action can be filed, and the notice has to carry a specific paragraph of statutory language to be valid.` },
  { when: 'Filing', what: `If the notice period runs out with rent still unpaid, the case is filed in Franklin County. Hard cost is ${usd(pricing.eviction.hardCostTotal)}, and our fee to manage the case is ${usd(pricing.eviction.rlpmProcessFee)}.` },
  { when: `The ${rentPolicy.ownerDisbursementDay}th`, what: `Collected funds are disbursed electronically to owners, and take ${rentPolicy.disbursementNote}.` },
];

const faq = [
  { q: 'When is rent due, and when are late fees charged?',
    a: `Rent is due ${rentPolicy.dueDate}. In practice many residents pay between ${rentPolicy.practicalWindow}. Late fees are assessed after ${rentPolicy.lateFeesAfter}. Across the portfolio, ${kpi('collectedBy5')} of rent is collected by the 5th as of ${kpis.asOfLabel}.` },
  { q: 'When do I get my money?',
    a: `Owner funds are disbursed electronically on the ${rentPolicy.ownerDisbursementDay}th of each month and take ${rentPolicy.disbursementNote}. The gap after the 5th lets the month close, so your statement matches your deposit.` },
  { q: 'What happens if my tenant does not pay rent?',
    a: `Late fees are assessed after ${rentPolicy.lateFeesAfter}, outreach escalates, and if rent stays unpaid we post a notice to vacate at no charge. If the notice period passes without payment, we file in Franklin County: hard costs are ${usd(pricing.eviction.hardCostTotal)} and our fee to run the case is ${usd(pricing.eviction.rlpmProcessFee)}. Roughly ${pricing.eviction.disputeRatePct}% of rentals reach eviction, litigation or another significant dispute.` },
  { q: 'Should I accept a partial payment?',
    a: 'It depends on the stage. Accepting partial rent after a notice has been served can affect the case, and in some circumstances restarts the process, so we check with the eviction attorney before accepting one mid-case. Any payment plan should be in writing, dated, and specific about amounts.' },
  { q: 'Do you offer payment plans?',
    a: 'Case by case, and only in writing. A resident with one bad month and a documented reason is worth working with, because a turn plus a vacancy plus an eviction costs the owner far more than a two-month catch-up plan.' },
  { q: 'What happens when a lease ends and the resident stays?',
    a: `A month-to-month tenancy carries a ${rentPolicy.monthToMonthIncreasePct}% rent increase, which gives the resident a clear reason to sign a renewal instead. A renewal is ${usd(pricing.leaseRenewalFee)} to the owner.` },
  { q: 'Can I collect rent myself and hire you for everything else?',
    a: 'No. Rent collection is where lease enforcement happens. Splitting it from management separates the leverage from the information, and your statement would no longer reflect what was collected.' },
  { q: 'What if I take over a unit whose resident is already behind?',
    a: 'That is a delinquent tenant setup: $300, when we take over an occupied unit whose resident owes more than $300. It covers reconstructing the ledger, establishing what is owed, and starting collection from a defensible position.' },
];

const schemaNodes = [
  serviceNode({
    path: '/services/rent-collection/',
    name: 'Rent collection and lease enforcement',
    description,
  }),
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="Rent collection"
    title="How rent gets collected, and what happens when it does not"
    answer={answer}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondaryCta={{ label: 'See all services', href: '/services/' }}
  
    image={{ src: "owner-paperwork", alt: "A property owner at a kitchen table comparing a statement against a laptop", widths: [640, 1000, 1400], ratio: 1.5 }}
  />

  <KeyFacts items={facts} />

  <section class="band" aria-labelledby="policy-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The policy</span>
      <h2 id="policy-h" class="text-[clamp(28px,3.3vw,40px)]">When is rent due?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Rent is due {rentPolicy.dueDate}. Many residents pay between {rentPolicy.practicalWindow}, when paychecks
        land, and late fees are assessed after {rentPolicy.lateFeesAfter}. A payment on the 3rd reflects a pay
        cycle. A payment not in by the 6th is a signal to act. Across our portfolio, {kpi('collectedBy5')} of rent is collected by the 5th as of
        {' '}{kpis.asOfLabel}.
      </p>
    </div>
  </section>

  <section class="band band-wash" aria-labelledby="timeline-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Month by month</span>
      <h2 id="timeline-h" class="text-[clamp(28px,3.3vw,40px)]">What does the collection month look like?</h2>
      <p class="text-[17.5px] text-muted mt-4 mb-8 max-w-[44em]">
        The same sequence every month, so no one decides in the moment what to do about a late resident.
      </p>
      <ol class="grid gap-4">
        {timeline.map((t) => (
          <li class="card">
            <div class="font-sans text-[12px] font-bold tracking-[.13em] uppercase text-crimson mb-2">{t.when}</div>
            <p class="text-[15.5px] text-muted m-0">{t.what}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="nonpay-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The hard case</span>
      <h2 id="nonpay-h" class="text-[clamp(28px,3.3vw,40px)]">What happens if my tenant does not pay?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        The fixed process above ends in a filing, and the numbers are published:
        {' '}{usd(pricing.eviction.hardCostTotal)} in hard costs, which is
        {' '}{usd(pricing.eviction.attorneyFee)} to the eviction attorney and
        {' '}{usd(pricing.eviction.countyFilingFee)} to Franklin County, plus
        {' '}{usd(pricing.eviction.rlpmProcessFee)} to us to manage the case. Roughly
        {' '}{pricing.eviction.disputeRatePct}% of rentals reach eviction, litigation or another significant dispute.
      </p>
      <p class="text-[17.5px] text-muted mt-4">
        The expensive mistake is waiting: each month of delay adds a month of rent you will not collect. The
        full process is on the
        {' '}<a href="/services/evictions/" class="text-crimson font-semibold no-underline hover:underline">evictions page</a>.
      </p>
    </div>
  </section>

  <section class="band band-wash" aria-labelledby="pay-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Your side of it</span>
      <h2 id="pay-h" class="text-[clamp(28px,3.3vw,40px)]">Why do owners get paid on the 10th and not the 6th?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        The month has to close first: payments clear, maintenance invoices post, and your statement matches
        your deposit. Disbursement is electronic on the {rentPolicy.ownerDisbursementDay}th and takes
        {' '}{rentPolicy.disbursementNote}. A manager who pays out before the books close is holding a float or
        sending a number that will be corrected later.
      </p>
    </div>
  </section>

  <section class="band band-wash">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Rent collection questions" id="rent-faq" />
      <LegalNote class="mb-5" />
      <div class="mt-8"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/services/evictions/', label: 'Evictions', note: 'What filing in Franklin County costs and involves.' },
    { href: '/services/owner-reporting/', label: 'Owner reporting', note: 'The statement that arrives with your disbursement.' },
    { href: '/services/tenant-screening/', label: 'Tenant screening', note: 'The cheapest way to avoid a collection problem.' },
    { href: '/pricing/', label: 'Pricing', note: 'Flat monthly management, and every other fee.' },
    { href: '/services/', label: 'All services', note: 'The other seven jobs a manager does.' },
  ]} />

  <Cta
    heading="Stop chasing rent"
    body="Rent comes in on a published schedule, late fees are enforced without a phone call from you, and your deposit lands on the 10th."
    primary={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondary={{ label: `Call ${company.phone}`, href: `tel:${company.phoneE164}` }}
  />
</Base>
