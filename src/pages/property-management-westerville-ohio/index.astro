---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, pricing, rentPolicy, typicalManager, usd } from '../../data/facts';
import { rentByMarketAndBedroom } from '../../data/markets';
import { serviceNode } from '../../lib/schema';

/**
 * Westerville, Ohio. Target query: "property management westerville ohio".
 *
 * The differentiating fact for Westerville is the municipal electric utility.
 * Westerville does not sit on AEP Ohio. The city owns and runs its own Electric
 * Division and bills electric, water, sewer and refuse on one municipal utility
 * account. That changes every utility transfer, every vacancy, and every
 * move-out reconciliation in this city, and no competitor page mentions it.
 *
 * SOURCES (verified 2026-09-09):
 *  - Westerville Electric Division, municipally owned and operated, serving the
 *    city's residents and more than 2,100 businesses, staffed 24 hours a day:
 *    westerville.org/services/electric and business.westerville.org
 *    /why-westerville/municipal-utilities/ ("the only municipally owned and
 *    operated electric provider in Central Ohio"). The westerville.org host
 *    refuses automated fetching, so these were read through search indexing of
 *    the official pages rather than a direct fetch.
 *  - Utility Billing handles meter reading, billing and collections for electric,
 *    water, sewer and refuse across more than 16,000 accounts, office at
 *    21 S. State Street, Westerville OH 43081:
 *    westerville.org/services/utility-billing.
 *  - City electric division established 1898, first water treatment plant 1901:
 *    same source.
 *  - American Municipal Power member community: amppartners.org/news
 *    /member-spotlight/westerville-ohio/.
 *  - Westerville lies in Franklin and Delaware counties:
 *    en.wikipedia.org/wiki/Westerville,_Ohio. Population 39,190 at the 2020 census.
 *  - Court jurisdiction follows the county under R.C. 1901.02. Franklin County
 *    Municipal Court eviction division, 375 S. High St., 3rd floor, Columbus
 *    43215. Delaware Municipal Court hears FED actions for Delaware County parcels.
 *  - Owner filing with the county auditor: R.C. 5323.02, penalty R.C. 5323.99.
 *  - Median year structure built 1982: US Census, ACS 2024 5-year estimates.
 *  - Columbus lists Westerville under water and sewer contract communities for
 *    various parts of the city: columbus.gov Water & Sewer Contract Communities.
 *    The split between city-supplied and Columbus-supplied service is not
 *    resolved and is marked SOURCE NEEDED rather than guessed.
 *
 * Rent figures are our own portfolio medians and qualify for Westerville at 3 and
 * 4 bedrooms (sample of 5 or more). No door counts, no per-market days on market.
 */

const CITY = 'Westerville';
const PATH = '/property-management-westerville-ohio/';
const MEDIAN_YEAR_BUILT = 1982;

const title = 'Westerville Property Management | RL Property Management';
const description =
  `Flat-fee property management for Westerville, Ohio rentals from ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} ` +
  `per unit per month with a ${usd(pricing.leasingFee)} leasing fee. Westerville runs its own municipal electric utility, which changes every utility transfer.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/areas-we-serve/' },
  { name: 'Westerville', path: PATH },
];

const rent = rentByMarketAndBedroom[CITY];

const keyFacts = [
  `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, not a percentage of rent`,
  `${usd(pricing.leasingFee)} leasing fee every time a Westerville unit turns`,
  'Electricity comes from the City of Westerville, not from AEP Ohio',
  'Electric, water, sewer and refuse arrive on one municipal utility account',
  `Median rent across the units we manage in Westerville: ${usd(rent['3'].median)} for a 3 bedroom`,
  `Median Westerville home was built in ${MEDIAN_YEAR_BUILT} (US Census, ACS 2024 5-year estimates)`,
];

const faq = [
  { q: 'Who provides electricity in Westerville, Ohio?',
    a: 'The City of Westerville, through its own Electric Division, which the city calls the only municipally owned and operated electric provider in central Ohio, running since 1898. Westerville rentals are not AEP Ohio accounts; electric, water, sewer and refuse are billed together by the city Utility Billing office at 21 S. State Street.' },
  { q: 'How does the Westerville municipal utility change a move-in or move-out?',
    a: 'Four Westerville utilities move on one account, so one missed transfer leaves all four in the owner name. We confirm the transfer date against the lease start and check the account again at move-out before a deposit is settled.' },
  { q: 'Which court hears an eviction in Westerville, Ohio?',
    a: 'For most addresses, Franklin County Municipal Court, 375 S. High St., 3rd floor, Columbus, OH 43215. Westerville\'s northern portion is in Delaware County, and under R.C. 1901.02 those parcels file at Delaware Municipal Court; the wrong court costs the fee and the time.' },
  { q: 'Do I have to register my Westerville rental property with anyone?',
    a: 'Yes, with the Franklin or Delaware County auditor, not the city. R.C. 5323.02 requires owner name, address, phone and parcel number, updated within 60 days of any change, with no filing fee; missing it draws an R.C. 5323.99 assessment the Franklin County Auditor states as $150 per tax year. We file as your designated agent.' },
  { q: 'What does a rental in Westerville, Ohio rent for?',
    a: `Across the units we manage in Westerville, the median rent is ${usd(rent['3'].median)} for a 3 bedroom and ${usd(rent['4'].median)} for a 4 bedroom, our own portfolio medians. That sits above our portfolio-wide median because of the housing stock.` },
  { q: 'What kind of rental property is there in Westerville?',
    a: `Mostly detached houses with a median year built of ${MEDIAN_YEAR_BUILT} (US Census ACS 2024 5-year), roughly two decades newer than Upper Arlington or Worthington. A 1980s Westerville house is past its first furnace, air conditioner and usually roof, but post-1978, so federal lead-based paint disclosure does not apply to most of it.` },
  { q: 'How much does property management cost in Westerville?',
    a: `A flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, a ${usd(pricing.leasingFee)} leasing fee and ${usd(pricing.leaseRenewalFee)} per renewal. On a ${usd(rent['3'].median)} Westerville house, a 10% manager would take about ${usd(Math.round(rent['3'].median * 0.1) * 12)} a year.` },
  { q: 'What does an eviction cost in Westerville?',
    a: `A typical Westerville case costs ${usd(pricing.eviction.typicalTotal)} before any setout: ${usd(pricing.eviction.countyFilingFee)} county filing, ${usd(pricing.eviction.attorneyFee)} attorney (filing plus up to two appearances) and ${usd(pricing.eviction.rlpmProcessFee)} to us, a ${usd(pricing.eviction.hardCostTotal)} hard cost. A setout adds ${usd(pricing.eviction.tagAndSetoutFee)} county and ${usd(pricing.eviction.setoutFee)} ours, and roughly ${pricing.eviction.disputeRatePct}% of cases are contested.` },
];

const schemaNodes = [
  {
    ...serviceNode({
      path: PATH,
      name: 'Residential property management in Westerville, Ohio',
      description,
    }),
    areaServed: {
      '@type': 'City',
      name: 'Westerville, Ohio',
      containedInPlace: [
        { '@type': 'AdministrativeArea', name: 'Franklin County, Ohio' },
        { '@type': 'AdministrativeArea', name: 'Delaware County, Ohio' },
      ],
    },
  },
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="Where we work"
    title="Property management in Westerville, Ohio"
    answer={`${company.name} manages single-family and small multifamily rentals in Westerville for a flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, with a ${usd(pricing.leasingFee)} leasing fee. Westerville runs its own electric utility, which changes every utility transfer.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondaryCta={{ label: 'See the full fee schedule', href: '/pricing/' }}
  />

  <KeyFacts items={keyFacts} heading="Westerville, at a glance" />

  <!-- THE MUNICIPAL UTILITY. The single most useful thing on this page. -->
  <section class="band-tight" aria-labelledby="util-h">
    <div class="wrap max-w-[880px]">
      <h2 id="util-h" class="text-[clamp(26px,3.2vw,38px)]">Who provides electricity in Westerville, and why does it matter to an owner?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        The City of Westerville, through its own Electric Division, which the city describes as the only
        municipally owned and operated electric provider in central Ohio, in business since 1898. No other
        suburb we work is set up this way.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Elsewhere a resident calls AEP Ohio, Columbia Gas of Ohio and a water utility. Here the city bills
        electric, water, sewer and refuse on one account from the Utility Billing office at 21 S. State Street.
        Westerville opened its own water treatment plant in 1901 and is a member of American Municipal Power, the
        nonprofit joint-action agency that supplies wholesale power to Ohio municipal systems.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Utility providers for Westerville, Ohio rental property</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Service</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Provider</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Who customarily pays</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Electricity</th>
              <td class="p-3.5 border border-line text-navy font-semibold">City of Westerville, Electric Division</td>
              <td class="p-3.5 border border-line text-muted">Resident, in their own name, on our standard lease</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Water and sewer</th>
              <td class="p-3.5 border border-line text-navy font-semibold">City of Westerville, billed with the electric account</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Refuse and recycling</th>
              <td class="p-3.5 border border-line text-navy font-semibold">City of Westerville, billed with the electric account</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Natural gas</th>
              <td class="p-3.5 border border-line text-navy font-semibold">Columbia Gas of Ohio</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
          </tbody>
        </table>
      </div>
      <h3 class="text-[21px] mt-9 mb-3">What the one-account structure does to a turn</h3>
      <p class="text-[16.5px] text-muted">
        One call moves four utilities, and one missed transfer leaves all four in your name. At move-out, a
        resident who closes the account early leaves a vacant house without power in February, and a burst pipe
        becomes a claim. So we:
      </p>
      <ul class="text-[16.5px] text-muted mt-3 list-disc pl-6 grid gap-1.5">
        <li>Confirm the transfer date against the lease start, not the resident's word.</li>
        <li>Keep the account in the owner name through the vacancy, so heat and power stay on while we turn and show it.</li>
        <li>Check it at move-out before settling the deposit, since unpaid water and sewer in Ohio can follow the property.</li>
      </ul>
    </div>
  </section>

  <!-- COURT -->
  <section class="band band-wash" aria-labelledby="court-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">If it goes wrong</span>
      <h2 id="court-h" class="text-[clamp(26px,3.2vw,38px)]">Which court hears an eviction in Westerville, Ohio?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Franklin County Municipal Court, 375 S. High St., 3rd floor, Columbus, OH 43215, for most addresses. The
        northern portion of the city is in Delaware County, and under Ohio Revised Code 1901.02 those parcels file at Delaware
        Municipal Court. Two houses a few streets apart can answer to different courts.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        The step self-managing owners miss most: the R.C. 1923.04 three-day notice, in statutory wording, served
        by certified mail, by hand or left at the property. Get it wrong and you restart three weeks and a month
        of rent behind. A typical case costs {usd(pricing.eviction.typicalTotal)} before any setout
        ({usd(pricing.eviction.hardCostTotal)} hard cost, of which {usd(pricing.eviction.countyFilingFee)} is the
        county and {usd(pricing.eviction.attorneyFee)} the attorney, plus our {usd(pricing.eviction.rlpmProcessFee)}).
        Contested cases are covered on the
        {' '}<a href="/services/evictions/" class="text-crimson font-semibold no-underline hover:underline">evictions page</a>.
      </p>
    </div>
  </section>

  <!-- REGISTRATION -->
  <section class="band-tight" aria-labelledby="reg-h">
    <div class="wrap max-w-[880px]">
      <h2 id="reg-h" class="text-[clamp(26px,3.2vw,38px)]">Do you have to register a Westerville rental property?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Yes, with the county auditor, free, and we file it for you at onboarding. R.C. 5323.02 asks for your
        name, address and phone, the property street address and permanent parcel number, within 60 days of
        buying and of any change. An LLC or trust adds its responsible officer, member or trustee (the line most
        often left blank). Missing it draws an R.C. 5323.99 assessment, stated by the Franklin County Auditor as
        $150 per tax year. City programs, such as the Columbus registry added in April 2026 under City Code
        Chapter 4515, stack on top; we track them.
      </p>
    </div>
  </section>

  <!-- HOUSING STOCK -->
  <section class="band band-wash" aria-labelledby="stock-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The market</span>
      <h2 id="stock-h" class="text-[clamp(26px,3.2vw,38px)]">What kind of rental property is there in Westerville?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Mostly detached houses, newer than closer in. The median home was built in {MEDIAN_YEAR_BUILT} (US Census
        ACS 2024 5-year), about two decades after Worthington and Upper Arlington. Uptown Westerville at State and
        Main is the nineteenth-century core, Otterbein University anchors the blocks around it, and most rentals
        sit in subdivisions built from the 1970s through the 1990s.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        A {MEDIAN_YEAR_BUILT} house is past its first furnace and air conditioner, usually on its second roof, with
        original cabinets and tile that work but no longer photograph well, and a third or fourth water heater.
        It is post-1978, so the federal lead disclosure rules that govern Upper Arlington and much of Worthington
        do not reach the typical Westerville rental.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Budget for mechanical replacement: a second furnace will need a third on your watch, ideally in September,
        not as a no-heat call in January. In-house maintenance is {usd(pricing.maintenance.inHouseHourly)} per hour with a
        {' '}{usd(pricing.maintenance.tripCharge)} trip charge and no minimum, and after hours it is
        {' '}{pricing.afterHours.weekdayEveningAndSaturday} times the rate on weekday evenings and Saturdays and
        {' '}{pricing.afterHours.sunday} times on Sundays.
      </p>
      <h3 class="text-[21px] mt-9 mb-3">Where in Westerville we work</h3>
      <p class="text-[16.5px] text-muted">
        Uptown Westerville, the Otterbein University blocks, Highlands, Spring Grove, the Cleveland Avenue and
        Sunbury Road corridors, Huber Village, Westar, and the newer sections north and east toward the Delaware
        County line, all in the Westerville City School District. Hoover Reservoir and Alum Creek are the local
        landmarks, and Otterbein adds staff and graduate demand outside the family rental cycle.
      </p>
    </div>
  </section>

  <!-- RENT AND PRICING -->
  <section class="band-tight" aria-labelledby="rent-h">
    <div class="wrap max-w-[880px]">
      <h2 id="rent-h" class="text-[clamp(26px,3.2vw,38px)]">What does a Westerville rental earn, and what does management cost?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Across the units we manage in Westerville, the median rent is {usd(rent['3'].median)} for a three bedroom
        and {usd(rent['4'].median)} for a four bedroom. Both are our own portfolio medians, not a market survey.
      </p>
      <div class="grid gap-5 sm:grid-cols-3 mt-8">
        {pricing.plans.map((p) => (
          <div class="card text-center">
            <div class="font-sans text-[12px] font-bold tracking-[.13em] uppercase text-faint mb-2">{p.name}</div>
            <div class="font-sans text-[42px] font-extrabold tracking-[-.045em] text-navy leading-none">{usd(p.monthly)}</div>
            <div class="font-sans text-[13px] text-faint mt-2">per unit, per month</div>
            <p class="text-[14.5px] text-muted mt-4 mb-0">{usd(p.repairApprovalLimit)} per-item repair approval limit</p>
          </div>
        ))}
      </div>
      <p class="text-[16.5px] text-muted mt-7">
        Plans differ only in the repair approval limit. A 10% manager on a {usd(rent['3'].median)} Westerville
        house takes about {usd(Math.round(rent['3'].median * 0.1) * 12)} a year plus
        {' '}{usd(typicalManager.leasingFee(rent['3'].median))} at each turn. Our middle plan is
        {' '}{usd(pricing.plans[1].monthly * 12)} a year with {usd(pricing.leasingFee)} placement, and it does not
        rise with your rent.
      </p>
      <p class="text-[14px] text-faint mt-4">
        Percentage figures describe common Columbus market rates, not any named company. Photography is billed
        separately at $250 to $450.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/pricing/" class="btn btn-navy">See every fee we charge</a>
        <a href="/free-rent-evaluation/" class="btn btn-ghost">Price my Westerville rental</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band band-wash" aria-labelledby="faq-section">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <h2 id="faq-section" class="sr-only">Westerville property management questions</h2>
      <Faq items={faq} heading="Westerville property management questions" id="westerville-faq" />
      <p class="mt-7 text-[15.5px] text-muted">
        Rent is due {rentPolicy.dueDate}, with late fees after {rentPolicy.lateFeesAfter}. Owners are paid on the
        {' '}{rentPolicy.ownerDisbursementDay}th. See the
        {' '}<a href="/owner-faqs/" class="text-crimson font-semibold no-underline hover:underline">owner FAQs page</a>.
      </p>
      <div class="mt-6"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/property-management-worthington-ohio/', label: 'Worthington property management', note: 'West across I-270, older stock and a design review district.' },
    { href: '/property-management-upper-arlington-ohio/', label: 'Upper Arlington property management', note: 'Southwest, the oldest housing stock we manage.' },
    { href: '/property-management-dublin-ohio/', label: 'Dublin property management', note: 'West, larger lots and a three-county eviction problem.' },
    { href: '/property-management-columbus-ohio/', label: 'Columbus property management', note: 'The anchor page, with every neighborhood we work.' },
    { href: '/pricing/', label: 'Pricing and the full fee schedule', note: 'Every charge that can appear on an owner statement.' },
  ]} heading="Nearby markets and what to read next" />

  <Cta
    heading="Find out what your Westerville rental should earn"
    body="Send the address and we will price it against our Westerville units and today's comparable listings. No charge."
    primary={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondary={{ label: 'Get a portfolio quote', href: '/property-management-consultation/' }}
  />
</Base>
