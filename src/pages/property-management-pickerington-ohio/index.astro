---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, pricing, rentPolicy, usd } from '../../data/facts';
import { rentByBedroom } from '../../data/markets';
import { serviceNode } from '../../lib/schema';

/**
 * Pickerington, Ohio. Target query: "property management pickerington ohio".
 *
 * The differentiating fact is the county. Pickerington is mostly FAIRFIELD
 * County, not Franklin, and part of the city extends into Franklin County. So:
 *   - an eviction on a Fairfield parcel goes to Fairfield County Municipal Court
 *     in Lancaster, not to Franklin County Municipal Court in Columbus;
 *   - the R.C. 5323.02 rental owner filing goes to the Fairfield County Auditor,
 *     not the Franklin County Auditor;
 *   - and for a parcel on the Franklin side, both of those flip.
 * Almost every "Columbus area property management" page treats Pickerington as
 * Franklin County by default. That is the error this page exists to correct.
 *
 * A SECOND, RELATED TRAP: a great many addresses with a Pickerington mailing
 * address are not inside the City of Pickerington at all, they are in
 * unincorporated Violet Township, Fairfield County. County answers do not change
 * (still Fairfield), but city utility service and city code do.
 *
 * SOURCES (verified 2026-09-09):
 *  - Pickerington lies partly in Fairfield and partly in Franklin County:
 *    en.wikipedia.org/wiki/Pickerington,_Ohio.
 *  - Eviction jurisdiction follows the county: R.C. 1901.02,
 *    codes.ohio.gov/ohio-revised-code/section-1901.02.
 *  - Fairfield County Municipal Court, 136 W. Main St., Lancaster, OH 43130,
 *    740-687-6621; civil jurisdiction to $15,000, hears forcible entry and
 *    detainer; the eviction complaint must have the notice to leave the premises
 *    attached. fcmcourt.org civil eviction packet and ohiolegalhelp.org.
 *  - Franklin County Municipal Court, 375 S. High St., Columbus, OH 43215,
 *    Eviction Court in Courtroom 11B. franklincountymunicourt.org.
 *  - R.C. 5323.02 applies statewide. Confirmed 2026-09-09 at
 *    codes.ohio.gov/ohio-revised-code/section-5323.02: the 200,000 population
 *    figure in the statute attaches to the county auditor's duty to NOTIFY
 *    owners, not to the owner's duty to file. Penalty R.C. 5323.99, $50 to $150.
 *  - Fairfield County 2020 decennial census population 158,921, below that
 *    200,000 notice threshold. US Census via en.wikipedia.org/wiki/Fairfield_County,_Ohio.
 *  - Pickerington is NOT on the City of Columbus water and sewer contract
 *    community list. columbus.gov Water & Sewer Contract Communities, fetched
 *    2026-09-09.
 *  - City of Pickerington Utilities Department, 100 Lockville Rd, Pickerington,
 *    OH 43147, 614-833-2289. Water and sewer billed monthly for the previous
 *    month's use; bills go out on the 1st and are due on the 15th.
 *    ci.pickerington.oh.us/departments/utility-billing/.
 *  - AEP Ohio for electricity, Columbia Gas of Ohio for natural gas.
 *
 * Pickerington has NO entry in rentByMarketAndBedroom, so no Pickerington rent
 * median is published here. Portfolio-wide medians are used and are labelled
 * portfolio-wide across the metro. No door counts, no per-market days on market.
 *
 * NOT VERIFIED, marked in the copy:
 *  - Whether the City of Pickerington requires residential rental registration,
 *    a rental licence or periodic inspection, and any fee.
 *  - Who supplies water and sewer to unincorporated Violet Township addresses
 *    outside the city limits.
 *  - Census median year structure built for Pickerington.
 */

const PATH = '/property-management-pickerington-ohio/';

const title = 'Property Management in Pickerington, Ohio | RL Property Management';
const description =
  `Flat-fee property management for Pickerington, Ohio rentals from ${usd(pricing.plans[0].monthly)} to ` +
  `${usd(pricing.plans[2].monthly)} per unit per month with a ${usd(pricing.leasingFee)} leasing fee. ` +
  `Pickerington is mostly Fairfield County, so an eviction is filed in Lancaster, not Columbus.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/areas-we-serve/' },
  { name: 'Pickerington', path: PATH },
];

const keyFacts = [
  `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, not a percentage of rent`,
  `${usd(pricing.leasingFee)} leasing fee every time a Pickerington unit turns`,
  'Mostly Fairfield County, with part of the city extending into Franklin County',
  'A Fairfield County eviction is filed at 136 W. Main St., Lancaster, not in Columbus',
  'Rental owner registration goes to the Fairfield County Auditor for a Fairfield parcel',
  'The City of Pickerington runs its own water and sewer utility, not Columbus',
];

const courts = [
  {
    county: 'Fairfield County',
    court: 'Fairfield County Municipal Court',
    where: '136 W. Main St., Lancaster, OH 43130. 740-687-6621. Civil jurisdiction to $15,000, and it hears forcible entry and detainer actions, with the notice to leave the premises attached to the complaint.',
    note: 'Covers most Pickerington addresses, and all of unincorporated Violet Township around the city.',
    auditor: 'Fairfield County Auditor',
  },
  {
    county: 'Franklin County',
    court: 'Franklin County Municipal Court',
    where: '375 S. High St., Columbus, OH 43215. Eviction Court sits in Courtroom 11B.',
    note: 'Covers the portion of the city that extends over the Franklin County line.',
    auditor: 'Franklin County Auditor',
  },
];

const faq = [
  { q: 'What county is Pickerington, Ohio in?',
    a: 'Mostly Fairfield County. Pickerington lies partly in Fairfield County and partly in Franklin County, with the larger share in Fairfield. That is the most consequential fact about owning a rental here, because both the eviction court and the county auditor you file your rental owner information with follow the county line rather than the city name. The answer depends on the specific address.' },
  { q: 'Which court hears an eviction in Pickerington, Ohio?',
    a: 'For a Fairfield County parcel, Fairfield County Municipal Court at 136 W. Main St., Lancaster, OH 43130, telephone 740-687-6621, whose civil jurisdiction runs to $15,000 and which hears forcible entry and detainer actions, with the notice to leave the premises attached to the complaint. For a Franklin County parcel, Franklin County Municipal Court at 375 S. High St., Columbus, Eviction Court in Courtroom 11B. Jurisdiction follows the county under Ohio Revised Code 1901.02, so a manager who assumes Pickerington is Columbus files in the wrong court.' },
  { q: 'Where do I register a Pickerington rental property?',
    a: 'With the auditor of the county your parcel is in: the Fairfield County Auditor for most of Pickerington, the Franklin County Auditor for the Franklin County portion. Ohio Revised Code 5323.02 requires the owner to file their name, address and telephone number plus the property street address and permanent parcel number, and to update within 60 days of any change. There is no filing fee, and failing to file draws a special assessment under R.C. 5323.99 of $50 to $150. A manager may file as the owner designated agent, and we do.' },
  { q: 'Does the Fairfield County Auditor remind me to register?',
    a: 'Do not count on it. R.C. 5323.02 requires the filing statewide, but the statutory duty on a county auditor to notify owners of the requirement attaches to counties with populations over 200,000. Fairfield County recorded 158,921 residents in the 2020 decennial census, below that line. The duty to file is yours regardless of whether anyone writes to you about it, and the penalty under R.C. 5323.99 applies regardless too.' },
  { q: 'Who provides water and sewer in Pickerington, Ohio?',
    a: 'The City of Pickerington runs its own utility, at 100 Lockville Rd, Pickerington, OH 43147, telephone 614-833-2289. Water and sewer are billed monthly for the previous month of use, bills go out on the first and are due on the fifteenth. Pickerington is not a City of Columbus water and sewer contract community, so nothing about the Columbus arrangement applies here. Electricity is AEP Ohio and natural gas is Columbia Gas of Ohio. [SOURCE NEEDED: confirm who supplies water and sewer to unincorporated Violet Township addresses that carry a Pickerington mailing address but sit outside the city limits.]' },
  { q: 'Is my Pickerington address actually in the City of Pickerington?',
    a: 'Often not. Many addresses with a Pickerington mailing address sit in unincorporated Violet Township, Fairfield County, rather than inside the city. The court and the auditor stay the same, because Violet Township is Fairfield County. What changes is city utility service, city zoning and city code enforcement, none of which reach an address outside the corporation limit. Check the parcel with the county auditor rather than trusting the postmark.' },
  { q: 'What kind of rental property is there in Pickerington?',
    a: 'Predominantly detached single-family houses in subdivisions built from the 1990s onward: three and four bedrooms, attached garages, full basements. Old Pickerington Village at the centre is a small older core and the exception. Demand is driven heavily by the Pickerington Local School District, which means families, longer tenancies and a leasing season that peaks before the school year. [SOURCE NEEDED: US Census ACS 2024 5-year median year structure built for Pickerington, Ohio.]' },
  { q: 'How much does property management cost in Pickerington?',
    a: `A flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month depending on plan, with a ${usd(pricing.leasingFee)} leasing fee and ${usd(pricing.leaseRenewalFee)} on a lease renewal. Nothing about the price changes because the property is in Fairfield County rather than Franklin. Photography is not included in the leasing fee and is billed separately at $250 to $450. Every other charge that can appear on an owner statement is published on the pricing page.` },
];

const schemaNodes = [
  {
    ...serviceNode({
      path: PATH,
      name: 'Residential property management in Pickerington, Ohio',
      description,
    }),
    areaServed: {
      '@type': 'City',
      name: 'Pickerington, Ohio',
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Fairfield County, Ohio' },
    },
  },
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="Where we work"
    title="Property management in Pickerington, Ohio"
    answer={`${company.name} manages single-family and small multifamily rentals in Pickerington for a flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, with a ${usd(pricing.leasingFee)} leasing fee. Pickerington is mostly Fairfield County, so an eviction is filed in Lancaster.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondaryCta={{ label: 'See the full fee schedule', href: '/pricing/' }}
  />

  <KeyFacts items={keyFacts} heading="Pickerington, at a glance" />

  <!-- THE HOOK: Pickerington is not Franklin County, and the answer depends on
       the parcel. This is the thing a national or Columbus-default page gets
       wrong, and it costs the owner a filing fee and three weeks. -->
  <section class="band-tight" aria-labelledby="county-h">
    <div class="wrap max-w-[880px]">
      <h2 id="county-h" class="text-[clamp(26px,3.2vw,38px)]">What county is Pickerington in, and which court hears an eviction?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Mostly Fairfield County, which means most Pickerington evictions are filed in Lancaster rather than in
        Columbus. Pickerington lies partly in Fairfield County and partly in Franklin County, with the larger
        share in Fairfield, so the correct answer depends on the parcel. Eviction jurisdiction follows the county
        under R.C. 1901.02, and so does the auditor you owe your rental owner filing to. Neither follows the city
        name or the mailing address.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        This is the most common factual error made about Pickerington by managers who market themselves as
        Columbus companies. It reads as a Columbus suburb and sits inside the metro, so the Franklin County
        assumption is easy to make and expensive to make. A complaint filed in the wrong court is dismissed, and
        you file again three weeks later with the resident still in the house and still not paying.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Eviction court and county auditor by county for Pickerington, Ohio rental property</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">If your parcel is in</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">You file an eviction at</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Where, and what it covers</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">R.C. 5323 filing goes to</th>
            </tr>
          </thead>
          <tbody>
            {courts.map((c) => (
              <tr>
                <th scope="row" class="text-left p-3.5 border border-line font-medium align-top whitespace-nowrap">{c.county}</th>
                <td class="p-3.5 border border-line align-top font-semibold text-navy">{c.court}</td>
                <td class="p-3.5 border border-line align-top text-muted">{c.where} {c.note}</td>
                <td class="p-3.5 border border-line align-top text-muted">{c.auditor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[16px] text-muted mt-6">
        Whichever court it is, the case starts before the filing. Ohio requires a three-day notice to leave the
        premises under R.C. 1923.04, carrying specific statutory language, and Fairfield County requires a copy of
        that notice attached to the complaint. Our published costs are {usd(pricing.eviction.attorneyFee)} to the
        eviction attorney for the filing and up to two appearances and {usd(pricing.eviction.rlpmProcessFee)} to
        us to run the process, plus the county filing fee, all set out on the
        {' '}<a href="/services/evictions/" class="text-crimson font-semibold no-underline hover:underline">evictions page</a>.
        {' '}The {usd(pricing.eviction.countyFilingFee)} figure published there is the Franklin County eviction
        complaint fee; a Fairfield County filing is billed at that court's own rate.
      </p>
    </div>
  </section>

  <!-- IN OR OUT OF THE CITY -->
  <section class="band band-wash" aria-labelledby="limits-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The second trap</span>
      <h2 id="limits-h" class="text-[clamp(26px,3.2vw,38px)]">Is a Pickerington address actually in the City of Pickerington?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Frequently not. A large number of addresses carrying a Pickerington mailing address sit in unincorporated
        Violet Township, Fairfield County, outside the corporation limit. The county answers do not change,
        because Violet Township is Fairfield County too, so the court and the auditor stay put. What changes is
        everything the city controls: utility service, zoning, code enforcement and permits. An owner who calls
        Pickerington City Hall about a property that is not in Pickerington gets a polite answer and no help.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Settle it by parcel, not by postmark. Look the property up on the county auditor's parcel record, which
        shows the taxing district, and confirm the utility account before assuming who bills the water. We do
        this at onboarding, because getting it wrong once means a resident with no water on move-in day.
      </p>
    </div>
  </section>

  <!-- REGISTRATION -->
  <section class="band-tight" aria-labelledby="reg-h">
    <div class="wrap max-w-[880px]">
      <h2 id="reg-h" class="text-[clamp(26px,3.2vw,38px)]">Do you have to register a Pickerington rental property?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Yes, with the county auditor, and for most of Pickerington that is the Fairfield County Auditor rather
        than the Franklin County Auditor. Ohio Revised Code 5323.02 requires every owner of residential rental
        property to file their name, address and telephone number, plus the property street address and permanent
        parcel number, and to update within 60 days of any change. There is no filing fee. Owners holding title
        through an LLC or a trust must name the responsible member, officer or trustee.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Here is the part that catches Fairfield County owners. The statute applies in every Ohio county, but the
        duty it puts on an auditor to notify owners attaches to counties over 200,000 in population, and
        Fairfield County recorded 158,921 residents in the 2020 decennial census. A Fairfield County owner is
        therefore less likely to be reminded, while the obligation and the R.C. 5323.99 assessment of $50 to $150
        are unchanged. A manager may file as the owner designated agent, and we do that at onboarding, as set out
        on the
        {' '}<a href="/services/compliance/" class="text-crimson font-semibold no-underline hover:underline">compliance page</a>.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Where a city runs its own registration, licence or inspection programme, it stacks on top of the county auditor filing rather than replacing it. Columbus added a citywide registry in April 2026 under City Code Chapter 4515. Keeping track of which programme applies to your address, and filing on time, is work we absorb rather than work we hand you.
      </p>
    </div>
  </section>

  <!-- UTILITIES -->
  <section class="band band-wash" aria-labelledby="util-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Utilities</span>
      <h2 id="util-h" class="text-[clamp(26px,3.2vw,38px)]">Who provides utilities in Pickerington, and who pays them?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        The City of Pickerington runs its own water and sewer utility, which is a real difference from most of
        the metro we work in, where the water is Columbus under a contract community agreement. Pickerington does
        not appear on the Columbus water and sewer contract community list, so no Columbus billing arrangement or
        water ordinance reaches a Pickerington city address.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Utility providers for Pickerington, Ohio rental property</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Service</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Provider</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Who customarily pays</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Water and sewer, inside the city</th>
              <td class="p-3.5 border border-line text-navy font-semibold">City of Pickerington Utilities Department, 100 Lockville Rd</td>
              <td class="p-3.5 border border-line text-muted">Resident, in their own name, on our standard lease</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Electricity</th>
              <td class="p-3.5 border border-line text-navy font-semibold">AEP Ohio</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Natural gas</th>
              <td class="p-3.5 border border-line text-navy font-semibold">Columbia Gas of Ohio</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-[16px] text-muted mt-6">
        The billing cycle matters because it decides how fast an arrears becomes your problem. Pickerington
        bills monthly for the previous month's use, sends bills on the first and makes them due on the fifteenth.
        Rent is due on {rentPolicy.dueDate} with late fees after {rentPolicy.lateFeesAfter}. A resident sliding on
        one is usually sliding on the other, and the utility balance is the earlier signal.
      </p>
      <p class="text-[16px] text-muted mt-5">
        [SOURCE NEEDED: confirm who supplies water and sewer to unincorporated Violet Township addresses that
        carry a Pickerington mailing address but sit outside the city limits.]
      </p>
    </div>
  </section>

  <!-- HOUSING STOCK AND PRICING -->
  <section class="band-tight" aria-labelledby="stock-h">
    <div class="wrap max-w-[880px]">
      <h2 id="stock-h" class="text-[clamp(26px,3.2vw,38px)]">What kind of rental property is there in Pickerington, and what does management cost?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Mostly detached single-family houses in subdivisions built from the 1990s onward: three and four
        bedrooms, attached garages, full basements, on streets off Refugee Road, Hill Road, Diley Road and the
        Route 256 corridor. Old Pickerington Village at the centre is a small older core and the exception.
        Demand runs heavily through the Pickerington Local School District, which means families rather than
        singles, longer tenancies, and a leasing season that peaks before the school year.
        {' '}[SOURCE NEEDED: US Census ACS 2024 5-year median year structure built for Pickerington, Ohio.]
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        We do not publish a Pickerington rent median, because we publish a market and bedroom median only where
        at least five of our own units support it and Pickerington does not clear that bar. Portfolio-wide across
        the metro our median is {usd(rentByBedroom['3'].median)} for a three bedroom and
        {' '}{usd(rentByBedroom['4'].median)} for a four bedroom. Those are metro-wide, not Pickerington. Anyone
        handing you a confident city-level average is reading a public index, not their own book.
      </p>
      <div class="grid gap-5 sm:grid-cols-3 mt-8">
        {pricing.plans.map((p) => (
          <div class="card text-center">
            <div class="font-sans text-[12px] font-bold tracking-[.13em] uppercase text-faint mb-2">{p.name}</div>
            <div class="font-sans text-[42px] font-extrabold tracking-[-.045em] text-navy leading-none">{usd(p.monthly)}</div>
            <div class="font-sans text-[13px] text-faint mt-2">per unit, per month</div>
            <p class="text-[14.5px] text-muted mt-4 mb-0">{usd(p.repairApprovalLimit)} per-item repair approval limit</p>
          </div>
        ))}
      </div>
      <p class="text-[16.5px] text-muted mt-7">
        The three plans differ in one variable: how large a repair we can approve before we call you. The leasing
        fee is {usd(pricing.leasingFee)} and a renewal is {usd(pricing.leaseRenewalFee)}. Being in Fairfield
        County changes nothing about the price. It changes where we file, which auditor we register you with and
        which court calendar we work around, and those are ours to carry rather than yours to learn.
      </p>
      <p class="text-[14px] text-faint mt-4">
        Photography is not included in the {usd(pricing.leasingFee)} leasing fee and is billed separately at $250
        to $450.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/pricing/" class="btn btn-navy">See every fee we charge</a>
        <a href="/free-rent-evaluation/" class="btn btn-ghost">Price my Pickerington rental</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band band-wash" aria-labelledby="faq-section">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <h2 id="faq-section" class="sr-only">Pickerington property management questions</h2>
      <Faq items={faq} heading="Pickerington property management questions" id="pickerington-faq" />
      <p class="mt-7 text-[15.5px] text-muted">
        Owner funds go out on the {rentPolicy.ownerDisbursementDay}th and take about
        {' '}{rentPolicy.disbursementNote}. Another forty answers sit on the
        {' '}<a href="/owner-faqs/" class="text-crimson font-semibold no-underline hover:underline">owner FAQs page</a>.
      </p>
      <div class="mt-6"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/property-management-canal-winchester/', label: 'Canal Winchester property management', note: 'West and also on a county line, with the same parcel-level question.' },
    { href: '/property-management-reynoldsburg-ohio/', label: 'Reynoldsburg property management', note: 'North, and a Franklin County filing.' },
    { href: '/property-management-columbus-ohio/', label: 'Columbus property management', note: 'The anchor market, and a different county entirely.' },
    { href: '/property-management-grove-city-ohio/', label: 'Grove City property management', note: 'Across the metro to the southwest, Franklin County throughout.' },
    { href: '/pricing/', label: 'Pricing and the full fee schedule', note: 'Every charge that can appear on an owner statement.' },
  ]} heading="Nearby markets and what to read next" />

  <Cta
    heading="Find out what your Pickerington rental should earn"
    body="Tell us the address and we will price it against comparable listings, confirm which county the parcel is in, and tell you what filing that implies. No charge, and no obligation to hire us."
    primary={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondary={{ label: 'Talk to us about a portfolio', href: '/property-management-consultation/' }}
  />
</Base>
