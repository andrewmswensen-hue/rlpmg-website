---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, pricing, rentPolicy, kpis, usd } from '../../data/facts';
import { serviceNode } from '../../lib/schema';

/**
 * Upper Arlington, Ohio. Target query: "property management upper arlington ohio".
 *
 * The differentiating fact for Upper Arlington is age. The median home here was
 * built in 1959, the oldest stock of any suburb we write a page for, which means
 * the typical Upper Arlington rental is pre-1978 target housing and carries
 * federal lead-based paint disclosure obligations at every lease, plus a
 * contractor rule that governs who may disturb painted surfaces during a turn.
 * That is a real cost line and a real legal exposure, and no competitor page
 * for this city mentions either.
 *
 * NO PORTFOLIO RENT MEDIAN IS PUBLISHED HERE. Upper Arlington has no qualifying
 * entry in rentByMarketAndBedroom (no bedroom count reaches the 5-unit minimum),
 * so markets.ts is deliberately not imported. The page uses the ACS 2024 5-year
 * median gross rent of $1,588, labeled as Census, and says plainly why we have
 * no number of our own to show.
 *
 * SOURCES (verified 2026-09-09):
 *  - Median year structure built 1959: US Census, ACS 2024 5-year estimates.
 *  - Median gross rent $1,588: US Census, ACS 2024 5-year estimates.
 *  - Lead Disclosure Rule, Section 1018 of Title X (Residential Lead-Based Paint
 *    Hazard Reduction Act of 1992), implemented at 24 CFR Part 35 subpart A and
 *    40 CFR Part 745 subpart F. Target housing means most housing built before
 *    1978. Requires the EPA-approved pamphlet, disclosure of known lead-based
 *    paint and hazards, delivery of available records and reports, and a signed
 *    Lead Warning Statement attached to the lease. It does not require testing
 *    or abatement.
 *  - Renovation, Repair and Painting Rule, 40 CFR Part 745 subpart E: pre-1978
 *    housing, work disturbing more than 6 square feet of painted surface in an
 *    interior room, more than 20 square feet on the exterior, or any window
 *    replacement or demolition, must be done by an EPA-certified firm using
 *    certified renovators and lead-safe work practices:
 *    epa.gov/lead/lead-renovation-repair-and-painting-program.
 *  - Ohio's RRP program is administered by US EPA rather than by the state.
 *    The Ohio Department of Health approves lead safe renovator training courses
 *    and licenses lead professionals under Ohio Revised Code Chapter 3742:
 *    ohhn.org/renovation/ and odh.ohio.gov.
 *  - Water and sewer supplied by the City of Columbus Division of Water, with
 *    Upper Arlington maintaining local sanitary sewer and stormwater lines;
 *    refuse collected by Local Waste Services under city contract; an opt-out
 *    Electric Aggregation Program has run since January 2024:
 *    upperarlingtonoh.gov/430/Utilities-Billing. Upper Arlington appears on the
 *    Columbus Water & Sewer Contract Communities list: columbus.gov.
 *  - Court jurisdiction follows the county under R.C. 1901.02. Upper Arlington
 *    is entirely in Franklin County, so Franklin County Municipal Court,
 *    eviction division, 375 S. High St., 3rd floor, Columbus, OH 43215.
 *  - Owner filing with the county auditor: R.C. 5323.02, penalty R.C. 5323.99.
 *
 * No door counts, no per-market days on market.
 */

const PATH = '/property-management-upper-arlington-ohio/';
const MEDIAN_YEAR_BUILT = 1959;
const CENSUS_MEDIAN_GROSS_RENT = 1588;

const title = 'Upper Arlington Property Management | RL Property Management';
const description =
  `Flat-fee property management for Upper Arlington, Ohio rentals from ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} ` +
  `per unit per month with a ${usd(pricing.leasingFee)} leasing fee. The median home here was built in ${MEDIAN_YEAR_BUILT}, so pre-1978 lead rules apply.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/areas-we-serve/' },
  { name: 'Upper Arlington', path: PATH },
];

const keyFacts = [
  `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, not a percentage of rent`,
  `${usd(pricing.leasingFee)} leasing fee every time an Upper Arlington unit turns`,
  `Median home built in ${MEDIAN_YEAR_BUILT} (US Census, ACS 2024 5-year estimates), the oldest stock we work`,
  'Most Upper Arlington rentals are pre-1978, so federal lead paint disclosure applies at every lease',
  `Median gross rent ${usd(CENSUS_MEDIAN_GROSS_RENT)} (US Census, ACS 2024 5-year estimates), not our figure`,
  'Entirely in Franklin County, so evictions are heard at 375 S. High St., Columbus',
];

const faq = [
  { q: 'Does my Upper Arlington rental need a lead-based paint disclosure?',
    a: `Almost certainly. With a median year built of ${MEDIAN_YEAR_BUILT}, most Upper Arlington rentals are pre-1978 target housing, so Section 1018 of Title X requires the EPA pamphlet, disclosure of known lead-based paint and hazards, any records you have, and a signed Lead Warning Statement in the lease.` },
  { q: 'Does that mean I have to test for lead paint or remove it?',
    a: 'No. The federal rule requires you to disclose what you know and hand over what you have, not to test or abate. The risk is paperwork: a knowing failure to disclose can bring damages beyond the actual harm, and the defense is a signed disclosure, which we keep on every pre-1978 unit we manage.' },
  { q: 'How does pre-1978 housing change what a turn costs in Upper Arlington?',
    a: 'It limits who can do the work. Under the EPA Renovation, Repair and Painting rule (40 CFR Part 745 subpart E), disturbing more than 6 square feet of paint inside a room or 20 outside, replacing a window, or demolition in pre-1978 housing requires an EPA-certified firm and lead-safe practices, which add containment, HEPA cleaning, time and cost.' },
  { q: 'Which court hears an eviction in Upper Arlington, Ohio?',
    a: 'Franklin County Municipal Court, 375 S. High St., 3rd floor, Columbus, OH 43215, for every Upper Arlington address, since the city is entirely in Franklin County (R.C. 1901.02). A three-day notice under R.C. 1923.04, in the statutory wording, comes first.' },
  { q: 'What does a rental in Upper Arlington rent for, and why is that not your number?',
    a: `Median gross rent in Upper Arlington is ${usd(CENSUS_MEDIAN_GROSS_RENT)} (US Census ACS 2024 5-year), covering all rented housing, so a three or four bedroom house typically rents well above it. We publish our own median only with five or more units at a bedroom count, and no Upper Arlington count reaches five.` },
  { q: 'Who provides utilities in Upper Arlington?',
    a: 'Columbus Division of Water for water and sewer (the city maintains local sewer and stormwater lines), Local Waste Services for refuse under city contract, AEP Ohio for electricity, and Columbia Gas of Ohio. The city opt-out Electric Aggregation Program, running since January 2024, may set a supplier the resident does not expect.' },
  { q: 'Do I have to register my Upper Arlington rental property with anyone?',
    a: 'Yes, with the Franklin County Auditor, not the city. R.C. 5323.02 requires owner name, address, phone and parcel number, updated within 60 days of any change, at no fee; not filing draws a special assessment under R.C. 5323.99 that the Auditor states as $150 per tax year. We file as your designated agent.' },
];

const schemaNodes = [
  {
    ...serviceNode({
      path: PATH,
      name: 'Residential property management in Upper Arlington, Ohio',
      description,
    }),
    areaServed: {
      '@type': 'City',
      name: 'Upper Arlington, Ohio',
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Franklin County, Ohio' },
    },
  },
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="Where we work"
    title="Property management in Upper Arlington, Ohio"
    answer={`${company.name} manages single-family and small multifamily rentals in Upper Arlington for a flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, with a ${usd(pricing.leasingFee)} leasing fee. The median home here was built in ${MEDIAN_YEAR_BUILT}.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondaryCta={{ label: 'See the full fee schedule', href: '/pricing/' }}
  />

  <KeyFacts items={keyFacts} heading="Upper Arlington, at a glance" />

  <!-- PRE-1978 HOUSING. The single most useful thing on this page. -->
  <section class="band-tight" aria-labelledby="lead-h">
    <div class="wrap max-w-[880px]">
      <h2 id="lead-h" class="text-[clamp(26px,3.2vw,38px)]">What changes when you rent out a house built before 1978?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Two federal rules attach. With a median year built of {MEDIAN_YEAR_BUILT} (US Census ACS 2024 5-year),
        older than Worthington and twenty-plus years older than Westerville, the typical rental here is pre-1978
        target housing.
      </p>
      <h3 class="text-[21px] mt-8 mb-3">Rule one: disclosure, at every lease</h3>
      <p class="text-[16.5px] text-muted">
        Section 1018 of Title X (24 CFR Part 35 subpart A, 40 CFR Part 745 subpart F) requires four things before
        a resident signs:
      </p>
      <ol class="text-[16.5px] text-muted mt-3 list-decimal pl-6 grid gap-1.5">
        <li>Give them the EPA-approved lead hazard information pamphlet.</li>
        <li>Disclose any known lead-based paint and lead-based paint hazards.</li>
        <li>Hand over any lead records or reports you have.</li>
        <li>Attach a Lead Warning Statement to the lease, signed by the resident.</li>
      </ol>
      <p class="text-[16.5px] text-muted mt-5">
        You do not have to test or remove anything. But a knowing failure to disclose can bring damages well
        beyond the actual harm, and an owner with nothing to hide can still lose without a signed form. We attach
        the disclosure to every pre-1978 lease and keep the signed copy.
      </p>
      <h3 class="text-[21px] mt-8 mb-3">Rule two: who is allowed to touch the paint</h3>
      <p class="text-[16.5px] text-muted">
        The EPA Renovation, Repair and Painting rule (40 CFR Part 745 subpart E) requires an EPA-certified firm,
        certified renovators and lead-safe practices for the work below. In Ohio the US EPA runs the program; the
        Ohio Department of Health approves renovator training and licenses lead abatement professionals under
        R.C. Chapter 3742.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">When the EPA Renovation, Repair and Painting rule applies to a pre-1978 Upper Arlington rental</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Turn work</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Inside the rule on a pre-1978 house?</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium align-top">Replacing a window</th>
              <td class="p-3.5 border border-line align-top text-navy font-semibold">Yes, regardless of size</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium align-top">Repainting a bedroom after scraping and sanding</th>
              <td class="p-3.5 border border-line align-top text-navy font-semibold">Yes, once more than 6 square feet of painted surface is disturbed</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium align-top">Exterior siding or trim repair</th>
              <td class="p-3.5 border border-line align-top text-navy font-semibold">Yes, once more than 20 square feet is disturbed</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium align-top">Taking out a wall</th>
              <td class="p-3.5 border border-line align-top text-navy font-semibold">Yes, demolition is covered at any size</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium align-top">Patching a small nail hole and touching up</th>
              <td class="p-3.5 border border-line align-top text-muted">Below the threshold, as minor repair and maintenance</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-[16px] text-muted mt-6">
        Containment, HEPA equipment and cleaning verification add labor and days, so the same job costs more
        than on a 1995 house. We plan the turn around it rather than finding out on day four.
      </p>
    </div>
  </section>

  <!-- OLDER SYSTEMS -->
  <section class="band band-wash" aria-labelledby="systems-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The building</span>
      <h2 id="systems-h" class="text-[clamp(26px,3.2vw,38px)]">What breaks on a {MEDIAN_YEAR_BUILT} house, and what should a reserve look like?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        The systems, not the shell, which was generally built well. What ages out:
      </p>
      <ul class="text-[17px] text-muted mt-3 list-disc pl-6 grid gap-1.5">
        <li>Galvanized supply lines that close up from the inside, and cast iron drain stacks</li>
        <li>Clay sewer laterals with tree roots in them</li>
        <li>Electrical panels sized before dishwashers</li>
        <li>Plaster that cracks rather than dents</li>
        <li>Single-pane windows, a heating complaint and a lead-rule trigger when replaced</li>
        <li>Asbestos-bearing floor tile, mastic and pipe insulation, common in mid-century houses, so identify materials before a contractor disturbs them</li>
      </ul>
      <p class="text-[17.5px] text-muted mt-5">
        Reserves run {usd(pricing.reserves.min)} to {usd(pricing.reserves.max)} per unit by plan; here, aim for
        the top. In-house maintenance is {usd(pricing.maintenance.inHouseHourly)} per hour
        with a {usd(pricing.maintenance.tripCharge)} trip charge and no minimum, materials at cost. Vendor
        projects carry a {pricing.maintenance.vendorProjectFeePct}% project management fee up to
        {' '}{usd(pricing.maintenance.vendorProjectFeeAppliesUpTo)}, capped at
        {' '}{usd(pricing.maintenance.vendorProjectFeeCap)}. After hours it is
        {' '}{pricing.afterHours.weekdayEveningAndSaturday} times the rate on weekday evenings and Saturdays and
        {' '}{pricing.afterHours.sunday} times on Sundays, the real price of an unserviced sixty-year-old boiler.
      </p>
    </div>
  </section>

  <!-- COURT AND COMPLIANCE -->
  <section class="band-tight" aria-labelledby="court-h">
    <div class="wrap max-w-[880px]">
      <h2 id="court-h" class="text-[clamp(26px,3.2vw,38px)]">Which court hears an eviction in Upper Arlington, and what has to be registered?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Franklin County Municipal Court, 375 S. High St., 3rd floor, Columbus, OH 43215, for every address.
        Upper Arlington is entirely in Franklin County (R.C. 1901.02), so unlike Dublin or Westerville there is
        no county question. The Ohio Revised Code 1923.04 three-day notice must use the statutory wording, or the case is
        dismissed.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        A typical case totals {usd(pricing.eviction.typicalTotal)} before any setout: a
        {' '}{usd(pricing.eviction.hardCostTotal)} hard cost ({usd(pricing.eviction.countyFilingFee)} county,
        {' '}{usd(pricing.eviction.attorneyFee)} attorney for filing and up to two appearances) plus our
        {' '}{usd(pricing.eviction.rlpmProcessFee)}. See the
        {' '}<a href="/services/evictions/" class="text-crimson font-semibold no-underline hover:underline">evictions page</a>.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Registration goes to the Franklin County Auditor under R.C. 5323.02: your name, address and phone plus the
        street address and permanent parcel number, within 60 days of the county’s notice and of any change, at no fee. An LLC
        or trust names its responsible officer, member or trustee. The penalty under R.C. 5323.99 is stated by
        the Auditor as $150 per tax year. We file it for you, and track any city program on top, such as the
        Columbus registry added in April 2026 under City Code Chapter 4515.
      </p>
    </div>
  </section>

  <!-- UTILITIES -->
  <section class="band band-wash" aria-labelledby="util-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Utilities</span>
      <h2 id="util-h" class="text-[clamp(26px,3.2vw,38px)]">Who provides utilities in Upper Arlington, and who pays them?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Columbus Division of Water supplies water and sewer; Upper Arlington maintains the local sewer and
        stormwater lines. Residents hold accounts in their own name.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Utility providers for Upper Arlington, Ohio rental property</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Service</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Provider</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Who customarily pays</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Water and sewer</th>
              <td class="p-3.5 border border-line text-navy font-semibold">City of Columbus Division of Water</td>
              <td class="p-3.5 border border-line text-muted">Resident, in their own name, on our standard lease</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Refuse and recycling</th>
              <td class="p-3.5 border border-line text-navy font-semibold">Local Waste Services, under City of Upper Arlington contract</td>
              <td class="p-3.5 border border-line text-muted">Per the city arrangement, not a separate resident account</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Electricity</th>
              <td class="p-3.5 border border-line text-navy font-semibold">AEP Ohio, with a city opt-out aggregation program since January 2024</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Natural gas</th>
              <td class="p-3.5 border border-line text-navy font-semibold">Columbia Gas of Ohio</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-[16px] text-muted mt-6">
        Two catches: the opt-out aggregation program can put a supplier on the resident's bill they did not
        choose, and unpaid water and sewer in Ohio can attach to the parcel, so we check the water account at
        every move-out before the deposit is settled.
      </p>
    </div>
  </section>

  <!-- RENT AND PRICING -->
  <section class="band-tight" aria-labelledby="rent-h">
    <div class="wrap max-w-[880px]">
      <h2 id="rent-h" class="text-[clamp(26px,3.2vw,38px)]">What does an Upper Arlington rental earn, and what does management cost?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Median gross rent is {usd(CENSUS_MEDIAN_GROSS_RENT)} (US Census ACS 2024 5-year). That is the Census
        figure, not ours, and it includes apartments and small older units, so a three or four bedroom house
        typically rents well above it. We publish our own median only with five or more units at a bedroom
        count, and no Upper Arlington count reaches five.
      </p>
      <div class="grid gap-5 sm:grid-cols-3 mt-8">
        {pricing.plans.map((p) => (
          <div class="card text-center">
            <div class="font-sans text-[12px] font-bold tracking-[.13em] uppercase text-faint mb-2">{p.name}</div>
            <div class="font-sans text-[42px] font-extrabold tracking-[-.045em] text-navy leading-none">{usd(p.monthly)}</div>
            <div class="font-sans text-[13px] text-faint mt-2">per unit, per month</div>
            <p class="text-[14.5px] text-muted mt-4 mb-0">{usd(p.repairApprovalLimit)} per-item repair approval limit</p>
          </div>
        ))}
      </div>
      <p class="text-[16.5px] text-muted mt-7">
        On the {usd(CENSUS_MEDIAN_GROSS_RENT)} Census median, a 10% manager takes about
        {' '}{usd(Math.round(CENSUS_MEDIAN_GROSS_RENT * 0.1) * 12)} a year plus
        {' '}{usd(Math.round(CENSUS_MEDIAN_GROSS_RENT / 2))} at each turn. Our middle plan is
        {' '}{usd(pricing.plans[1].monthly * 12)} a year, placement {usd(pricing.leasingFee)}. Most houses here
        rent above that median, so the gap is wider still.
      </p>
      <p class="text-[14px] text-faint mt-4">
        Percentage figures describe common Columbus market rates, not a quote from any named company.
        Photography is billed separately at $250 to $450.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/pricing/" class="btn btn-navy">See every fee we charge</a>
        <a href="/free-rent-evaluation/" class="btn btn-ghost">Price my Upper Arlington rental</a>
      </div>
    </div>
  </section>

  <!-- WHERE WE WORK -->
  <section class="band band-wash" aria-labelledby="where-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The market</span>
      <h2 id="where-h" class="text-[clamp(26px,3.2vw,38px)]">Where in Upper Arlington do we work?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Across the city: the pre-war streets near Tremont and Northwest Boulevard, the post-war and mid-century
        sections north toward Henderson Road and Reed Road, the Lane Avenue and Kenny Road corridors, Arlington
        Ridge, Golfview, Barrington, the streets around Northam Park and the older blocks near the Scioto. All
        feed the Upper Arlington City School District.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Ohio State and the medical campuses bring faculty, resident physicians and relocating professionals:
        fewer, stronger applications and longer tenancies, which makes a vacancy expensive. Our portfolio-wide
        lease renewal rate is {kpis.metrics.find((m) => m.id === 'renewal')?.value}, and here renewal is where
        the money is.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band-tight" aria-labelledby="faq-section">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <h2 id="faq-section" class="sr-only">Upper Arlington property management questions</h2>
      <Faq items={faq} heading="Upper Arlington property management questions" id="upper-arlington-faq" />
      <p class="mt-7 text-[15.5px] text-muted">
        Rent is due {rentPolicy.dueDate} and late after {rentPolicy.lateFeesAfter}. Owner funds go out on the
        {' '}{rentPolicy.ownerDisbursementDay}th. More answers on the
        {' '}<a href="/owner-faqs/" class="text-crimson font-semibold no-underline hover:underline">owner FAQs page</a>.
      </p>
      <p class="mt-4 text-[14px] text-faint">
        Nothing on this page is legal advice. Lead-based paint obligations are federal and they attach to the
        property, so confirm your own position with counsel before you rely on a summary.
      </p>
      <div class="mt-6"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/property-management-worthington-ohio/', label: 'Worthington property management', note: 'North, older stock and a design review district.' },
    { href: '/property-management-dublin-ohio/', label: 'Dublin property management', note: 'Northwest, larger lots and a three-county eviction problem.' },
    { href: '/property-management-westerville-ohio/', label: 'Westerville property management', note: 'Northeast, newer stock and a municipal electric utility.' },
    { href: '/property-management-columbus-ohio/', label: 'Columbus property management', note: 'The anchor page, with every neighborhood we work.' },
    { href: '/pricing/', label: 'Pricing and the full fee schedule', note: 'Every charge that can appear on an owner statement.' },
  ]} heading="Nearby markets and what to read next" />

  <Cta
    heading="Find out what your Upper Arlington rental should earn"
    body="Send the address. We will price it against live listings and tell you what the pre-1978 rules mean for your turn. Free."
    primary={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondary={{ label: 'Get a portfolio quote', href: '/property-management-consultation/' }}
  />
</Base>
