---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, pricing, kpis, rentPolicy, areas, usd } from '../../data/facts';
import { serviceNode } from '../../lib/schema';

/**
 * Written to the portfolio owner, not to the accidental landlord.
 *
 * Target queries: "property management for rental portfolio", "out of state
 * investor property management columbus", "property management multiple properties".
 *
 * PRICING RULE: portfolio discounts are real and significant, and the numbers are
 * never published (pricing.portfolioDiscount in facts.ts). Every path here routes
 * to a consultation for a written quote.
 */

const title = 'Property Management for Rental Portfolios in Columbus';
const description =
  `${company.name} manages ${company.unitsManaged} single-family and small multifamily units for Columbus investors. ` +
  `Flat per-unit pricing, a ${usd(pricing.leasingFee)} leasing fee, substantial discounts for larger portfolios, and a published scorecard.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Owners', path: '/columbus-property-management/' },
  { name: 'Investors', path: '/investors/' },
];

const std = pricing.plans[1];
const avgRent = 1653;    // kpis avgRent as a number, for the cost-per-door arithmetic
const doors = [10, 25, 50];
const perDoor = doors.map((d) => {
  const flat = std.monthly * 12 * d;
  const pct8 = Math.round(avgRent * 0.08) * 12 * d;
  const pct10 = Math.round(avgRent * 0.10) * 12 * d;
  const leasing = Math.round(avgRent / 2) * Math.round(d * 0.28);   // turns at the portfolio renewal rate
  return { d, flat, pct8: pct8 + leasing, pct10: pct10 + leasing, leasing };
});

const keyFacts = [
  `Flat per-unit pricing, published: ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month`,
  'Substantial portfolio discounts, quoted per owner and not published',
  `${usd(pricing.leasingFee)} leasing fee, so cost per door does not spike on a turn`,
  `${company.unitsManaged} units under management, in-house maintenance since ${company.founded}`,
  `Published scorecard: ${kpis.metrics[0].value} days on market, ${kpis.metrics[6].value} collected by the 5th, ${kpis.metrics[2].value} renewal rate`,
  `Owner funds disbursed on the ${rentPolicy.ownerDisbursementDay}th, with every invoice in the portal`,
];

const pillars = [
  { h: 'Cost per door that does not move',
    p: `A flat fee is the same number in a year when rent rises and in a year when it does not. A percentage fee compounds with every increase, and a leasing fee spikes it every time a unit turns. Ours is ${usd(pricing.leasingFee)}.` },
  { h: 'One fee schedule, entirely public',
    p: 'Every charge that can appear on an owner statement is published, including the situational ones. You can model the operating expense line before you speak to anyone here.' },
  { h: 'Operating numbers you can audit',
    p: `Days on market, turn time, renewal rate, occupancy, collection rate and repair close time are all published with their definitions, and refreshed. Not a testimonial, a number.` },
  { h: 'In-house maintenance',
    p: `Technicians on payroll at ${usd(pricing.maintenance.inHouseHourly)} per hour plus a ${usd(pricing.maintenance.tripCharge)} trip charge, with no minimum charge and materials at cost. Vendor work carries a ${pricing.maintenance.vendorProjectFeePct}% project fee capped at ${usd(pricing.maintenance.vendorProjectFeeCap)}.` },
  { h: 'Renewals are the strategy',
    p: `Because placing a resident earns us nothing, keeping a good one is the only thing that pays. The portfolio renewal rate is ${kpis.metrics[2].value}, and a renewal costs an owner ${usd(pricing.leaseRenewalFee)} against a full turn.` },
  { h: 'Consolidation without a gap',
    p: 'Moving several properties off one or more managers is a scheduling problem, not a paperwork problem. We plan it against your lease dates and termination clauses before anyone gives notice.' },
];

const outOfState = [
  'A real-time owner portal with every statement and the invoice behind each charge',
  `Direct deposit on the ${rentPolicy.ownerDisbursementDay}th, ${rentPolicy.disbursementNote}`,
  'Quarterly inspections with photographs, so you see condition without flying in',
  'Repair approval limits you set by plan, so routine work does not wait on your time zone',
  'A custom lease reviewed by legal counsel and kept current with Ohio landlord-tenant law',
  'Eviction handled locally through the Franklin County Municipal Court when it is needed',
];

const faq = [
  { q: 'Do you manage rental portfolios in Columbus?',
    a: `Yes. ${company.name} manages ${company.unitsManaged} ${company.propertyTypes} across the Columbus metro, and portfolio owners are the core of the client base. Any property that does not require on-site staff is in scope.` },
  { q: 'Do you discount management for a larger portfolio?',
    a: 'Yes, and the discount is significant. Monthly management drops as unit count rises. It is quoted per owner rather than published, because it depends on unit count, property type and how concentrated the portfolio is geographically. Ask for a portfolio quote and you get a number in writing.' },
  { q: 'Why is portfolio pricing not published?',
    a: 'Because a single published number would be wrong for almost every portfolio. Twenty units in one suburb and twenty units scattered across five counties cost very different amounts to run. The per-unit rates on the pricing page are published in full, and the portfolio rate starts from there and goes down.' },
  { q: 'What is my real cost per door?',
    a: `On the middle plan the management line is ${usd(std.monthly)} per door per month before any portfolio discount, plus ${usd(pricing.leaseRenewalFee)} when a lease renews. Placing a resident is ${usd(pricing.leasingFee)}. A manager charging 10% of an average ${kpis.metrics[4].value} rent runs about ${usd(Math.round(avgRent * 0.10))} per door per month, plus roughly ${usd(Math.round(avgRent / 2))} each time a unit turns.` },
  { q: 'Can you manage for an out-of-state investor?',
    a: 'Yes. Out-of-state owners get the same portal, the same monthly statements with invoices attached, quarterly inspections with photographs, and direct deposit. The repair approval limit on your plan is what decides how often a decision needs your time zone.' },
  { q: 'Can you take on a portfolio that is currently with another manager?',
    a: 'Yes, and that is a common move. The work is in the timing: termination clauses, lease dates, deposit transfers and where the resident sends rent on the first of the month. We build that plan before notice is given, not after.' },
  { q: 'Will you advise on a property I am about to buy?',
    a: `We do not perform buyer inspections. We can advise during due diligence on medium and large multifamily, and we offer a pre-signature inspection on property you already own at ${usd(pricing.prePurchaseInspection.fee)}, ${pricing.prePurchaseInspection.note}.` },
  { q: 'What reporting do portfolio owners get?',
    a: 'Monthly statements per property and consolidated across the portfolio, year-end reporting for your accountant, and a live portal showing rent received, every expense and the invoice behind it.' },
  { q: 'What are the operating numbers?',
    a: `As of ${kpis.asOfLabel}: ${kpis.metrics[0].value} median days on market, ${kpis.metrics[1].value} median days to turn a unit, ${kpis.metrics[2].value} lease renewal rate, ${kpis.metrics[3].value} portfolio occupancy, ${kpis.metrics[6].value} of rent collected by the 5th and ${kpis.metrics[5].value} median days to close a repair.` },
];

const schemaNodes = [
  serviceNode({
    path: '/investors/',
    name: 'Portfolio property management for real estate investors',
    description,
  }),
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="For portfolio owners"
    title="Property management for rental portfolios in Columbus"
    answer={`${company.name} manages ${company.unitsManaged} single-family and small multifamily units for Columbus investors. Pricing is flat per door, the leasing fee is ${usd(pricing.leasingFee)}, and larger portfolios get a substantial discount quoted in writing.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Get a portfolio quote', href: '/property-management-consultation/' }}
    secondaryCta={{ label: 'See the published fee schedule', href: '/pricing/' }}
    wide
  />

  <KeyFacts items={keyFacts} />

  <!-- THE PITCH IN ARITHMETIC -->
  <section class="band-tight" aria-labelledby="cost-h">
    <div class="wrap max-w-[880px]">
      <h2 id="cost-h" class="text-[clamp(26px,3.2vw,38px)]">What does a Columbus portfolio actually cost to manage?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        On published per-unit pricing, the middle plan is {usd(std.monthly)} per door per month, or
        {' '}{usd(std.monthly * 12)} per door per year. A percentage manager on the portfolio average rent of
        {' '}{kpis.metrics[4].value} costs roughly {usd(Math.round(avgRent * 0.08))} to
        {' '}{usd(Math.round(avgRent * 0.10))} per door per month, and then bills about
        {' '}{usd(Math.round(avgRent / 2))} again every time a unit turns. At scale the leasing fee is the line
        that actually decides the year, because a portfolio always has units turning.
      </p>
      <p class="text-[17.5px] text-muted mt-4">
        Below is the annual management line at three portfolio sizes, before any portfolio discount is applied.
        Turns are estimated from our own {kpis.metrics[2].value} renewal rate, so roughly
        {' '}{100 - parseInt(kpis.metrics[2].value)} percent of units turn in a year.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse bg-white rounded-[12px] overflow-hidden text-[15.5px]">
          <caption class="sr-only">
            Estimated annual management cost by portfolio size, on the portfolio average rent, including placement fees
          </caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Doors</th>
              <th scope="col" class="text-right p-3.5 border border-line font-semibold">Us, {std.name}</th>
              <th scope="col" class="text-right p-3.5 border border-line font-semibold">Typical 8% plus placements</th>
              <th scope="col" class="text-right p-3.5 border border-line font-semibold">Typical 10% plus placements</th>
            </tr>
          </thead>
          <tbody>
            {perDoor.map((r) => (
              <tr>
                <th scope="row" class="text-left p-3.5 border border-line font-medium tabular-nums">{r.d} doors</th>
                <td class="text-right p-3.5 border border-line tabular-nums font-bold text-crimson">{usd(r.flat)}</td>
                <td class="text-right p-3.5 border border-line tabular-nums text-muted">{usd(r.pct8)}</td>
                <td class="text-right p-3.5 border border-line tabular-nums text-muted">{usd(r.pct10)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[14px] text-faint mt-5">
        Our column is exact at published per-unit pricing and goes down with a portfolio discount. The comparison
        columns are illustrative, calculated at the portfolio average rent of {kpis.metrics[4].value} with a
        half-month placement fee on each estimated turn. They describe common Columbus market rates and are not a
        quote from any named company.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/property-management-consultation/" class="btn btn-primary">Get your portfolio number</a>
        <a href="/pricing/" class="btn btn-ghost">See every fee</a>
      </div>
    </div>
  </section>

  <!-- DISCOUNT -->
  <section class="band-tight" aria-labelledby="discount-h">
    <div class="wrap max-w-[880px]">
      <div class="card !border-2 !border-navy !p-9 md:!p-11">
        <span class="eyebrow">Portfolio pricing</span>
        <h2 id="discount-h" class="text-[clamp(24px,2.9vw,34px)] mb-4">The discount is significant, and it is not published</h2>
        <p class="text-[17.5px] text-muted mb-5">
          Monthly management drops as unit count rises. How far it drops depends on how many units you own, what
          type they are, and how close together they sit, so a single published number would be wrong for almost
          every portfolio that reads it.
        </p>
        <p class="text-[17.5px] text-muted mb-6">
          What is published is everything the discount starts from: the per-unit rates, the leasing fee, the
          renewal fee, the maintenance rates and every situational charge. You can model the whole operating
          expense line before you call, then find out how much lower the management line goes.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/property-management-consultation/" class="btn btn-navy">Request a written quote</a>
          <a href={`tel:${company.salesPhoneE164}`} class="btn btn-ghost">Call {company.salesPhone}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="band band-wash" aria-labelledby="why-h">
    <div class="wrap">
      <span class="eyebrow">What you are buying</span>
      <h2 id="why-h" class="text-[clamp(26px,3.2vw,38px)]">What should an investor look for in a manager?</h2>
      <p class="text-[17.5px] text-muted mt-4 max-w-[46em]">
        Six things, and all six are checkable before you sign. If a manager cannot show you these, the pitch is
        the product.
      </p>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3 mt-8">
        {pillars.map((p) => (
          <div class="card">
            <h3 class="text-[18.5px] mb-2">{p.h}</h3>
            <p class="text-[15px] text-muted m-0">{p.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SCORECARD -->
  <section class="band-tight" aria-labelledby="kpi-h">
    <div class="wrap max-w-[940px]">
      <span class="eyebrow">Published, with definitions</span>
      <h2 id="kpi-h" class="text-[clamp(26px,3.2vw,38px)]">How is the portfolio performing?</h2>
      <p class="text-[17.5px] text-muted mt-4 max-w-[44em]">
        Every unit under management, as of {kpis.asOfLabel}. Publishing the definition matters as much as
        publishing the number, because days on market can be measured four ways and three of them flatter.
      </p>
      <div class="grid gap-4 grid-cols-2 lg:grid-cols-4 mt-8">
        {kpis.metrics.map((m) => (
          <div class="card text-center !p-5">
            <div class="font-sans text-[30px] font-extrabold tracking-[-.03em] text-navy leading-none">{m.value}</div>
            <div class="font-sans text-[13px] text-muted mt-2">{m.label}</div>
          </div>
        ))}
      </div>
      <p class="text-[14px] text-faint mt-5">
        Days on market is defined as: {kpis.domDefinition}
        {' '}<a href="/key-performance-indicators/" class="text-crimson font-semibold no-underline hover:underline">Full methodology and history</a>.
      </p>
    </div>
  </section>

  <!-- OUT OF STATE -->
  <section class="band band-wash" aria-labelledby="oos-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Remote owners</span>
      <h2 id="oos-h" class="text-[clamp(26px,3.2vw,38px)]">Can you manage for an out-of-state investor?</h2>
      <p class="text-[17.5px] text-muted mt-4 mb-6">
        Yes, and most of what makes remote ownership work is unglamorous: reporting you can read without calling,
        approval limits that let routine work proceed without you, and inspections with photographs so condition is
        something you can see rather than something you are told.
      </p>
      <ul class="grid gap-x-8 gap-y-1 sm:grid-cols-2">
        {outOfState.map((x) => (
          <li class="flex gap-3 py-1.5 text-[15.5px]">
            <span class="text-crimson font-extrabold shrink-0" aria-hidden="true">✓</span><span>{x}</span>
          </li>
        ))}
      </ul>
      <p class="text-[16px] text-muted mt-7">
        The repair approval limit is the setting that matters most to a remote owner:
        {' '}{pricing.plans.map((p) => `${p.name} at ${usd(p.monthly)} carries a ${usd(p.repairApprovalLimit)} per-item limit`).join(', ')}.
        A higher limit means fewer approvals reach you, which is usually what a remote owner wants.
      </p>
    </div>
  </section>

  <!-- SCALE -->
  <section class="band-tight" aria-labelledby="scale-h">
    <div class="wrap max-w-[880px]">
      <h2 id="scale-h" class="text-[clamp(26px,3.2vw,38px)]">Can you carry a portfolio at scale?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        {company.unitsManaged} units under management across {areas.length} communities, managed since
        {' '}{company.founded}, with maintenance technicians on payroll rather than subcontracted for every work
        order.
      </p>
      <p class="text-[17.5px] text-muted mt-4">
        Scale matters to a portfolio owner for one reason: a manager who is at capacity solves their staffing
        problem with your vacancy. Ask any manager you are considering how many doors they run per portfolio
        manager and per technician, and ask what happens to that ratio when they add you.
      </p>
    </div>
  </section>

  <section class="band band-wash">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Investor questions" id="investor-faq" />
      <div class="mt-7"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/property-management-consultation/', label: 'Get a portfolio quote', note: 'Where the discounted number gets put in writing.' },
    { href: '/pricing/', label: 'The full fee schedule', note: 'Model the operating expense line before you call.' },
    { href: '/switching-property-managers/', label: 'Switching property managers', note: 'Consolidating off one or more managers.' },
    { href: '/key-performance-indicators/', label: 'The published scorecard', note: 'The operating numbers, with definitions.' },
    { href: '/2026-columbus-market-report/', label: '2026 Columbus rental market report', note: 'Market data behind the underwriting.' },
  ]} />

  <Cta
    heading="Tell us what you own, get a number in writing"
    body="Portfolio pricing is quoted per owner and the discount is significant. Bring your addresses and your current statements and we will price the whole thing."
    primary={{ label: 'Get a portfolio quote', href: '/property-management-consultation/' }}
    secondary={{ label: 'See published pricing', href: '/pricing/' }}
  />
</Base>
