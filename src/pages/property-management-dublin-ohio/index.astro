---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, pricing, rentPolicy, typicalManager, usd } from '../../data/facts';
import { rentByMarketAndBedroom } from '../../data/markets';
import { serviceNode } from '../../lib/schema';

/**
 * Dublin, Ohio. Target query: "property management dublin ohio".
 *
 * The differentiating fact for Dublin is the three-county problem. Dublin is one
 * city sitting in Franklin, Delaware and Union counties, which means the correct
 * eviction court, and whether the Ohio R.C. 5323 county auditor filing applies,
 * both depend on which parcel you own. No competitor page says this.
 *
 * SOURCES (verified 2026-09-09):
 *  - Counties: en.wikipedia.org/wiki/Dublin,_Ohio and dublinchamber.org fast facts.
 *  - Franklin County Municipal Court jurisdiction: R.C. 1901.02 at
 *    codes.ohio.gov/ohio-revised-code/section-1901.02. Eviction Court address and
 *    courtroom: franklincountymunicourt.org/Courts/Eviction-Court.
 *  - Delaware Municipal Court hears evictions, civil to $15,000:
 *    ohiolegalhelp.org/resource/delaware-municipal-court.
 *  - Marysville Municipal Court, Union County, FED jurisdiction and address:
 *    marysvilleohio.org/724/Civil.
 *  - Water and sewer: Dublin is a City of Columbus water and sewer contract
 *    community. columbus.gov Water & Sewer Contract Communities, and
 *    communityplan.dublinohiousa.gov/utilities/municipal-service-agreements.
 *  - Owner filing with the county auditor: R.C. 5323.02, penalty R.C. 5323.99.
 *  - R.C. 5323.01(E) limits "residential rental property" to counties of more
 *    than 200,000 people at the last decennial census, so the 5323.02 filing
 *    applies on the Franklin and Delaware sides, not in Union (62,784 in 2020).
 *    Verified on codes.ohio.gov 2026-11-05: https://codes.ohio.gov/ohio-revised-code/section-5323.01
 *  - AEP Ohio serves central Ohio (1.5 million customers): en.wikipedia.org/wiki/AEP_Ohio.
 *    Columbia Gas of Ohio, largest Ohio gas provider, serves Columbus and central
 *    Ohio: columbiagasohio.com/about-us.
 *
 * Rent figures are our own portfolio medians, which qualify for Dublin because the
 * sample is 5 or more units at those bedroom counts. Never a market figure dressed
 * up as ours. No door counts, no per-market days on market.
 */

const CITY = 'Dublin';
const PATH = '/property-management-dublin-ohio/';

const title = 'Dublin Property Management | RL Property Management';
const description =
  `Flat-fee property management for Dublin, Ohio rentals from ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} ` +
  `per unit per month with a ${usd(pricing.leasingFee)} leasing fee. Dublin sits in three counties, which changes which court hears an eviction.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/areas-we-serve/' },
  { name: 'Dublin', path: PATH },
];

const rent = rentByMarketAndBedroom[CITY];

const keyFacts = [
  `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, ${usd(pricing.leasingFee)} leasing fee`,
  'Most of Dublin is in Franklin County, with parts in Delaware and Union counties',
  'Franklin County parcels: eviction filed at 375 S. High St., Columbus',
  'Water and sewer come from the City of Columbus under contract',
  `Median rent across the units we manage in Dublin: ${usd(rent['3'].median)} for a 3 bedroom`,
];

const courts = [
  {
    county: 'Franklin County',
    court: 'Franklin County Municipal Court',
    where: '375 S. High St., Columbus, OH 43215. Eviction Court sits in Courtroom 11B.',
    note: 'Most Dublin addresses, including Historic Dublin and everything south of the Delaware County line.',
  },
  {
    county: 'Delaware County',
    court: 'Delaware Municipal Court',
    where: 'Delaware, Ohio. Civil jurisdiction runs to $15,000, and it hears forcible entry and detainer cases.',
    note: 'Northern Dublin, including parts of the Tartan Fields and Bright Road areas.',
  },
  {
    county: 'Union County',
    court: 'Marysville Municipal Court',
    where: '1250 W. 5th St., Marysville, OH 43040. Civil to $15,000, small claims to $6,000.',
    note: 'The western edge, the smallest slice.',
  },
];

const faq = [
  { q: 'What county is Dublin, Ohio in?',
    a: 'Three: mostly Franklin County, with a northern portion in Delaware County and a western portion in Union County. Two houses on the same road can fall under different courts and different county rules.' },
  { q: 'Which court hears an eviction in Dublin, Ohio?',
    a: 'It depends on which county the parcel is in. Franklin County parcels go to Franklin County Municipal Court, 375 S. High St., Columbus (Eviction Court, Courtroom 11B). A Delaware County parcel goes to Delaware Municipal Court. A Union County parcel goes to Marysville Municipal Court at 1250 W. 5th St. Filing in the wrong court costs you the filing fee and the calendar time.' },
  { q: 'Do I have to register my Dublin rental property with anyone?',
    a: 'It depends on the parcel’s county. The state’s county auditor rental registration (R.C. 5323.02) applies only in counties of more than 200,000 people, so it applies on the Franklin and Delaware County sides of Dublin and not on the Union County side. Where it applies it requires owner contact details and the parcel number, updated within 60 days of any change, and failing to file draws a $50 to $150 special assessment under R.C. 5323.99. We check the parcel’s county at onboarding and file it for you as your designated agent where it applies.' },
  { q: 'Does the City of Dublin require a rental license or inspection?',
    a: 'Any city registration or inspection program is separate from the R.C. 5323 county auditor filing, which applies to Franklin and Delaware County parcels. We track which rules apply to each address and handle the filings that do, including the auditor registration during onboarding where it applies. If you self-manage, that tracking falls to you.' },
  { q: 'Who provides water and sewer in Dublin, Ohio?',
    a: 'The City of Dublin supplies water and sanitary sewer largely under contract with the City of Columbus, and Dublin appears on the Columbus water and sewer contract community list. Electricity is AEP Ohio and natural gas is Columbia Gas of Ohio, and in our Dublin leases the resident holds the accounts.' },
  { q: 'What does a rental in Dublin, Ohio rent for?',
    a: `Across the units we manage in Dublin, the median rent is ${usd(rent['3'].median)} for a 3 bedroom and ${usd(rent['4'].median)} for a 4 bedroom. Those are our own portfolio medians, not a market survey, and the top end of what we manage in the metro.` },
  { q: 'What kind of rental property is there in Dublin?',
    a: 'Mostly detached single-family houses built from the 1970s onward, plus newer construction in the Ballantrae, Tartan Fields and Muirfield Village areas and a small nineteenth-century core in Historic Dublin. Large-lot four bedroom homes are the common rental, so rents run high and turn slowly.' },
  { q: 'How much does property management cost in Dublin?',
    a: `A flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month depending on plan, with a ${usd(pricing.leasingFee)} leasing fee and ${usd(pricing.leaseRenewalFee)} on a lease renewal. A Dublin house renting at ${usd(rent['3'].median)} costs the same to manage as one at ${usd(1200)}, where a 10% manager would collect roughly ${usd(Math.round(rent['3'].median * 0.1) * 12)} a year.` },
];

const schemaNodes = [
  {
    ...serviceNode({
      path: PATH,
      name: 'Residential property management in Dublin, Ohio',
      description,
    }),
    areaServed: {
      '@type': 'City',
      name: 'Dublin, Ohio',
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Franklin County, Ohio' },
    },
  },
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="Where we work"
    title="Property management in Dublin, Ohio"
    answer={`${company.name} manages single-family and small multifamily rentals in Dublin for a flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, with a ${usd(pricing.leasingFee)} leasing fee. Dublin spans three counties, so the correct eviction court depends on your parcel.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondaryCta={{ label: 'See the full fee schedule', href: '/pricing/' }}
  />

  <KeyFacts items={keyFacts} heading="Dublin, at a glance" />

  <!-- THE THREE-COUNTY PROBLEM. The single most useful thing on this page. -->
  <section class="band-tight" aria-labelledby="county-h">
    <div class="wrap max-w-[880px]">
      <h2 id="county-h" class="text-[clamp(26px,3.2vw,38px)]">Which county is Dublin in, and which court hears an eviction?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        One city in three counties: mostly Franklin, a northern piece in Delaware, a western piece in Union.
        Your parcel's county decides which municipal court hears a forcible entry and detainer action (an
        eviction) and whether the county auditor rental filing applies.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Eviction court by county for Dublin, Ohio rental property</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">If your parcel is in</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">You file at</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Where, and what it covers</th>
            </tr>
          </thead>
          <tbody>
            {courts.map((c) => (
              <tr>
                <th scope="row" class="text-left p-3.5 border border-line font-medium align-top whitespace-nowrap">{c.county}</th>
                <td class="p-3.5 border border-line align-top font-semibold text-navy">{c.court}</td>
                <td class="p-3.5 border border-line align-top text-muted">{c.where} {c.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[16px] text-muted mt-6">
        First comes a three-day notice under R.C. 1923.04, with specific statutory language, served by certified
        mail, by hand or left at the property. Wrong wording means dismissal and a three-week restart. Our process
        and costs are on the
        {' '}<a href="/services/evictions/" class="text-crimson font-semibold no-underline hover:underline">evictions page</a>.
      </p>
    </div>
  </section>

  <!-- REGISTRATION -->
  <section class="band band-wash" aria-labelledby="reg-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Compliance</span>
      <h2 id="reg-h" class="text-[clamp(26px,3.2vw,38px)]">Do you have to register a Dublin rental property?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        It depends on your parcel's county. The state's county auditor rental registration (R.C. 5323.02)
        applies only in counties of more than 200,000 people, so it applies on the Franklin and Delaware County
        sides of Dublin and not on the Union County side. We check the parcel's county at onboarding and file it
        as your designated agent where it applies, so it is handled for you.
      </p>
      <p class="text-[17.5px] text-muted mt-4">On a Franklin or Delaware County parcel:</p>
      <ul class="text-[17.5px] text-muted mt-2 list-disc pl-5 grid gap-2">
        <li>Ohio Revised Code 5323.02: your name, address and telephone number, plus the property address and parcel number.</li>
        <li>Any change updated within 60 days.</li>
        <li>LLC and trust owners must name the responsible officer, member or trustee, the part most often missed.</li>
        <li>Miss it and the auditor can assess $50 to $150 under R.C. 5323.99, appealable to the county board of revision.</li>
      </ul>
      <p class="text-[17.5px] text-muted mt-5">
        A city program, like the Columbus registry under City Code Chapter 4515 (April 2026), is separate from the auditor filing. We track which apply to your Dublin address.
      </p>
    </div>
  </section>

  <!-- UTILITIES -->
  <section class="band-tight" aria-labelledby="util-h">
    <div class="wrap max-w-[880px]">
      <h2 id="util-h" class="text-[clamp(26px,3.2vw,38px)]">Who provides utilities in Dublin, and who pays them?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        The City of Dublin supplies water and sanitary sewer, largely under contract with Columbus; Dublin is on
        the Columbus contract community list with Bexley, Gahanna, Grove City and New Albany. AEP Ohio supplies
        electricity and Columbia Gas of Ohio supplies gas.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Utility providers for Dublin, Ohio rental property</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Service</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Provider</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Who customarily pays</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Water and sewer</th>
              <td class="p-3.5 border border-line text-navy font-semibold">City of Dublin, sourced from Columbus</td>
              <td class="p-3.5 border border-line text-muted">Resident, in their own name, on our standard lease</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Electricity</th>
              <td class="p-3.5 border border-line text-navy font-semibold">AEP Ohio</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Natural gas</th>
              <td class="p-3.5 border border-line text-navy font-semibold">Columbia Gas of Ohio</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-[16px] text-muted mt-6">
        Water and sewer arrears in Ohio can follow the property, not the person. We put accounts in the resident
        name at signing and check them at move-out, before the deposit is settled.
      </p>
    </div>
  </section>

  <!-- WHAT WE MANAGE -->
  <section class="band band-wash" aria-labelledby="stock-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The market</span>
      <h2 id="stock-h" class="text-[clamp(26px,3.2vw,38px)]">What kind of rental property is there in Dublin?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Overwhelmingly detached single-family houses from the 1970s onward, on larger lots than anywhere else we
        work. Historic Dublin, the small nineteenth-century core around Bridge and High, is the exception.
        Muirfield Village, Ballantrae, Tartan Fields and the Riverside Drive corridor are newer and larger.
        Condos and small multifamily are a thin slice.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Four bedroom houses draw relocating families: fewer, stronger applications and longer tenancies.
        Irrigation systems, finished basements and three-car garages are common here and rare elsewhere in our
        portfolio, so each gets a maintenance plan.
      </p>
      <h3 class="text-[21px] mt-9 mb-3">Where in Dublin we work</h3>
      <p class="text-[16.5px] text-muted">
        Historic Dublin, Muirfield Village, Ballantrae, Tartan Fields, Llewellyn Farms, Indian Run, the Riverside
        Drive corridor, Bright Road, Brand Road, Avery Road, Coffman Road, and the Sawmill Road and Dublin
        Granville Road commercial edges. The Dublin City School District drives much of the rent. Cardinal Health's
        headquarters and OhioHealth Dublin Methodist Hospital keep relocation demand steady. Landmarks: Muirfield
        Village Golf Club, the Dublin Link bridge over the Scioto and Field of Corn.
      </p>
    </div>
  </section>

  <!-- RENT AND PRICING -->
  <section class="band-tight" aria-labelledby="rent-h">
    <div class="wrap max-w-[880px]">
      <h2 id="rent-h" class="text-[clamp(26px,3.2vw,38px)]">What does a Dublin rental earn, and what does management cost?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Across the units we manage in Dublin, the median rent is {usd(rent['3'].median)} for a three bedroom and
        {' '}{usd(rent['4'].median)} for a four bedroom, from our own leases, not a market survey.
      </p>
      <div class="grid gap-5 sm:grid-cols-3 mt-8">
        {pricing.plans.map((p) => (
          <div class="card text-center">
            <div class="font-sans text-[12px] font-bold tracking-[.13em] uppercase text-faint mb-2">{p.name}</div>
            <div class="font-sans text-[42px] font-extrabold tracking-[-.045em] text-navy leading-none">{usd(p.monthly)}</div>
            <div class="font-sans text-[13px] text-faint mt-2">per unit, per month</div>
            <p class="text-[14.5px] text-muted mt-4 mb-0">{usd(p.repairApprovalLimit)} per-item repair approval limit</p>
          </div>
        ))}
      </div>
      <p class="text-[16.5px] text-muted mt-7">
        A flat price matters more in Dublin because rents are high. A 10% manager on a {usd(rent['3'].median)} house takes about
        {' '}{usd(Math.round(rent['3'].median * 0.1) * 12)} a year, and roughly {usd(typicalManager.leasingFee(rent['3'].median))}
        {' '}again every time the unit turns. Our middle plan is {usd(pricing.plans[1].monthly * 12)} a year and the
        placement is {usd(pricing.leasingFee)}, and our number does not move when your rent does.
      </p>
      <p class="text-[14px] text-faint mt-4">
        Those percentages are common local market rates rather than any one company's quote. Listing photography
        runs $250 to $450 on top of the {usd(pricing.leasingFee)} leasing fee.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/pricing/" class="btn btn-navy">See every fee we charge</a>
        <a href="/free-rent-evaluation/" class="btn btn-ghost">Price my Dublin rental</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band band-wash" aria-labelledby="faq-section">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <h2 id="faq-section" class="sr-only">Dublin property management questions</h2>
      <Faq items={faq} heading="Dublin property management questions" id="dublin-faq" />
      <p class="mt-7 text-[15.5px] text-muted">
        Rent is due on {rentPolicy.dueDate} and late fees are assessed after {rentPolicy.lateFeesAfter}. Owner
        funds go out on the {rentPolicy.ownerDisbursementDay}th. Another forty answers sit on the
        {' '}<a href="/owner-faqs/" class="text-crimson font-semibold no-underline hover:underline">owner FAQs page</a>.
      </p>
      <div class="mt-6"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/property-management-hilliard-ohio/', label: 'Hilliard property management', note: 'Directly south, similar stock, different school district.' },
    { href: '/property-management-powell-ohio/', label: 'Powell property management', note: 'North across the Delaware County line.' },
    { href: '/property-management-worthington-ohio/', label: 'Worthington property management', note: 'East, older housing and a tighter street grid.' },
    { href: '/property-management-upper-arlington-ohio/', label: 'Upper Arlington property management', note: 'Southeast, pre-war and mid-century houses.' },
    { href: '/pricing/', label: 'Pricing and the full fee schedule', note: 'Every charge that can appear on an owner statement.' },
  ]} heading="Nearby markets and what to read next" />

  <Cta
    heading="Find out what your Dublin rental should earn"
    body="Tell us the address and we will price it against the units we already manage in Dublin and the comparable listings live right now. No charge, and no obligation to hire us."
    primary={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondary={{ label: 'Get a portfolio quote', href: '/property-management-consultation/' }}
  />
</Base>
