---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import Faq from '../../../components/Faq.astro';
import Verified from '../../../components/Verified.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import Cta from '../../../components/Cta.astro';
import { company, pricing, rentPolicy, usd } from '../../../data/facts';
import { rentByBedroom, rentByMarketAndBedroom } from '../../../data/markets';
import { serviceNode } from '../../../lib/schema';

/**
 * German Village. A CHILD of the Columbus page, not a peer of Dublin.
 *
 * SCHEMA. Service with areaServed set to the single City of Columbus. German
 * Village is a Columbus neighborhood, not a municipality. No LocalBusiness, no
 * address, no geo. The only LocalBusiness node on this site is the organization at
 * 750 Cross Pointe Rd.
 *
 * RENT DATA. No publishable German Village median: our data sits at zip level and
 * the sample is too small to defend. This page shows the Columbus city medians
 * (ours, labelled) and the portfolio-wide medians (ours, labelled) and says so.
 *
 * SOURCES, pulled 2026-09-09
 *  - 233-acre National Historic Landmark; National Register listing 1974, boundaries
 *    expanded 1980 bringing the count to more than 1,860 structures; German Village
 *    Society founded 1960 after 1950s urban renewal removed about a third of the old
 *    German neighborhood; typical stock is small brick cottages and Dutch Doubles on
 *    small lots on a rectangular grid:
 *    https://www.achp.gov/preserve-america/community/german-village-neighborhood-columbus-ohio
 *    https://sah-archipedia.org/buildings/OH-01-049-0087
 *    https://www.planning.org/greatplaces/neighborhoods/2011/germanvillage.htm
 *  - Schiller Park, 23.45 acres: https://en.wikipedia.org/wiki/Schiller_Park_(Columbus,_Ohio)
 *  - German Village Commission issues Certificates of Appropriateness for exterior
 *    alterations under Columbus City Code chapters 3116 and 3119; applications go
 *    through the Citizens Access Portal and are due about a month before the hearing:
 *    https://germanvillage.com/gvc/
 *    https://www.columbus.gov/Business-Development/Building-Zoning-Services/Boards-and-Commissions/Historic-Preservation-Design-Review-Boards-Commissions-Panels/German-Village-Commission
 *  - December 2025 code change exempted the City itself from obtaining a Certificate
 *    of Appropriateness for work in historic district rights-of-way. Private property
 *    review is unchanged:
 *    https://www.wosu.org/politics-government/2025-12-16/columbus-city-council-votes-to-strip-power-from-german-village-other-historic-districts
 *  - Court, registry, auditor filing and water lien sources are the same as the
 *    Columbus parent page: ORC 1901.02, Chapter 4515 of the Columbus City Codes,
 *    ORC 5323.02, and Columbus City Code 1105.045 and 1147.16.
 */

const PATH = '/property-management-columbus-ohio/german-village/';
const PARENT = '/property-management-columbus-ohio/';

const title = 'Property Management in German Village, Columbus OH | RL Property Management';
const description =
  `${company.name} manages rental cottages and doubles in German Village, a 233-acre National Historic Landmark inside Columbus. ` +
  `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, ${usd(pricing.leasingFee)} leasing fee, ` +
  `and design review on every exterior change.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/areas-we-serve/' },
  { name: 'Columbus', path: PARENT },
  { name: 'German Village', path: PATH },
];

const cbus = rentByMarketAndBedroom['Columbus'];

const keyFacts = [
  'A Columbus neighborhood in Franklin County, zip code 43206',
  'A 233-acre National Historic Landmark with more than 1,860 structures',
  'Every exterior change needs a Certificate of Appropriateness from the German Village Commission',
  'Evictions are heard at Franklin County Municipal Court, 375 S. High St.',
  `Columbus rental registry applies: ${usd(15)} per unit per year, capped at ${usd(1500)} per complex`,
  'Water and sewer billed by the City of Columbus, with the owner liable for unpaid charges',
];

const faq = [
  { q: 'Do I need approval to replace the windows on a German Village rental?',
    a: 'Yes. Every exterior alteration in the German Village Historic District requires a Certificate of Appropriateness from the German Village Commission, issued under Columbus City Code chapters 3116 and 3119. That covers windows, doors, roofing, siding, porches, fences, and anything else visible from the public right of way. Applications are submitted through the Columbus Citizens Access Portal and are due roughly a month before the meeting at which you want to be heard, so budget a review cycle into the schedule before you promise a resident a repair date.' },
  { q: 'What is a Dutch Double, and why does it matter to an owner?',
    a: 'A Dutch Double is a German Village cottage expanded into two units, and it is the most common small rental configuration in the neighborhood. It matters because it changes three things at once: the building is two income streams rather than one, the stairs and the shared entry are the parts that wear, and the lot almost never has off-street parking for two households. That last point does more to shape the applicant pool than anything about the interior.' },
  { q: 'Is German Village its own city?',
    a: 'No. German Village is a Columbus neighborhood in Franklin County, zip code 43206, immediately south of downtown. Columbus ordinances apply in full: the rental registry, source of income protections, Columbus water and sewer, and Columbus Division of Refuse Collection. Evictions go to Franklin County Municipal Court like every other Franklin County address.' },
  { q: 'Did Columbus weaken the German Village Commission in 2025?',
    a: 'Not for private property. In December 2025 Columbus City Council amended the code so the City itself, its officials, agents and contractors do not need a Certificate of Appropriateness when doing construction, reconstruction, demolition or alteration in a right of way. That carve-out covers city work on public streets and sidewalks. Review of exterior alterations on privately owned buildings, which is what affects an owner, was not changed.' },
  { q: 'What kind of rental housing is in German Village?',
    a: 'Mid-nineteenth-century brick cottages and Dutch Doubles on small lots on a rectangular street grid, plus a smaller number of larger brick houses and a few converted commercial buildings. The district was listed on the National Register in 1974, expanded in 1980, and holds more than 1,860 structures across 233 acres. Expect brick, slate or replaced slate, tall narrow window openings, plaster over lath, and basements that were not built for modern mechanicals.' },
  { q: 'Which court hears an eviction in German Village?',
    a: 'Franklin County Municipal Court, at 375 S. High St. Ohio Revised Code 1901.02 gives that court jurisdiction throughout Franklin County. An Ohio eviction is a forcible entry and detainer action under Revised Code Chapter 1923, filed in two causes: one for possession of the property and one for the money judgment.' },
  { q: 'Who bills the water on a German Village rental, and who is liable?',
    a: 'The City of Columbus Department of Public Utilities bills water, sewer and stormwater. The resident can be put on the bill through the city Tenant Billing Agreement, but Columbus City Code 1105.045 is titled "Unpaid charges a lien. Owner liable." and section 1147.16 does the same for sewer. The owner stays liable and unpaid charges attach to the property. Electric is AEP Ohio, gas is Columbia Gas of Ohio, and both go in the resident name.' },
  { q: 'How much does property management cost in German Village?',
    a: `A flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month depending on the plan, with a ${usd(pricing.leasingFee)} leasing fee and no startup fee on an occupied unit. Pricing does not vary by Columbus neighborhood, and there is no historic-district surcharge. What historic status changes is the timeline on exterior work, not the management fee.` },
];

const schemaNodes = [
  {
    ...serviceNode({ path: PATH, name: 'Residential property management in German Village, Columbus, Ohio', description }),
    areaServed: {
      '@type': 'City',
      name: 'Columbus',
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Franklin County, Ohio' },
    },
  },
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="A Columbus neighborhood"
    title="Property management in German Village"
    answer={`${company.name} manages rental cottages and doubles in German Village for a flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month with a ${usd(pricing.leasingFee)} leasing fee. It is a Columbus neighborhood, so Franklin County Municipal Court hears evictions.`}
    breadcrumbs={breadcrumbs}
    secondaryCta={{ label: 'See pricing', href: '/pricing/' }}
  />

  <KeyFacts items={keyFacts} heading="German Village, the short version" />

  <!-- THE DISTRICT -->
  <section class="band-tight" aria-labelledby="dist-h">
    <div class="wrap max-w-[880px]">
      <h2 id="dist-h" class="text-[clamp(26px,3vw,36px)]">What makes German Village different to own in?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Design review. German Village is a 233-acre National Historic Landmark holding more than 1,860
        structures, and every exterior alteration on a privately owned building requires a Certificate
        of Appropriateness from the German Village Commission under Columbus City Code chapters 3116
        and 3119. No other consideration changes an owner's operating reality here as much.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        In practice that means a window replacement, a roof, a porch rebuild, a fence or a rear
        addition is a permitting question before it is a contractor question. Applications go through
        the Columbus Citizens Access Portal and are due roughly a month before the meeting you want to
        be heard at, so a repair that would take two weeks elsewhere in the city can take two months
        here. We plan exterior work around the commission calendar rather than the other way round, and
        we tell residents a realistic date rather than an optimistic one.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        In December 2025 Columbus City Council exempted the City itself from obtaining a Certificate of
        Appropriateness for work in historic district rights of way. That covers city work on public
        streets and sidewalks. Review of private exterior alterations was not changed, so nothing about
        an owner's obligation moved.
      </p>
    </div>
  </section>

  <!-- HOUSING STOCK -->
  <section class="band band-wash" aria-labelledby="stock-h">
    <div class="wrap max-w-[900px]">
      <span class="eyebrow">What is actually here</span>
      <h2 id="stock-h" class="text-[clamp(28px,3.3vw,40px)]">What kind of rental housing does German Village have?</h2>
      <p class="text-[17.5px] text-muted mt-4 max-w-[44em]">
        Mid-nineteenth-century brick cottages, built small and built close, on a rectangular grid of
        brick streets. The neighborhood was raised by German immigrants before 1900, lost about a third
        of its buildings to 1950s urban renewal, and was pulled back by the German Village Society,
        founded in 1960. What survived is unusually consistent, which makes it unusually predictable to
        underwrite.
      </p>
      <div class="grid gap-5 sm:grid-cols-3 mt-7">
        {[
          { h: 'The brick cottage', p: 'One or one and a half stories, soft-burned red brick, a steep roof, tall narrow openings and a stoop straight onto the sidewalk. Small square footage, high rent per foot, and no room to absorb a bad floor plan.' },
          { h: 'The Dutch Double', p: 'A cottage expanded into two units, the workhorse small rental of the neighborhood. Two income streams, shared stairs and entry that take the wear, and almost never off-street parking for two households.' },
          { h: 'The larger brick house', p: 'Two full stories, often on City Park Avenue, Third Street or Mohawk. Bigger systems, slate or replaced slate roofs, and the highest rents in the district.' },
        ].map((x) => (
          <div class="card">
            <h3 class="text-[18.5px] mb-2">{x.h}</h3>
            <p class="text-[15px] text-muted m-0">{x.p}</p>
          </div>
        ))}
      </div>
      <p class="text-[15px] text-muted mt-7">
        The anchors residents ask about are Schiller Park, 23.45 acres in the middle of the
        neighborhood, and the Third Street and South High commercial edges. The Brewery District sits
        immediately west, downtown is a short walk north, and the whole district sits inside zip code
        43206. Streets worth knowing by name because they set the tone: City Park Avenue, Third Street,
        Mohawk, Jaeger, Sycamore, Kossuth and Deshler.
      </p>
      <p class="text-[14px] text-faint mt-4">
      </p>
    </div>
  </section>

  <!-- RENT -->
  <section class="band" aria-labelledby="rent-h">
    <div class="wrap max-w-[900px]">
      <span class="eyebrow">Our own numbers, honestly labelled</span>
      <h2 id="rent-h" class="text-[clamp(28px,3.3vw,40px)]">What do German Village rentals rent for?</h2>
      <p class="text-[17.5px] text-muted mt-4 max-w-[44em]">
        We do not publish a German Village median, because our sample inside the district is too small
        to be honest about. What we can publish is the two figures that come directly from our leases,
        both labelled for what they are.
      </p>
      <div class="grid gap-5 sm:grid-cols-2 mt-7">
        <div class="card">
          <h3 class="text-[18.5px] mb-3">Across the units we manage in Columbus</h3>
          <ul class="text-[15.5px] text-muted">
            {['1', '2', '3', '4'].map((b) => (
              <li class="flex justify-between py-1.5 border-b border-line last:border-0">
                <span>{b} bedroom</span>
                <span class="font-semibold text-navy tabular-nums">{usd(cbus[b].median)}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="card">
          <h3 class="text-[18.5px] mb-3">Across the {company.unitsManaged} units we manage, portfolio-wide</h3>
          <ul class="text-[15.5px] text-muted">
            {Object.entries(rentByBedroom).map(([b, v]) => (
              <li class="flex justify-between py-1.5 border-b border-line last:border-0">
                <span>{b} bedroom</span>
                <span class="font-semibold text-navy tabular-nums">{usd(v.median)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="text-[15px] text-muted mt-6">
        German Village units are small, so rent per square foot runs well above the city figures above
        while total rent on a one-bedroom cottage can look ordinary. Underwriting on rent per foot
        rather than on bedroom count is the more useful habit here. A rent evaluation on the specific
        address is free and it is the only way to price a building this idiosyncratic.
      </p>
      <p class="text-[14px] text-faint mt-4">
        The left column is our own Columbus leases. The right column is our whole portfolio across the
        metro. Neither is a German Village figure and neither is presented as one.
      </p>
    </div>
  </section>

  <!-- RULES -->
  <section class="band band-wash" aria-labelledby="rules-h">
    <div class="wrap max-w-[900px]">
      <span class="eyebrow">Compliance</span>
      <h2 id="rules-h" class="text-[clamp(28px,3.3vw,40px)]">What does a German Village owner have to file, and with whom?</h2>
      <p class="text-[17.5px] text-muted mt-4 max-w-[44em]">
        Three separate things, and the design review is the one that catches people out because it has
        no equivalent in the suburbs.
      </p>
      <div class="grid gap-5 sm:grid-cols-3 mt-7">
        <div class="card">
          <h3 class="text-[18.5px] mb-2">German Village Commission</h3>
          <p class="text-[15px] text-muted m-0">
            A Certificate of Appropriateness for any exterior alteration, under Columbus City Code
            chapters 3116 and 3119. Applied for through the Citizens Access Portal, roughly a month
            ahead of the meeting.
          </p>
        </div>
        <div class="card">
          <h3 class="text-[18.5px] mb-2">Columbus rental registry</h3>
          <p class="text-[15px] text-muted m-0">
            Chapter 4515 of the Columbus City Codes, enacted April 20, 2026. Annual registration at
            {' '}{usd(15)} per unit, capped at {usd(1500)} per complex, including a safety inspection of
            common areas and critical building systems every three years.
          </p>
        </div>
        <div class="card">
          <h3 class="text-[18.5px] mb-2">Franklin County Auditor</h3>
          <p class="text-[15px] text-muted m-0">
            Ohio Revised Code 5323.02. Owner name, address and telephone number, filed once, no fee,
            updated within 60 days of any change. Out-of-state owners must name an Ohio agent for
            service of process.
          </p>
        </div>
      </div>
      <p class="text-[15px] text-muted mt-6">
        Rent is due {rentPolicy.dueDate}, late fees are assessed after {rentPolicy.lateFeesAfter}, and
        owner funds go out on the {rentPolicy.ownerDisbursementDay}th. Everything else about Columbus
        compliance, including source of income protections and the water lien rule, is on the
        {' '}<a href={PARENT} class="text-crimson font-semibold no-underline hover:underline">Columbus page</a>.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="German Village questions" id="german-village-faq" />
      <div class="mt-8">
        <Verified date="2026-09-09" />
      </div>
    </div>
  </section>

  <RelatedLinks
    heading="Where to go next"
    links={[
      { href: PARENT, label: 'Property management in Columbus', note: 'The full local reference: registry, court, utilities, rents.' },
      { href: '/property-management-columbus-ohio/short-north/', label: 'Short North', note: 'The other side of downtown, with its own design review.' },
      { href: '/property-management-bexley-ohio/', label: 'Bexley', note: 'Just east, and a separate municipality with its own rules.' },
      { href: '/pricing/', label: 'Pricing', note: `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month.` },
      { href: '/areas-we-serve/', label: 'All areas we serve', note: 'Every Central Ohio community, grouped by county.' },
    ]}
  />

  <Cta
    heading="What should your German Village rental earn?"
    body="Send us the address. You get a rent number priced against our own Columbus leases, a read on what the commission will and will not approve, and a realistic timeline for any exterior work."
    secondary={{ label: 'See pricing', href: '/pricing/' }}
  />
</Base>
