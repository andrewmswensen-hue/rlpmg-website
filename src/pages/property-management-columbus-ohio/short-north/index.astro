---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import Faq from '../../../components/Faq.astro';
import Verified from '../../../components/Verified.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import Cta from '../../../components/Cta.astro';
import { company, pricing, rentPolicy, usd } from '../../../data/facts';
import { rentByBedroom, rentByMarketAndBedroom } from '../../../data/markets';
import { serviceNode } from '../../../lib/schema';

/**
 * Short North. A CHILD of the Columbus page, not a peer of Dublin.
 *
 * SCHEMA. Service with areaServed set to the single City of Columbus. The Short
 * North is a Columbus district, not a municipality. No LocalBusiness, no address,
 * no geo. The only LocalBusiness node on this site is the organization at
 * 750 Cross Pointe Rd.
 *
 * RENT DATA. No publishable Short North median: our data sits at zip level and the
 * sample is too small to defend. This page shows the Columbus city medians (ours,
 * labeled) and the portfolio-wide medians (ours, labeled) and says so.
 *
 * SOURCES, pulled 2026-09-09
 *  - The Short North runs along High Street between downtown and the Ohio State
 *    campus, with the Arena District to the south and the University District to the
 *    north, flanked by Victorian Village to the west and Italian Village to the east,
 *    and Harrison West beyond Victorian Village to the Olentangy River:
 *    https://en.wikipedia.org/wiki/The_Short_North
 *    https://www.wosu.org/news/2010-03-05/the-short-north-a-history
 *  - Italian Village is bounded by I-670 on the south, Fifth Avenue on the north,
 *    North High Street on the west and the Conrail tracks on the east:
 *    https://en.wikipedia.org/wiki/Italian_Village
 *  - The Italian Village Commission and the Italian Village Historic District were
 *    established by Ordinance 1579-73 in 1973; commission guidelines were adopted in
 *    1990. The commission issues Certificates of Appropriateness for exterior
 *    alterations under Columbus City Code chapters 3116 and 3119, with applications
 *    submitted through the Citizens Access Portal about a month before the hearing:
 *    https://shortnorthcivic.org/ivc-commission/
 *  - Typical Italian Village architecture, two-story brick with gray slate hipped or
 *    flat roofs, chimneys from the ridge line, hanging or box gutters, soft-burned red
 *    brick facades: same source.
 *  - The Short North Design Guidelines, adopted September 19, 2011, cover the High
 *    Street corridor within Italian Village and Victorian Village:
 *    https://www.columbus.gov/files/sharedassets/city/v/1/building-and-zoning/bzs-boards-and-commissions/planning-document-library/short-north-design-guidelines-adopted-09-19-11.pdf
 *  - Columbus historic commissions are the Historic Resources Commission, German
 *    Village, Victorian Village and Italian Village:
 *    https://germanvillage.com/residents/historic_districts/
 *  - December 2025 code change exempted the City itself from a Certificate of
 *    Appropriateness for right-of-way work; private review unchanged:
 *    https://www.wosu.org/politics-government/2025-12-16/columbus-city-council-votes-to-strip-power-from-german-village-other-historic-districts
 *  - Court, registry, auditor filing and water lien sources are the same as the
 *    Columbus parent page: ORC 1901.02, Chapter 4515 of the Columbus City Codes,
 *    ORC 5323.02, and Columbus City Code 1105.045 and 1147.16.
 */

const PATH = '/property-management-columbus-ohio/short-north/';
const PARENT = '/property-management-columbus-ohio/';

const title = 'Property Management in the Short North, Columbus OH | RL Property Management';
const description =
  `${company.name} manages rental property in the Short North, the High Street corridor between downtown Columbus and campus. ` +
  `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, ${usd(pricing.leasingFee)} leasing fee, ` +
  `plus which historic commission reviews your address.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/areas-we-serve/' },
  { name: 'Columbus', path: PARENT },
  { name: 'Short North', path: PATH },
];

const cbus = rentByMarketAndBedroom['Columbus'];

const keyFacts = [
  'A Columbus district in Franklin County, largely zip code 43201',
  'Victorian Village sits west of High Street, Italian Village east, each with its own commission',
  'The Short North Design Guidelines, adopted in 2011, cover the High Street corridor itself',
  'Evictions are heard at Franklin County Municipal Court, 375 S. High St.',
  `Columbus rental registry applies: ${usd(15)} per unit per year, capped at ${usd(1500)} per complex`,
  'Water and sewer billed by the City of Columbus, with the owner liable for unpaid charges',
];

const faq = [
  { q: 'Which historic commission reviews work on a Short North property?',
    a: 'It depends on the side of High Street. West is the Victorian Village Commission, east is the Italian Village Commission. Both issue Certificates of Appropriateness under Columbus City Code chapters 3116 and 3119, with applications through the Columbus Citizens Access Portal roughly a month before the meeting, and the High Street corridor also falls under the Short North Design Guidelines, adopted September 19, 2011.' },
  { q: 'Where exactly is the Short North?',
    a: 'It runs along High Street between downtown Columbus and the Ohio State campus, with the Arena District to the south and the University District to the north. Victorian Village flanks it on the west, Italian Village on the east, and Harrison West runs out to the Olentangy River. Most of it falls in zip code 43201.' },
  { q: 'Is the Short North its own city?',
    a: 'No. It is a Columbus district in Franklin County, so Columbus ordinances apply in full: the rental registry, source of income protections, Columbus water and sewer, and city refuse collection for buildings of four attached units or fewer. Evictions go to Franklin County Municipal Court.' },
  { q: 'What kind of rental housing is in the Short North?',
    a: 'Two-story brick houses, many cut into two or three units decades ago, plus doubles, apartments above High Street retail and newer infill. Flat and low-slope roofs are far more common here than in the rest of the city, and they are the largest capital item to plan for.' },
  { q: 'Which court hears an eviction in the Short North?',
    a: 'Franklin County Municipal Court, at 375 S. High St., just south of the district. Ohio Revised Code 1901.02 gives it jurisdiction throughout Franklin County, and the case is a forcible entry and detainer action under Revised Code Chapter 1923, with one cause for possession and one for the money judgment.' },
  { q: 'Who bills the water on a Short North rental, and who is liable?',
    a: 'The City of Columbus Department of Public Utilities bills water, sewer and stormwater, and under Columbus City Code 1105.045 and 1147.16 the owner stays liable even with a Tenant Billing Agreement. The risk is higher here because divided brick buildings often share one water meter, so one bill covers several households.' },
  { q: 'Did Columbus weaken the Italian Village and Victorian Village commissions in 2025?',
    a: 'Not for private property. In December 2025 Columbus City Council exempted the City, its officials, agents and contractors from needing a Certificate of Appropriateness for work in a right of way. Review of exterior alterations on privately owned buildings was not changed.' },
  { q: 'How much does property management cost in the Short North?',
    a: `A flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month depending on the plan, with a ${usd(pricing.leasingFee)} leasing fee and no startup fee on an occupied unit. There is no historic-district surcharge, and because Short North rents run above the Columbus median, a flat price saves more here than a percentage would.` },
];

const schemaNodes = [
  {
    ...serviceNode({ path: PATH, name: 'Residential property management in the Short North, Columbus, Ohio', description }),
    areaServed: {
      '@type': 'City',
      name: 'Columbus',
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Franklin County, Ohio' },
    },
  },
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="A Columbus district"
    title="Property management in the Short North"
    answer={`${company.name} manages rental property in the Short North for a flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month with a ${usd(pricing.leasingFee)} leasing fee. It is Columbus, Franklin County, so Franklin County Municipal Court hears evictions.`}
    breadcrumbs={breadcrumbs}
    secondaryCta={{ label: 'See pricing', href: '/pricing/' }}
  />

  <KeyFacts items={keyFacts} heading="The Short North, the short version" />

  <!-- GEOGRAPHY -->
  <section class="band-tight" aria-labelledby="where-h">
    <div class="wrap max-w-[880px]">
      <h2 id="where-h" class="text-[clamp(26px,3vw,36px)]">Where is the Short North, and what is it made of?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        High Street between downtown and the Ohio State campus, from the Arena District to the University
        District. It is a district, not one neighborhood: Victorian Village lies west of High, Italian
        Village east, and Harrison West runs out to the Olentangy River. Goodale Park sits at the
        southwest corner. Most of it is zip code 43201.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Your side of High Street decides which commission reviews exterior work, and the two have
        separate guidelines and calendars.
      </p>
    </div>
  </section>

  <!-- DESIGN REVIEW -->
  <section class="band band-wash" aria-labelledby="review-h">
    <div class="wrap max-w-[900px]">
      <span class="eyebrow">Design review</span>
      <h2 id="review-h" class="text-[clamp(28px,3.3vw,40px)]">Which commission has to approve exterior work here?</h2>
      <p class="text-[17.5px] text-muted mt-4 max-w-[44em]">
        Both issue Certificates of Appropriateness under Columbus City Code chapters 3116 and 3119, with
        applications through the Columbus Citizens Access Portal about a month before the meeting.
      </p>
      <div class="grid gap-5 sm:grid-cols-3 mt-7">
        {[
          { h: 'Italian Village Commission', p: 'East of High Street. The commission and the district were established by Ordinance 1579-73 in 1973, and the district guidelines were adopted in 1990. The district runs from I-670 on the south to Fifth Avenue on the north, North High Street on the west and the Conrail tracks on the east.' },
          { h: 'Victorian Village Commission', p: 'West of High Street. Same legal basis and certificate requirement, with its own guidelines and meeting calendar.' },
          { h: 'Short North Design Guidelines', p: 'Adopted September 19, 2011, for the High Street corridor through both districts. A building on High is reviewed against these and the district guidelines.' },
        ].map((x) => (
          <div class="card">
            <h3 class="text-[18.5px] mb-2">{x.h}</h3>
            <p class="text-[15px] text-muted m-0">{x.p}</p>
          </div>
        ))}
      </div>
      <p class="text-[15px] text-muted mt-7">
        The December 2025 amendment exempting the City from the certificate covers only city work in a
        right of way. Private property review did not change.
      </p>
      <p class="text-[14px] text-faint mt-4">
      </p>
    </div>
  </section>

  <!-- HOUSING STOCK -->
  <section class="band" aria-labelledby="stock-h">
    <div class="wrap max-w-[900px]">
      <span class="eyebrow">The buildings</span>
      <h2 id="stock-h" class="text-[clamp(28px,3.3vw,40px)]">What kind of buildings do you manage in the Short North?</h2>
      <p class="text-[17.5px] text-muted mt-4 max-w-[44em]">
        Mostly nineteenth-century brick, often divided into more units than it was built for. Typical
        Italian Village stock is two-story soft-burned red brick with a gray slate hipped or flat roof,
        ridge-line chimneys and hanging or box gutters. Victorian Village runs to larger houses on wider lots.
      </p>
      <div class="grid gap-5 sm:grid-cols-2 mt-7">
        {[
          { h: 'The divided brick house', p: 'A house cut into two or three flats. Good rent per foot, but the shared stairs, single water meter and original stack are where the money goes.' },
          { h: 'The double', p: 'Purpose-built two-unit brick or frame buildings on the side streets. The simplest to own and lease.' },
          { h: 'The commercial upper', p: 'Apartments above High Street retail, under both sets of guidelines and exposed to ground-floor noise and refuse.' },
          { h: 'Newer infill', p: 'Townhomes and small apartment buildings from the last two decades. Newer systems, higher rent, and association documents to read.' },
        ].map((x) => (
          <div class="card">
            <h3 class="text-[18.5px] mb-2">{x.h}</h3>
            <p class="text-[15px] text-muted m-0">{x.p}</p>
          </div>
        ))}
      </div>
      <p class="text-[15px] text-muted mt-7">
        Two things to plan for: flat and low-slope roofs, which are rare elsewhere in Columbus and the
        capital item to underwrite hardest, and shared water meters, where one city bill covers several
        households and stays the owner's liability under Columbus City Code 1105.045.
      </p>
    </div>
  </section>

  <!-- RENT -->
  <section class="band band-wash" aria-labelledby="rent-h">
    <div class="wrap max-w-[900px]">
      <span class="eyebrow">Our own numbers, labeled</span>
      <h2 id="rent-h" class="text-[clamp(28px,3.3vw,40px)]">What do Short North rentals rent for?</h2>
      <p class="text-[17.5px] text-muted mt-4 max-w-[44em]">
        Above the Columbus median, sometimes well above. We do not have enough leases here for an honest
        district median, so these are two labeled figures from our own leases.
      </p>
      <div class="grid gap-5 sm:grid-cols-2 mt-7">
        <div class="card">
          <h3 class="text-[18.5px] mb-3">Across the units we manage in Columbus</h3>
          <ul class="text-[15.5px] text-muted">
            {['1', '2', '3', '4'].map((b) => (
              <li class="flex justify-between py-1.5 border-b border-line last:border-0">
                <span>{b} bedroom</span>
                <span class="font-semibold text-navy tabular-nums">{usd(cbus[b].median)}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="card">
          <h3 class="text-[18.5px] mb-3">Across the {company.unitsManaged} units we manage, portfolio-wide</h3>
          <ul class="text-[15.5px] text-muted">
            {Object.entries(rentByBedroom).map(([b, v]) => (
              <li class="flex justify-between py-1.5 border-b border-line last:border-0">
                <span>{b} bedroom</span>
                <span class="font-semibold text-navy tabular-nums">{usd(v.median)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="text-[15px] text-muted mt-6">
        With rents at the top of the Columbus range, a flat price saves more here than anywhere else in
        the city: a 10% manager earns more only because the rent is higher. See the comparison at three
        rent levels on the
        {' '}<a href="/pricing/" class="text-crimson font-semibold no-underline hover:underline">pricing page</a>.
      </p>
      <p class="text-[14px] text-faint mt-4">
        Left: our Columbus leases. Right: our whole metro portfolio. Neither is a Short North figure.
      </p>
    </div>
  </section>

  <!-- RULES -->
  <section class="band" aria-labelledby="rules-h">
    <div class="wrap max-w-[900px]">
      <span class="eyebrow">Compliance</span>
      <h2 id="rules-h" class="text-[clamp(28px,3.3vw,40px)]">What does a Short North owner have to file?</h2>
      <div class="grid gap-5 sm:grid-cols-3 mt-6">
        <div class="card">
          <h3 class="text-[18.5px] mb-2">Certificate of Appropriateness</h3>
          <p class="text-[15px] text-muted m-0">
            From the Italian Village Commission or the Victorian Village Commission, depending on your
            side of High Street, for any exterior alteration. Columbus City Code chapters 3116 and 3119.
          </p>
        </div>
        <div class="card">
          <h3 class="text-[18.5px] mb-2">Columbus rental registry</h3>
          <p class="text-[15px] text-muted m-0">
            Chapter 4515 of the Columbus City Codes, enacted April 20, 2026. {usd(15)} per unit per
            year, capped at {usd(1500)} per complex, with a safety inspection of common areas and
            critical building systems every three years.
          </p>
        </div>
        <div class="card">
          <h3 class="text-[18.5px] mb-2">Franklin County Auditor</h3>
          <p class="text-[15px] text-muted m-0">
            Ohio Revised Code 5323.02. Filed once, no fee, updated within 60 days of any change.
            An owner outside Ohio names an Ohio agent for service of process.
          </p>
        </div>
      </div>
      <p class="text-[15px] text-muted mt-6">
        Rent is due {rentPolicy.dueDate}, late fees are assessed after {rentPolicy.lateFeesAfter}, and
        owner funds go out on the {rentPolicy.ownerDisbursementDay}th. Source of income protections and
        the rest of the Columbus rule set are on the
        {' '}<a href={PARENT} class="text-crimson font-semibold no-underline hover:underline">Columbus page</a>.
      </p>
    </div>
  </section>

  <section class="band band-wash">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Short North questions" id="short-north-faq" />
      <div class="mt-8">
        <Verified date="2026-09-09" />
      </div>
    </div>
  </section>

  <RelatedLinks
    heading="Where to go next"
    links={[
      { href: PARENT, label: 'Property management in Columbus', note: 'The full local reference: registry, court, utilities, rents.' },
      { href: '/property-management-columbus-ohio/german-village/', label: 'German Village', note: 'The other side of downtown, with its own commission.' },
      { href: '/property-management-columbus-ohio/clintonville/', label: 'Clintonville', note: 'Straight up High Street, past campus.' },
      { href: '/pricing/', label: 'Pricing', note: `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month.` },
      { href: '/areas-we-serve/', label: 'All areas we serve', note: 'Every Central Ohio community, grouped by county.' },
    ]}
  />

  <Cta
    heading="What should your Short North rental earn?"
    body="Send us the address. You get a rent number priced against our own Columbus leases, the right commission for your side of High Street, and a realistic timeline for any exterior work."
    secondary={{ label: 'See pricing', href: '/pricing/' }}
  />
</Base>
