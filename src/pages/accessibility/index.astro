---
/*
 * ===========================================================================
 * DRAFT. NOT LEGAL ADVICE. PENDING REVIEW BY COUNSEL BEFORE PUBLICATION.
 * ===========================================================================
 * Written by a non-lawyer. Open legal questions are marked inline as
 * [LEGAL REVIEW: question] and open facts as [SOURCE NEEDED: what is needed].
 *
 * IMPORTANT: this page states a TARGET (WCAG 2.2 Level AA) and a commitment to
 * fix reported barriers. It deliberately does NOT claim conformance, does not
 * cite a statute, and does not promise a legal outcome. Keep it that way.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company } from '../../data/facts';
import { longDate } from '../../lib/format';

const title = 'Accessibility | RL Property Management';
const description =
  `rlpmg.com targets WCAG 2.2 Level AA. The site ships zero JavaScript, uses semantic HTML with visible ` +
  `focus states, and stays readable with CSS off. Report a barrier and we will fix it.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Accessibility', path: '/accessibility/' },
];

const effective = '2026-09-09';

const keyFacts = [
  'The target is WCAG 2.2 Level AA',
  'Zero JavaScript ships to your browser',
  'The site is readable with CSS and JavaScript disabled',
  'Semantic HTML, real headings, visible focus states',
  'Every page works from the keyboard alone',
  `Report a barrier: ${company.phone} or ${company.email}`,
];

/** What is actually built in. Each of these is verifiable by inspecting the site,
 *  which is the only kind of accessibility claim worth publishing. */
const built = [
  {
    h: 'No JavaScript at all',
    p: 'Nothing on this site depends on a script running. Menus, fee tables and FAQ sections use the HTML details element, so they open and close with the keyboard and are announced correctly by screen readers. If scripting is blocked or fails, the page still works.',
  },
  {
    h: 'Readable with CSS turned off',
    p: 'Every page is written as a document first: one h1, headings in order with no skipped levels, real lists, real tables with header cells, and content in the order you would read it. Turn off the stylesheet and the page still makes sense.',
  },
  {
    h: 'Keyboard access with a visible focus ring',
    p: 'Every link, button and form control is reachable with the Tab key, in a sensible order, and the focused element is clearly outlined. There are no keyboard traps because there is nothing scripted to trap you.',
  },
  {
    h: 'A skip link on every page',
    p: 'The first thing in the tab order is a link that jumps past the header and navigation straight to the main content, so a keyboard or screen reader user does not walk the menu on every page.',
  },
  {
    h: 'Text that resizes',
    p: 'Type is set in relative units and the layout reflows, so zooming to 200 percent or raising the browser font size does not cut off content or force sideways scrolling. Wide tables scroll inside their own container instead of pushing the page sideways.',
  },
  {
    h: 'Labels, landmarks and alternative text',
    p: 'Form fields have real labels tied to the input, sections use landmarks and headings a screen reader can navigate by, images carry alternative text, and decorative marks are hidden from assistive technology rather than read aloud.',
  },
];

const faq = [
  {
    q: 'What accessibility standard does rlpmg.com target?',
    a: 'WCAG 2.2 Level AA. That is the target we build and review against. We do not claim full conformance, because a site with hundreds of pages that changes every week cannot honestly claim a fixed conformance status. We claim the target, the practices behind it, and a commitment to fix what is reported.',
  },
  {
    q: 'Does this site work with a screen reader?',
    a: 'It is built to. Pages are semantic HTML with one h1, headings in order, real lists and tables, labeled form fields, landmarks to navigate by, and alternative text on images. If your screen reader hits something that does not work, that is a bug and we want the report.',
  },
  {
    q: 'Does this site work without JavaScript?',
    a: 'Yes. The site ships zero JavaScript. Expanding sections, the mobile menu and the FAQ blocks all use the HTML details element rather than a script, so everything works with scripting disabled or blocked.',
  },
  {
    q: 'How do I report an accessibility problem?',
    a: `Call ${company.phone} or email ${company.email} with the page address, what you were trying to do, and what got in the way. Tell us what you are using, such as a screen reader, keyboard only, magnification or voice control, because it usually points straight at the cause.`,
  },
  {
    q: 'Can I get information from this site in another format?',
    a: `Yes. If a page, a document or a form is not usable for you, call ${company.phone} and a person will read it to you, send it in another format, or take the information over the phone. Nothing on this site is a task that can only be completed on a screen.`,
  },
  {
    q: 'What about the resident portal and the maintenance system?',
    a: 'Those are separate platforms run by other companies, and their accessibility is theirs to control rather than ours. If one of them blocks you, tell us anyway. We will handle your request another way, and we will raise it with the vendor.',
  },
];
---
<Base {title} {description} {faq} {breadcrumbs}>
  <!--
    ==========================================================================
    DRAFT ACCESSIBILITY STATEMENT. NOT LEGAL ADVICE. PENDING REVIEW BY COUNSEL.
    States a TARGET (WCAG 2.2 AA) and a commitment to remediate. Deliberately
    makes NO conformance claim and cites NO statute. Open items are marked
    inline as [LEGAL REVIEW: ...] and [SOURCE NEEDED: ...].
    ==========================================================================
  -->

  <PageHero
    eyebrow="Accessibility"
    title="Accessibility at RL Property Management"
    answer="This site targets WCAG 2.2 Level AA. It ships zero JavaScript, uses semantic HTML with visible focus states, and stays readable with CSS and JavaScript disabled. Report a barrier and we will fix it."
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Report an accessibility problem', href: '#report' }}
    secondaryCta={{ label: `Call ${company.phone}`, href: `tel:${company.phoneE164}` }}
  />

  <KeyFacts items={keyFacts} heading="The short version" />

  <section class="band-tight" aria-labelledby="target-h">
    <div class="wrap max-w-[880px] prose-rl">
      <p class="text-[14px] text-faint">Last reviewed {longDate(effective)}.</p>

      <h2 id="target-h">What standard does this site target?</h2>
      <p>
        The Web Content Accessibility Guidelines, version 2.2, Level AA. That is the standard we
        design, write and review against, and it is the one we measure a reported problem by.
      </p>
      <p>
        We do not claim full conformance. A site this size changes every week, and a conformance
        badge on a moving target is a claim we would not be able to stand behind on any given day.
        What we will say is this: the target is WCAG 2.2 AA, the practices below are actually in
        the code, and when someone tells us a page has a barrier we fix the page.
        {' '}[LEGAL REVIEW: confirm whether any accessibility statute or regulation applies to this
        business and, if so, whether specific wording, a conformance claim, a remediation timeline
        or a named contact must appear on this page. Nothing on this page cites a law, on purpose.]
      </p>

      <h2>Why does zero JavaScript matter for accessibility?</h2>
      <p>
        Most accessibility failures on a marketing website come from scripted widgets: a custom
        dropdown that a screen reader cannot see, an accordion that traps the keyboard, a modal
        that steals focus, a carousel that moves on its own. This site has none of them, because it
        ships no JavaScript at all.
      </p>
      <p>
        Expanding sections use the HTML details element, which browsers and assistive technology
        already know how to handle. That decision was made for speed, and accessibility came along
        with it.
      </p>
    </div>
  </section>

  <section class="band band-wash" aria-labelledby="built-h">
    <div class="wrap max-w-[940px]">
      <span class="eyebrow">What is actually in the build</span>
      <h2 id="built-h" class="text-[clamp(26px,3.2vw,38px)]">What has been built into this site?</h2>
      <p class="text-[17.5px] text-muted mt-4 mb-8 max-w-[44em]">
        Six things, and every one of them can be checked by inspecting a page rather than taking
        our word for it.
      </p>
      <div class="grid gap-5 sm:grid-cols-2">
        {built.map((b) => (
          <div class="card">
            <h3 class="text-[18.5px] mb-2">{b.h}</h3>
            <p class="text-[15px] text-muted m-0">{b.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band-tight" aria-labelledby="gaps-h">
    <div class="wrap max-w-[880px] prose-rl">
      <h2 id="gaps-h">What do we know is not covered?</h2>
      <p>
        Three things, and it is more useful to say so than to imply the whole experience is under
        our control.
      </p>
      <ul>
        <li>
          <strong>Other companies' platforms.</strong> The resident portal, the payment system, the
          maintenance request system and the listing service are run by separate companies. We
          choose vendors and we can raise problems with them, but we do not write their code. If
          one of them blocks you, call us and we will complete the task with you another way.
        </li>
        <li>
          <strong>Documents.</strong> Leases, statements and other paperwork are generated by those
          systems, and a PDF is not automatically accessible.
          {' '}[SOURCE NEEDED: whether tagged, screen-reader-readable versions of leases and owner
          statements can be produced on request, and by whom.]
        </li>
        <li>
          <strong>Older published posts.</strong> The blog archive goes back years and predates the
          current build. Structure and alternative text in the oldest posts are being worked
          through, and a report about a specific post moves it to the front of the line.
        </li>
      </ul>
      <p>
        We also have not commissioned a third-party audit.
        {' '}[SOURCE NEEDED: whether an independent accessibility audit is planned, and whether the
        result would be published here.]
      </p>
    </div>
  </section>

  <section class="band" id="report" aria-labelledby="report-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Tell us</span>
      <h2 id="report-h" class="text-[clamp(26px,3.2vw,38px)]">How do I report an accessibility problem?</h2>
      <p class="text-[17.5px] text-muted mt-4 mb-7 max-w-[44em]">
        Call {company.phone} or email
        {' '}<a href={`mailto:${company.email}`} class="text-crimson font-semibold no-underline hover:underline">{company.email}</a>.
        A report from one person is worth more than a scan, because it tells us what the barrier
        actually stopped you from doing.
      </p>
      <div class="card !bg-wash-soft">
        <h3 class="text-[18.5px] mb-3">What to include, if you have it</h3>
        <ul class="grid gap-2">
          {[
            'The address of the page',
            'What you were trying to do',
            'What happened instead',
            'What you were using: screen reader, keyboard only, magnification, voice control, or a phone',
            'A way to reach you, if you want to hear what we did about it',
          ].map((x) => (
            <li class="flex gap-3 text-[15.5px]">
              <span class="text-crimson font-extrabold shrink-0" aria-hidden="true">✓</span><span>{x}</span>
            </li>
          ))}
        </ul>
      </div>
      <p class="text-[17.5px] text-muted mt-7">
        You do not need to know what rule was broken or use the right vocabulary. "I cannot get past
        this with the keyboard" is a complete report.
      </p>

      <h3 class="text-[21px] mt-9 mb-3">What happens after you report one?</h3>
      <p class="text-[17.5px] text-muted">
        A person reads it, reproduces it, and fixes the page. If a fix is going to take longer than
        a few days, we will tell you that and we will give you another way to do the thing you were
        trying to do in the meantime.
        {' '}[SOURCE NEEDED: the response time we are willing to commit to in writing, and the
        person or role who owns accessibility reports.]
      </p>

      <h3 class="text-[21px] mt-9 mb-3">What if you need information another way?</h3>
      <p class="text-[17.5px] text-muted">
        Call {company.phone} and a person will read a page to you, send the information in another
        format, or take the details over the phone. Nothing on this site is a task that can only be
        completed on a screen. That includes requesting a rent evaluation, asking about a listing,
        and submitting a maintenance request.
      </p>

      <h3 class="text-[21px] mt-9 mb-3">What about accommodations at a property?</h3>
      <p class="text-[17.5px] text-muted">
        A request for a reasonable accommodation or a reasonable modification at a rental home is a
        separate process from a website problem, and it is handled by our leasing and resident
        teams rather than by whoever fixes a web page. Call {company.phone} and say that is what
        you are asking about, so it gets routed correctly the first time.
        {' '}[LEGAL REVIEW: the reasonable accommodation and modification request process, the
        wording required on this page, whether a designated contact or form must be named, and how
        that language interacts with our fair housing statement.]
      </p>
    </div>
  </section>

  <section class="band band-wash">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Accessibility questions" id="a11y-faq" />
      <div class="mt-8"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/contact-us/', label: 'Contact us', note: 'Phone, email and office address.' },
    { href: '/privacy-policy/', label: 'Privacy policy', note: 'What this site collects, and where it goes.' },
    { href: '/terms/', label: 'Terms of use', note: 'What this website is and is not.' },
    { href: '/editorial-policy/', label: 'Editorial policy', note: 'Who writes and reviews these pages.' },
    { href: '/residents/', label: 'Resident resources', note: 'Rent, repairs and applications.' },
  ]} />

  <Cta
    heading="Something on this site not working for you?"
    body="Tell us what page it was and what got in the way. We will fix the page, and we will get you what you needed in the meantime."
    primary={{ label: 'Contact us', href: '/contact-us/' }}
    secondary={{ label: `Call ${company.phone}`, href: `tel:${company.phoneE164}` }}
  />
</Base>
