---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, kpis, rentPolicy, pricing, areas, areaUrl, usd } from '../../data/facts';
import { partitionAreas } from '../../lib/areas';
import { rentByBedroom } from '../../data/markets';

/**
 * The highest-traffic renter page on the site.
 *
 * Search intent: "houses for rent columbus ohio", "3 bedroom house for rent
 * [city] ohio", "pet friendly rentals columbus", "houses for rent near me".
 *
 * The job of this page is to turn a searcher into a showing and then an
 * application. The listings themselves are a live feed; everything around them
 * is the static content that will actually rank and that answers the four
 * questions every renter has before they call: how do I see it, what do I need
 * to qualify, what does it cost to apply, can I have a pet.
 *
 * LISTINGS FEED: pending. See the placeholder section below.
 */

const title = 'Homes for Rent in Columbus, Ohio | RL Property Management';
const description =
  `Houses and small multifamily rentals available now across the Columbus, Ohio metro from ${company.name}. ` +
  `See current listings, book a showing, and apply online. Median 3 bedroom rent is ${usd(rentByBedroom['3'].median)}.`;

const { linked: linkedAreas, unlinked: namedAreas } = partitionAreas(areas, areaUrl);

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Homes for rent', path: '/homes-for-rent/' },
];

const answer =
  `${company.name} manages ${company.unitsManaged} rental homes across the Columbus, Ohio metro. ` +
  `Browse what is available now, book a showing, and apply online. Median rent runs ` +
  `${usd(rentByBedroom['2'].median)} for a two bedroom and ${usd(rentByBedroom['3'].median)} for a three bedroom.`;

const keyFacts = [
  `${company.unitsManaged} homes under management across ${areas.length} Columbus area communities`,
  `Median rent across the portfolio: 1 bed ${usd(rentByBedroom['1'].median)}, 2 bed ${usd(rentByBedroom['2'].median)}, 3 bed ${usd(rentByBedroom['3'].median)}, 4 bed ${usd(rentByBedroom['4'].median)}`,
  `Rent is due on ${rentPolicy.dueDate}, late fees are assessed after ${rentPolicy.lateFeesAfter}`,
  `Resident satisfaction ${kpis.metrics.find((m) => m.id === 'satisfaction')?.value} out of 5`,
  `Repairs close in a median of ${kpis.metrics.find((m) => m.id === 'repairDays')?.value} days`,
  `Approved pets are covered up to ${usd(pricing.petDamageCoverage.cap)} in damage above the deposit`,
];

/** Bedroom rows for the rent table. Read from the fact bank, never typed. */
const bedroomRows = Object.entries(rentByBedroom).map(([beds, v]) => ({
  beds,
  median: v.median,
  sample: v.sample,
}));

const dom = kpis.metrics.find((m) => m.id === 'dom')?.value;
const occupancy = kpis.metrics.find((m) => m.id === 'occupancy')?.value;
const repairDays = kpis.metrics.find((m) => m.id === 'repairDays')?.value;

const faq = [
  { q: 'What homes do you have for rent in Columbus, Ohio right now?',
    a: `${company.name} manages ${company.unitsManaged} single-family homes and small multifamily units across ${areas.length} communities in the Columbus metro, and the list of what is available changes weekly. Current listings appear on this page. If nothing on the list fits, call ${company.phone} and tell us what you are looking for.` },
  { q: 'How do I schedule a showing?',
    a: 'Book from the listing for the home you want to see. Each listing has its own showing option. [SOURCE NEEDED: whether showings are self-guided, agent-led, or both, and any identity or payment card verification required to book one].' },
  { q: 'How much does it cost to apply?',
    a: 'The application fee is [SOURCE NEEDED: application fee amount, and whether it is charged per adult applicant or per household]. It is charged when you submit and covers the screening reports.' },
  { q: 'Do you allow pets?',
    a: `Many of our homes accept pets, and the specific listing says whether that home does. Approved pets carry a monthly pet administration fee, which funds coverage of up to ${usd(pricing.petDamageCoverage.cap)} in pet damage above the security deposit. Service animals and assistance animals are not pets, are not charged a pet fee, and are handled under fair housing law. [SOURCE NEEDED: monthly pet administration fee amount, pet deposit if any, and the number, size or breed limits that apply].` },
  { q: 'What do I need to qualify for a rental?',
    a: 'Every applicant is screened on the same published criteria: identity, income, credit, rental history, and background. The full thresholds are on our application criteria page. [SOURCE NEEDED: income multiple, credit score minimum, and rental history requirements].' },
  { q: 'How fast do your rentals get leased?',
    a: `Median days on market across the portfolio is ${dom} days as of ${kpis.asOfLabel}, measured as ${kpis.domDefinition.charAt(0).toLowerCase() + kpis.domDefinition.slice(1)} Portfolio occupancy is ${occupancy}.` },
  { q: 'Do you rent to applicants using a housing voucher?',
    a: 'Yes. Columbus City Code sections 2331.02 and 4551.03 prohibit refusing to rent to someone because their income includes housing assistance, and many surrounding Central Ohio municipalities have the same protection. We apply the same screening criteria to every applicant regardless of how the income arrives.' },
  { q: 'What areas do you have rentals in?',
    a: `We manage homes in ${areas.length} communities across the Columbus metro, including Columbus, Dublin, Upper Arlington, Westerville, Worthington, Gahanna, Hilliard, Powell, Reynoldsburg, New Albany, Grove City, Bexley and Pickerington, spanning Franklin, Delaware, Fairfield, Licking, Union, Madison and Pickaway counties.` },
  { q: 'Who handles repairs once I move in?',
    a: `We do. Maintenance requests go through the resident portal and are handled by in-house technicians and vetted vendors. Median time to close a repair is ${repairDays} days, and emergency coverage runs 24 hours a day.` },
];
---
<Base {title} {description} {faq} {breadcrumbs}>

  <PageHero
    eyebrow="For renters"
    title="Houses for rent in Columbus, Ohio"
    answer={answer}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Start an application', href: '/residents/how-to-apply/' }}
    secondaryCta={{ label: 'See what you need to qualify', href: '/residents/application-criteria/' }}
  />

  <KeyFacts items={keyFacts} heading="The short version" />

  <!--
    LIVE LISTINGS. RentEngine is embed-only (Andrew, 2026-09-10): there is no
    API to render the feed at build time, so the hosted page is framed here.

    Known cost, accepted: content inside an iframe is indexed as RentEngine's,
    not ours, so individual listings will not rank on rlpmg.com from this. The
    page itself still ranks on everything around the embed, which is why the
    FAQs and the qualification details stay below it.

    Height is fixed so the frame reserves its space and nothing shifts as it
    loads. Lazy, because it sits below the heading. The plain link underneath
    is the fallback if a browser or extension blocks third-party frames.
  -->
  <section class="band-tight" aria-labelledby="listings-h">
    <div class="wrap">
      <div class="max-w-[880px]">
        <span class="eyebrow">Available now</span>
        <h2 id="listings-h" class="text-[clamp(28px,3.3vw,40px)]">What is available right now</h2>
        <p class="text-[17px] text-muted mt-3 mb-6">
          Every home we have open across the Columbus metro. Pick one to see photos, book a showing, and apply.
        </p>
      </div>
      <div class="rounded-[18px] overflow-hidden border border-line bg-white"
           style="box-shadow:0 1px 2px rgb(18 49 67 / .05), 0 8px 24px rgb(18 49 67 / .06)">
        <iframe
          src="https://rentengine.io/c/rlpmg"
          title={`Homes for rent from ${company.name}, live listings`}
          width="100%" height="750" loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          style="display:block; border:0; width:100%; height:750px;"></iframe>
      </div>
      <p class="text-[14.5px] text-muted mt-4">
        Listings not showing?
        {' '}<a href="https://rentengine.io/c/rlpmg" rel="noopener" class="text-crimson font-semibold no-underline hover:underline">Open them in a new tab</a>,
        or call {company.phone} and tell us the bedroom count, area and move-in date you want.
      </p>
    </div>
  </section>

  <!-- HOW TO SEE A HOME -->
  <section class="band band-wash" aria-labelledby="see-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Step one</span>
      <h2 id="see-h" class="text-[clamp(28px,3.3vw,40px)]">How do I see one of your homes?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Book the showing from the listing for that home, not a general contact form. No waiting on a callback.
      </p>
      <ol class="mt-6 grid gap-4">
        <li class="card !p-5">
          <span class="block font-serif text-[18px] font-semibold text-navy mb-1">1. Find the home</span>
          <span class="block text-[15.5px] text-muted">
            Check the bedrooms, rent, pet policy and available date on the listing first.
          </span>
        </li>
        <li class="card !p-5">
          <span class="block font-serif text-[18px] font-semibold text-navy mb-1">2. Book a showing</span>
          <span class="block text-[15.5px] text-muted">
            Showings are booked per home.
            <span class="text-crimson font-semibold">[SOURCE NEEDED: whether showings are self-guided with
            a lockbox code, agent-led, or both, and what identity verification is required to book]</span>
          </span>
        </li>
        <li class="card !p-5">
          <span class="block font-serif text-[18px] font-semibold text-navy mb-1">3. Apply the same day if you want it</span>
          <span class="block text-[15.5px] text-muted">
            Applications are reviewed in the order they are completed, not started. An incomplete
            one waits behind a complete one filed later.
          </span>
        </li>
      </ol>
      <p class="text-[15px] text-muted mt-6">
        Median days on market across our portfolio: {dom} days as of {kpis.asOfLabel}.
      </p>
    </div>
  </section>

  <!-- QUALIFYING -->
  <section class="band" aria-labelledby="qualify-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Before you pay a fee</span>
      <h2 id="qualify-h" class="text-[clamp(28px,3.3vw,40px)]">What do I need to qualify?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Five checks, the same for every applicant on every home. Check yourself against them before you pay anything.
      </p>
      <ul class="mt-6 grid gap-3">
        <li class="flex gap-3 text-[15.5px]"><span class="text-crimson font-extrabold shrink-0" aria-hidden="true">1</span><span><strong class="text-navy">Identity.</strong> A government issued photo ID for every adult who will live in the home.</span></li>
        <li class="flex gap-3 text-[15.5px]"><span class="text-crimson font-extrabold shrink-0" aria-hidden="true">2</span><span><strong class="text-navy">Income.</strong> Verifiable income against the rent. <span class="text-crimson font-semibold">[SOURCE NEEDED: the income multiple required, for example gross monthly income of at least a set multiple of rent, and which documents are accepted as proof]</span></span></li>
        <li class="flex gap-3 text-[15.5px]"><span class="text-crimson font-extrabold shrink-0" aria-hidden="true">3</span><span><strong class="text-navy">Credit.</strong> A credit report is pulled for every adult applicant. <span class="text-crimson font-semibold">[SOURCE NEEDED: minimum credit score, and how open collections, medical debt and prior bankruptcy are treated]</span></span></li>
        <li class="flex gap-3 text-[15.5px]"><span class="text-crimson font-extrabold shrink-0" aria-hidden="true">4</span><span><strong class="text-navy">Rental history.</strong> We contact prior landlords. <span class="text-crimson font-semibold">[SOURCE NEEDED: how many years of rental history are verified, and how prior evictions, judgments and balances owed are treated]</span></span></li>
        <li class="flex gap-3 text-[15.5px]"><span class="text-crimson font-extrabold shrink-0" aria-hidden="true">5</span><span><strong class="text-navy">Background.</strong> A criminal background check is run for every adult applicant, and the result is assessed individually. <span class="text-crimson font-semibold">[SOURCE NEEDED: the written criminal screening standard, including lookback period and the individualized assessment process]</span></span></li>
      </ul>
      <p class="text-[15px] text-muted mt-6">
        The full standard is on the
        {' '}<a href="/residents/application-criteria/" class="text-crimson font-semibold no-underline hover:underline">application criteria</a> page.
      </p>
    </div>
  </section>

  <!-- COST TO APPLY -->
  <section class="band band-wash" aria-labelledby="cost-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Money up front</span>
      <h2 id="cost-h" class="text-[clamp(28px,3.3vw,40px)]">What does it cost to apply, and what is due at move-in?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Money moves twice: the application fee when you submit, and move-in funds when you sign. Nothing is due in between.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Costs an applicant should expect, in order</caption>
          <thead>
            <tr class="bg-white">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">When</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">What</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Amount</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium align-top">When you submit</th>
              <td class="p-3.5 border border-line align-top text-muted">Application fee, which pays for the screening reports</td>
              <td class="p-3.5 border border-line align-top text-crimson font-semibold">[SOURCE NEEDED: application fee, and whether it is per adult or per household]</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium align-top">When you are approved</th>
              <td class="p-3.5 border border-line align-top text-muted">Security deposit</td>
              <td class="p-3.5 border border-line align-top text-crimson font-semibold">[SOURCE NEEDED: security deposit amount or formula, and the deadline to pay it after approval]</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium align-top">Before you get keys</th>
              <td class="p-3.5 border border-line align-top text-muted">First month of rent, prorated if you move mid-month</td>
              <td class="p-3.5 border border-line align-top text-muted">The rent shown on the listing</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium align-top">Monthly, if you have a pet</th>
              <td class="p-3.5 border border-line align-top text-muted">Pet administration fee, which funds pet damage coverage above the deposit</td>
              <td class="p-3.5 border border-line align-top text-crimson font-semibold">[SOURCE NEEDED: monthly pet administration fee amount]</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-[15px] text-muted mt-6">
        After move-in, rent is due on {rentPolicy.dueDate}. Most residents pay between
        {' '}{rentPolicy.practicalWindow}; late fees are assessed after {rentPolicy.lateFeesAfter}.
        {' '}{kpis.metrics.find((m) => m.id === 'collectedBy5')?.value} of rent is collected by the 5th.
      </p>
    </div>
  </section>

  <!-- PETS -->
  <section class="band" aria-labelledby="pets-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Pet friendly rentals</span>
      <h2 id="pets-h" class="text-[clamp(28px,3.3vw,40px)]">Can I have a pet?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        In many of our homes, yes. Each listing says so. The owner sets the pet policy per property, so we
        cannot override a "no pets" home for one applicant.
      </p>
      <p class="text-[16.5px] text-muted mt-4">
        An approved pet carries a monthly pet administration fee. It funds coverage of up to
        {' '}{usd(pricing.petDamageCoverage.cap)} in pet damage (beyond normal wear and tear) above the
        security deposit, which is why so many owners allow pets.
      </p>
      <div class="card mt-6">
        <h3 class="text-[18.5px] mb-2">Service animals and assistance animals are not pets</h3>
        <p class="text-[15.5px] text-muted m-0">
          A service animal or an assistance animal is not a pet under fair housing law. No pet
          administration fee applies, no pet deposit applies, and the {usd(pricing.petDamageCoverage.cap)}
          {' '}pet damage coverage described above does not apply to them either. Requests for a reasonable
          accommodation are handled separately from the pet policy and are reviewed the same way for every
          applicant.
        </p>
      </div>
      <p class="text-[15px] text-crimson font-semibold mt-5">
        [SOURCE NEEDED: monthly pet administration fee amount, pet deposit if any, and any limits on number,
        weight, species or breed]
      </p>
    </div>
  </section>

  <!-- RENTS -->
  <section class="band band-wash" aria-labelledby="rents-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">What things cost</span>
      <h2 id="rents-h" class="text-[clamp(28px,3.3vw,40px)]">What do homes rent for in the Columbus metro?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        From {usd(rentByBedroom['1'].median)} for a one bedroom to {usd(rentByBedroom['4'].median)} for a four
        bedroom (median). These are our own leases across {company.unitsManaged} homes, not a market estimate.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse bg-white text-[15.5px] rounded-[12px] overflow-hidden">
          <caption class="sr-only">Median rent by bedroom count across the RL Property Management portfolio</caption>
          <thead>
            <tr class="bg-white">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Bedrooms</th>
              <th scope="col" class="text-right p-3.5 border border-line font-semibold">Median rent</th>
              <th scope="col" class="text-right p-3.5 border border-line font-semibold">Units in the sample</th>
            </tr>
          </thead>
          <tbody>
            {bedroomRows.map((r) => (
              <tr>
                <th scope="row" class="text-left p-3.5 border border-line font-medium">{r.beds} bedroom</th>
                <td class="text-right p-3.5 border border-line tabular-nums font-semibold text-navy">{usd(r.median)}</td>
                <td class="text-right p-3.5 border border-line tabular-nums text-muted">{r.sample}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[15px] text-faint mt-5">
        Portfolio average: {kpis.metrics.find((m) => m.id === 'avgRent')?.value}, as of {kpis.asOfLabel}.
        Each listing shows that home's rent.
      </p>
    </div>
  </section>

  <!-- WHERE -->
  <section class="band" aria-labelledby="where-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Where we lease</span>
      <h2 id="where-h" class="text-[clamp(28px,3.3vw,40px)]">Where do you have rentals?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        {areas.length} communities across Franklin, Delaware, Fairfield, Licking, Union, Madison and Pickaway counties.
      </p>
      <div class="flex flex-wrap gap-x-5 gap-y-2 mt-6 text-[15.5px]">
        {linkedAreas.map((a) => (
          <a href={a.href} class="text-crimson no-underline hover:underline">{a.name}</a>
        ))}
        {namedAreas.map((a) => (
          <span class="text-muted">{a.name}</span>
        ))}
      </div>
      <p class="text-[15px] text-muted mt-6">
        Nothing open where you want? Tell us the area and bedroom count, and we will tell you what is coming up.
      </p>
    </div>
  </section>

  <!-- FAIR HOUSING -->
  <section class="band-tight" aria-labelledby="fh-h">
    <div class="wrap max-w-[880px]">
      <div class="card !border-2 !border-navy">
        <h2 id="fh-h" class="text-[21px] mb-3">Equal housing opportunity</h2>
        <p class="text-[15.5px] text-muted m-0">
          {company.name} is a licensed Ohio real estate brokerage and follows federal, Ohio and City of
          Columbus fair housing law. Every applicant is screened against the same written criteria, in the
          order applications are completed. We do not steer applicants toward or away from any home or any
          area. Applicants who need a reasonable accommodation or a reasonable modification because of a
          disability should tell us, and the request is handled separately from the screening decision.
        </p>
      </div>
    </div>
  </section>

  <section class="band band-wash">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Renter questions about our Columbus homes" id="homes-faq" />
      <div class="mt-8">
        <Verified date="2026-09-09" />
      </div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/residents/how-to-apply/', label: 'How to apply', note: 'The application, start to keys, and what to have ready.' },
    { href: '/residents/application-criteria/', label: 'Application criteria', note: 'The written standard every applicant is screened against.' },
    { href: '/residents/moving-in/', label: 'Moving in', note: 'Utilities, keys, and the condition report.' },
    { href: '/resident-faqs/', label: 'Resident FAQs', note: 'Rent, repairs, pets, renewals and move-out, answered.' },
    { href: '/residents/', label: 'Resident hub', note: 'Everything a current resident needs in one place.' },
  ]} />

  <Cta
    heading="Found one you like?"
    body="Applications are reviewed in the order they are completed. Check the criteria first, then apply, and have your income documents ready when you do."
    primary={{ label: 'Start an application', href: '/residents/how-to-apply/' }}
    secondary={{ label: 'See application criteria', href: '/residents/application-criteria/' }}
  />
</Base>
