---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, pricing, rentPolicy, typicalManager, usd } from '../../data/facts';
import { canPublishOwnRent } from '../../data/markets';
import { serviceNode } from '../../lib/schema';

/**
 * Lewis Center, Ohio. Target query: "property management lewis center ohio".
 *
 * The differentiating fact: Lewis Center is not a city. It is an unincorporated
 * community in Orange Township, Delaware County. There is no city hall, no
 * municipal code, no municipal income tax and no city rental registration,
 * because there is no city. Evictions go to Delaware Municipal Court and the
 * R.C. 5323.02 owner filing goes to the Delaware County Auditor at
 * 145 N. Union St. A national manager will treat this as a Columbus suburb and
 * get every one of those wrong.
 *
 * SOURCES (verified 2026-09-09):
 *  - Lewis Center is an unincorporated community in northwestern Orange
 *    Township, Delaware County, ZIP 43035, in the Columbus metropolitan area:
 *    en.wikipedia.org/wiki/Lewis_Center,_Ohio.
 *  - Orange Township, Delaware County: 22.8 square miles, population 37,452 at
 *    the 2020 census: en.wikipedia.org/wiki/Orange_Township,_Delaware_County,_Ohio.
 *  - Eviction jurisdiction follows the county under R.C. 1901.02. Delaware
 *    County goes to Delaware Municipal Court (docs/area-research-verified.md).
 *  - R.C. 5323.02 owner filing with the county auditor, penalty R.C. 5323.99,
 *    $50 to $150. The Delaware County Auditor runs its own registration at
 *    145 N. Union St., Delaware (docs/area-research-verified.md).
 *  - R.C. 1923.04 three-day notice to leave the premises.
 *  - Del-Co Water Company: member-owned non-profit cooperative water utility,
 *    Ohio EPA public water system PWS-2101412, roughly 44,000 customers across
 *    eight central Ohio counties, with the Timothy F. McNamara treatment plant
 *    in Lewis Center: delcowater.org/about.
 *  - Delaware County Regional Sewer District operates the Alum Creek Water
 *    Reclamation Facility in Lewis Center: co.delaware.oh.us and
 *    regionalsewer.co.delaware.oh.us.
 *  - Township zoning authority sits in R.C. Chapter 519, not in a municipal
 *    zoning code.
 *
 * NO qualifying entry in rentByMarketAndBedroom for Lewis Center, so no rent
 * median is published here at all. No door counts. No per-market days on market.
 */

const CITY = 'Lewis Center';
const PATH = '/property-management-lewis-center-ohio/';

const title = 'Lewis Center Property Management | RL Property Management';
const description =
  `Flat-fee property management for Lewis Center, Ohio rentals from ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} ` +
  `per unit per month with a ${usd(pricing.leasingFee)} leasing fee. Lewis Center is unincorporated Delaware County, so the rules differ from Columbus.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/areas-we-serve/' },
  { name: 'Lewis Center', path: PATH },
];

// Guard rail: if a future data refresh ever adds Lewis Center to
// rentByMarketAndBedroom, this page still must not quietly start publishing a
// figure without an editor deciding to. Assert the current state instead.
const publishesOwnRent = canPublishOwnRent(CITY);

const keyFacts = [
  `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, not a percentage of rent`,
  `${usd(pricing.leasingFee)} leasing fee every time a Lewis Center unit turns`,
  'Lewis Center is unincorporated Orange Township, Delaware County, not a city',
  'Evictions are filed at Delaware Municipal Court, not in Franklin County',
  'The R.C. 5323 owner filing goes to the Delaware County Auditor, 145 N. Union St.',
  'Drinking water comes from Del-Co Water, not the City of Columbus',
];

const faq = [
  { q: 'Is Lewis Center, Ohio a city?',
    a: 'No. Lewis Center (ZIP 43035) is an unincorporated community in northwestern Orange Township, Delaware County, with no mayor, council, municipal code or city hall. Orange Township zones land under R.C. Chapter 519, the Delaware County Sheriff polices it, and there is no municipal income tax.' },
  { q: 'What county is Lewis Center, Ohio in?',
    a: 'Delaware County, which sets the court, the auditor and the recorder for every Lewis Center rental. Franklin County does not apply, though owners coming from Columbus listings often assume it does.' },
  { q: 'Which court hears an eviction in Lewis Center, Ohio?',
    a: 'Delaware Municipal Court, because jurisdiction follows the county under R.C. 1901.02 and Lewis Center is entirely in Delaware County. Filing at Franklin County Municipal Court instead costs the fee and about three weeks.' },
  { q: 'Do I have to register a rental property in Lewis Center?',
    a: 'Yes, with the Delaware County Auditor (145 N. Union St., Delaware) under R.C. 5323.02: owner name, address, phone and parcel number, updated within 60 days of any change, no fee. Missing it draws a $50 to $150 special assessment under R.C. 5323.99, and as an unincorporated area there is no city registration on top.' },
  { q: 'Who provides water and sewer in Lewis Center, Ohio?',
    a: 'Water comes from Del-Co Water Company, a member-owned non-profit cooperative, and sewer from the Delaware County Regional Sewer District, which runs the Alum Creek Water Reclamation Facility in Lewis Center. Neither is Columbus, so the Columbus rule leaving owners liable for a resident water balance does not apply the same way.' },
  { q: 'Does an unincorporated address change how a lease works?',
    a: 'Not the lease. Ohio law (R.C. Chapter 5321, the R.C. 1923.04 three-day notice, the 30 day deposit return) applies exactly as in Columbus. What changes is municipal: township zoning, county code enforcement, the Sheriff, and no city license to renew.' },
  { q: 'What does a rental in Lewis Center rent for?',
    a: 'We do not publish a Lewis Center rent median, because our sample is below our five-unit threshold. Send the address and we will price it against live comparables and the units we manage nearby.' },
  { q: 'How much does property management cost in Lewis Center?',
    a: `A flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, a ${usd(pricing.leasingFee)} leasing fee and ${usd(pricing.leaseRenewalFee)} per renewal, so a higher-rent Olentangy-district house costs the same to manage as a modest one. Photography is billed separately at $250 to $450.` },
];

const schemaNodes = [
  {
    ...serviceNode({
      path: PATH,
      name: 'Residential property management in Lewis Center, Ohio',
      description,
    }),
    areaServed: {
      '@type': 'Place',
      name: 'Lewis Center, Ohio',
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Delaware County, Ohio' },
    },
  },
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="Where we work"
    title="Property management in Lewis Center, Ohio"
    answer={`${company.name} manages Lewis Center rentals for a flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month with a ${usd(pricing.leasingFee)} leasing fee. Lewis Center is unincorporated Delaware County, so evictions go to Delaware Municipal Court.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondaryCta={{ label: 'See the full fee schedule', href: '/pricing/' }}
  />

  <KeyFacts items={keyFacts} heading="Lewis Center, at a glance" />

  <!-- THE HOOK: there is no city. Everything downstream follows from this. -->
  <section class="band-tight" aria-labelledby="unincorporated-h">
    <div class="wrap max-w-[880px]">
      <h2 id="unincorporated-h" class="text-[clamp(26px,3.2vw,38px)]">Is Lewis Center a city, and why does that matter to a landlord?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        No. It is an unincorporated community in northwestern Orange Township, Delaware County (ZIP 43035), with
        no city hall, council or ordinances. That changes who you file with, who you call and who inspects.
      </p>
      <ul class="text-[17px] text-muted mt-4 list-disc pl-6 grid gap-1.5">
        <li>Orange Township covers about 22.8 square miles and had 37,452 residents in 2020, larger than several incorporated suburbs.</li>
        <li>Zoning is a township resolution under R.C. Chapter 519, not a municipal code.</li>
        <li>The Delaware County Sheriff handles law enforcement.</li>
        <li>A township cannot levy a municipal income tax, so residents pay none, one quiet reason it leases well.</li>
      </ul>
      <p class="text-[17.5px] text-muted mt-5">
        A common mistake: an out-of-state owner looks up Columbus rental rules, follows ones that do not apply
        and misses the one that does.
      </p>
    </div>
  </section>

  <!-- COURT -->
  <section class="band band-wash" aria-labelledby="court-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Evictions</span>
      <h2 id="court-h" class="text-[clamp(26px,3.2vw,38px)]">Which court hears an eviction in Lewis Center, Ohio?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Delaware Municipal Court, not Franklin County Municipal Court at 375 S. High St. in Columbus, the court
        most central Ohio eviction advice assumes. Ohio Revised Code 1901.02 ties jurisdiction to territory, and Lewis Center
        is wholly in Delaware County.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        The case starts with a three-day notice under R.C. 1923.04 in the statutory wording. Get the wording,
        service or day count wrong and it is dismissed, leaving you three weeks and another month of rent behind.
      </p>
      <div class="card mt-7">
        <h3 class="text-[19px] mt-0 mb-3">What an eviction costs an owner</h3>
        <ul class="grid gap-2 text-[15.5px] text-muted mb-0 list-none pl-0">
          <li><strong class="text-navy">{usd(pricing.eviction.attorneyFee)}</strong> to the eviction attorney, covering the filing and up to two appearances</li>
          <li><strong class="text-navy">{usd(pricing.eviction.countyFilingFee)}</strong> county filing fee for the eviction complaint</li>
          <li><strong class="text-navy">{usd(pricing.eviction.rlpmProcessFee)}</strong> to us to run the process end to end</li>
          <li><strong class="text-navy">{usd(pricing.eviction.typicalTotal)}</strong> typical total before any setout</li>
        </ul>
        <p class="text-[14px] text-faint mt-4 mb-0">
          The {usd(pricing.eviction.countyFilingFee)} figure is the Franklin County eviction complaint fee from
          our published schedule. A Delaware County parcel files at Delaware Municipal Court instead, and we confirm that court's current filing deposit at the time of filing rather than quoting a figure that may have moved.
        </p>
      </div>
      <p class="text-[16px] text-muted mt-6">
        Full procedure on the
        {' '}<a href="/services/evictions/" class="text-crimson font-semibold no-underline hover:underline">evictions page</a>.
      </p>
    </div>
  </section>

  <!-- REGISTRATION -->
  <section class="band-tight" aria-labelledby="reg-h">
    <div class="wrap max-w-[880px]">
      <h2 id="reg-h" class="text-[clamp(26px,3.2vw,38px)]">Do you have to register a Lewis Center rental property?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Yes, with the Delaware County Auditor only (145 N. Union St., Delaware). We file it as your designated
        agent at onboarding. Under R.C. 5323.02:
      </p>
      <ul class="text-[17px] text-muted mt-3 list-disc pl-6 grid gap-1.5">
        <li>File your name, address and phone, plus the property street address and permanent parcel number.</li>
        <li>No fee. Update within 60 days of any change.</li>
        <li>Skip it and the auditor can assess $50 to $150 under R.C. 5323.99.</li>
        <li>An LLC or trust must name its responsible officer, member or trustee, the step owners miss most.</li>
      </ul>
      <p class="text-[17.5px] text-muted mt-5">
        Unincorporated means no city rental license, inspection cycle or registration fee on top. Count that when
        comparing houses ten minutes apart.
      </p>
    </div>
  </section>

  <!-- UTILITIES -->
  <section class="band band-wash" aria-labelledby="util-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Utilities</span>
      <h2 id="util-h" class="text-[clamp(26px,3.2vw,38px)]">Who provides water, sewer and power in Lewis Center?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Not Columbus. Water is Del-Co Water Company, a member-owned non-profit cooperative serving roughly 44,000
        customers across eight central Ohio counties, whose oldest treatment plant is in Lewis Center. Sewer in
        developed Orange Township is the Delaware County Regional Sewer District, which runs the Alum Creek
        Water Reclamation Facility, also here.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Utility providers for Lewis Center, Ohio rental property</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Service</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Provider</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Who customarily pays</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Water</th>
              <td class="p-3.5 border border-line text-navy font-semibold">Del-Co Water Company</td>
              <td class="p-3.5 border border-line text-muted">Resident, in their own name, on our standard lease</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Sanitary sewer</th>
              <td class="p-3.5 border border-line text-navy font-semibold">Delaware County Regional Sewer District</td>
              <td class="p-3.5 border border-line text-muted">Resident, where the property is on public sewer</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Natural gas</th>
              <td class="p-3.5 border border-line text-navy font-semibold">Columbia Gas of Ohio</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Electricity</th>
              <td class="p-3.5 border border-line text-navy font-semibold">Confirm per address</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-[16px] text-muted mt-6">
        Before you buy, check the sewer. Older parcels on the rural edges may run private septic (regulated in
        Ohio as a household sewage treatment system), which is a capital item, not a repair line.
      </p>
    </div>
  </section>

  <!-- MARKET AND PRICING -->
  <section class="band-tight" aria-labelledby="market-h">
    <div class="wrap max-w-[880px]">
      <h2 id="market-h" class="text-[clamp(26px,3.2vw,38px)]">What kind of rental property is in Lewis Center, and what does management cost?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Overwhelmingly detached houses in subdivisions built from the 1990s on along the Olentangy corridor
        between Powell and Westerville, mostly three and four bedrooms. The Olentangy Local School District
        draws relocating families, so tenancies run long.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        {publishesOwnRent
          ? 'Our portfolio sample in Lewis Center now supports a published median. Update this page before relying on it.'
          : 'We do not publish a Lewis Center rent median yet: our sample is below our five-unit floor.'}
        {' '}Send an address and we will price it against live comparables.
      </p>
      <div class="grid gap-5 sm:grid-cols-3 mt-8">
        {pricing.plans.map((p) => (
          <div class="card text-center">
            <div class="font-sans text-[12px] font-bold tracking-[.13em] uppercase text-faint mb-2">{p.name}</div>
            <div class="font-sans text-[42px] font-extrabold tracking-[-.045em] text-navy leading-none">{usd(p.monthly)}</div>
            <div class="font-sans text-[13px] text-faint mt-2">per unit, per month</div>
            <p class="text-[14.5px] text-muted mt-4 mb-0">{usd(p.repairApprovalLimit)} per-item repair approval limit</p>
          </div>
        ))}
      </div>
      <p class="text-[16.5px] text-muted mt-7">
        On a {usd(2000)} rent, a 10% manager collects {usd(2400)} a year plus about {usd(typicalManager.leasingFee(2000))}, {typicalManager.leasingFeePhrase}, at each turn.
        Our middle plan is {usd(pricing.plans[1].monthly * 12)} a year with a {usd(pricing.leasingFee)} placement.
        Percentage figures describe common Columbus market rates, not a quote from any named company.
        Photography is billed separately at $250 to $450.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/pricing/" class="btn btn-navy">See every fee we charge</a>
        <a href="/free-rent-evaluation/" class="btn btn-ghost">Price my Lewis Center rental</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band band-wash" aria-labelledby="faq-section">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <h2 id="faq-section" class="sr-only">Lewis Center property management questions</h2>
      <Faq items={faq} heading="Lewis Center property management questions" id="lewis-center-faq" />
      <p class="mt-7 text-[15.5px] text-muted">
        Rent is due on {rentPolicy.dueDate}. Late fees apply after {rentPolicy.lateFeesAfter}. Owner funds go out
        on the {rentPolicy.ownerDisbursementDay}th. See also the
        {' '}<a href="/owner-faqs/" class="text-crimson font-semibold no-underline hover:underline">owner FAQs page</a>.
      </p>
      <div class="mt-6"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/property-management-powell-ohio/', label: 'Powell property management', note: 'West across the Olentangy, incorporated, same county and same court.' },
    { href: '/property-management-westerville-ohio/', label: 'Westerville property management', note: 'Southeast, and the one central Ohio suburb with its own electric utility.' },
    { href: '/property-management-worthington-ohio/', label: 'Worthington property management', note: 'South, older housing stock and a Franklin County court.' },
    { href: '/property-management-dublin-ohio/', label: 'Dublin property management', note: 'Southwest, and split across three counties.' },
    { href: '/pricing/', label: 'Pricing and the full fee schedule', note: 'Every charge that can appear on an owner statement.' },
  ]} heading="Nearby markets and what to read next" />

  <Cta
    heading="Find out what your Lewis Center rental should earn"
    body="Send the address and we will price it against live listings and the units we manage nearby in Delaware County. Free."
    primary={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondary={{ label: 'Get a portfolio quote', href: '/property-management-consultation/' }}
  />
</Base>
