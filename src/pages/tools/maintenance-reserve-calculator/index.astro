<script>
  import { calculateReserve, resultText, type ReserveInputs, type ReserveRates } from '../../../lib/calculators/maintenanceReserve';

  const form = document.getElementById('mr-calc') as HTMLFormElement | null;
  const fields = form?.querySelector<HTMLFieldSetElement>('[data-mr-fields]');

  if (form && fields && form.dataset.rates) {
    const rates = JSON.parse(form.dataset.rates) as ReserveRates;
    /** Items come from the rendered rows, so the page markup stays the single list. */
    const itemIds = Array.from(form.querySelectorAll<HTMLInputElement>('input[name$="-cost"]'))
      .map((el) => el.name.replace(/-cost$/, ''));
    const labels = new Map(itemIds.map((id) => [id, form.querySelector(`#mr-${id}-cost`)
      ?.closest('fieldset')?.querySelector('legend')?.textContent?.trim() ?? id]));

    /** A blank field reads as NaN, which the calculator treats as 0 (units as 1). */
    const val = (name: string) => {
      const el = form.elements.namedItem(name) as HTMLInputElement | null;
      return el && el.value.trim() !== '' ? Number(el.value) : NaN;
    };

    const read = (): ReserveInputs => ({
      units: val('units'),
      rent: val('rent'),
      monthsOfRent: val('months'),
      repairHours: val('hours'),
      repairsCovered: val('repairs'),
      items: itemIds.map((id) => ({
        id, label: labels.get(id) ?? id,
        cost: val(`${id}-cost`), age: val(`${id}-age`), life: val(`${id}-life`),
      })),
    });

    let last = '';
    const update = () => {
      const input = read();
      const text = resultText(input, calculateReserve(input, rates));
      for (const [key, value] of Object.entries(text)) {
        if (key === 'summary') continue;
        const el = document.getElementById(`mr-${key}`);
        if (el && el.textContent !== value) el.textContent = value;
      }
      // Announce only when the headline changes, so screen readers are not flooded.
      if (text.summary !== last) {
        last = text.summary;
        const live = document.getElementById('mr-summary');
        if (live) live.textContent = text.summary;
      }
    };

    fields.disabled = false;
    form.addEventListener('input', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    // Reset restores the HTML default values after the event, so recompute on the next tick.
    form.addEventListener('reset', () => setTimeout(update, 0));
    update();
  }
</script>
