---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import Faq from '../../../components/Faq.astro';
import Verified from '../../../components/Verified.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import Cta from '../../../components/Cta.astro';
import { company, pricing, kpis, usd } from '../../../data/facts';
import { rentByBedroom } from '../../../data/markets';
import {
  calculateReserve, defaultInputs, resultText, DEFAULT_MONTHS_OF_RENT,
  type ReserveRates,
} from '../../../lib/calculators/maintenanceReserve';

/**
 * Target: "maintenance reserve calculator", "how much to save per unit for
 * repairs", "rental property repair reserve".
 *
 * An interactive calculator, and a sanctioned exception to the site's zero
 * JavaScript rule (Andrew, 2026-11-05: every calculator fully interactive at
 * launch). The arithmetic lives in src/lib/calculators/maintenanceReserve.ts and
 * is tested by scripts/test-calculators/maintenance-reserve.mjs. The same
 * function runs here in the frontmatter, so the example result is in the HTML
 * and the page still reads as a complete answer with JavaScript off. The inputs
 * stay locked (disabled fieldset) until the script runs.
 *
 * RLPM rates come from src/data/facts.ts and reach the script through the
 * form's data-rates attribute. Every other default (six months of rent, the
 * example replacement costs and expected lives) is an editable assumption drawn
 * from RLPM's own blog posts and labeled that way on the page; the sources are
 * noted in the module.
 *
 * Every repair figure in the worked examples is computed from the published
 * labor and vendor rates in src/data/facts.ts, so the page teaches the
 * arithmetic using prices a reader can verify against our fee schedule.
 *
 * NOTHING here states a typical annual repair spend. That number is not in the
 * fact bank. The example expected lives are the worked example from
 * /blog/planning-property-improvements-columbus-ohio/, presented as editable
 * example inputs, not as published lifespans.
 */

const kpi = (id: string) => kpis.metrics.find((m) => m.id === id)?.value ?? '';

const m = pricing.maintenance;
const RESERVE_MIN = pricing.reserves.min;
const RESERVE_MAX = pricing.reserves.max;

/** A repair priced at our published rates, at each of the three time bands. */
const REPAIR_HOURS = 2;
const labor = (mult: number) => m.inHouseHourly * mult * REPAIR_HOURS + m.tripCharge;
const repairBands = [
  { when: 'Weekday, normal hours', mult: 1, total: labor(1),
    note: `${usd(m.inHouseHourly)} per hour times ${REPAIR_HOURS} hours, plus the ${usd(m.tripCharge)} trip charge.` },
  { when: 'Weekday evening or Saturday', mult: pricing.afterHours.weekdayEveningAndSaturday, total: labor(pricing.afterHours.weekdayEveningAndSaturday),
    note: `Labor at ${pricing.afterHours.weekdayEveningAndSaturday}x, trip charge unchanged.` },
  { when: 'Sunday', mult: pricing.afterHours.sunday, total: labor(pricing.afterHours.sunday),
    note: `Labor at ${pricing.afterHours.sunday}x, trip charge unchanged.` },
];
const repairNormal = repairBands[0].total;
const repairSunday = repairBands[2].total;

/** Vendor work. The project management fee is 15% of vendor cost up to $3,000, capped at $450. */
const vendorFee = (cost: number) =>
  Math.min(Math.round(Math.min(cost, m.vendorProjectFeeAppliesUpTo) * (m.vendorProjectFeePct / 100)), m.vendorProjectFeeCap);
const vendorJobs = [1000, 2500, m.vendorProjectFeeAppliesUpTo, 6000].map((c) => ({
  cost: c, fee: vendorFee(c), total: c + vendorFee(c),
}));

/** Turn work is tiered separately. */
const turnPct = (cost: number) => {
  for (const t of m.turnTiers) if (t.upTo === null || cost <= t.upTo) return t.pct;
  return m.turnTiers[m.turnTiers.length - 1].pct;
};
const turnJobs = [8000, 20000, 30000].map((c) => ({
  cost: c, pct: turnPct(c), fee: Math.round(c * (turnPct(c) / 100)), total: c + Math.round(c * (turnPct(c) / 100)),
}));

/** What a reserve level actually buys, and what it costs to rebuild over a year. */
const reserveLevels = [RESERVE_MIN, RESERVE_MAX].map((r) => ({
  amount: r,
  normalRepairs: Math.floor(r / repairNormal),
  sundayRepairs: Math.floor(r / repairSunday),
  monthlyRebuild: Math.round(r / 12),
  /** The reserve expressed against a month of median 3 bed rent. */
  vsRent: ((r / rentByBedroom['3'].median) * 100).toFixed(0),
}));

/** Portfolio-level sizing: what a reserve costs across a small portfolio. */
const portfolioSizes = [1, 5, 10, 25];

/* ---------- The calculator ---------- */

/** RLPM facts the calculator needs, all from facts.ts. */
const rates: ReserveRates = {
  hourly: m.inHouseHourly,
  tripCharge: m.tripCharge,
  accountReserveMin: RESERVE_MIN,
  accountReserveMax: RESERVE_MAX,
};
/** Example rent: the portfolio median for a 3 bed, from markets.ts. */
const exampleRent = rentByBedroom['3'].median;
const ex = defaultInputs(exampleRent);
const exResult = calculateReserve(ex, rates);
const t = resultText(ex, exResult);

const labelCls = 'block font-sans text-[13px] font-semibold text-muted mb-1.5';
const inputCls = 'w-full px-3.5 py-3 border border-line rounded-lg bg-white text-[16px] tabular-nums disabled:bg-wash-soft disabled:text-muted';
const hintCls = 'text-[13px] text-faint mt-1.5 mb-0';

const title = 'Maintenance Reserve Calculator for Rental Units | RL Property Management';
const description =
  `How much to hold per unit for repairs, worked out at published Columbus rates. ${company.name} requires ` +
  `${usd(RESERVE_MIN)} to ${usd(RESERVE_MAX)} per unit depending on plan, and a ${REPAIR_HOURS}-hour in-house ` +
  `repair runs ${usd(repairNormal)} on a weekday.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Tools', path: '/tools/' },
  { name: 'Maintenance reserve calculator', path: '/tools/maintenance-reserve-calculator/' },
];

const answer =
  `${company.name} holds ${usd(RESERVE_MIN)} to ${usd(RESERVE_MAX)} per unit on your account, by plan. ` +
  `Behind that, keep at least ${DEFAULT_MONTHS_OF_RENT} months of rent per unit in your own reserve, plus a ` +
  `monthly set-aside for the roof, HVAC and other big items.`;

const facts = [
  `${company.shortName} holds a reserve of ${usd(RESERVE_MIN)} to ${usd(RESERVE_MAX)} per unit, by plan`,
  'The reserve stays your money and is returned when management ends',
  `Our starting point for your own cash reserve is ${DEFAULT_MONTHS_OF_RENT} months of rent per unit`,
  `In-house labor is ${usd(m.inHouseHourly)} per hour plus a ${usd(m.tripCharge)} trip charge, ${m.rateYear} rate`,
  `No minimum charge on maintenance work, and materials are provided at cost`,
  `A ${REPAIR_HOURS}-hour repair runs ${usd(repairNormal)} on a weekday and ${usd(repairSunday)} on a Sunday`,
  `Vendor project management is ${m.vendorProjectFeePct}% of vendor cost up to ${usd(m.vendorProjectFeeAppliesUpTo)}, capped at ${usd(m.vendorProjectFeeCap)}`,
  `Median ${kpi('repairDays')} days to close a repair across the portfolio`,
];

const faq = [
  { q: 'How much should I hold in reserve per rental unit?',
    a: `Our starting point is at least ${DEFAULT_MONTHS_OF_RENT} months of rent per unit in your own reserve, plus a monthly set-aside for the big items. Separately, ${company.name} holds ${usd(RESERVE_MIN)} to ${usd(RESERVE_MAX)} per unit on your account, depending on the plan, so routine repairs do not wait on funding. At our rates, a ${usd(RESERVE_MAX)} account reserve covers about ${reserveLevels[1].normalRepairs} weekday ${REPAIR_HOURS}-hour repairs.` },
  { q: 'How does this calculator work?',
    a: `It adds ${DEFAULT_MONTHS_OF_RENT} months of rent (or the months you choose) to the cost of anything already past its expected life. That is the reserve. The monthly set-aside is each big item's replacement cost divided by the months it has left, plus a twelfth of a two-repair float at our ${usd(m.inHouseHourly)} hourly rate. Everything runs in your browser and nothing is sent anywhere.` },
  { q: 'Is six months of rent per unit too much?',
    a: 'It is a starting point, not a ceiling or a rule. Owners with several units can often hold less per unit, because it is unlikely every unit needs a major repair at the same time. A high turnover rate or older systems argue for holding more.' },
  { q: 'Why does a property manager hold a maintenance reserve?',
    a: `So a repair can be authorized and completed the same day instead of waiting on a transfer. The money stays yours: it sits on your account, it is spent only on your property, and it is returned when management ends. Median time to close a repair across our portfolio is ${kpi('repairDays')} days.` },
  { q: 'What does a repair actually cost?',
    a: `In-house labor is ${usd(m.inHouseHourly)} per hour at the ${m.rateYear} rate, plus a ${usd(m.tripCharge)} trip charge per visit, with materials at cost and no minimum charge. After hours, labor is ${pricing.afterHours.weekdayEveningAndSaturday}x on weekday evenings and Saturdays and ${pricing.afterHours.sunday}x on Sundays, so a ${REPAIR_HOURS}-hour job is ${usd(repairNormal)} on a Tuesday morning and ${usd(repairSunday)} on a Sunday.` },
  { q: 'How is vendor work billed?',
    a: `At vendor cost plus a project management fee of ${m.vendorProjectFeePct}% of vendor cost, applied to costs up to ${usd(m.vendorProjectFeeAppliesUpTo)} and capped at ${usd(m.vendorProjectFeeCap)} per project. A ${usd(vendorJobs[0].cost)} job carries ${usd(vendorJobs[0].fee)}; a ${usd(vendorJobs[3].cost)} job carries ${usd(vendorJobs[3].fee)}, because the cap has been reached. It is waived on insurance claim work.` },
  { q: 'What is the difference between a reserve and a capital budget?',
    a: 'The reserve is cash for the repairs that happen this month. A capital budget is a monthly set-aside for the items that fail once a decade: roof, furnace, water heater, service panel, sewer line. Size them separately and never spend one on the other.' },
  { q: 'How do I set a capital budget without guessing?',
    a: 'For each major item, get a real replacement quote, estimate the years it has left, and divide the quote by the months remaining. Sum across items and that is your monthly set-aside. Your own quotes and inspection make the number defensible.' },
  { q: 'What does it cost to rebuild the reserve after a big repair?',
    a: `Spread over twelve months, ${usd(RESERVE_MIN)} is ${usd(reserveLevels[0].monthlyRebuild)} a month and ${usd(RESERVE_MAX)} is ${usd(reserveLevels[1].monthlyRebuild)} a month. Most owners top the reserve back up out of the monthly disbursement, which is the mechanic we default to.` },
  { q: 'What about turn costs?',
    a: `Turns are billed on their own tiered schedule: ${m.turnTiers[0].pct}% on turns up to ${usd(m.turnTiers[0].upTo as number)}, ${m.turnTiers[1].pct}% from there to ${usd(m.turnTiers[1].upTo as number)}, and ${m.turnTiers[2].pct}% above that. A turn is a planned event, so budget it against the vacancy rather than the working reserve.` },
  { q: 'Does the reserve cover pet damage?',
    a: `It does not need to, up to a point. If an approved pet causes damage beyond normal wear and tear and the cost exceeds the security deposit, we cover the difference up to ${usd(pricing.petDamageCoverage.cap)}. That coverage is funded by a monthly pet administration fee and does not apply to service or assistance animals, because those are not pets.` },
];
---
<Base {title} {description} {faq} {breadcrumbs}>

  <PageHero
    eyebrow="Free calculator, no sign-up"
    title="How much should you hold in reserve per rental unit?"
    answer={answer}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Run your numbers', href: '#calculator' }}
    secondaryCta={{ label: 'See pricing', href: '/pricing/' }}
  />

  <!-- THE CALCULATOR -->
  <section id="calculator" class="pb-14 scroll-mt-24" aria-labelledby="calc-h">
    <div class="wrap max-w-[1080px]">
      <form id="mr-calc" class="card !p-0 overflow-hidden" novalidate data-rates={JSON.stringify(rates)}>
        <div class="grid lg:grid-cols-[minmax(0,1fr)_400px]">

          <!-- INPUTS -->
          <div class="p-6 sm:p-8">
            <h2 id="calc-h" class="text-[24px] mb-1">Run your own numbers</h2>
            <p class="text-[15px] text-muted mb-1">Change any number and the result updates. Nothing is sent anywhere.</p>
            <noscript>
              <p class="text-[14.5px] text-crimson mt-3 mb-0">
                JavaScript is off, so the inputs are locked and the result shows the example. The method is written
                out below the calculator.
              </p>
            </noscript>

            <fieldset class="mt-6" disabled data-mr-fields>
              <legend class="sr-only">Calculator inputs</legend>

              <fieldset>
                <legend class="font-sans text-[16px] font-bold text-navy mb-3">Your property</legend>
                <div class="grid gap-5 sm:grid-cols-3">
                  <div>
                    <label for="mr-units" class={labelCls}>Number of units</label>
                    <input id="mr-units" name="units" type="number" inputmode="numeric" min="1" step="1" value={ex.units} class={inputCls} />
                  </div>
                  <div>
                    <label for="mr-rent" class={labelCls}>Monthly rent per unit ($)</label>
                    <input id="mr-rent" name="rent" type="number" inputmode="decimal" min="0" step="25" value={ex.rent}
                           aria-describedby="mr-rent-hint" class={inputCls} />
                    <p id="mr-rent-hint" class={hintCls}>
                      Example: {usd(exampleRent)}, the median 3 bed rent across the homes we manage.
                    </p>
                  </div>
                  <div>
                    <label for="mr-months" class={labelCls}>Months of rent to hold</label>
                    <input id="mr-months" name="months" type="number" inputmode="decimal" min="0" step="0.5" value={ex.monthsOfRent}
                           aria-describedby="mr-months-hint" class={inputCls} />
                    <p id="mr-months-hint" class={hintCls}>
                      {DEFAULT_MONTHS_OF_RENT} is our{' '}
                      <a href="/blog/how-much-money-should-you-hold-in-reserve-for-each-rental-unit/" class="text-crimson underline underline-offset-2">published starting point</a>.
                      Owners of several units can often hold less.
                    </p>
                  </div>
                </div>
              </fieldset>

              <fieldset class="mt-8">
                <legend class="font-sans text-[16px] font-bold text-navy mb-1">Big items, for one unit</legend>
                <p id="mr-items-hint" class="text-[13px] text-faint mt-0 mb-4">
                  Example assumptions from our{' '}
                  <a href="/blog/planning-property-improvements-columbus-ohio/" class="text-crimson underline underline-offset-2">post on planning improvements</a>,
                  with every age set to new. Replace them with your own quotes and inspection report. A cost of 0 leaves
                  an item out. For a shared roof, enter one unit's share.
                </p>
                <div class="grid gap-4">
                  {ex.items.map((it) => (
                    <fieldset class="rounded-[12px] border border-line bg-wash-soft p-3.5 sm:p-4">
                      <legend class="sr-only">{it.label}</legend>
                      <p class="font-sans text-[14.5px] font-semibold text-navy m-0 mb-2" aria-hidden="true">{it.label}</p>
                      <div class="grid gap-3 grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1fr)]">
                        <div>
                          <label for={`mr-${it.id}-cost`} class={labelCls}>Cost ($)</label>
                          <input id={`mr-${it.id}-cost`} name={`${it.id}-cost`} type="number" inputmode="decimal" min="0" step="100"
                                 value={it.cost} aria-describedby="mr-items-hint" class={inputCls} />
                        </div>
                        <div>
                          <label for={`mr-${it.id}-age`} class={labelCls}>Age (yrs)</label>
                          <input id={`mr-${it.id}-age`} name={`${it.id}-age`} type="number" inputmode="decimal" min="0" step="1"
                                 value={it.age} class={inputCls} />
                        </div>
                        <div>
                          <label for={`mr-${it.id}-life`} class={labelCls}>Life (yrs)</label>
                          <input id={`mr-${it.id}-life`} name={`${it.id}-life`} type="number" inputmode="decimal" min="0" step="1"
                                 value={it.life} class={inputCls} />
                        </div>
                      </div>
                    </fieldset>
                  ))}
                </div>
              </fieldset>

              <fieldset class="mt-8">
                <legend class="font-sans text-[16px] font-bold text-navy mb-3">Routine repairs</legend>
                <div class="grid gap-5 grid-cols-2">
                  <div>
                    <label for="mr-hours" class={labelCls}>Hours per repair</label>
                    <input id="mr-hours" name="hours" type="number" inputmode="decimal" min="0" step="0.5" value={ex.repairHours}
                           aria-describedby="mr-repair-hint" class={inputCls} />
                  </div>
                  <div>
                    <label for="mr-repairs" class={labelCls}>Repairs to cover</label>
                    <input id="mr-repairs" name="repairs" type="number" inputmode="numeric" min="0" step="1" value={ex.repairsCovered}
                           aria-describedby="mr-repair-hint" class={inputCls} />
                  </div>
                </div>
                <p id="mr-repair-hint" class={hintCls}>
                  Priced at our {m.rateYear} rate: {usd(m.inHouseHourly)} an hour plus a {usd(m.tripCharge)} trip charge, before materials.
                </p>
              </fieldset>

              <button type="reset" class="btn btn-ghost mt-7 !text-[14px] !py-2.5">Reset to the example</button>
            </fieldset>
          </div>

          <!-- RESULTS -->
          <div class="bg-navy text-white p-6 sm:p-8">
            <div class="lg:sticky lg:top-24">
              <span class="eyebrow !text-[#f0b9c4]">Your result</span>
              <p id="mr-summary" class="sr-only" aria-live="polite" aria-atomic="true">{t['summary']}</p>

              <p class="font-sans text-[14px] font-semibold text-[#c9d6df] m-0">Hold in reserve</p>
              <p id="mr-reserve" class="font-sans text-[44px] font-extrabold tracking-[-.04em] leading-none mt-1 mb-1 tabular-nums">{t['reserve']}</p>
              <p id="mr-reserve-sub" class="text-[14px] text-[#c9d6df] m-0">{t['reserve-sub']}</p>

              <p class="font-sans text-[14px] font-semibold text-[#c9d6df] mt-6 mb-0">Set aside each month</p>
              <p id="mr-monthly" class="font-sans text-[44px] font-extrabold tracking-[-.04em] leading-none mt-1 mb-1 tabular-nums">{t['monthly']}</p>
              <p id="mr-monthly-sub" class="text-[14px] text-[#c9d6df] m-0">{t['monthly-sub']}</p>

              <h3 class="!text-white text-[18px] mt-8 mb-3">How it adds up</h3>
              <dl class="grid gap-3 text-[14.5px] m-0">
                <div class="flex justify-between gap-4 border-t border-white/15 pt-3">
                  <dt>Cash reserve<span id="mr-cash-note" class="block text-[13px] text-[#c9d6df]">{t['cash-note']}</span></dt>
                  <dd id="mr-cash" class="m-0 font-semibold tabular-nums text-right whitespace-nowrap">{t['cash']}</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-white/15 pt-3">
                  <dt>Plus items due now<span id="mr-due-note" class="block text-[13px] text-[#c9d6df]">{t['due-note']}</span></dt>
                  <dd id="mr-due" class="m-0 font-semibold tabular-nums text-right whitespace-nowrap">{t['due']}</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-white/15 pt-3">
                  <dt>Big-item set-aside<span class="block text-[13px] text-[#c9d6df]">Each cost over the months it has left</span></dt>
                  <dd id="mr-capital" class="m-0 font-semibold tabular-nums text-right whitespace-nowrap">{t['capital']}</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-white/15 pt-3">
                  <dt>Repair float refill<span id="mr-refill-note" class="block text-[13px] text-[#c9d6df]">{t['refill-note']}</span></dt>
                  <dd id="mr-refill" class="m-0 font-semibold tabular-nums text-right whitespace-nowrap">{t['refill']}</dd>
                </div>
              </dl>

              <div class="scroll-x mt-5">
                <table class="w-full border-collapse text-[13.5px]">
                  <caption class="sr-only">Monthly set-aside by item, for all units</caption>
                  <thead>
                    <tr class="text-[#c9d6df]">
                      <th scope="col" class="text-left font-semibold pb-1.5">Item</th>
                      <th scope="col" class="text-left font-semibold pb-1.5">Life left</th>
                      <th scope="col" class="text-right font-semibold pb-1.5">Set aside</th>
                    </tr>
                  </thead>
                  <tbody>
                    {ex.items.map((it) => (
                      <tr class="border-t border-white/10">
                        <th scope="row" class="text-left font-medium py-1.5">{it.label}</th>
                        <td id={`mr-item-${it.id}-left`} class="py-1.5 tabular-nums">{t[`item-${it.id}-left`]}</td>
                        <td id={`mr-item-${it.id}-monthly`} class="py-1.5 tabular-nums text-right">{t[`item-${it.id}-monthly`]}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <p id="mr-check" class="text-[14px] mt-5 mb-0 rounded-[10px] bg-white/10 p-3">{t['check']}</p>
              <p class="text-[13.5px] text-[#c9d6df] mt-4 mb-0">
                With {company.shortName}, <span id="mr-account" class="text-white font-semibold">{t['account']}</span> of
                this sits on your account as the maintenance reserve, set by plan. It is still your money.
              </p>

              <div class="flex flex-wrap gap-3 mt-6">
                <a href="/property-management-consultation/" class="btn btn-on-dark">Book a free consultation</a>
                <a href="/pricing/" class="btn btn-outline-light">See pricing</a>
              </div>
            </div>
          </div>
        </div>
      </form>
      <p class="text-[13px] text-faint mt-4">
        A planning estimate, not a quote. It assumes you start saving for each item today, so subtract anything you
        have already set aside for it.
      </p>
    </div>
  </section>

  <KeyFacts items={facts} />

  <!-- THREE DIFFERENT NUMBERS -->
  <section class="band" aria-labelledby="two-h">
    <div class="wrap max-w-[940px]">
      <span class="eyebrow">Get this right first</span>
      <h2 id="two-h" class="text-[clamp(28px,3.3vw,40px)]">What is a maintenance reserve, and what is it not?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        A maintenance reserve is cash held so a repair can be approved without a funding request. It is not a
        capital budget. Confuse the two and you have a healthy float and no plan for the furnace.
      </p>
      <div class="grid gap-5 md:grid-cols-3 mt-8">
        <div class="card">
          <h3 class="text-[19.5px] mb-2">The account reserve</h3>
          <p class="text-[15.5px] text-muted m-0">
            {usd(RESERVE_MIN)} to {usd(RESERVE_MAX)} per unit on your {company.shortName} account, by plan. It
            covers this month's repairs and is returned when management ends.
          </p>
        </div>
        <div class="card">
          <h3 class="text-[19.5px] mb-2">Your cash reserve</h3>
          <p class="text-[15.5px] text-muted m-0">
            Money you hold for the failure that cannot wait. Our starting point is {DEFAULT_MONTHS_OF_RENT} months
            of rent per unit.
          </p>
        </div>
        <div class="card">
          <h3 class="text-[19.5px] mb-2">The capital budget</h3>
          <p class="text-[15.5px] text-muted m-0">
            A monthly set-aside for items that fail once a decade: roof, furnace, water heater, service panel,
            sewer line. Size it from real quotes on your property.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE FORMULA -->
  <section class="band band-wash" aria-labelledby="formula-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The formula</span>
      <h2 id="formula-h" class="text-[clamp(28px,3.3vw,40px)]">How do you calculate a maintenance reserve?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Four lines, the same ones the calculator runs. On our plans the repair approval limit
        ({pricing.plans.map((p, i) => <span>{i > 0 ? ', ' : ''}{p.name} {usd(p.repairApprovalLimit)}</span>)})
