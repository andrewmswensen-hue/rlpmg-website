---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import Faq from '../../../components/Faq.astro';
import Verified from '../../../components/Verified.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import Cta from '../../../components/Cta.astro';
import { company, pricing, kpis, usd } from '../../../data/facts';
import { rentByBedroom } from '../../../data/markets';
import { DAYS_IN_MONTH, lostRent, vacancyCost, compareManagers } from '../../../lib/calculators/vacancyCost';

/**
 * Target: "vacancy cost calculator", "how much does vacancy cost", "cost of a
 * vacant rental property".
 *
 * An interactive calculator on top of a worked-example page. This page is a
 * sanctioned exception to the site's zero-JavaScript rule (Andrew, 2026-11-05:
 * every calculator fully interactive at launch). Progressive enhancement:
 *   - The formula lives in src/lib/calculators/vacancyCost.ts, tested by
 *     scripts/test-calculators/vacancy-cost.mjs.
 *   - The frontmatter runs that same module to render the default result into
 *     the HTML, so with JavaScript off the calculator reads as one more worked
 *     example and every table below is unchanged.
 *   - The processed <script> at the bottom recomputes as the owner types. No
 *     network calls, no tracking, no storage, no email gate.
 * Every rent point comes from the portfolio medians in src/data/markets.ts and
 * every day count from the KPIs in facts.ts. RLPM's numbers reach the script
 * through data attributes on the form, never typed into the script.
 */

const kpi = (id: string) => kpis.metrics.find((m) => m.id === id)?.value ?? '';

/** The formula. Daily cost of an empty unit is monthly rent divided by 30 (see the lib). */
const daily = (rent: number) => Math.round(rent / DAYS_IN_MONTH);
const cost = (rent: number, days: number) => Math.round(lostRent(rent, days));

/** Published KPI day counts, parsed so the page cannot drift from the scorecard. */
const domDays = Number(kpi('dom'));
const turnDays = Number(kpi('turn'));
const cycleDays = domDays + turnDays;

/** A $50 monthly rent reduction, used to price the hold-out-for-more-rent decision. */
const RENT_CUT = 50;

/** Portfolio median rent by bedroom count. Publishable, sample sizes are in the data. */
const beds = Object.entries(rentByBedroom).map(([b, v]) => ({
  bed: b,
  rent: v.median,
  sample: v.sample,
  daily: daily(v.median),
  atCycle: cost(v.median, cycleDays),
  at30: cost(v.median, 30),
  at60: cost(v.median, 60),
  /** Share of a year's gross rent lost to one typical turn. */
  pctOfYear: ((cost(v.median, cycleDays) / (v.median * 12)) * 100).toFixed(1),
  /** Days of vacancy that cost the same as cutting rent $50 a month for a year. */
  daysPerCut: Math.round((RENT_CUT * 12) / (v.median / DAYS_IN_MONTH)),
}));

const dayScale = [7, 14, turnDays + 7, cycleDays, 45, 60, 90];

const three = beds.find((b) => b.bed === '3')!;
const two = beds.find((b) => b.bed === '2')!;
const four = beds.find((b) => b.bed === '4')!;

const VACANCY_CREDIT_DAYS = 60;

/**
 * Calculator defaults. Rent, days and RLPM's leasing fee come from the data files.
 * The rest are ASSUMPTIONS, not facts, and the page labels each one as editable:
 *   vacantMonthly 150  utilities, lawn and snow on an empty house, a round planning figure.
 *   turn 1500          a light make-ready. Together with lost rent at the defaults this lands
 *                      inside the $3,000 to $5,000 single-family turnover range RLPM published in
 *                      its own blog (lease-renewal-rent-increase-strategy), which is a sanity
 *                      check only and is not quoted on this page.
 *   otherDom 30        another manager's days on market. A placeholder, not a market statistic.
 *   otherPct 50        another manager's leasing charge as a percent of one month's rent. RLPM's
 *                      own posts say a percentage of the first month's rent is a common charge;
 *                      the 50 is a placeholder, not a survey figure.
 */
const D = {
  rent: three.rent,
  days: cycleDays,
  vacantMonthly: 150,
  turn: 1500,
  leasing: pricing.leasingFee,
  fixed: 0,
  otherDom: 30,
  otherPct: 50,
};

const initial = vacancyCost({
  monthlyRent: D.rent, daysVacant: D.days, monthlyVacantCosts: D.vacantMonthly,
  turnCost: D.turn, leasingCost: D.leasing, monthlyFixedCosts: D.fixed,
});
const initialCmp = compareManagers({
  monthlyRent: D.rent, monthlyVacantCosts: D.vacantMonthly, turnCost: D.turn, turnDays,
  otherDaysOnMarket: D.otherDom, otherLeasingPct: D.otherPct,
  rlDaysOnMarket: domDays, rlLeasingFee: pricing.leasingFee,
});
const pct = (share: number | null) => (share == null ? 'n/a' : `${(share * 100).toFixed(1)}%`);
const diffText = (d: number) =>
  Math.round(d) > 0 ? `You keep ${usd(d)} more with us on this vacancy.`
  : Math.round(d) < 0 ? `With these numbers the other manager costs ${usd(-d)} less.`
  : 'With these numbers the two cost the same.';

/** The input fields, rendered from one list so labels, hints and ids stay in step. */
type Field = { id: string; label: string; value: number | ''; pre?: string; post?: string; mode: 'numeric' | 'decimal'; hint: string; placeholder?: string };
const unitFields: Field[] = [
  { id: 'vc-rent', label: 'Monthly rent', value: D.rent, pre: '$', mode: 'decimal',
    hint: `Default: our ${three.bed} bed median rent. Use yours.` },
  { id: 'vc-days', label: 'Days vacant', value: D.days, post: 'days', mode: 'numeric',
    hint: `Default: our median ${turnDays} days to turn plus ${domDays} days on market. Count from move-out to the first day of new rent.` },
  { id: 'vc-vacant', label: 'Utilities, lawn and snow while empty', value: D.vacantMonthly, pre: '$', post: '/ month', mode: 'decimal',
    hint: 'Assumption. What you pay only because no resident is there.' },
  { id: 'vc-turn', label: 'Turn cost, one time', value: D.turn, pre: '$', mode: 'decimal',
    hint: 'Assumption. Paint, cleaning and repairs between residents.' },
  { id: 'vc-leasing', label: 'Leasing cost, one time', value: D.leasing, pre: '$', mode: 'decimal',
    hint: `${usd(pricing.leasingFee)} leasing fee with us. Enter what your manager charges to place a resident.` },
  { id: 'vc-fixed', label: 'Mortgage, taxes and insurance (optional)', value: '', placeholder: '0', pre: '$', post: '/ month', mode: 'decimal',
    hint: 'Not added to the cost: you pay these whether the unit is full or empty. Used only for the cash you put in.' },
];
const compareFields: Field[] = [
  { id: 'vc-other-dom', label: 'Their days on market', value: D.otherDom, post: 'days', mode: 'numeric',
    hint: 'Assumption, not a market figure. Use what your current or quoted manager reports.' },
  { id: 'vc-other-pct', label: 'Their leasing charge', value: D.otherPct, post: '% of a month', mode: 'decimal',
    hint: 'Assumption. Check the management agreement.' },
];

const title = 'Vacancy Cost Calculator for Columbus Rentals | RL Property Management';
const description =
  `What an empty rental costs per day, worked out. Daily cost is monthly rent divided by 30, so a ` +
  `${usd(three.rent)} unit costs ${usd(three.daily)} a day and ${usd(three.atCycle)} over a typical ` +
  `${cycleDays}-day turn and lease-up in Columbus.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Tools', path: '/tools/' },
  { name: 'Vacancy cost calculator', path: '/tools/vacancy-cost-calculator/' },
];

const answer =
  `A vacant unit costs monthly rent divided by 30 for every day it sits empty. At the ${usd(three.rent)} ` +
  `portfolio median for a 3 bed, that is ${usd(three.daily)} a day and ${usd(three.atCycle)} across a ` +
  `typical ${cycleDays}-day turn and lease-up.`;

const facts = [
  `Daily cost of a vacant unit equals monthly rent divided by ${DAYS_IN_MONTH}`,
  `At the ${usd(two.rent)} median 2 bed rent, that is ${usd(two.daily)} a day`,
  `At the ${usd(three.rent)} median 3 bed rent, that is ${usd(three.daily)} a day`,
  `Median ${turnDays} days to turn a unit plus ${domDays} median days on market is a ${cycleDays}-day cycle`,
  `A ${cycleDays}-day cycle on a 3 bed costs ${usd(three.atCycle)}, about ${three.pctOfYear}% of a year's gross rent`,
  `Portfolio occupancy is ${kpi('occupancy')}`,
  `${company.shortName} credits management fees back after ${VACANCY_CREDIT_DAYS} days of vacancy`,
  `Holding out for ${usd(RENT_CUT)} more rent pays off only if it costs under ${three.daysPerCut} extra vacant days on a 3 bed`,
];

const faq = [
  { q: 'How do you calculate the cost of a vacant rental property?',
    a: `Divide monthly rent by ${DAYS_IN_MONTH} to get the daily cost, then multiply by the number of days the unit is empty. At the ${usd(three.rent)} portfolio median for a Columbus 3 bed, that is ${usd(three.daily)} a day, ${usd(three.at30)} for a month and ${usd(three.at60)} for two. Then add the turn and leasing costs and the utilities, lawn and snow you pay while it is empty. Mortgage, taxes and insurance are paid either way, so they raise the cash you put in, not the cost of the vacancy.` },
  { q: 'How long does a rental usually sit empty?',
    a: `Across the ${company.unitsManaged} units ${company.name} manages, median days on market is ${domDays} and median days to turn a unit is ${turnDays}, so a typical full cycle from move-out to signed lease runs about ${cycleDays} days. ${kpis.domDefinition} Portfolio occupancy is ${kpi('occupancy')}.` },
  { q: 'Is it worth holding out for a higher rent?',
    a: `Only if the wait is short. ${usd(RENT_CUT)} a month is ${usd(RENT_CUT * 12)} over a year. On a ${usd(three.rent)} 3 bed, that is the same as ${three.daysPerCut} extra vacant days, and on a ${usd(two.rent)} 2 bed it is ${two.daysPerCut} days. If holding the higher price costs more days than that, the lower rent earned more money.` },
  { q: 'What costs are there beyond the lost rent?',
    a: `Three groups. Turn costs: paint, cleaning, flooring and repairs between residents. Vacant-unit costs: lawn, snow and the utilities that revert to you. And re-leasing costs: marketing, showings, screening and photography, which run ${usd(pricing.leasingFee)} with us apart from photography at $250 to $450 where new photos are needed.` },
  { q: 'Do I still pay a management fee while the unit is empty?',
    a: `Yes, and this is where a flat fee and a percentage fee differ. A percentage fee is charged on collected rent, so it falls to zero in a month with no rent. Our flat fee is charged whether the unit is occupied or not. The offset is a written commitment: if a property has been listed for rent longer than ${VACANCY_CREDIT_DAYS} days, we proactively credit management fees back to your account.` },
  { q: 'What shortens a vacancy?',
    a: 'Four things, in this order: pricing the unit against live comparables rather than last year\'s rent, having the unit ready to show on day one, replying to inquiries within hours, and making showings easy to book. Most lost leases are lost to a slow reply or a unit that shows badly, not to the price.' },
  { q: 'How much vacancy should I budget for in a year?',
    a: `Budget from your own turnover rate, not from a rule of thumb. If a unit turns once a year and the cycle runs ${cycleDays} days, that is about ${three.pctOfYear}% of gross rent on a ${usd(three.rent)} 3 bed. If the resident renews, it is close to zero. Our portfolio lease renewal rate is ${kpi('renewal')}, which is why renewals matter more to annual return than the rent increase you chase with a turn.` },
  { q: 'Does this calculator work for small multifamily?',
    a: 'Yes. The formula is per unit, so run it once per unit and add the results. The one difference is that shared utilities, common area lighting and shared lawn care keep running at full cost regardless of how many units are occupied, so the vacant-unit cost line does not scale down the way it does on a single-family house.' },
];
---
<Base {title} {description} {faq} {breadcrumbs}>

  <PageHero
    eyebrow="Free calculator, no sign-up"
    title="Vacancy cost calculator for Columbus rentals"
    answer={answer}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondaryCta={{ label: 'Run your numbers', href: '#calculator' }}
  />

  <!-- THE CALCULATOR. Server-rendered with the defaults; the script below makes it live. -->
  <section id="calculator" class="band band-wash scroll-mt-24" aria-labelledby="calc-h">
    <div class="wrap max-w-[1060px]">
      <span class="eyebrow">Your numbers</span>
      <h2 id="calc-h" class="text-[clamp(28px,3.3vw,40px)]">What will your vacancy cost?</h2>
      <p class="text-[17px] text-muted mt-3 mb-7 max-w-[44em]">
        Change any number and the result updates. Rent and days start at our published medians. Every
        other default is an assumption, so replace it with yours.
      </p>

      <form id="vc" class="vc" novalidate autocomplete="off"
            data-turn-days={turnDays} data-rl-dom={domDays} data-rl-leasing={pricing.leasingFee}>
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,400px)] lg:items-start">

          <fieldset class="card !p-6 sm:!p-7 min-w-0">
            <legend class="sr-only">Your unit</legend>
            <div class="grid gap-5 sm:grid-cols-2">
              {unitFields.map((f) => (
                <div class="vc-field">
                  <label for={f.id} class="vc-label">{f.label}</label>
                  <div class="vc-box">
                    {f.pre && <span class="vc-affix" aria-hidden="true">{f.pre}</span>}
                    <input id={f.id} type="text" inputmode={f.mode} value={f.value} placeholder={f.placeholder}
                           aria-describedby={`${f.id}-hint`} spellcheck="false" class="vc-input" />
                    {f.post && <span class="vc-affix" aria-hidden="true">{f.post}</span>}
                  </div>
                  <p id={`${f.id}-hint`} class="vc-hint">{f.hint}</p>
                </div>
              ))}
            </div>
            <button type="reset" class="btn btn-ghost !py-2.5 !px-5 !text-[14px] mt-6">Reset to defaults</button>
          </fieldset>

          <section class="card !p-6 sm:!p-7 min-w-0" aria-labelledby="vc-res-h">
            <h3 id="vc-res-h" class="eyebrow !mb-1.5">This vacancy costs you</h3>
            <p class="vc-total" id="vc-total">{usd(initial.total)}</p>
            <p class="text-[15px] text-muted mt-1 mb-0">
              <strong class="text-navy" id="vc-perday">{usd(initial.perDay)}</strong> per vacant day,
              {' '}<span id="vc-share">{pct(initial.shareOfYearRent)}</span> of a year's rent
            </p>

            <dl class="vc-breakdown mt-5">
              <div><dt>Lost rent, <span id="vc-days-used">{initial.days}</span> days</dt><dd id="vc-b-rent">{usd(initial.lostRent)}</dd></div>
              <div><dt>Utilities, lawn and snow</dt><dd id="vc-b-vacant">{usd(initial.vacantCosts)}</dd></div>
              <div><dt>Turn cost</dt><dd id="vc-b-turn">{usd(initial.turnCost)}</dd></div>
              <div><dt>Leasing cost</dt><dd id="vc-b-leasing">{usd(initial.leasingCost)}</dd></div>
            </dl>
            <p class="text-[14.5px] text-muted mt-4 mb-0">
              Cash you put in while it is empty: <strong class="text-navy" id="vc-oop">{usd(initial.outOfPocket)}</strong>
            </p>
            <noscript>
              <p class="text-[13.5px] text-faint mt-3 mb-0">
                JavaScript is off, so this shows the default numbers. The tables below cover other rents.
              </p>
            </noscript>
            <p class="sr-only" aria-live="polite" aria-atomic="true" id="vc-live"></p>
            <div class="flex flex-wrap gap-3 mt-6">
              <a href="/free-rent-evaluation/" class="btn btn-primary">Get a free rent evaluation</a>
              <a href="/pricing/" class="btn btn-ghost">See pricing</a>
            </div>
          </section>
        </div>

        <!-- COMPARISON: same unit, another manager vs our published numbers -->
        <fieldset class="card !p-6 sm:!p-7 mt-6 min-w-0">
          <legend class="sr-only">Compare with another manager</legend>
          <h3 class="text-[21px]">What would the same vacancy cost with us?</h3>
          <p class="text-[15px] text-muted mt-2 mb-5 max-w-[46em]">
            Same rent, turn cost and vacant-unit costs as above. Both sides get our median {turnDays}-day
            turn plus their own days on market. Ours are our published {domDays}-day median and
            {' '}{usd(pricing.leasingFee)} leasing fee.
          </p>
          <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,400px)] lg:items-start">
            <div class="grid gap-5 sm:grid-cols-2">
              {compareFields.map((f) => (
                <div class="vc-field">
                  <label for={f.id} class="vc-label">{f.label}</label>
                  <div class="vc-box">
                    <input id={f.id} type="text" inputmode={f.mode} value={f.value}
                           aria-describedby={`${f.id}-hint`} spellcheck="false" class="vc-input" />
                    {f.post && <span class="vc-affix" aria-hidden="true">{f.post}</span>}
                  </div>
                  <p id={`${f.id}-hint`} class="vc-hint">{f.hint}</p>
                </div>
              ))}
            </div>
            <div>
              <dl class="vc-breakdown">
                <div>
                  <dt>Another manager, <span id="vc-c-other-days">{initialCmp.other.days}</span> days</dt>
                  <dd id="vc-c-other">{usd(initialCmp.other.total)}</dd>
                </div>
                <div>
                  <dt>{company.shortName}, <span id="vc-c-rl-days">{initialCmp.rl.days}</span> days</dt>
                  <dd id="vc-c-rl">{usd(initialCmp.rl.total)}</dd>
                </div>
              </dl>
              <p class="text-[16px] font-semibold text-crimson mt-4 mb-0" id="vc-c-diff">{diffText(initialCmp.difference)}</p>
              <p class="text-[13.5px] text-faint mt-3 mb-0">
                Turn time is {turnDays} days on both sides. If a listing passes {VACANCY_CREDIT_DAYS} days, we
                credit management fees back to you.
              </p>
            </div>
          </div>
        </fieldset>
      </form>
    </div>
  </section>

  <KeyFacts items={facts} />

  <!-- THE FORMULA -->
  <section class="band" aria-labelledby="formula-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The formula</span>
      <h2 id="formula-h" class="text-[clamp(28px,3.3vw,40px)]">How do you calculate the cost of a vacant rental?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Divide monthly rent by {DAYS_IN_MONTH} for the daily cost, then multiply by the days the unit sits
        empty. That is the lost rent. Then add three things that are easy to forget.
      </p>
      <div class="card !bg-wash-soft mt-8">
        <h3 class="text-[19px] mb-3.5">The whole calculation, in four lines</h3>
        <ol class="grid gap-2.5 text-[16px]">
          <li><strong class="text-navy">Lost rent.</strong> Monthly rent divided by {DAYS_IN_MONTH}, times the number of vacant days.</li>
          <li><strong class="text-navy">Vacant-unit costs.</strong> Lawn, snow and every utility that reverts to your name.</li>
          <li><strong class="text-navy">Turn cost.</strong> Paint, cleaning, flooring, repairs and trash-out between residents.</li>
          <li><strong class="text-navy">Re-leasing cost.</strong> Marketing, showings, screening, lease preparation and photography where new photos are needed.</li>
        </ol>
        <p class="text-[15px] text-muted mt-5 mb-0">
          Lines 1 and 2 run every day and lines 3 and 4 happen once, so for most owners the number of vacant
          days matters more than the size of the turn bill.
        </p>
      </div>
      <p class="text-[15px] text-faint mt-6">
        Mortgage, taxes and insurance are not on the list. You pay them whether the unit is full or empty, so
        adding them to lost rent counts them twice. They do raise the cash you put in while it is empty, which
        the calculator shows separately. Figures are rounded to the nearest dollar, and dividing by
        {' '}{DAYS_IN_MONTH} is the convention property managers use.
      </p>
    </div>
  </section>

  <!-- DAILY COST TABLE -->
  <section class="band band-wash" aria-labelledby="daily-h">
    <div class="wrap max-w-[940px]">
      <span class="eyebrow">Start here</span>
      <h2 id="daily-h" class="text-[clamp(28px,3.3vw,40px)]">What does one vacant day cost in Columbus?</h2>
      <p class="text-[17.5px] text-muted mt-4 mb-7 max-w-[44em]">
        Median rents across the {company.unitsManaged} units we manage. Find the row closest to your rent.
      </p>
      <div class="scroll-x">
        <table class="w-full border-collapse bg-white rounded-[12px] overflow-hidden text-[15.5px]"
               style="box-shadow:0 1px 2px rgb(18 49 67 / .05), 0 8px 24px rgb(18 49 67 / .06)">
          <caption class="sr-only">Daily and cumulative cost of vacancy at portfolio median rents</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border-b border-line font-semibold">Unit</th>
              <th scope="col" class="text-right p-3.5 border-b border-line font-semibold">Median rent</th>
              <th scope="col" class="text-right p-3.5 border-b border-line font-semibold">Per vacant day</th>
              <th scope="col" class="text-right p-3.5 border-b border-line font-semibold">{cycleDays}-day cycle</th>
              <th scope="col" class="text-right p-3.5 border-b border-line font-semibold">60 days</th>
              <th scope="col" class="text-right p-3.5 border-b border-line font-semibold">Share of a year's rent</th>
            </tr>
          </thead>
          <tbody>
            {beds.map((b) => (
              <tr>
                <th scope="row" class="text-left p-3.5 border-b border-line font-medium">{b.bed} bed</th>
                <td class="text-right p-3.5 border-b border-line tabular-nums text-muted">{usd(b.rent)}</td>
                <td class="text-right p-3.5 border-b border-line tabular-nums font-bold text-crimson">{usd(b.daily)}</td>
                <td class="text-right p-3.5 border-b border-line tabular-nums text-navy font-semibold">{usd(b.atCycle)}</td>
                <td class="text-right p-3.5 border-b border-line tabular-nums text-navy font-semibold">{usd(b.at60)}</td>
                <td class="text-right p-3.5 border-b border-line tabular-nums text-muted">{b.pctOfYear}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[15.5px] text-muted mt-6">
        The {cycleDays}-day column is our median turn of {turnDays} days plus our median {domDays} days on
        market. {kpis.domDefinition} The last column is that cycle against twelve months of gross rent.
      </p>
    </div>
  </section>

  <!-- THE GRID -->
  <section class="band" aria-labelledby="grid-h">
    <div class="wrap max-w-[940px]">
      <span class="eyebrow">Lost rent by the day</span>
      <h2 id="grid-h" class="text-[clamp(28px,3.3vw,40px)]">What does a vacancy cost by the day?</h2>
      <p class="text-[17.5px] text-muted mt-4 mb-7 max-w-[44em]">
        Lost rent only, before turn and vacant-unit costs. Find your rent and read across.
      </p>
      <div class="scroll-x">
        <table class="w-full border-collapse bg-white rounded-[12px] overflow-hidden text-[15px]"
               style="box-shadow:0 1px 2px rgb(18 49 67 / .05), 0 8px 24px rgb(18 49 67 / .06)">
          <caption class="sr-only">Lost rent by monthly rent and number of vacant days</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3 border-b border-line font-semibold">Monthly rent</th>
              {dayScale.map((d) => (
                <th scope="col" class="text-right p-3 border-b border-line font-semibold whitespace-nowrap">{d} days</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {beds.map((b) => (
              <tr>
                <th scope="row" class="text-left p-3 border-b border-line font-medium tabular-nums whitespace-nowrap">
                  {usd(b.rent)} <span class="text-faint font-normal">({b.bed} bed)</span>
                </th>
                {dayScale.map((d) => (
                  <td class="text-right p-3 border-b border-line tabular-nums text-navy">{usd(cost(b.rent, d))}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[15px] text-faint mt-5">
        Sample sizes behind each median:
        {beds.map((b, i) => (
          <span>{' '}{b.bed} bed, {b.sample} units{i < beds.length - 1 ? ';' : '.'}</span>
        ))}
      </p>
    </div>
  </section>

  <!-- THREE WORKED EXAMPLES -->
  <section class="band band-wash" aria-labelledby="ex-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Three worked examples</span>
      <h2 id="ex-h" class="text-[clamp(28px,3.3vw,40px)]">What does this look like on a real Columbus unit?</h2>
      <div class="grid gap-5 mt-8">

        <div class="card">
          <h3 class="text-[19.5px] mb-3">A 3 bed at {usd(three.rent)}, turned and leased on schedule</h3>
          <p class="text-[15.5px] text-muted">
            Daily cost is {usd(three.rent)} divided by {DAYS_IN_MONTH}, or {usd(three.daily)}. The turn runs
            our median {turnDays} days and the unit leases in our median {domDays} days on market, so
            {' '}{cycleDays} vacant days in total.
          </p>
          <p class="text-[15.5px] text-navy font-semibold mt-3 mb-0">
            Lost rent: {usd(three.daily)} times {cycleDays} days equals {usd(three.atCycle)}, about
            {' '}{three.pctOfYear}% of a year of gross rent. Turn and vacant-unit costs sit on top of that.
          </p>
        </div>

        <div class="card">
          <h3 class="text-[19.5px] mb-3">A 2 bed at {usd(two.rent)}, still empty at {VACANCY_CREDIT_DAYS} days</h3>
          <p class="text-[15.5px] text-muted">
            Daily cost is {usd(two.daily)}. At {VACANCY_CREDIT_DAYS} days the lost rent is
            {' '}{usd(two.at60)}, more than {Math.floor(two.at60 / pricing.plans[1].monthly)} months
            of management on {pricing.plans[1].name}. A unit still empty at {VACANCY_CREDIT_DAYS} days is
            almost always priced above the market or showing badly, and both are fixable in a week.
          </p>
          <p class="text-[15.5px] text-navy font-semibold mt-3 mb-0">
            Our commitment applies here: past {VACANCY_CREDIT_DAYS} days on the market we
            proactively credit management fees back to your account.
          </p>
        </div>

        <div class="card">
          <h3 class="text-[19.5px] mb-3">A 4 bed at {usd(four.rent)}, held back three weeks for a repair</h3>
          <p class="text-[15.5px] text-muted">
            Daily cost is {usd(four.daily)}. Twenty-one days waiting on a contractor before the unit can be
            listed costs {usd(cost(four.rent, 21))} in rent, before day one of marketing. Add the normal
            {' '}{cycleDays}-day cycle and the total is {usd(cost(four.rent, 21 + cycleDays))}.
          </p>
          <p class="text-[15.5px] text-navy font-semibold mt-3 mb-0">
            Scheduling the turn before the move-out date, rather than after it, is worth more on a high-rent
            unit than any negotiation you will have with the contractor.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- THE RENT CUT TRADEOFF -->
  <section class="band" aria-labelledby="cut-h">
    <div class="wrap max-w-[940px]">
      <span class="eyebrow">The decision this informs</span>
      <h2 id="cut-h" class="text-[clamp(28px,3.3vw,40px)]">Should you hold out for a higher rent?</h2>
      <p class="text-[17.5px] text-muted mt-4 mb-7 max-w-[44em]">
        Only if the wait is short. {usd(RENT_CUT)} a month is {usd(RENT_CUT * 12)} over a twelve-month lease.
        Wait longer than the last column and the lower rent would have earned more.
      </p>
      <div class="scroll-x">
        <table class="w-full border-collapse bg-white rounded-[12px] overflow-hidden text-[15.5px]"
               style="box-shadow:0 1px 2px rgb(18 49 67 / .05), 0 8px 24px rgb(18 49 67 / .06)">
          <caption class="sr-only">Extra vacant days equivalent to a fifty dollar monthly rent reduction</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border-b border-line font-semibold">Unit</th>
              <th scope="col" class="text-right p-3.5 border-b border-line font-semibold">Median rent</th>
              <th scope="col" class="text-right p-3.5 border-b border-line font-semibold">Per vacant day</th>
              <th scope="col" class="text-right p-3.5 border-b border-line font-semibold">{usd(RENT_CUT)} a month, over a year</th>
              <th scope="col" class="text-right p-3.5 border-b border-line font-semibold">Break-even in vacant days</th>
            </tr>
          </thead>
          <tbody>
            {beds.map((b) => (
              <tr>
                <th scope="row" class="text-left p-3.5 border-b border-line font-medium">{b.bed} bed</th>
                <td class="text-right p-3.5 border-b border-line tabular-nums text-muted">{usd(b.rent)}</td>
                <td class="text-right p-3.5 border-b border-line tabular-nums text-muted">{usd(b.daily)}</td>
                <td class="text-right p-3.5 border-b border-line tabular-nums text-muted">{usd(RENT_CUT * 12)}</td>
                <td class="text-right p-3.5 border-b border-line tabular-nums font-bold text-crimson">{b.daysPerCut} days</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[15.5px] text-muted mt-6">
        On a {usd(three.rent)} 3 bed, holding out for {usd(RENT_CUT)} more rent pays off only if it costs
        fewer than {three.daysPerCut} extra vacant days. Our median days on market is {domDays}, so pricing
        to the market on day one usually beats testing a number for two weeks.
      </p>
      <p class="text-[15.5px] text-muted mt-4">
        One caveat: the higher rent carries into renewals and the vacancy does not. If the resident stays
        three years, a {usd(RENT_CUT)} difference compounds into {usd(RENT_CUT * 36)} of forgone rent. Our
        lease renewal rate is {kpi('renewal')}, so the test is whether you can defend the higher rent with
        comparables.
      </p>
    </div>
  </section>

  <section class="band band-wash">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Vacancy cost questions" id="vacancy-faq" />
      <div class="mt-8"><Verified date="2026-09-09" /></div>
      <p class="text-[13px] text-faint mt-3">
        Rent medians are across the {company.unitsManaged} units {company.name} manages, as of
        {' '}{kpis.asOfLabel}. Day counts come from our published scorecard. Calculator defaults marked as
        assumptions are placeholders for your own numbers. Figures are rounded to the nearest dollar and
        illustrate the formula; they are not a forecast for any specific property.
      </p>
    </div>
  </section>

