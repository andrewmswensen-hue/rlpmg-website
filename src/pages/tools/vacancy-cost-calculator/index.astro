<style>
  .vc-label { display: block; font-size: 14.5px; font-weight: 600; color: var(--color-navy); margin-bottom: 6px; }
  .vc-box {
    display: flex; align-items: center; gap: 6px;
    background: #fff; border: 1.5px solid var(--color-line); border-radius: 12px;
    padding: 0 14px; transition: border-color .15s;
  }
  .vc-box:hover { border-color: var(--color-faint); }
  .vc-box:focus-within { border-color: var(--color-crimson); box-shadow: 0 0 0 3px rgb(166 5 48 / .15); }
  .vc-input {
    flex: 1 1 auto; min-width: 0; width: 100%;
    /* 17px keeps iOS Safari from zooming the page on focus. */
    font: 600 17px/1.2 var(--font-sans); color: var(--color-navy);
    font-variant-numeric: tabular-nums;
    border: 0; background: transparent; padding: 12px 0; outline: none;
  }
  .vc-input:focus-visible { outline: none; }
  .vc-affix { color: var(--color-muted); font-size: 14.5px; white-space: nowrap; }
  .vc-hint { font-size: 13px; line-height: 1.45; color: var(--color-muted); margin: 6px 0 0; }
  .vc-total {
    font-family: var(--font-serif); font-weight: 600; color: var(--color-crimson);
    font-size: clamp(40px, 6vw, 54px); line-height: 1.05; margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .vc-breakdown { margin: 0; border-top: 1px solid var(--color-line); }
  .vc-breakdown > div {
    display: flex; justify-content: space-between; gap: 16px;
    padding: 10px 0; border-bottom: 1px solid var(--color-line); font-size: 15px;
  }
  .vc-breakdown dt { color: var(--color-muted); }
  .vc-breakdown dd { margin: 0; font-weight: 600; color: var(--color-navy); font-variant-numeric: tabular-nums; }
</style>

<script>
  // Live recalculation. The math is in the shared lib; this file only reads inputs and writes text.
  import { vacancyCost, compareManagers, parseAmount } from '../../../lib/calculators/vacancyCost';
  import { usd } from '../../../data/facts';

  const form = document.getElementById('vc') as HTMLFormElement | null;
  if (form) {
    const num = (id: string) => parseAmount((document.getElementById(id) as HTMLInputElement | null)?.value);
    const set = (id: string, text: string) => { const el = document.getElementById(id); if (el) el.textContent = text; };
    const turnDays = Number(form.dataset.turnDays) || 0;
    const rlDom = Number(form.dataset.rlDom) || 0;
    const rlLeasing = Number(form.dataset.rlLeasing) || 0;
    let announce: ReturnType<typeof setTimeout> | undefined;

    const update = () => {
      const rent = num('vc-rent');
      const vacantMonthly = num('vc-vacant');
      const turn = num('vc-turn');
      const r = vacancyCost({
        monthlyRent: rent, daysVacant: num('vc-days'), monthlyVacantCosts: vacantMonthly,
        turnCost: turn, leasingCost: num('vc-leasing'), monthlyFixedCosts: num('vc-fixed'),
      });
      set('vc-total', usd(r.total));
      set('vc-perday', usd(r.perDay));
      set('vc-share', r.shareOfYearRent == null ? 'n/a' : `${(r.shareOfYearRent * 100).toFixed(1)}%`);
      set('vc-days-used', String(r.days));
      set('vc-b-rent', usd(r.lostRent));
      set('vc-b-vacant', usd(r.vacantCosts));
      set('vc-b-turn', usd(r.turnCost));
      set('vc-b-leasing', usd(r.leasingCost));
      set('vc-oop', usd(r.outOfPocket));

      const c = compareManagers({
        monthlyRent: rent, monthlyVacantCosts: vacantMonthly, turnCost: turn, turnDays,
        otherDaysOnMarket: num('vc-other-dom'), otherLeasingPct: num('vc-other-pct'),
        rlDaysOnMarket: rlDom, rlLeasingFee: rlLeasing,
      });
      set('vc-c-other-days', String(c.other.days));
      set('vc-c-rl-days', String(c.rl.days));
      set('vc-c-other', usd(c.other.total));
      set('vc-c-rl', usd(c.rl.total));
      const d = Math.round(c.difference);
      set('vc-c-diff',
        d > 0 ? `You keep ${usd(d)} more with us on this vacancy.`
        : d < 0 ? `With these numbers the other manager costs ${usd(-d)} less.`
        : 'With these numbers the two cost the same.');

      // One short, debounced sentence for screen readers, so typing is not read out digit by digit.
      clearTimeout(announce);
      announce = setTimeout(() => {
        set('vc-live', `This vacancy costs ${usd(r.total)}, or ${usd(r.perDay)} per vacant day.`);
      }, 700);
    };

    form.addEventListener('input', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    // Reset restores the value attributes after the event, so recalculate on the next tick.
    form.addEventListener('reset', () => setTimeout(update, 0));
    update();
  }
</script>
