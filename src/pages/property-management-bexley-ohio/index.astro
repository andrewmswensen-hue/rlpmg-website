---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, pricing, rentPolicy, usd } from '../../data/facts';
import { rentByBedroom } from '../../data/markets';
import { serviceNode } from '../../lib/schema';

/**
 * Bexley, Ohio. Target query: "property management bexley ohio".
 *
 * The differentiating fact for Bexley is independence. Bexley is a separate
 * incorporated city with Columbus on every side of it. It has its own council,
 * its own codified ordinances, its own building and zoning department, its own
 * school district and its own mayor's court. An owner who reads a Columbus
 * ordinance and assumes it governs a Bexley rental is reading the wrong book.
 * The reverse trap is just as real: the eviction court and the rental owner
 * filing are COUNTY functions, so those do follow Franklin County.
 *
 * Bexley is a coverage market in src/data/markets.ts and has no entry in
 * rentByMarketAndBedroom, so this page publishes NO Bexley rent median and says
 * nothing about how many doors we do or do not have there. Portfolio-wide
 * medians are used instead, labelled as portfolio-wide across the metro.
 *
 * SOURCES (verified 2026-09-09):
 *  - Franklin County Municipal Court hears forcible entry and detainer for
 *    Franklin County: R.C. 1901.02, codes.ohio.gov/ohio-revised-code/section-1901.02.
 *    Address and Eviction Court courtroom: franklincountymunicourt.org.
 *  - Bexley Mayor's Court is a limited jurisdiction court hearing minor
 *    misdemeanours and traffic offences arising inside the city, presided over by
 *    a magistrate, no jury trials, no civil jurisdiction. Confirmed across
 *    multiple Franklin County criminal defence court directories, 2026-09-09.
 *  - Owner filing with the county auditor: R.C. 5323.02 at
 *    codes.ohio.gov/ohio-revised-code/section-5323.02. Confirmed 2026-09-09 to
 *    apply statewide; the 200,000 population threshold in the statute governs the
 *    auditor's duty to NOTIFY, not the owner's duty to file. Penalty R.C. 5323.99,
 *    $50 to $150; the Franklin County Auditor states $150 per tax year.
 *  - Bexley short-term rental registration and the $75 annual fee: Bexley
 *    Codified Ordinances 1266.19 Short Term Rentals, codelibrary.amlegal.com.
 *  - Bexley is a City of Columbus water and sewer contract community:
 *    columbus.gov Water & Sewer Contract Communities list, fetched 2026-09-09.
 *    Columbus states the property owner is ultimately responsible for all charges
 *    even under a Tenant Billing Agreement.
 *  - AEP Ohio distributes electricity across central Ohio; Columbia Gas of Ohio
 *    is the central Ohio gas distributor.
 *
 * NOT VERIFIED, marked in the copy:
 *  - Whether the City of Bexley operates a LONG-TERM residential rental
 *    registration, licence or periodic inspection programme. American Legal's
 *    code library blocks automated retrieval, so the full Part Fourteen Building
 *    and Housing Code could not be read. Marked [SOURCE NEEDED].
 *  - Census median year structure built for Bexley. Marked [SOURCE NEEDED].
 */

const PATH = '/property-management-bexley-ohio/';

const title = 'Property Management in Bexley, Ohio | RL Property Management';
const description =
  `Flat-fee property management for Bexley, Ohio rentals from ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} ` +
  `per unit per month with a ${usd(pricing.leasingFee)} leasing fee. Bexley is its own city with its own code, ` +
  `and Columbus ordinances do not apply there.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/areas-we-serve/' },
  { name: 'Bexley', path: PATH },
];

const keyFacts = [
  `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, not a percentage of rent`,
  `${usd(pricing.leasingFee)} leasing fee every time a Bexley unit turns`,
  'Bexley is a separate incorporated city, not a Columbus neighborhood',
  'Columbus city ordinances do not govern a Bexley rental; the Bexley codified ordinances do',
  'Franklin County, so an eviction is filed at 375 S. High St., Columbus',
  'Water and sewer come from the City of Columbus under a contract community agreement',
];

/**
 * City function versus county function. This is the whole page in one table:
 * which rules Bexley writes for itself, and which ones follow the county line
 * regardless of what the city does.
 */
const whoDecides = [
  {
    thing: 'Zoning, setbacks, additions, accessory dwelling units',
    who: 'City of Bexley',
    detail: 'The Bexley Planning and Zoning Code governs, including accessory dwelling units, which carry their own registration renewal and a building code inspection.',
  },
  {
    thing: 'Short-term rentals',
    who: 'City of Bexley',
    detail: 'Bexley Codified Ordinances 1266.19 requires city registration and a $75 annual fee. A Columbus permit does not cover a Bexley address.',
  },
  {
    thing: 'Property maintenance, exterior code, nuisance enforcement',
    who: 'City of Bexley',
    detail: 'Bexley runs its own code enforcement. A violation letter comes from Bexley and is answered in Bexley.',
  },
  {
    thing: 'Traffic and minor misdemeanour matters arising in the city',
    who: 'Bexley Mayor’s Court',
    detail: 'A limited jurisdiction court run by a magistrate. It does not hear evictions or landlord and tenant money claims.',
  },
  {
    thing: 'Eviction, and any landlord or tenant civil claim',
    who: 'Franklin County Municipal Court',
    detail: 'A county function under R.C. 1901.02. Filed at 375 S. High St., Columbus, OH 43215, Eviction Court in Courtroom 11B.',
  },
  {
    thing: 'Rental owner registration under R.C. 5323.02',
    who: 'Franklin County Auditor',
    detail: 'A state duty discharged at the county, not at Bexley City Hall. No fee, and due within 60 days of any change.',
  },
];

const faq = [
  { q: 'Is Bexley part of Columbus?',
    a: 'No. Bexley is a separate incorporated city in Franklin County with Columbus on every side of it. It has its own mayor and council, its own codified ordinances, its own building and zoning department, its own code enforcement, its own police and its own school district. A Columbus ordinance does not govern a Bexley rental.' },
  { q: 'Which court hears an eviction in Bexley, Ohio?',
    a: 'Franklin County Municipal Court, at 375 S. High St., Columbus, OH 43215, where Eviction Court sits in Courtroom 11B. Eviction jurisdiction follows the county under Ohio Revised Code 1901.02, not the city, so Bexley being its own city changes nothing here. Bexley Mayor’s Court hears traffic and minor misdemeanour matters that arise in the city and has no jurisdiction over an eviction or a landlord and tenant money claim.' },
  { q: 'Do I have to register a rental property in Bexley?',
    a: 'Yes, with the Franklin County Auditor. Ohio Revised Code 5323.02 requires the owner of residential rental property to file the owner name, address and telephone number and the property street address and permanent parcel number with the auditor of the county the property sits in, and to update within 60 days of any change. There is no filing fee. The Franklin County Auditor states a penalty of $150 per tax year; the statutory range under R.C. 5323.99 is $50 to $150. A manager can file as the owner designated agent, and we do.' },
  { q: 'Does the City of Bexley have its own rental registration or inspection programme?',
    a: 'Short-term rentals, yes. Bexley Codified Ordinances 1266.19 requires an owner offering a short-term residential rental to register with the city and pay a $75 annual registration fee, and Bexley separately regulates accessory dwelling units with its own registration and inspection step. The Franklin County Auditor filing under R.C. 5323 applies either way.' },
  { q: 'Who provides water and sewer in Bexley, Ohio?',
    a: 'The City of Columbus. Bexley appears on the Columbus Department of Public Utilities water and sewer contract community list, so the water and sewer behind a Bexley rental is Columbus infrastructure supplied under contract. Electricity is AEP Ohio and natural gas is Columbia Gas of Ohio. Columbus states that the property owner is ultimately responsible for all charges even where a Tenant Billing Agreement puts the account in the resident name.' },
  { q: 'What kind of rental property is in Bexley?',
    a: 'Older detached houses, two-family buildings, and apartment buildings along the Main Street and East Broad Street corridors. Much of the stock predates the Second World War, on small lots with detached garages reached from alleys. Capital University sits inside the city and shapes demand near its edges. [SOURCE NEEDED: US Census ACS 2024 5-year median year structure built for Bexley, Ohio.]' },
  { q: 'How much does property management cost in Bexley?',
    a: `A flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month depending on plan, with a ${usd(pricing.leasingFee)} leasing fee and ${usd(pricing.leaseRenewalFee)} on a lease renewal. The fee is a fixed dollar amount, so it does not move when your rent moves. Photography is not part of the ${usd(pricing.leasingFee)} leasing fee and is billed separately at $250 to $450. Every other charge that can land on an owner statement is published on the pricing page.` },
  { q: 'What does a rental in Bexley rent for?',
    a: `We do not publish a Bexley rent median, because we only publish our own portfolio medians where the sample is at least five units and Bexley does not meet that bar. Across our whole book in the Columbus metro the median is ${usd(rentByBedroom['2'].median)} for a two bedroom and ${usd(rentByBedroom['3'].median)} for a three bedroom. Those are metro-wide figures, not Bexley figures, and Bexley is not an average part of the metro. For an address-specific number, ask for a rent evaluation.` },
];

const schemaNodes = [
  {
    ...serviceNode({
      path: PATH,
      name: 'Residential property management in Bexley, Ohio',
      description,
    }),
    areaServed: {
      '@type': 'City',
      name: 'Bexley, Ohio',
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Franklin County, Ohio' },
    },
  },
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="Where we work"
    title="Property management in Bexley, Ohio"
    answer={`${company.name} manages single-family and small multifamily rentals in Bexley for a flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, with a ${usd(pricing.leasingFee)} leasing fee. Bexley is its own city with its own code, not Columbus.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondaryCta={{ label: 'See the full fee schedule', href: '/pricing/' }}
  />

  <KeyFacts items={keyFacts} heading="Bexley, at a glance" />

  <!-- THE HOOK: Bexley is not Columbus, and the split between city rules and
       county rules is the thing owners actually get wrong. -->
  <section class="band-tight" aria-labelledby="indep-h">
    <div class="wrap max-w-[880px]">
      <h2 id="indep-h" class="text-[clamp(26px,3.2vw,38px)]">Is Bexley part of Columbus?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        No. Bexley is a separate incorporated city with Columbus on every side of it, with its own mayor and
        council, codified ordinances, building and zoning department, code enforcement, police department,
        mayor's court and school district. None of that is ceremonial. If you own a rental in Bexley and answer a
        question by looking up a Columbus ordinance, you have looked in the wrong book.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        The trap runs both ways, and the second half is the part nobody explains. Some things are decided at
        city hall and some at the county, and independence does not change the county ones. Getting it backwards
        costs a filing fee, three weeks off a turn, or a letter answered to the wrong department.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Which authority decides what for a Bexley, Ohio rental property</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">The question</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Who decides</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">What that means in practice</th>
            </tr>
          </thead>
          <tbody>
            {whoDecides.map((r) => (
              <tr>
                <th scope="row" class="text-left p-3.5 border border-line font-medium align-top">{r.thing}</th>
                <td class="p-3.5 border border-line align-top font-semibold text-navy">{r.who}</td>
                <td class="p-3.5 border border-line align-top text-muted">{r.detail}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- EVICTION -->
  <section class="band band-wash" aria-labelledby="court-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">If it goes wrong</span>
      <h2 id="court-h" class="text-[clamp(26px,3.2vw,38px)]">Which court hears an eviction in Bexley?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Franklin County Municipal Court, at 375 S. High St., Columbus, OH 43215, where Eviction Court sits in
        Courtroom 11B. Eviction jurisdiction follows the county under R.C. 1901.02, so Bexley's independence does
        not create a Bexley eviction court. Owners sometimes assume Bexley Mayor's Court is the venue. It is a
        limited jurisdiction court run by a magistrate, hearing minor misdemeanour and traffic matters arising
        inside the city, and it hears neither a forcible entry and detainer action nor a claim for unpaid rent.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Before any of that, Ohio requires a three-day notice to leave the premises under R.C. 1923.04, carrying
        specific statutory language. Wrong wording, dismissed case, three more weeks with no rent. Our costs are
        published on the
        {' '}<a href="/services/evictions/" class="text-crimson font-semibold no-underline hover:underline">evictions page</a>:
        {' '}{usd(pricing.eviction.countyFilingFee)} to the county, {usd(pricing.eviction.attorneyFee)} to the
        attorney, and {usd(pricing.eviction.rlpmProcessFee)} to us to run it.
      </p>
    </div>
  </section>

  <!-- REGISTRATION -->
  <section class="band-tight" aria-labelledby="reg-h">
    <div class="wrap max-w-[880px]">
      <h2 id="reg-h" class="text-[clamp(26px,3.2vw,38px)]">Do you have to register a Bexley rental property?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Yes, with the Franklin County Auditor, and not with the City of Bexley. Ohio Revised Code 5323.02
        requires every owner of residential rental property to file their name, address and telephone number,
        plus the property street address and permanent parcel number, with the auditor of the county the property
        sits in, and to update within 60 days of any change. There is no filing fee. Miss it and the auditor can
        place a special assessment under R.C. 5323.99; the statutory range is $50 to $150 and the Franklin County
        Auditor states $150 per tax year.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Owners holding title through an LLC or a trust have to name the responsible member, officer or trustee,
        which is the detail most often skipped. A manager may file as the owner designated agent, and we do.
      </p>
      <h3 class="text-[21px] mt-9 mb-3">What Bexley itself requires</h3>
      <p class="text-[16.5px] text-muted">
        Bexley regulates short-term rentals separately. Bexley Codified Ordinances 1266.19 requires an owner
        offering a short-term residential rental to register with the city and pay a $75 annual registration fee.
        Accessory dwelling units are regulated directly too, with registration renewed every two years or within
        thirty days of a change in ownership or rental status, and a building code inspection before continued
        occupancy is certified. A Columbus permit substitutes for neither.
      </p>
      <p class="text-[16.5px] text-muted mt-5">
        Where a city runs its own registration, licence or inspection programme, it stacks on top of the county auditor filing rather than replacing it. Columbus added a citywide registry in April 2026 under City Code Chapter 4515. Keeping track of which programme applies to your address, and filing on time, is work we absorb rather than work we hand you.
      </p>
    </div>
  </section>

  <!-- UTILITIES -->
  <section class="band band-wash" aria-labelledby="util-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Utilities</span>
      <h2 id="util-h" class="text-[clamp(26px,3.2vw,38px)]">Who provides utilities in Bexley, and who pays them?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Water and sanitary sewer come from the City of Columbus. Bexley appears on the Columbus Department of
        Public Utilities water and sewer contract community list, so this is one place where independence does
        not apply. Electricity is AEP Ohio and natural gas is Columbia Gas of Ohio.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Utility providers for Bexley, Ohio rental property</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Service</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Provider</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Who customarily pays</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Water and sewer</th>
              <td class="p-3.5 border border-line text-navy font-semibold">City of Columbus, contract community</td>
              <td class="p-3.5 border border-line text-muted">Resident, in their own name, on our standard lease</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Electricity</th>
              <td class="p-3.5 border border-line text-navy font-semibold">AEP Ohio</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Natural gas</th>
              <td class="p-3.5 border border-line text-navy font-semibold">Columbia Gas of Ohio</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-[16px] text-muted mt-6">
        The line that matters: Columbus states that the property owner is ultimately responsible for all
        charges, even under a Tenant Billing Agreement, so an unpaid balance can end up attached to your parcel.
        We check balances at move-out, while there is still a deposit to settle against.
      </p>
    </div>
  </section>

  <!-- HOUSING STOCK -->
  <section class="band-tight" aria-labelledby="stock-h">
    <div class="wrap max-w-[880px]">
      <h2 id="stock-h" class="text-[clamp(26px,3.2vw,38px)]">What kind of rental property is there in Bexley?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Older housing, and a lot of it. Bexley is built out, with almost no new subdivision land, so the rental
        stock is what was built decades ago: detached houses on small lots, two-family and small multifamily
        buildings, and apartment buildings along the Main Street and East Broad Street corridors, with garages
        off alleys rather than the street. Capital University sits inside the city, and Bexley City Schools is a
        large part of why families rent here rather than buy elsewhere.
        {' '}[SOURCE NEEDED: US Census ACS 2024 5-year median year structure built for Bexley, Ohio.]
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Age changes the job. A house from the 1920s carries original service lines, plaster, older sewer
        laterals, and roofs and windows on a replacement cycle rather than a repair cycle. Price a reserve before
        you buy rather than in February when a resident calls at 11pm about no heat. The
        {' '}<a href="/tools/maintenance-reserve-calculator/" class="text-crimson font-semibold no-underline hover:underline">maintenance reserve calculator</a>
        {' '}does that free. And because Bexley notices exterior condition, a deferred repair becomes a letter
        faster here, which is why we
        {' '}<a href="/services/inspections/" class="text-crimson font-semibold no-underline hover:underline">inspect on a schedule</a>.
      </p>
    </div>
  </section>

  <!-- PRICING -->
  <section class="band band-wash" aria-labelledby="price-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">What it costs</span>
      <h2 id="price-h" class="text-[clamp(26px,3.2vw,38px)]">What does property management cost in Bexley?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        A flat {usd(pricing.plans[0].monthly)} to {usd(pricing.plans[2].monthly)} per unit per month, plus
        {usd(pricing.leaseRenewalFee)} on a lease renewal. The leasing fee is {usd(pricing.leasingFee)}, every
        time, including the first placement. The three plans differ in one variable: how large a repair we can
        approve without calling you first.
      </p>
      <div class="grid gap-5 sm:grid-cols-3 mt-8">
        {pricing.plans.map((p) => (
          <div class="card text-center">
            <div class="font-sans text-[12px] font-bold tracking-[.13em] uppercase text-faint mb-2">{p.name}</div>
            <div class="font-sans text-[42px] font-extrabold tracking-[-.045em] text-navy leading-none">{usd(p.monthly)}</div>
            <div class="font-sans text-[13px] text-faint mt-2">per unit, per month</div>
            <p class="text-[14.5px] text-muted mt-4 mb-0">{usd(p.repairApprovalLimit)} per-item repair approval limit</p>
          </div>
        ))}
      </div>
      <h3 class="text-[21px] mt-10 mb-3">What we will not tell you about Bexley rents</h3>
      <p class="text-[16.5px] text-muted">
        We publish our own portfolio medians only where at least five units support the figure, and Bexley does
        not clear that bar, so there is no Bexley median here and we will not borrow a public index and call it
        our book. Portfolio-wide across the metro our median is {usd(rentByBedroom['2'].median)} for a two
        bedroom and {usd(rentByBedroom['3'].median)} for a three bedroom. Bexley is not an average slice of the
        metro, so for a real address, ask for a rent evaluation.
      </p>
      <p class="text-[14px] text-faint mt-5">
        Photography is not included in the {usd(pricing.leasingFee)} leasing fee and is billed separately at $250
        to $450.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/pricing/" class="btn btn-navy">See every fee we charge</a>
        <a href="/free-rent-evaluation/" class="btn btn-ghost">Price my Bexley rental</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band-tight" aria-labelledby="faq-section">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <h2 id="faq-section" class="sr-only">Bexley property management questions</h2>
      <Faq items={faq} heading="Bexley property management questions" id="bexley-faq" />
      <p class="mt-7 text-[15.5px] text-muted">
        Rent is due on {rentPolicy.dueDate} and late fees are assessed after {rentPolicy.lateFeesAfter}. Owner
        funds go out on the {rentPolicy.ownerDisbursementDay}th. Another forty answers sit on the
        {' '}<a href="/owner-faqs/" class="text-crimson font-semibold no-underline hover:underline">owner FAQs page</a>.
      </p>
      <div class="mt-6"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/property-management-columbus-ohio/', label: 'Columbus property management', note: 'The city on all four sides, and a different rulebook.' },
    { href: '/property-management-grandview-heights-ohio/', label: 'Grandview Heights property management', note: 'The other independent city inside Columbus, with the same trap.' },
    { href: '/property-management-columbus-ohio/german-village/', label: 'German Village property management', note: 'Southwest, older stock, historic review to plan around.' },
    { href: '/services/compliance/', label: 'Compliance and rental registration', note: 'What we file for you, and when.' },
    { href: '/pricing/', label: 'Pricing and the full fee schedule', note: 'Every charge that can appear on an owner statement.' },
  ]} heading="Nearby markets and what to read next" />

  <Cta
    heading="Find out what your Bexley rental should earn"
    body="Tell us the address and we will price it against comparable listings live right now. No charge, and no obligation to hire us."
    primary={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondary={{ label: 'Talk to us about a portfolio', href: '/property-management-consultation/' }}
  />
</Base>
