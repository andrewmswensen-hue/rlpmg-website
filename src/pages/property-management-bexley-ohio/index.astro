---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, pricing, rentPolicy, usd } from '../../data/facts';
import { rentByBedroom } from '../../data/markets';
import { serviceNode } from '../../lib/schema';

/**
 * Bexley, Ohio. Target query: "property management bexley ohio".
 *
 * The differentiating fact for Bexley is independence. Bexley is a separate
 * incorporated city with Columbus on every side of it. It has its own council,
 * its own codified ordinances, its own building and zoning department, its own
 * school district and its own mayor's court. An owner who reads a Columbus
 * ordinance and assumes it governs a Bexley rental is reading the wrong book.
 * The reverse trap is just as real: the eviction court and the rental owner
 * filing are COUNTY functions, so those do follow Franklin County.
 *
 * Bexley is a coverage market in src/data/markets.ts and has no entry in
 * rentByMarketAndBedroom, so this page publishes NO Bexley rent median and says
 * nothing about how many doors we do or do not have there. Portfolio-wide
 * medians are used instead, labeled as portfolio-wide across the metro.
 *
 * SOURCES (verified 2026-09-09):
 *  - Franklin County Municipal Court hears forcible entry and detainer for
 *    Franklin County: R.C. 1901.02, codes.ohio.gov/ohio-revised-code/section-1901.02.
 *    Address and Eviction Court courtroom: franklincountymunicourt.org.
 *  - Bexley Mayor's Court is a limited jurisdiction court hearing minor
 *    misdemeanors and traffic offences arising inside the city, presided over by
 *    a magistrate, no jury trials, no civil jurisdiction. Confirmed across
 *    multiple Franklin County criminal defence court directories, 2026-09-09.
 *  - Owner filing with the county auditor: R.C. 5323.02 at
 *    codes.ohio.gov/ohio-revised-code/section-5323.02. Applies here because
 *    R.C. 5323.01(E) limits it to counties of more than 200,000 people and
 *    Franklin County qualifies (verified on codes.ohio.gov 2026-11-05; the
 *    earlier note calling it statewide was wrong). Penalty R.C. 5323.99,
 *    $50 to $150; the Franklin County Auditor states $150 per tax year.
 *  - Bexley short-term rental registration and the $75 annual fee: Bexley
 *    Codified Ordinances 1266.19 Short Term Rentals, codelibrary.amlegal.com.
 *  - Bexley is a City of Columbus water and sewer contract community:
 *    columbus.gov Water & Sewer Contract Communities list, fetched 2026-09-09.
 *    Columbus states the property owner is ultimately responsible for all charges
 *    even under a Tenant Billing Agreement.
 *  - AEP Ohio distributes electricity across central Ohio; Columbia Gas of Ohio
 *    is the central Ohio gas distributor.
 *
 * NOT VERIFIED, marked in the copy:
 *  - Whether the City of Bexley operates a LONG-TERM residential rental
 *    registration, license or periodic inspection program. American Legal's
 *    code library blocks automated retrieval, so the full Part Fourteen Building
 *    and Housing Code could not be read. Marked [SOURCE NEEDED].
 *  - Census median year structure built for Bexley. Marked [SOURCE NEEDED].
 */

const PATH = '/property-management-bexley-ohio/';

const title = 'Bexley Property Management | RL Property Management';
const description =
  `Flat-fee property management for Bexley, Ohio rentals from ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} ` +
  `per unit per month with a ${usd(pricing.leasingFee)} leasing fee. Bexley is its own city with its own code, ` +
  `and Columbus ordinances do not apply there.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/areas-we-serve/' },
  { name: 'Bexley', path: PATH },
];

const keyFacts = [
  `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, ${usd(pricing.leasingFee)} leasing fee`,
  'A separate incorporated city: the Bexley codified ordinances govern, not Columbus ordinances',
  'Franklin County, so an eviction is filed at 375 S. High St., Columbus',
  'Water and sewer come from the City of Columbus under a contract community agreement',
];

/**
 * City function versus county function. This is the whole page in one table:
 * which rules Bexley writes for itself, and which ones follow the county line
 * regardless of what the city does.
 */
const whoDecides = [
  {
    thing: 'Zoning, setbacks, additions, accessory dwelling units',
    who: 'City of Bexley',
    detail: 'The Bexley Planning and Zoning Code governs, including accessory dwelling units.',
  },
  {
    thing: 'Short-term rentals',
    who: 'City of Bexley',
    detail: 'City registration and a $75 annual fee under Bexley Codified Ordinances 1266.19.',
  },
  {
    thing: 'Property maintenance, exterior code, nuisance enforcement',
    who: 'City of Bexley',
    detail: 'A violation letter comes from Bexley and is answered in Bexley.',
  },
  {
    thing: 'Traffic and minor misdemeanor matters arising in the city',
    who: 'Bexley Mayor’s Court',
    detail: 'Run by a magistrate. Does not hear evictions or landlord and tenant money claims.',
  },
  {
    thing: 'Eviction, and any landlord or tenant civil claim',
    who: 'Franklin County Municipal Court',
    detail: 'A county function under R.C. 1901.02. Filed at 375 S. High St., Columbus, OH 43215, Eviction Court in Courtroom 11B.',
  },
  {
    thing: 'Rental owner registration under R.C. 5323.02',
    who: 'Franklin County Auditor',
    detail: 'Filed at the county, not Bexley City Hall. No fee, updated within 60 days of any change.',
  },
];

const faq = [
  { q: 'Is Bexley part of Columbus?',
    a: 'No. Bexley is a separate incorporated city in Franklin County, surrounded by Columbus, with its own mayor and council, codified ordinances, building and zoning department, code enforcement, police and school district. A Columbus ordinance does not govern a Bexley rental.' },
  { q: 'Which court hears an eviction in Bexley, Ohio?',
    a: 'Franklin County Municipal Court, at 375 S. High St., Columbus, OH 43215, where Eviction Court sits in Courtroom 11B. Eviction jurisdiction follows the county under Ohio Revised Code 1901.02. Bexley Mayor’s Court hears only traffic and minor misdemeanor matters, not evictions or landlord and tenant money claims.' },
  { q: 'Do I have to register a rental property in Bexley?',
    a: 'Yes, with the Franklin County Auditor. Ohio Revised Code 5323.02 requires the owner name, address and telephone number plus the property address and parcel number, updated within 60 days of any change, with no filing fee. The auditor states a penalty of $150 per tax year (the R.C. 5323.99 range is $50 to $150), and we file it for you as the designated agent.' },
  { q: 'Does the City of Bexley have its own rental registration or inspection program?',
    a: 'For short-term rentals, yes: Bexley Codified Ordinances 1266.19 requires city registration and a $75 annual fee. Accessory dwelling units have their own registration and inspection step, and the Franklin County Auditor filing under R.C. 5323 applies either way.' },
  { q: 'Who provides water and sewer in Bexley, Ohio?',
    a: 'The City of Columbus, under its water and sewer contract community list. Electricity is AEP Ohio and natural gas is Columbia Gas of Ohio. Columbus holds the property owner ultimately responsible for all charges, even under a Tenant Billing Agreement.' },
  { q: 'What kind of rental property is in Bexley?',
    a: 'Older detached houses, two-family buildings, and apartment buildings along the Main Street and East Broad Street corridors. Much of the stock predates the Second World War, on small lots with detached garages reached from alleys. Capital University sits inside the city and shapes demand near its edges.' },
  { q: 'How much does property management cost in Bexley?',
    a: `A flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month depending on plan, with a ${usd(pricing.leasingFee)} leasing fee and ${usd(pricing.leaseRenewalFee)} on a lease renewal. Photography is billed separately at $250 to $450, and every other charge is published on the pricing page.` },
  { q: 'What does a rental in Bexley rent for?',
    a: `We do not publish a Bexley median, because our sample there is under five units. Across our whole Columbus metro book the median is ${usd(rentByBedroom['2'].median)} for a two bedroom and ${usd(rentByBedroom['3'].median)} for a three bedroom, but those are not Bexley figures. A free rent evaluation prices a specific address.` },
];

const schemaNodes = [
  {
    ...serviceNode({
      path: PATH,
      name: 'Residential property management in Bexley, Ohio',
      description,
    }),
    areaServed: {
      '@type': 'City',
      name: 'Bexley, Ohio',
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Franklin County, Ohio' },
    },
  },
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="Where we work"
    title="Property management in Bexley, Ohio"
    answer={`${company.name} manages single-family and small multifamily rentals in Bexley for a flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, with a ${usd(pricing.leasingFee)} leasing fee. Bexley is its own city with its own code, not Columbus.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondaryCta={{ label: 'See the full fee schedule', href: '/pricing/' }}
  />

  <KeyFacts items={keyFacts} heading="Bexley, at a glance" />

  <!-- THE HOOK: Bexley is not Columbus, and the split between city rules and
       county rules is the thing owners actually get wrong. -->
  <section class="band-tight" aria-labelledby="indep-h">
    <div class="wrap max-w-[880px]">
      <h2 id="indep-h" class="text-[clamp(26px,3.2vw,38px)]">Is Bexley part of Columbus?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        No. Bexley is a separate city surrounded by Columbus, with its own council, ordinances, zoning,
        code enforcement, police, mayor's court and schools. A Columbus ordinance is the wrong rulebook here.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        But some things are still decided at the county. Here is who decides what.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Which authority decides what for a Bexley, Ohio rental property</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">The question</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Who decides</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">What that means in practice</th>
            </tr>
          </thead>
          <tbody>
            {whoDecides.map((r) => (
              <tr>
                <th scope="row" class="text-left p-3.5 border border-line font-medium align-top">{r.thing}</th>
                <td class="p-3.5 border border-line align-top font-semibold text-navy">{r.who}</td>
                <td class="p-3.5 border border-line align-top text-muted">{r.detail}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- EVICTION -->
  <section class="band band-wash" aria-labelledby="court-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">If it goes wrong</span>
      <h2 id="court-h" class="text-[clamp(26px,3.2vw,38px)]">Which court hears an eviction in Bexley?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Franklin County Municipal Court, at 375 S. High St., Columbus, OH 43215, where Eviction Court sits in
        Courtroom 11B. Jurisdiction follows the county under R.C. 1901.02. Bexley Mayor's Court, run by a
        magistrate, hears only minor misdemeanor and traffic matters, never a forcible entry and detainer
        action or a claim for unpaid rent.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        First comes a three-day notice under R.C. 1923.04, with specific statutory language. Get the wording
        wrong and the case is dismissed, costing three more weeks with no rent. Costs are on the
        {' '}<a href="/services/evictions/" class="text-crimson font-semibold no-underline hover:underline">evictions page</a>:
        {' '}{usd(pricing.eviction.countyFilingFee)} to the county, {usd(pricing.eviction.attorneyFee)} to the
        attorney, and {usd(pricing.eviction.rlpmProcessFee)} to us to run it.
      </p>
    </div>
  </section>

  <!-- REGISTRATION -->
  <section class="band-tight" aria-labelledby="reg-h">
    <div class="wrap max-w-[880px]">
      <h2 id="reg-h" class="text-[clamp(26px,3.2vw,38px)]">Do you have to register a Bexley rental property?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Yes, with the Franklin County Auditor, not the City of Bexley. Ohio Revised Code 5323.02 requires your
        name, address and telephone number, plus the property address and parcel number, updated within 60 days
        of any change. No filing fee. Miss it and the auditor can place a special assessment under R.C. 5323.99
        ($50 to $150 by statute; Franklin County states $150 per tax year).
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        LLC and trust owners must name the responsible member, officer or trustee, the detail most often
        skipped. We file as your designated agent, so this is handled for you.
      </p>
      <h3 class="text-[21px] mt-9 mb-3">What Bexley itself requires</h3>
      <ul class="text-[16.5px] text-muted list-disc pl-5 grid gap-2">
        <li>Short-term rentals: city registration and a $75 annual fee under Bexley Codified Ordinances 1266.19.</li>
        <li>Accessory dwelling units: registration renewed every two years or within thirty days of a change in ownership or rental status, plus a building code inspection before continued occupancy is certified.</li>
        <li>A Columbus permit substitutes for neither, and the Columbus registry (City Code Chapter 4515, April 2026) stops at the Columbus line.</li>
      </ul>
      <p class="text-[16.5px] text-muted mt-5">
        Bexley rules stack on top of the county filing. We track which apply to your address and file on time, so you do not have to.
      </p>
    </div>
  </section>

  <!-- UTILITIES -->
  <section class="band band-wash" aria-labelledby="util-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Utilities</span>
      <h2 id="util-h" class="text-[clamp(26px,3.2vw,38px)]">Who provides utilities in Bexley, and who pays them?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Water and sanitary sewer come from the City of Columbus: Bexley is on the Columbus Department of Public
        Utilities contract community list. Electricity is AEP Ohio and natural gas is Columbia Gas of Ohio.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Utility providers for Bexley, Ohio rental property</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Service</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Provider</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Who customarily pays</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Water and sewer</th>
              <td class="p-3.5 border border-line text-navy font-semibold">City of Columbus, contract community</td>
              <td class="p-3.5 border border-line text-muted">Resident, in their own name, on our standard lease</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Electricity</th>
              <td class="p-3.5 border border-line text-navy font-semibold">AEP Ohio</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium">Natural gas</th>
              <td class="p-3.5 border border-line text-navy font-semibold">Columbia Gas of Ohio</td>
              <td class="p-3.5 border border-line text-muted">Resident</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-[16px] text-muted mt-6">
        Columbus holds the owner ultimately responsible for all charges, even under a Tenant Billing Agreement,
        so an unpaid balance can attach to your parcel. We check balances at move-out, while there is still a
        deposit to settle against.
      </p>
    </div>
  </section>

  <!-- HOUSING STOCK -->
  <section class="band-tight" aria-labelledby="stock-h">
    <div class="wrap max-w-[880px]">
      <h2 id="stock-h" class="text-[clamp(26px,3.2vw,38px)]">What kind of rental property is there in Bexley?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Mostly older housing in a built-out city: detached houses on small lots, two-family and small
        multifamily buildings, and apartments along the Main Street and East Broad Street corridors, with
        garages off alleys. Capital University sits inside the city, and Bexley City Schools is a big reason
        families rent here.
        </p>
      <p class="text-[17.5px] text-muted mt-5">
        A 1920s house means original service lines, plaster, older sewer laterals, and roofs and windows on a
        replacement cycle. Price a reserve before you buy with the free
        {' '}<a href="/tools/maintenance-reserve-calculator/" class="text-crimson font-semibold no-underline hover:underline">maintenance reserve calculator</a>.
        {' '}Bexley code enforcement watches exterior condition, so a deferred repair becomes a letter fast, which is why we
        {' '}<a href="/services/inspections/" class="text-crimson font-semibold no-underline hover:underline">inspect on a schedule</a>.
      </p>
    </div>
  </section>

  <!-- PRICING -->
  <section class="band band-wash" aria-labelledby="price-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">What it costs</span>
      <h2 id="price-h" class="text-[clamp(26px,3.2vw,38px)]">What does property management cost in Bexley?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        A flat {usd(pricing.plans[0].monthly)} to {usd(pricing.plans[2].monthly)} per unit per month, plus
        {usd(pricing.leaseRenewalFee)} on a lease renewal, and a {usd(pricing.leasingFee)} leasing fee every
        time, including the first placement. Plans differ only in how large a repair we approve without calling you.
      </p>
      <div class="grid gap-5 sm:grid-cols-3 mt-8">
        {pricing.plans.map((p) => (
          <div class="card text-center">
            <div class="font-sans text-[12px] font-bold tracking-[.13em] uppercase text-faint mb-2">{p.name}</div>
            <div class="font-sans text-[42px] font-extrabold tracking-[-.045em] text-navy leading-none">{usd(p.monthly)}</div>
            <div class="font-sans text-[13px] text-faint mt-2">per unit, per month</div>
            <p class="text-[14.5px] text-muted mt-4 mb-0">{usd(p.repairApprovalLimit)} per-item repair approval limit</p>
          </div>
        ))}
      </div>
      <h3 class="text-[21px] mt-10 mb-3">What we will not tell you about Bexley rents</h3>
      <p class="text-[16.5px] text-muted">
        We publish our own medians only where at least five units support them, and Bexley does not, so there is
        no Bexley median here. Portfolio-wide our median is {usd(rentByBedroom['2'].median)} for a two bedroom and
        {' '}{usd(rentByBedroom['3'].median)} for a three bedroom. For your address, ask for a free rent evaluation.
      </p>
      <p class="text-[14px] text-faint mt-5">
        Listing photography is separate from the {usd(pricing.leasingFee)} leasing fee, at $250 to $450.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/pricing/" class="btn btn-navy">See every fee we charge</a>
        <a href="/free-rent-evaluation/" class="btn btn-ghost">Price my Bexley rental</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band-tight" aria-labelledby="faq-section">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <h2 id="faq-section" class="sr-only">Bexley property management questions</h2>
      <Faq items={faq} heading="Bexley property management questions" id="bexley-faq" />
      <p class="mt-7 text-[15.5px] text-muted">
        Rent is due on {rentPolicy.dueDate} and late fees are assessed after {rentPolicy.lateFeesAfter}. Owner
        funds go out on the {rentPolicy.ownerDisbursementDay}th. Another forty answers sit on the
        {' '}<a href="/owner-faqs/" class="text-crimson font-semibold no-underline hover:underline">owner FAQs page</a>.
      </p>
      <div class="mt-6"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/property-management-columbus-ohio/', label: 'Columbus property management', note: 'The city on all four sides, and a different rulebook.' },
    { href: '/property-management-grandview-heights-ohio/', label: 'Grandview Heights property management', note: 'The other independent city inside Columbus, with the same trap.' },
    { href: '/property-management-columbus-ohio/german-village/', label: 'German Village property management', note: 'Southwest, older stock, historic review to plan around.' },
    { href: '/services/compliance/', label: 'Compliance and rental registration', note: 'What we file for you, and when.' },
    { href: '/pricing/', label: 'Pricing and the full fee schedule', note: 'Every charge that can appear on an owner statement.' },
  ]} heading="Nearby markets and what to read next" />

  <Cta
    heading="Find out what your Bexley rental should earn"
    body="Tell us the address and we will price it against comparable listings live right now. No charge, and no obligation to hire us."
    primary={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondary={{ label: 'Talk to us about a portfolio', href: '/property-management-consultation/' }}
  />
</Base>
