---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { company } from '../../data/facts';

/**
 * A plain description of what this website collects and where it goes.
 *
 * Deliberately short. Andrew, 2026-09-10: RLPM does not want the site making
 * legal claims or reading as defensive boilerplate. The previous draft ran to
 * nearly 2,000 words with 13 open questions for counsel, which was over-built
 * for what this page is.
 *
 * The live rlpmg.com does have a privacy policy, so this page stays, but it is
 * now what it should have been: a factual note about the site's own data flows,
 * written so a person can read it. It states no legal position and makes no
 * claim about which statutes apply. If counsel later wants specific language,
 * it is one page to update.
 */
const title = `Privacy Policy | ${company.name}`;
const description =
  `What ${company.name} collects through this website, what we do with it, and how to reach us about it.`;
const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Privacy policy', path: '/privacy-policy/' }];
---
<Base {title} {description} {breadcrumbs}>
  <PageHero
    eyebrow="Privacy"
    title="Privacy policy"
    answer={`This describes what ${company.name} collects through rlpmg.com, what we use it for, and how to ask us about it. It covers this website. It does not cover the resident and owner portals, which are run on separate systems.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Contact us', href: '/contact-us/' }}
    secondaryCta={{ label: `Email ${company.email}`, href: `mailto:${company.email}` }}
  />

  <section class="band-tight">
    <div class="wrap max-w-[760px]">
      <div class="prose-rl">
        <h2>What we collect</h2>
        <p>
          Only what you type into a form. That usually means your name, email
          address, phone number, and the address of a property you are asking
          about. Nothing on this site asks for a payment method, a Social
          Security number, or a date of birth.
        </p>

        <h2>What we do with it</h2>
        <p>
          We use it to answer you. A form submission reaches our team so someone
          can reply, and it is stored in the system we use to track enquiries. We
          do not sell it, and we do not share it with anyone who is not helping
          us respond to you.
        </p>

        <h2>Analytics</h2>
        <p>
          We use standard website analytics to see which pages people read and
          where they arrive from. That data is aggregated and is not used to
          identify you. Most browsers let you block analytics if you prefer.
        </p>

        <h2>What this page does not cover</h2>
        <p>
          Applying for a home, paying rent, and submitting maintenance requests
          all happen in separate systems with their own privacy terms. So does
          the owner portal. This page is about the website only.
        </p>

        <h2>Asking us about your information</h2>
        <p>
          Email <a href={`mailto:${company.email}`}>{company.email}</a> or call
          {' '}{company.phone} and ask. If you want us to delete an enquiry you
          sent us, say so and we will.
        </p>

        <h2>Changes</h2>
        <p>
          If this changes we will update this page and the date below.
        </p>
      </div>
      <div class="mt-9"><Verified date="2026-09-10" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/contact-us/', label: 'Contact us', note: `${company.phone} or ${company.email}` },
    { href: '/about/', label: 'About RL Property Management', note: 'Who we are and how we work' },
    { href: '/client-handbook/', label: 'Client handbook', note: 'How we operate, in full' },
  ]} />
</Base>
