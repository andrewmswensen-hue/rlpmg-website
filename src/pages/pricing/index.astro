      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/property-management-consultation/#consultation-form" class="btn btn-on-dark">Schedule a free consultation</a>
        <a href={`tel:${company.salesPhoneE164}`} class="btn btn-outline-light">Call {company.salesPhone}</a>
      </div>
    </div>
  </section>
</Base>

