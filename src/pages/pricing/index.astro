---
import Base from '../../layouts/Base.astro';
import PricingTable from '../../components/PricingTable.astro';
import Faq from '../../components/Faq.astro';
import { company, pricing, kpis, commitments, rentPolicy, usd, tierPrice, typicalManager } from '../../data/facts';
import { rentByBedroom } from '../../data/markets';
import { serviceNode } from '../../lib/schema';

/**
 * The highest-value page on the site.
 *
 * "How much does property management cost in Columbus" is a late-stage commercial
 * query RLPM can answer better than anyone locally, because the prices are public.
 * Every figure reads from src/data/facts.ts, which is sourced from the Client
 * Handbook. Nothing here is hand-typed.
 */

const title = 'Property Management Pricing in Columbus, Ohio | RL Property Management';
const description =
  `Flat property management pricing from ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} ` +
  `per unit per month with a ${usd(pricing.leasingFee)} leasing fee. The complete Columbus fee schedule, published in the open.`;
const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Pricing', path: '/pricing/' }];

const std = pricing.plans[1];   // the middle plan, used for every worked comparison
/** Three rent points, to show how a flat fee behaves as rent rises. Derived, not typed. */
const rents = [1200, 1650, 2100];
const compare = rents.map((rent) => {
  const rl = std.monthly * 12;
  const lease = typicalManager.leasingFee(rent);   // facts.ts: 75% of one month's rent
  // Monthly fees only.
  const f8 = Math.round(rent * 0.08) * 12;
  const f10 = Math.round(rent * 0.10) * 12;
  // A year with one resident placement: add the typical leasing fee (ours is $0).
  const p8 = f8 + lease;
  const p10 = f10 + lease;
  return { rent, rl, lease, f8, f10, p8, p10,
           fsave8: f8 - rl, fsave10: f10 - rl, save8: p8 - rl, save10: p10 - rl };
});
/** Honest savings wording: a range when both are positive, and say so plainly when we cost more. */
const saveText = (a: number, b: number) =>
  a > 0 && b > 0 ? `${usd(a)} to ${usd(b)}`
  : a <= 0 && b > 0 ? `Up to ${usd(b)}`
  : `${usd(-b)} to ${usd(-a)} more with us`;
const mid = compare[1];

/**
 * The animated bar chart above the yearly table (Andrew, 2026-11-13). Every bar is
 * scaled against the largest yearly cost in EITHER view, so flipping the toggle
 * visibly changes bar length. Each row has a fees-only bar (.v-f) and a bar with
 * the leasing fee stacked on as a lighter segment (.v-l); CSS shows one.
 */
const chartMax = Math.max(...compare.flatMap((c) => [c.rl + pricing.leasingFee, c.p8, c.p10, c.f8, c.f10]));
const barW = (n: number) => (n / chartMax).toFixed(4);
const chartRows = (c: (typeof compare)[number]) => [
  { name: 'RL', fee: c.rl, lease: pricing.leasingFee, rl: true },
  { name: 'Typical 8%', fee: c.f8, lease: c.lease, rl: false },
  { name: 'Typical 10%', fee: c.f10, lease: c.lease, rl: false },
];
/** One plain-English savings line per rent. Says so outright when a percentage manager costs less. */
const chartSave = (a: number, b: number) =>
  a > 0 && b > 0 ? `You save ${usd(a)} to ${usd(b)} a year`
  : a <= 0 && b > 0 ? `You save ${usd(b)} a year against a 10% manager. An 8% manager costs ${usd(-a)} less.`
  : `On monthly fees alone, a percentage manager costs ${usd(-b)} to ${usd(-a)} less`;
/** What a screen reader hears instead of the bars (the table below stays the full data). */
const chartSummary = (lease: boolean) =>
  `Bar chart of yearly cost, ${lease ? 'in a year with one resident placement' : 'monthly fees only'}. ` +
  compare.map((c) =>
    `At ${usd(c.rent)} rent: RL ${usd(c.rl + (lease ? pricing.leasingFee : 0))}, ` +
    `typical 8% manager ${usd(lease ? c.p8 : c.f8)}, typical 10% manager ${usd(lease ? c.p10 : c.f10)}.`).join(' ');

const included = [
  'Listing syndication to every major rental portal',
  'Self-guided and agent-led showings',
  'Full resident screening: credit, criminal, income, rental history and eviction',
  'Lease preparation on a custom lease reviewed by legal counsel',
  'Online rent collection and automated late notices',
  `Owner direct deposit on the ${rentPolicy.ownerDisbursementDay}th of each month`,
  'Monthly statements and a real-time owner portal',
  'Maintenance coordination and 24/7 emergency response',
  'Quarterly property inspections',
  'Ohio landlord-tenant compliance and eviction coordination',
];

/** The other side of the picture: what is billed on top of the monthly fee. Every value reads from facts.ts. */
const techFee = pricing.otherFees.find((f) => f.name.startsWith('Annual technology'));
const extras = [
  `Lease renewal: ${usd(pricing.leaseRenewalFee)}, charged when the lease renews`,
  `In-house repairs: ${usd(pricing.maintenance.inHouseHourly)} per hour plus a ${usd(pricing.maintenance.tripCharge)} trip charge, materials at cost`,
  `Vendor repairs: vendor cost plus ${pricing.maintenance.vendorProjectFeePct}%, capped at ${usd(pricing.maintenance.vendorProjectFeeCap)} per project`,
  ...(techFee ? [`${techFee.name}: ${techFee.amount}`] : []),
  'Startup on a vacant unit: varies, quoted in writing before you sign',
  'Eviction costs and a short list of situational fees, only if they apply',
];

const coreFees = [
  ['Monthly management', `${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit`, 'Flat by plan, not a percentage of rent. Discounted for larger portfolios.'],
  ['Leasing fee', usd(pricing.leasingFee), 'Every plan. Covers syndication, showings, screening and lease preparation.'],
  ['Lease renewal', usd(pricing.leaseRenewalFee), 'Charged to the owner on the date the lease renews.'],
  ['Startup fee, occupied unit', usd(pricing.startupFeeOccupied), 'No charge to bring an occupied unit under management.'],
  ['Startup fee, vacant unit', 'Varies', 'By unit count and plan. Quoted in writing before you sign.'],
  ['Maintenance reserve', `${usd(pricing.reserves.min)} to ${usd(pricing.reserves.max)} per unit`, 'Held on your account so routine repairs do not wait on funding. It stays your money.'],
];
const maintFees = [
  ['In-house labor', `${usd(pricing.maintenance.inHouseHourly)} per hour`, `Plus a ${usd(pricing.maintenance.tripCharge)} trip charge per visit, materials at cost. No minimum charge. ${pricing.maintenance.rateYear} rate.`],
  ['After-hours labor', `${pricing.afterHours.weekdayEveningAndSaturday}x or ${pricing.afterHours.sunday}x`, `${pricing.afterHours.weekdayEveningAndSaturday}x on weekday evenings and Saturdays, ${pricing.afterHours.sunday}x on Sundays.`],
  ['Vendor project management', `${pricing.maintenance.vendorProjectFeePct}% of vendor cost`, `Applies to vendor costs up to ${usd(pricing.maintenance.vendorProjectFeeAppliesUpTo)}, capped at ${usd(pricing.maintenance.vendorProjectFeeCap)} per project. Waived on insurance claim work.`],
  ['Vendor fee on turns', '15%, 10%, 7.5%', `15% on turns up to ${usd(15000)}, 10% from ${usd(15001)} to ${usd(25000)}, 7.5% above ${usd(25000)}.`],
];
const evictionFees = [
  ['Attorney fee', usd(pricing.eviction.attorneyFee), 'Paid to the eviction attorney for filing and up to two court appearances.'],
  ['Court filing fee', usd(pricing.eviction.countyFilingFee), 'The Eviction Complaint. Paid to Franklin County.'],
  ['Eviction management', usd(pricing.eviction.rlpmProcessFee), `Paid to ${company.shortName} for running the process, including up to two appearances.`],
  ['Tag and setout', usd(pricing.eviction.tagAndSetoutFee), 'Paid to Franklin County, only if the resident has not vacated.'],
  ['Setout', usd(pricing.eviction.setoutFee), `Paid to ${company.shortName}, only if a setout is required. Covers bailiff and locksmith scheduling.`],
];

const faq = [
  { q: 'How much does property management cost in Columbus, Ohio?',
    a: `${company.name} charges a flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month depending on the plan, with no leasing fee. Most Columbus managers charge 8% to 10% of collected rent plus about ${typicalManager.leasingFeePhrase} to place each resident.` },
  { q: 'Do you charge a leasing fee?',
    a: `No. Placing a resident costs ${usd(pricing.leasingFee)} on every plan, covering listing syndication, showings, full applicant screening and lease preparation. On a ${usd(mid.rent)} rent, a manager charging ${typicalManager.leasingFeePhrase} would bill ${usd(mid.lease)} for the same work.` },
  { q: 'Is flat fee or percentage property management better?',
    a: `A flat fee costs the same whether rent is ${usd(1200)} or ${usd(2100)}, and it does not rise when rent does. A percentage fee compounds with every rent increase. On a ${usd(mid.rent)} rent in a year that includes one resident placement, ${company.name} at ${usd(std.monthly)} a month costs ${usd(mid.rl)} against roughly ${usd(mid.p10)} for a typical 10% manager.` },
  { q: 'Do you discount pricing for larger portfolios?',
    a: `Yes. ${pricing.portfolioDiscount.line} Switch the pricing above to Investor to see the rate for your portfolio size.` },
  { q: 'Is there a startup fee?',
    a: 'There is no startup fee on an occupied unit. On a vacant unit the fee varies by total unit count and plan, and it is quoted in writing before you sign anything.' },
  { q: 'What does an eviction cost in Franklin County?',
    a: `The hard cost is ${usd(pricing.eviction.hardCostTotal)}: ${usd(pricing.eviction.attorneyFee)} to the eviction attorney and ${usd(pricing.eviction.countyFilingFee)} to Franklin County for the filing. ${company.name} charges ${usd(pricing.eviction.rlpmProcessFee)} to manage the process, and a setout, if needed, adds ${usd(pricing.eviction.tagAndSetoutFee)} to the county and ${usd(pricing.eviction.setoutFee)} to us. Roughly ${pricing.eviction.disputeRatePct}% of rentals reach eviction, litigation or another significant dispute.` },
  { q: 'What happens if my property sits vacant?',
    a: 'If a property has been listed for rent longer than 60 days, we proactively credit management fees back to your account.' },
  { q: 'What is the maintenance reserve for?',
    a: `A reserve of ${usd(pricing.reserves.min)} to ${usd(pricing.reserves.max)} per unit is held on your account so routine repairs do not wait on funding. It remains your money and is returned when management ends.` },
  { q: 'What insurance do you require?',
    a: `A Rental Dwelling Policy or Commercial Policy carrying at least ${usd(pricing.insuranceRequired.liabilityMin)} in liability coverage, with ${company.name} named as an additional insured.` },
];

const investorOffers = pricing.portfolioDiscount.tiers.flatMap((t) =>
  pricing.plans.map((p) => ({ plan: p.name, label: t.label, min: t.min, max: t.max, price: tierPrice(p.monthly, t.pct) })),
);

const schemaNodes = [
  serviceNode({ path: '/pricing/', name: 'Residential property management', description }),
  {
    '@type': 'PriceSpecification',
    '@id': `${company.url}/pricing/#pricespec`,
    name: 'Flat monthly property management',
    minPrice: Math.min(...investorOffers.map((o) => o.price)),
    maxPrice: pricing.plans[2].monthly,
    priceCurrency: 'USD',
    valueAddedTaxIncluded: false,
    description: `Per unit, per month. Not a percentage of collected rent. No leasing fee. ${pricing.portfolioDiscount.line}`,
  },
  /**
   * Volume pricing, the schema.org way: one Offer per plan per tier, each with
   * an eligibleQuantity range in rental units. Kept on this page rather than in
   * the sitewide Organization node so every other page's JSON-LD stays lean.
   */
  {
    '@type': 'OfferCatalog',
    '@id': `${company.url}/pricing/#investor-pricing`,
    name: 'Investor pricing by portfolio size',
    itemListElement: investorOffers.map((o) => ({
      '@type': 'Offer',
      name: `${o.plan}, ${o.label}`,
      price: o.price,
      priceCurrency: 'USD',
      eligibleQuantity: { '@type': 'QuantitativeValue', minValue: o.min, maxValue: o.max, unitText: 'rental units' },
      priceSpecification: { '@type': 'UnitPriceSpecification', price: o.price, priceCurrency: 'USD', unitText: 'per unit per month' },
      seller: { '@id': `${company.url}/#organization` },
    })),
  },
];
import MotionScript from '../../components/MotionScript.astro';
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>
  <MotionScript />

  <section class="pt-14 pb-10">
    <div class="wrap max-w-[880px]">
      <nav aria-label="Breadcrumb" class="mb-5 text-[13px] text-faint">
        <a href="/" class="no-underline hover:text-crimson">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">Pricing</span>
      </nav>
      <span class="eyebrow">Clear pricing</span>
      <h1 class="text-[clamp(34px,4.4vw,52px)] tracking-[-.022em]">
        What property management costs in Columbus
      </h1>
      <p class="text-[20px] text-muted mt-5 max-w-[38em]">
        A flat {usd(pricing.plans[0].monthly)} to {usd(pricing.plans[2].monthly)} per unit per month, not a
        percentage of rent. {usd(pricing.leasingFee)} leasing fee, no startup fee on occupied units, and up to
        {' '}{Math.max(...pricing.portfolioDiscount.tiers.map((t) => t.pct))}% off for investors with five or more units.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/property-management-consultation/#consultation-form" class="btn btn-primary">Schedule a free consultation</a>
        <a href="#plans-h" class="btn btn-ghost">See pricing for your portfolio</a>
      </div>
    </div>
  </section>

  <!-- PLANS -->
  <section class="band-tight" aria-labelledby="plans-h">
    <div class="wrap">
      <h2 id="plans-h" class="sr-only">Management plans</h2>
      <PricingTable id="pricing-page" />

      <p class="text-center mt-6 text-[15px] text-muted">
        The plans differ in one thing: how much repair spending we approve without asking you first.
      </p>

      <!-- The $0 leasing fee. Sits under the plans so it reads as a footnote to the
           pricing rather than interrupting the scroll between the hero and the plans. -->
      <div class="mt-8 rounded-[18px] bg-maroon text-white px-7 py-6 md:px-9 md:py-7
                  flex flex-col md:flex-row md:items-center gap-5 md:gap-9">
        <div class="shrink-0 text-center md:text-left md:border-r md:border-white/20 md:pr-9">
          <div class="font-sans text-[clamp(44px,5.5vw,60px)] font-extrabold leading-none tracking-[-.05em]">$0</div>
          <div class="font-sans text-[11px] font-bold tracking-[.16em] uppercase text-[#e8b9c0] mt-1.5">Leasing fee</div>
        </div>
        <p class="text-[#e9d0d4] text-[16.5px] m-0">
          Most Columbus managers charge about {typicalManager.leasingFeePhrase} to place a resident: on a
          {usd(mid.rent)} rent, <strong class="text-white font-semibold">{usd(mid.lease)} every time the unit turns</strong>.
          We charge nothing, on every plan, so we have no reason to prefer a new lease over a renewal.
        </p>
      </div>
    </div>
  </section>

  <!-- INCLUDED / COSTS EXTRA. Sits right under the plans so the whole cost picture is in one place. -->
  <section class="band" aria-labelledby="incl-h">
    <div class="wrap max-w-[940px]">
      <span class="eyebrow">In every plan</span>
      <h2 id="incl-h" class="text-[clamp(28px,3.3vw,40px)]">What the monthly fee covers</h2>
      <div class="grid gap-5 md:grid-cols-2 mt-7">
        <div class="card">
          <h3 class="text-[18.5px] mb-3">Included</h3>
          <ul>
            {included.map((x) => (
              <li class="flex gap-3 py-1.5 text-[15.5px]">
                <span class="text-crimson font-extrabold shrink-0" aria-hidden="true">✓</span><span>{x}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="card">
          <h3 class="text-[18.5px] mb-3">Costs extra</h3>
          <ul>
            {extras.map((x) => (
              <li class="flex gap-3 py-1.5 text-[15.5px]">
                <span class="text-navy font-extrabold shrink-0" aria-hidden="true">+</span><span>{x}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-[14.5px] text-muted m-0">
            Every amount is in the <a href="#fees-h" class="text-crimson font-semibold no-underline hover:underline">complete fee schedule</a> below.
          </p>
        </div>
      </div>
      <p class="mt-6 text-[15px] text-muted">
        Median rent across the {company.unitsManaged} units we manage:
        {Object.entries(rentByBedroom).map(([b, v], i, arr) => (
          <span>{' '}{b} bed {usd(v.median)}{i < arr.length - 1 ? ',' : '.'}</span>
        ))}
      </p>
    </div>
  </section>

  <!-- FLAT VS PERCENTAGE, THREE RENTS.
       Andrew, 2026-11-05: "the math across one year", RL at the standard price
       without a plan name, and a toggle between monthly fees only and a year
       with a resident placement (typical leasing fee 75% of a month, ours $0).
       No JavaScript: radio inputs and :has(), so both views are in the HTML. -->
  <section class="band band-wash" aria-labelledby="compare-h">
    <div class="wrap max-w-[940px] lt">
      <span class="eyebrow">The math across one year</span>
      <h2 id="compare-h" class="text-[clamp(28px,3.3vw,40px)]">A flat fee against a percentage, at three Columbus rents</h2>

      <fieldset class="lt-toggle mt-6" aria-label="What to include in the yearly cost">
        <input type="radio" class="sr-only lt-fees" name="lt-mode" id="lt-fees" value="fees" />
        <label for="lt-fees">Monthly fees only</label>
        <input type="radio" class="sr-only lt-lease" name="lt-mode" id="lt-lease" value="lease" checked />
        <label for="lt-lease">Plus a leasing fee</label>
      </fieldset>

      <p class="text-[17.5px] text-muted mt-4 mb-7 max-w-[44em]">
        <span class="v-l">On years when the property turns over for a new resident, here is what our
        {' '}{usd(pricing.leasingFee)} leasing fee saves you. A typical manager charges about
        {' '}{typicalManager.leasingFeePhrase} to place a resident.</span>
        <span class="v-f">Twelve months of management fees, with no resident placement in the year.</span>
      </p>
      <!-- The chart is decorative for assistive technology: the sr-only summary
           and the table below carry the same numbers. -->
      <p class="sr-only"><span class="v-l">{chartSummary(true)}</span><span class="v-f">{chartSummary(false)}</span></p>
      <div class="lc card" aria-hidden="true">
        <div class="lc-legend">
          <span><i class="lc-sw lc-sw-rl"></i>RL Property Management ({usd(std.monthly)}/mo.)</span>
          <span><i class="lc-sw lc-sw-fee"></i>Typical manager</span>
          <span class="v-l"><i class="lc-sw lc-sw-lease"></i>Leasing fee (ours is {usd(pricing.leasingFee)})</span>
        </div>
        {compare.map((c) => (
          <div class="lc-group">
            <p class="lc-rent">{usd(c.rent)} monthly rent</p>
            {chartRows(c).map((r, i) => (
              <div class="lc-row">
                <span class="lc-name">{r.name}</span>
                <div class="lc-track v-f">
                  <span class={`lc-bar rv-grow-x${r.rl ? ' is-rl' : ''}`} style={`--i:${i};--w:${barW(r.fee)}`}>
                    <span class="lc-seg lc-fee"></span>
                  </span>
                  <span class="lc-val">{usd(r.fee)}</span>
                </div>
                <div class="lc-track v-l">
                  <span class={`lc-bar rv-grow-x${r.rl ? ' is-rl' : ''}`} style={`--i:${i};--w:${barW(r.fee + r.lease)}`}>
                    <span class="lc-seg lc-fee" style={`flex-grow:${r.fee}`}></span>
                    {r.lease > 0 && <span class="lc-seg lc-lease" style={`flex-grow:${r.lease}`}></span>}
                  </span>
                  <span class="lc-val">{usd(r.fee + r.lease)}</span>
                </div>
              </div>
            ))}
            <p class="lc-save">
              <span class="v-l">{chartSave(c.save8, c.save10)}</span><span class="v-f">{chartSave(c.fsave8, c.fsave10)}</span>
            </p>
          </div>
        ))}
      </div>

      <details class="fee-group mt-5">
        <summary><span><span class="fee-group-title">See the numbers as a table</span></span></summary>
        <div class="fee-group-body">
          <div class="scroll-x">
            <table class="w-full border-collapse bg-white text-[15.5px]">
              <caption class="sr-only">Annual management cost at three monthly rents, with and without a resident placement</caption>
              <thead>
                <tr class="bg-wash-soft">
                  <th scope="col" class="text-left p-3.5 border-b border-line font-semibold">Monthly rent</th>
                  <th scope="col" class="text-right p-3.5 border-b border-line font-semibold">RL ({usd(std.monthly)}/mo.)</th>
                  <th scope="col" class="text-right p-3.5 border-b border-line font-semibold">Typical 8%</th>
                  <th scope="col" class="text-right p-3.5 border-b border-line font-semibold">Typical 10%</th>
                  <th scope="col" class="text-right p-3.5 border-b border-line font-semibold">You save</th>
                </tr>
              </thead>
              <tbody>
                {compare.map((c) => (
                  <tr>
                    <th scope="row" class="text-left p-3.5 border-b border-line font-medium tabular-nums">{usd(c.rent)}</th>
                    <td class="text-right p-3.5 border-b border-line tabular-nums font-bold text-crimson">{usd(c.rl)}</td>
                    <td class="text-right p-3.5 border-b border-line tabular-nums text-muted">
                      <span class="v-l">{usd(c.p8)}</span><span class="v-f">{usd(c.f8)}</span>
                    </td>
                    <td class="text-right p-3.5 border-b border-line tabular-nums text-muted">
                      <span class="v-l">{usd(c.p10)}</span><span class="v-f">{usd(c.f10)}</span>
                    </td>
                    <td class="text-right p-3.5 border-b border-line tabular-nums font-semibold text-navy">
                      <span class="v-l">{saveText(c.save8, c.save10)}</span><span class="v-f">{saveText(c.fsave8, c.fsave10)}</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </details>
      <p class="text-[15.5px] text-muted mt-6">
        <span class="v-l">Most of the gap is the leasing fee, and it widens as rent rises because our fee
        does not move when your rent does.</span>
        <span class="v-f">On monthly fees alone, an 8% manager can cost less at lower rents. The
        difference opens up in any year the unit turns over, and grows with every rent increase.</span>
      </p>
      <p class="text-[14px] text-faint mt-4">
        Percentage and leasing figures illustrate common Columbus market rates and are not a quote from any
        named competitor. Our figures are exact.
      </p>
    </div>
  </section>

  <!-- COMMITMENTS -->
  <section class="band band-wash" aria-labelledby="commit-h">
    <div class="wrap max-w-[900px]">
      <span class="eyebrow">What we commit to</span>
      <h2 id="commit-h" class="text-[clamp(28px,3.3vw,40px)]">The parts most managers leave vague</h2>
      <div class="grid gap-5 sm:grid-cols-2 mt-8">
        {commitments.map((c) => (
          <div class="card">
            <h3 class="text-[18.5px] mb-2">{c.name}</h3>
            <p class="text-[15px] text-muted m-0">{c.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FULL FEE SCHEDULE -->
  <section class="band" aria-labelledby="fees-h">
    <div class="wrap max-w-[940px]">
      <span class="eyebrow">Nothing hidden</span>
      <h2 id="fees-h" class="text-[clamp(28px,3.3vw,40px)]">The complete fee schedule</h2>
      <p class="text-[17.5px] text-muted mt-4 mb-8 max-w-[44em]">
        Every charge that can appear on an owner statement. If it is not on this list, we do not charge it.
      </p>

      <!-- Each group collapses. Core pricing is open by default because it answers
           the question people came for; the rest is there for anyone who wants it.
           <details> means this works with zero JavaScript. -->
      {[
        { h: 'Core pricing', rows: coreFees, open: true,
          note: 'The fees that apply to every managed unit.' },
        { h: 'Maintenance', rows: maintFees, open: false,
          note: 'How repair work is billed, in house and through vendors.' },
        { h: 'Eviction, if it comes to that', rows: evictionFees, open: false,
