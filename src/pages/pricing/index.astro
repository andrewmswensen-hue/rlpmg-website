        { h: 'Situational fees', rows: pricing.otherFees.map((f) => [f.name, f.amount, f.note]), open: false,
          note: 'Only in specific circumstances. Most owners never see them.' },
      ].map((group) => (
        <details class="fee-group" open={group.open}>
          <summary>
            <span>
              <span class="fee-group-title">{group.h}</span>
              <span class="fee-group-count">{group.rows.length} {group.rows.length === 1 ? 'item' : 'items'}</span>
            </span>
          </summary>
          <div class="fee-group-body">
            <p class="text-[15px] text-muted mb-4">{group.note}</p>
            <div class="scroll-x">
              <table class="w-full border-collapse text-[15.5px]">
                <caption class="sr-only">{group.h}</caption>
                <thead>
                  <tr class="bg-wash-soft">
                    <th scope="col" class="text-left p-3.5 border border-line font-semibold">Item</th>
                    <th scope="col" class="text-left p-3.5 border border-line font-semibold whitespace-nowrap">Amount</th>
                    <th scope="col" class="text-left p-3.5 border border-line font-semibold">Detail</th>
                  </tr>
                </thead>
                <tbody>
                  {group.rows.map(([item, amount, detail]) => (
                    <tr>
                      <th scope="row" class="text-left p-3.5 border border-line font-medium align-top">{item}</th>
                      <td class="p-3.5 border border-line align-top whitespace-nowrap font-semibold text-navy">{amount}</td>
                      <td class="p-3.5 border border-line align-top text-muted">{detail}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </details>
      ))}

      <p class="text-[14px] text-faint mt-5">
        Full detail lives in the <a href="/client-handbook/" class="text-crimson font-semibold no-underline hover:underline">Client Handbook</a>
        {' '}and in your Property Management Agreement.
      </p>
    </div>
  </section>

  <section class="band band-wash">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Pricing questions" id="pricing-faq" />
      <p class="mt-8 text-[13px] text-faint">
        Pricing verified {kpis.asOfLabel} against the {company.name} Client Handbook.
        Reviewed by {company.brokerOfRecord.name}, {company.brokerOfRecord.title}.
      </p>
    </div>
  </section>

  <section class="bg-maroon text-white text-center py-[88px]">
    <div class="wrap">
      <h2 class="!text-white text-[clamp(30px,3.8vw,46px)] max-w-[16em] mx-auto mb-4">See the number for your property</h2>
      <p class="text-[#e2c8cc] text-[18px] max-w-[36em] mx-auto mb-7">
