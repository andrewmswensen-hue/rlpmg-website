---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, kpis, pricing, rentPolicy, usd, priceRange } from '../../data/facts';

/**
 * The scorecard.
 *
 * Every value renders from `kpis` in the fact bank. Nothing is typed here.
 *
 * The important editorial decision on this page is publishing the measurement
 * definition next to the number. See docs/kpi-methodology.md: days on market is
 * genuinely volatile week to week, so the published figure is a trailing
 * 12-month median, the definition is stated, and the page is refreshed
 * quarterly. A number without a method is marketing.
 *
 * Per AGENTS.md: site-wide figures only. Never per-market days on market.
 */

const title = 'Our Scorecard: RL Property Management by the Numbers';
const description =
  `The published operating numbers for ${company.name}, refreshed quarterly. ` +
  `${kpis.metrics[0].value} median days on market, ${kpis.metrics[3].value} occupancy, ` +
  `${kpis.metrics[6].value} of rent collected by the 5th, as of ${kpis.asOfLabel}.`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Scorecard', path: '/key-performance-indicators/' },
];

const m = Object.fromEntries(kpis.metrics.map((k) => [k.id, k]));

/**
 * What each metric describes, in plain English.
 *
 * `definition` is the exact measurement method and is ONLY populated where the
 * fact bank supplies it. Days on market has one. The other seven describe what
 * the metric is about, and the page says outright that their exact windows and
 * denominators are not yet published. Inventing a methodology here would be
 * worse than admitting it is missing.
 */
const explained = [
  {
    id: 'dom',
    heading: 'Median days on market',
    definition: kpis.domDefinition,
    why: `Every day a unit sits empty is a day of lost rent that never comes back. At the ${m.avgRent.value} average rent under management, an extra month of vacancy is an entire month of rent gone, and no later month makes it back.`,
  },
  {
    id: 'turn',
    heading: 'Median days to turn a unit',
    why: 'A turn is the work between one resident moving out and the next one moving in: cleaning, paint, repairs, and getting the unit ready to show. Turn time and days on market are separate clocks, and a manager who is fast at one can be slow at the other.',
  },
  {
    id: 'renewal',
    heading: 'Lease renewal rate',
    why: 'The share of residents who sign another lease instead of moving out. Renewals are the cheapest possible outcome for an owner, because a renewal has no turn cost, no vacancy and no leasing work. It is also the single best proxy for whether residents are treated decently.',
  },
  {
    id: 'occupancy',
    heading: 'Portfolio occupancy',
    why: 'The share of managed units that are occupied. It is the blunt version of the vacancy question, across the whole book rather than one property.',
  },
  {
    id: 'avgRent',
    heading: 'Average rent under management',
    why: 'What the average managed unit rents for. It is context for every other number on this page: a portfolio of studios and a portfolio of four-bedroom houses do not behave the same way.',
  },
  {
    id: 'repairDays',
    heading: 'Median days to close a repair',
    why: 'From a request being submitted to the work being finished. Slow repairs are how a good resident becomes a former resident, and how a small problem becomes an insurance claim.',
  },
  {
    id: 'collectedBy5',
    heading: 'Rent collected by the 5th',
    why: `The share of rent in hand by the 5th of the month. Rent is due on ${rentPolicy.dueDate}, late fees are assessed after ${rentPolicy.lateFeesAfter}, and owner funds go out on the ${rentPolicy.ownerDisbursementDay}th. Collection speed is what makes that disbursement date possible.`,
  },
  {
    id: 'satisfaction',
    heading: 'Resident satisfaction',
    why: 'How residents rate their experience, out of 5. Owners sometimes treat this as the soft metric. It is not. Unhappy residents leave, and a turn costs an owner more than almost any repair.',
  },
].map((e) => ({ ...e, value: m[e.id].value, label: m[e.id].label }));

const faq = [
  { q: 'What are RL Property Management’s key performance indicators?',
    a: `As of ${kpis.asOfLabel}: ${kpis.metrics.map((k) => `${k.label.toLowerCase()} ${k.value}`).join(', ')}. All eight are published on this page and refreshed quarterly.` },
  { q: 'How is days on market measured?',
    a: `${kpis.domDefinition} It is currently ${m.dom.value} days. The figure is a trailing 12-month median rather than a recent average, because Columbus leasing is seasonal and a 30-day number mostly measures what month it is.` },
  { q: 'How often are these numbers updated?',
    a: `Quarterly. The current set is as of ${kpis.asOfLabel} and every figure on the page carries that date. A weekly refresh is not sustainable by hand, and a number that is quietly stale is worse than no number at all.` },
  { q: 'Why does RL Property Management publish its operating numbers?',
    a: 'Because they are checkable and they are the thing an owner is actually trying to assess. Most property management websites publish adjectives, which cost nothing to write and prove nothing. Publishing a number means it can be held against us at the next quarterly refresh.' },
  { q: 'Do you publish days on market by neighborhood?',
    a: 'No, and that is deliberate. Outside Columbus itself, no single market in the portfolio has enough units leased in a year for a median to mean anything. A figure built on a handful of units is noise presented as data, so we publish site-wide only.' },
  { q: 'Is a lower days on market always better?',
    a: 'No. A unit priced below market will lease in three days, and the owner will pay for that discount every month for a year. The pairing that matters is days on market alongside rent achieved. Speed alone is easy to buy.' },
  { q: 'What does a 72% lease renewal rate mean for an owner?',
    a: `It means roughly seven in ten residents sign again rather than move. Every renewal avoids a turn and a vacancy, and at ${company.name} it also avoids a leasing fee, because placing a resident costs ${usd(pricing.leasingFee)} on every plan and a renewal is ${usd(pricing.leaseRenewalFee)}.` },
  { q: 'Where do these numbers come from?',
    a: 'From the internal property management records for the units under management, calculated across the whole portfolio rather than a selected subset. The measurement definition for days on market is published above the number. [SOURCE NEEDED: published measurement definitions for the remaining seven metrics.]' },
];

const related = [
  { href: '/pricing/', label: 'Pricing', note: 'The complete published fee schedule.' },
  { href: '/about/', label: 'About the company', note: `What ${company.shortName} does, and for whom.` },
  { href: '/team/', label: 'Our team', note: 'The people who produce these numbers.' },
  { href: '/core-values/', label: 'Core values', note: 'What the company optimizes for.' },
  { href: '/reviews/', label: 'Reviews', note: 'What owners and residents say publicly.' },
];
---
<Base {title} {description} {faq} {breadcrumbs}>

  <PageHero
    eyebrow="Our scorecard"
    title="RL Property Management by the numbers"
    answer={`${company.name} publishes eight operating numbers, refreshed quarterly. As of ${kpis.asOfLabel}: ${m.dom.value} median days on market, ${m.turn.value} median days to turn a unit, ${m.occupancy.value} occupancy and ${m.collectedBy5.value} of rent collected by the 5th.`}
    breadcrumbs={breadcrumbs}
    secondaryCta={{ label: 'See the pricing', href: '/pricing/' }}
    wide
  />

  <!-- THE SCORECARD -->
  <section class="band-tight" aria-labelledby="board-h">
    <div class="wrap">
      <h2 id="board-h" class="sr-only">The scorecard</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {kpis.metrics.map((k) => (
          <div class="card text-center">
            <div class="font-sans text-[clamp(38px,4.4vw,50px)] font-extrabold tracking-[-.045em] text-navy leading-none">
              {k.value}
            </div>
            <div class="font-sans text-[13.5px] text-muted mt-3">{k.label}</div>
          </div>
        ))}
      </div>
      <p class="text-center mt-6 text-[15px] text-faint">
        As of {kpis.asOfLabel}. Refreshed quarterly, across the whole portfolio of
        {' '}{company.unitsManaged} units.
      </p>
    </div>
  </section>

  <!-- WHY PUBLISH -->
  <section class="band-tight" aria-labelledby="why-h">
    <div class="wrap max-w-[880px] prose-rl">
      <h2 id="why-h">Why does RL Property Management publish operating numbers?</h2>
      <p>
        Because they can be checked, and almost nothing else on a property management website can
        be. An owner comparing managers is usually handed adjectives: responsive, experienced,
        trusted. None of those cost anything to write and none of them can be wrong. A published
        median repair time can be wrong, and that is exactly what makes it worth reading.
      </p>
      <p>
        Publishing also changes internal behavior, which is the honest reason. A number that goes on
        a public page four times a year is a number somebody owns. When the renewal rate moves, it
        moves in front of clients.
      </p>
      <p>
        The trade is that some quarters will look worse than others. That is the cost of the format,
        and it is a smaller cost than being the company that publishes nothing.
      </p>

      <h2>How is days on market actually measured?</h2>
      <p class="text-[19px] text-navy">
        <strong>{kpis.domDefinition}</strong>
      </p>
      <p>
        That definition matters more than the {m.dom.value} does. Days on market can be measured
        from listing to lease signature, from listing to move-in, or from the previous resident
        moving out, and those three produce very different numbers for the same unit. A manager who
        quotes a figure without saying which one they mean has told you nothing.
      </p>
      <p>
        The window is a trailing 12 months rather than a recent average, for a specific reason.
        Columbus leasing is strongly seasonal: spring and summer move fast, deep winter does not. A
        trailing 30-day figure is mostly measuring what month it is, not how the business runs. A
        12-month median absorbs the season and describes the operation, which is what an owner is
        actually trying to assess.
      </p>
      <p>
        The practical implication for an owner: your unit will not take exactly {m.dom.value} days.
        A well-priced unit listed in May will beat it. The same unit listed in January will not.
      </p>

      <h2>Is faster always better?</h2>
      <p>
        No, and this is the most common mistake in reading a days-on-market figure. Any unit will
        lease in a few days if it is priced far enough below market, and the owner then pays for
        that discount every month for the next twelve. Speed is cheap to buy and expensive to own.
      </p>
      <p>
        The pair that matters is time to lease alongside rent achieved. Average rent under
        management here is {m.avgRent.value}, published on this page for exactly that reason.
      </p>
    </div>
  </section>

  <!-- METRIC BY METRIC -->
  <section class="band band-wash" aria-labelledby="each-h">
    <div class="wrap max-w-[940px]">
      <span class="eyebrow">Metric by metric</span>
      <h2 id="each-h" class="text-[clamp(28px,3.3vw,40px)]">What does each number actually measure?</h2>
      <p class="text-[17.5px] text-muted mt-4 mb-8 max-w-[44em]">
        Eight numbers, what each one describes, and why it matters to the person paying the
        mortgage.
      </p>

      {explained.map((e) => (
        <details class="fee-group">
          <summary>
            <span>
              <span class="fee-group-title">{e.heading}</span>
              <span class="fee-group-count">{e.value}</span>
            </span>
          </summary>
          <div class="fee-group-body">
            {e.definition && (
              <p class="text-[15.5px] text-navy mb-3">
                <strong>How it is measured: </strong>{e.definition}
              </p>
            )}
            <p class="text-[15.5px] text-muted m-0">{e.why}</p>
          </div>
        </details>
      ))}

      <p class="text-[14px] text-faint mt-6 max-w-[46em]">
        [SOURCE NEEDED: the exact measurement window and denominator for the seven metrics other
        than days on market. Days on market has a published definition. The other seven are
        described above in plain English, but their precise calculation method has not been
        confirmed and is therefore not stated as fact.]
      </p>
    </div>
  </section>

  <!-- HOW TO USE THIS -->
  <section class="band-tight" aria-labelledby="use-h">
    <div class="wrap max-w-[880px] prose-rl">
      <h2 id="use-h">How should an owner use these numbers?</h2>
      <p>
        As questions to ask any manager, including us. If a company will not give you a figure for
        median days to close a repair, that is itself an answer. If they give you one, ask how it is
        measured and over what window, the way the definition above is stated.
      </p>
      <p>Four worth asking anyone:</p>
      <ul>
        <li>What is your median days on market, and is that measured to lease signature or to move-in?</li>
        <li>What share of rent is in hand by the 5th, and what happens to my disbursement when it is not?</li>
        <li>What is your lease renewal rate, and do you charge a leasing fee when a resident does not renew?</li>
        <li>How long does a repair take from request to closed, at the median rather than the average?</li>
      </ul>
      <p>
        The third question matters more than it looks. A manager who charges half a month of rent to
        place a resident earns money every time a lease ends. Placing a resident costs
        {' '}{usd(pricing.leasingFee)} here, on every plan, which removes that conflict entirely.
        The full fee schedule is on the <a href="/pricing/">pricing page</a>, where monthly
        management runs {priceRange()} per unit.
      </p>

      <h2>When is this page updated?</h2>
      <p>
        Quarterly. The current figures are as of {kpis.asOfLabel} and the verification line at the
        bottom of this page carries the date they were last checked. Every number renders from a
        single source file, so the figures on this page, in the page's structured data and in the
        machine-readable facts feed can never disagree with each other.
      </p>
    </div>
  </section>

  <section class="band band-wash">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Questions about the scorecard" id="kpi-faq" />
      <div class="mt-8"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={related} />

  <Cta
    heading="See what these numbers mean for your unit"
    body="A free rent evaluation gives you a rent figure and a realistic time to lease for your specific property, not a portfolio median."
    secondary={{ label: 'Read the pricing', href: '/pricing/' }}
  />
</Base>
