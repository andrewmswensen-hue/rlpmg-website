---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, kpis, pricing, rentPolicy, usd, priceRange } from '../../data/facts';

/**
 * The scorecard.
 *
 * Every value renders from `kpis` in the fact bank. Nothing is typed here.
 *
 * The important editorial decision on this page is publishing the measurement
 * definition next to the number. See docs/kpi-methodology.md: days on market is
 * genuinely volatile week to week, so the published figure is a trailing
 * 12-month median, the definition is stated, and the page is refreshed
 * monthly. A number without a method is marketing.
 *
 * Per AGENTS.md: site-wide figures only. Never per-market days on market.
 */

const title = 'Our Scorecard: RL Property Management by the Numbers';
const description =
  `The published operating numbers for ${company.name}, refreshed monthly. ` +
  `${kpis.metrics[0].value} median days on market, ${kpis.metrics[3].value} occupancy, ` +
  `${kpis.metrics[6].value} of rent collected by the 5th, as of ${kpis.asOfLabel}.`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Scorecard', path: '/key-performance-indicators/' },
];

const m = Object.fromEntries(kpis.metrics.map((k) => [k.id, k]));

/**
 * What each metric describes, in plain English.
 *
 * `definition` is the exact measurement method and is ONLY populated where the
 * fact bank supplies it. Days on market has one. The other seven describe what
 * the metric is about, and the page says outright that their exact windows and
 * denominators are not yet published. Inventing a methodology here would be
 * worse than admitting it is missing.
 */
const explained = [
  {
    id: 'dom',
    heading: 'Median days on market',
    definition: kpis.domDefinition,
    why: `Every empty day is rent you do not get back. At the ${m.avgRent.value} average rent under management, an extra month of vacancy costs a full month of rent.`,
  },
  {
    id: 'turn',
    heading: 'Median days to turn a unit',
    why: 'The work between one resident moving out and the next moving in: cleaning, paint, repairs, getting the unit ready to show. It is a separate clock from days on market.',
  },
  {
    id: 'renewal',
    heading: 'Lease renewal rate',
    why: 'The share of residents who sign another lease instead of moving out. A renewal is the cheapest outcome for an owner: no turn cost, no vacancy, no leasing work.',
  },
  {
    id: 'occupancy',
    heading: 'Portfolio occupancy',
    why: 'The share of managed units that are occupied, across the whole portfolio.',
  },
  {
    id: 'avgRent',
    heading: 'Average rent under management',
    why: 'What the average managed unit rents for. It is context for every other number here.',
  },
  {
    id: 'repairDays',
    heading: 'Median days to close a repair',
    why: 'The time from a submitted request to finished work. Slow repairs lose good residents and turn small problems into big ones.',
  },
  {
    id: 'collectedBy5',
    heading: 'Rent collected by the 5th',
    why: `The share of rent in hand by the 5th of the month. Rent is due on ${rentPolicy.dueDate}, late fees are assessed after ${rentPolicy.lateFeesAfter}, and owner funds go out on the ${rentPolicy.ownerDisbursementDay}th. Fast collection makes that date possible.`,
  },
  {
    id: 'satisfaction',
    heading: 'Resident satisfaction',
    why: 'How residents rate their experience, out of 5. Unhappy residents leave, and a turn costs an owner more than almost any repair.',
  },
].map((e) => ({ ...e, value: m[e.id].value, label: m[e.id].label }));

const faq = [
  { q: 'What are RL Property Management’s key performance indicators?',
    a: `As of ${kpis.asOfLabel}: ${kpis.metrics.map((k) => `${k.label.toLowerCase()} ${k.value}`).join(', ')}. All eight are published on this page and refreshed monthly.` },
  { q: 'How is days on market measured?',
    a: `${kpis.domDefinition} It is currently ${m.dom.value} days. The figure is a trailing 12-month median rather than a recent average, because Columbus leasing is seasonal and a 30-day number mostly measures what month it is.` },
  { q: 'How often are these numbers updated?',
    a: `Monthly. The current set is as of ${kpis.asOfLabel} and every figure on the page carries that date.` },
  { q: 'Why does RL Property Management publish its operating numbers?',
    a: 'Because numbers can be checked, and they are what an owner is trying to assess. Most property management websites publish adjectives, which prove nothing. A published number can be held against us at the next monthly refresh.' },
  { q: 'Do you publish days on market by neighborhood?',
    a: 'No. Outside Columbus itself, no single market in the portfolio leases enough units in a year for a median to mean anything, so we publish site-wide only.' },
  { q: 'Is a lower days on market always better?',
    a: 'No. A unit priced below market will lease in three days, and the owner will pay for that discount every month for a year. The pairing that matters is days on market alongside rent achieved, because speed alone is easy to buy.' },
  { q: 'What does a 72% lease renewal rate mean for an owner?',
    a: `It means roughly seven in ten residents sign again rather than move. Every renewal avoids a turn and a vacancy, and at ${company.name} it also avoids a leasing fee, because placing a resident costs ${usd(pricing.leasingFee)} on every plan and a renewal is ${usd(pricing.leaseRenewalFee)}.` },
  { q: 'Where do these numbers come from?',
    a: 'From the internal property management records for the units under management, calculated across the whole portfolio rather than a selected subset. The measurement definition for days on market is published above the number. [SOURCE NEEDED: published measurement definitions for the remaining seven metrics.]' },
];

const related = [
  { href: '/pricing/', label: 'Pricing', note: 'The complete published fee schedule.' },
  { href: '/about/', label: 'About the company', note: `What ${company.shortName} does, and for whom.` },
  { href: '/team/', label: 'Our team', note: 'The people who produce these numbers.' },
  { href: '/core-values/', label: 'Core values', note: 'What the company optimizes for.' },
  { href: '/reviews/', label: 'Reviews', note: 'What owners and residents say publicly.' },
];
---
<Base {title} {description} {faq} {breadcrumbs}>

  <PageHero
    eyebrow="Our scorecard"
    title="RL Property Management by the numbers"
    answer={`${company.name} publishes eight operating numbers, refreshed monthly. As of ${kpis.asOfLabel}: ${m.dom.value} median days on market, ${m.turn.value} median days to turn a unit, ${m.occupancy.value} occupancy and ${m.collectedBy5.value} of rent collected by the 5th.`}
    breadcrumbs={breadcrumbs}
    secondaryCta={{ label: 'See the pricing', href: '/pricing/' }}
    wide
  />

  <!-- THE SCORECARD -->
  <section class="band-tight" aria-labelledby="board-h">
    <div class="wrap">
      <h2 id="board-h" class="sr-only">The scorecard</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {kpis.metrics.map((k) => (
          <div class="card text-center">
            <div class="font-sans text-[clamp(38px,4.4vw,50px)] font-extrabold tracking-[-.045em] text-navy leading-none">
              {k.value}
            </div>
            <div class="font-sans text-[13.5px] text-muted mt-3">{k.label}</div>
          </div>
        ))}
      </div>
      <p class="text-center mt-6 text-[15px] text-faint">
        As of {kpis.asOfLabel}. Refreshed monthly, across the whole portfolio of
        {' '}{company.unitsManaged} units.
      </p>
    </div>
  </section>

  <!-- WHY PUBLISH -->
  <section class="band-tight" aria-labelledby="why-h">
    <div class="wrap max-w-[880px] prose-rl">
      <h2 id="why-h">Why does RL Property Management publish operating numbers?</h2>
      <p>
        Because numbers can be checked. Adjectives like "responsive" and "trusted" cannot. Someone on
        our team owns each number, and when one moves, clients see it. Some months will look worse than
        others; we would rather accept that than publish nothing.
      </p>

      <h2>How is days on market measured?</h2>
      <p class="text-[19px] text-navy">
        <strong>{kpis.domDefinition}</strong>
      </p>
      <p>
        Days on market can run to lease signature, to move-in, or from the last move-out, and each gives
        a different number for the same unit. Ask any manager which one they mean.
      </p>
      <p>
        We use a trailing 12 months because Columbus leasing is seasonal: spring and summer move fast,
        deep winter does not. A well-priced unit listed in May will beat {m.dom.value} days; the same unit
        in January will not.
      </p>

      <h2>Is faster always better?</h2>
      <p>
        No. Any unit leases fast if it is priced below market, and the owner pays for that discount
        every month for a year. Read time to lease alongside rent achieved: average rent under
        management here is {m.avgRent.value}.
      </p>
    </div>
  </section>

  <!-- METRIC BY METRIC -->
  <section class="band band-wash" aria-labelledby="each-h">
    <div class="wrap max-w-[940px]">
      <span class="eyebrow">Metric by metric</span>
      <h2 id="each-h" class="text-[clamp(28px,3.3vw,40px)] mb-8">What does each number measure?</h2>

      {explained.map((e) => (
        <details class="fee-group">
          <summary>
            <span>
              <span class="fee-group-title">{e.heading}</span>
              <span class="fee-group-count">{e.value}</span>
            </span>
          </summary>
          <div class="fee-group-body">
            {e.definition && (
              <p class="text-[15.5px] text-navy mb-3">
                <strong>How it is measured: </strong>{e.definition}
              </p>
            )}
            <p class="text-[15.5px] text-muted m-0">{e.why}</p>
          </div>
        </details>
      ))}

      <p class="text-[14px] text-faint mt-6 max-w-[46em]">
        [SOURCE NEEDED: the exact measurement window and denominator for the seven metrics other
        than days on market. Days on market has a published definition. The other seven are
        described above in plain English, but their precise calculation method has not been
        confirmed and is therefore not stated as fact.]
      </p>
    </div>
  </section>

  <!-- HOW TO USE THIS -->
  <section class="band-tight" aria-labelledby="use-h">
    <div class="wrap max-w-[880px] prose-rl">
      <h2 id="use-h">How should an owner use these numbers?</h2>
      <p>As questions to ask any manager, including us:</p>
      <ul>
        <li>What is your median days on market, and is that measured to lease signature or to move-in?</li>
        <li>What share of rent is in hand by the 5th, and what happens to my disbursement when it is not?</li>
        <li>What is your lease renewal rate, and do you charge a leasing fee when a resident does not renew?</li>
        <li>How long does a repair take from request to closed, at the median rather than the average?</li>
      </ul>
      <p>
        The third matters most. A manager who charges a leasing fee earns money every time a lease ends.
        Placing a resident costs {usd(pricing.leasingFee)} here, on every plan.
        The full fee schedule is on the <a href="/pricing/">pricing page</a>, where monthly
        management runs {priceRange()} per unit.
      </p>

      <h2>When is this page updated?</h2>
      <p>
        Monthly. The current figures are as of {kpis.asOfLabel}. Every number comes from one source
        file, so this page, its structured data and our machine-readable facts feed always match.
      </p>
    </div>
  </section>

  <section class="band band-wash">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Questions about the scorecard" id="kpi-faq" />
      <div class="mt-8"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={related} />

  <Cta
    heading="See what these numbers mean for your unit"
    body="A free rent evaluation gives you a rent figure and a realistic time to lease for your specific property, not a portfolio median."
    secondary={{ label: 'Read the pricing', href: '/pricing/' }}
  />
</Base>
