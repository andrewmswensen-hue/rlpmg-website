---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, pricing, rentPolicy, typicalManager, usd } from '../../data/facts';
import { rentByMarketAndBedroom } from '../../data/markets';
import { serviceNode } from '../../lib/schema';

/**
 * Hilliard, Ohio. Target query: "property management hilliard ohio".
 *
 * The differentiating fact for Hilliard is the water bill. Hilliard is a City of
 * Columbus water and sewer contract community, and Columbus states that the
 * property owner "is ultimately responsible for all charges" even where a Tenant
 * Billing Agreement puts the bill in the resident's name. A resident who leaves
 * owing a water balance leaves it pointed at the owner. No competitor page for
 * this city says that.
 *
 * Second fact: median year built 1997, US Census ACS 2024 5-year. Newer stock
 * than the older inner suburbs, with a different maintenance profile.
 *
 * SOURCES (verified 2026-09-09):
 *  - Hilliard appears on the City of Columbus Water & Sewer Contract Communities
 *    list: columbus.gov Water & Sewer Contract Communities. Canal Winchester
 *    does not; Powell does not.
 *  - "The Columbus Division of Water provides water and sewer services for
 *    Hilliard residents": hilliardohio.gov/questions-answers/. That page also
 *    names Columbia Gas of Ohio for gas, AEP Ohio as the distribution utility,
 *    the city electric aggregation program, and Local Waste Services for trash.
 *  - Columbus owner-responsibility language on a Tenant Billing Agreement,
 *    carried from docs/area-research-verified.md (Columbus Billing & Collections
 *    Regulation): the property owner "is ultimately responsible for all charges".
 *  - Hilliard is entirely in Franklin County. Court jurisdiction follows the
 *    county under R.C. 1901.02. Franklin County Municipal Court eviction
 *    division, 375 S. High St., 3rd floor, Columbus, OH 43215, Courtroom 11B:
 *    franklincountymunicourt.org/Courts/Eviction-Court.
 *  - Owner filing with the county auditor: R.C. 5323.02, penalty R.C. 5323.99.
 *    Franklin County Auditor states $150 per tax year.
 *  - Median year structure built 1997: US Census, ACS 2024 5-year estimates.
 *
 * Rent: rentByMarketAndBedroom has a qualifying Hilliard entry at 3 bedrooms
 * only (sample 10). No door counts, no per-market days on market.
 */

const CITY = 'Hilliard';
const PATH = '/property-management-hilliard-ohio/';

const title = 'Hilliard Property Management | RL Property Management';
const description =
  `Flat-fee property management for Hilliard, Ohio rentals from ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} ` +
  `per unit per month with a ${usd(pricing.leasingFee)} leasing fee. Hilliard is on Columbus water, where the owner stays responsible for the bill.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/areas-we-serve/' },
  { name: 'Hilliard', path: PATH },
];

const rent = rentByMarketAndBedroom[CITY];

const keyFacts = [
  'Hilliard buys water and sewer from the City of Columbus under contract',
  'Columbus holds the property owner ultimately responsible for all water charges',
  'Hilliard is entirely in Franklin County, so evictions go to 375 S. High St.',
  `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, not a percentage of rent`,
  `${usd(pricing.leasingFee)} leasing fee every time a Hilliard unit turns`,
  `Median rent across the units we manage in Hilliard: ${usd(rent['3'].median)} for a 3 bedroom`,
];

const utilities = [
  { service: 'Water and sewer', provider: 'Columbus Division of Water, under contract with Hilliard', pays: 'Resident under a Tenant Billing Agreement, but the owner remains liable to Columbus' },
  { service: 'Electricity', provider: 'AEP Ohio distributes. Hilliard also runs a community aggregation program', pays: 'Resident' },
  { service: 'Natural gas', provider: 'Columbia Gas of Ohio', pays: 'Resident' },
  { service: 'Trash and recycling', provider: 'Local Waste Services, billed quarterly', pays: 'Varies by lease' },
];

const faq = [
  { q: 'Who is responsible for an unpaid water bill on a Hilliard rental?',
    a: 'The property owner. Hilliard buys water and sewer from the City of Columbus, and Columbus holds the owner ultimately responsible for all charges even when a Tenant Billing Agreement puts the bill in the resident name. A resident who leaves owing water leaves that balance with you.' },
  { q: 'What county is Hilliard, Ohio in?',
    a: 'Franklin County, all of it. Unlike Dublin (three counties) or Powell (Delaware County), every Hilliard parcel files with the Franklin County Auditor and every Hilliard eviction goes to the same court.' },
  { q: 'Which court hears an eviction in Hilliard, Ohio?',
    a: 'Franklin County Municipal Court, 375 S. High St., 3rd floor, Columbus, OH 43215, Courtroom 11B, with jurisdiction following the county under R.C. 1901.02. The case must start with a three-day notice under R.C. 1923.04 in the statutory wording, or it is dismissed and you lose three weeks.' },
  { q: 'Do I have to register my Hilliard rental property with anyone?',
    a: 'Yes, with the Franklin County Auditor, not the city. R.C. 5323.02 requires owner name, address and phone plus the property address and parcel number, updated within 60 days of any change, at no fee, and the Auditor states a $150 per tax year penalty for not filing. We file it as your designated agent.' },
  { q: 'Does the City of Hilliard require a rental license or inspection?',
    a: 'Any city registration or inspection program in Central Ohio sits on top of the R.C. 5323 county auditor filing, which applies to a Hilliard rental either way. We track which rules apply to each address and handle the filings and renewals for you.' },
  { q: 'What does a rental in Hilliard, Ohio rent for?',
    a: `Across the units we manage in Hilliard, the median rent is ${usd(rent['3'].median)} for a three bedroom. That is our own portfolio median, not a market survey; other bedroom counts have under five units, so we do not publish a median for them.` },
  { q: 'How old is the housing stock in Hilliard?',
    a: 'The median Hilliard home was built in 1997 (US Census ACS 2024 5-year), newer than Westerville (1982), Reynoldsburg (1984), Worthington (1963) and Upper Arlington (1959). Most rentals are 1990s and 2000s subdivision houses whose original furnace, condenser, water heater and roof are reaching the end of their first service life together.' },
  { q: 'How much does property management cost in Hilliard?',
    a: `A flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, a ${usd(pricing.leasingFee)} leasing fee and ${usd(pricing.leaseRenewalFee)} per lease renewal. On a ${usd(rent['3'].median)} Hilliard rent, a 10% manager would take roughly ${usd(Math.round(rent['3'].median * 0.1) * 12)} a year. Photography is billed separately at $250 to $450.` },
];

const schemaNodes = [
  {
    ...serviceNode({
      path: PATH,
      name: 'Residential property management in Hilliard, Ohio',
      description,
    }),
    areaServed: {
      '@type': 'City',
      name: 'Hilliard, Ohio',
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Franklin County, Ohio' },
    },
  },
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="Where we work"
    title="Property management in Hilliard, Ohio"
    answer={`${company.name} manages single-family and small multifamily rentals in Hilliard for a flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, with a ${usd(pricing.leasingFee)} leasing fee. Hilliard runs on Columbus water, where the owner stays liable for the bill.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondaryCta={{ label: 'See the full fee schedule', href: '/pricing/' }}
  />

  <KeyFacts items={keyFacts} heading="Hilliard, at a glance" />

  <!-- THE COLUMBUS WATER PROBLEM. The single most useful thing on this page. -->
  <section class="band-tight" aria-labelledby="water-h">
    <div class="wrap max-w-[880px]">
      <h2 id="water-h" class="text-[clamp(26px,3.2vw,38px)]">Who is responsible for the water bill on a Hilliard rental?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        You are, even when the resident gets the bill. Hilliard is a City of Columbus water and sewer contract
        community. Columbus lets a resident take the bill under a Tenant Billing Agreement, but it holds the
        property owner ultimately responsible for all charges, which is why you keep getting copies.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        The risk: a resident who stops paying water but keeps paying rent can move out, get the deposit back,
        and leave the balance on your property weeks later. So we put the account in the resident's name at
        lease signing and check its status at move-out, inside the 30 days Ohio gives you to return the deposit
        with an itemized list of deductions.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Utility providers for Hilliard, Ohio rental property</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Service</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Provider</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Who carries the risk</th>
            </tr>
          </thead>
          <tbody>
            {utilities.map((u) => (
              <tr>
                <th scope="row" class="text-left p-3.5 border border-line font-medium align-top">{u.service}</th>
                <td class="p-3.5 border border-line text-navy font-semibold align-top">{u.provider}</td>
                <td class="p-3.5 border border-line text-muted align-top">{u.pays}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[16px] text-muted mt-6">
        Under Hilliard's electricity aggregation program, AEP Ohio still owns the wires and handles outages.
        Local Waste Services bills trash quarterly (January, April, July, October), so do not write a lease that
        assumes a monthly bill.
      </p>
    </div>
  </section>

  <!-- COURT AND REGISTRATION -->
  <section class="band band-wash" aria-labelledby="court-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Compliance</span>
      <h2 id="court-h" class="text-[clamp(26px,3.2vw,38px)]">Which court hears a Hilliard eviction, and where do you register the property?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Franklin County Municipal Court, civil and eviction division, at 375 S. High St., 3rd floor, Columbus,
        OH 43215, Courtroom 11B. All of Hilliard is in Franklin County, unlike Dublin, where three counties meet,
        or Powell, which files in Delaware County twenty-five miles north.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Registration also goes to the county, not the city. Under Ohio Revised Code 5323.02, you file with the Franklin
        County Auditor:
      </p>
      <ul class="text-[17px] text-muted mt-3 list-disc pl-6 space-y-1.5">
        <li>Your name, address and phone, plus the property street address and permanent parcel number.</li>
        <li>No fee. Due within 60 days, and any change updated within 60 days.</li>
        <li>Penalty: $150 per tax year per the Auditor (statutory range $50 to $150 under R.C. 5323.99).</li>
        <li>An LLC or trust must also name the responsible officer, member or trustee.</li>
      </ul>
      <p class="text-[17.5px] text-muted mt-5">
        We file as your designated agent during onboarding. A city program (such as the Columbus registry
        added in April 2026 under City Code Chapter 4515) stacks on top of the auditor filing, and we track
        which applies to your address.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        A typical Franklin County eviction costs {usd(pricing.eviction.typicalTotal)} before any setout:
        {' '}{usd(pricing.eviction.countyFilingFee)} to file, {usd(pricing.eviction.attorneyFee)} for the attorney
        (filing plus up to two appearances) and {usd(pricing.eviction.rlpmProcessFee)} for us to run it. A setout
        adds {usd(pricing.eviction.tagAndSetoutFee)} county and {usd(pricing.eviction.setoutFee)} ours. Roughly
        {' '}{pricing.eviction.disputeRatePct}% of our cases are disputed. See the
        {' '}<a href="/services/evictions/" class="text-crimson font-semibold no-underline hover:underline">evictions page</a>.
      </p>
    </div>
  </section>

  <!-- WHAT WE MANAGE -->
  <section class="band-tight" aria-labelledby="stock-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The market</span>
      <h2 id="stock-h" class="text-[clamp(26px,3.2vw,38px)]">What kind of rental property is there in Hilliard?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Mostly late-century subdivision houses. The median Hilliard home was built in 1997 (US Census ACS 2024
        5-year), between the 1980s stock in Westerville and Reynoldsburg and the 2001 medians in Powell and Canal
        Winchester. Old Hilliard, the original village around Main and Norwich, is a thin slice of the total.
      </p>
      <ul class="text-[17px] text-muted mt-4 list-disc pl-6 space-y-1.5">
        <li><strong>Systems come due together.</strong> Original furnaces, condensers, water heaters and roofs are at the end of a first service life, so expect clustered four-figure items. We log every system's age at onboarding.</li>
        <li><strong>Family renters.</strong> Three and four bedroom detached houses with attached garages draw fewer, stronger applications and longer tenancies, but costlier turns (carpet, paint, full clean).</li>
        <li><strong>Deed restrictions.</strong> Many subdivisions restrict parking, fencing and lawn condition, and the association notice goes to the owner. We route it to the resident with a cure date.</li>
      </ul>
      <h3 class="text-[21px] mt-9 mb-3">Where in Hilliard we work</h3>
      <p class="text-[16.5px] text-muted">
        Old Hilliard, Britton Farms, Heritage Lakes, Brown Township, Davidson Road, Cemetery Road, Scioto Darby
        Road, Leap Road, Avery Road, the Trueman Boulevard corridor and the newer sections out toward Alton
        Darby. Houses across the city feed the Hilliard City School District, a large part of why Hilliard rents
        where it does. Landmarks: the Franklin County Fairgrounds, Hilliard Station Park and the Heritage Rail
        Trail. The I-270 and Cemetery Road interchange puts most of these houses within twenty minutes of the
        west side employment corridor.
      </p>
    </div>
  </section>

  <!-- RENT AND PRICING -->
  <section class="band band-wash" aria-labelledby="rent-h">
    <div class="wrap max-w-[880px]">
      <h2 id="rent-h" class="text-[clamp(26px,3.2vw,38px)]">What does a Hilliard rental earn, and what does management cost?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        {usd(rent['3'].median)} for a three bedroom, the median across the units we manage in Hilliard. That is
        our own portfolio, not a market survey. Other bedroom counts have under five units, so we do not publish
        a median for them.
      </p>
      <div class="grid gap-5 sm:grid-cols-3 mt-8">
        {pricing.plans.map((p) => (
          <div class="card text-center">
            <div class="font-sans text-[12px] font-bold tracking-[.13em] uppercase text-faint mb-2">{p.name}</div>
            <div class="font-sans text-[42px] font-extrabold tracking-[-.045em] text-navy leading-none">{usd(p.monthly)}</div>
            <div class="font-sans text-[13px] text-faint mt-2">per unit, per month</div>
            <p class="text-[14.5px] text-muted mt-4 mb-0">{usd(p.repairApprovalLimit)} per-item repair approval limit</p>
          </div>
        ))}
      </div>
      <p class="text-[16.5px] text-muted mt-7">
        At a {usd(rent['3'].median)} rent, a manager charging 10% of collected rent takes about
        {' '}{usd(Math.round(rent['3'].median * 0.1) * 12)} a year, plus roughly
        {' '}{usd(typicalManager.leasingFee(rent['3'].median))} again every time the unit turns. Our middle plan is
        {' '}{usd(pricing.plans[1].monthly * 12)} a year and the placement is {usd(pricing.leasingFee)}. The plans
        differ only in the repair approval limit.
      </p>
      <p class="text-[14px] text-faint mt-4">
        Percentage figures describe common Columbus market rates. They are not a quote from any named company.
        Photography is not included in the {usd(pricing.leasingFee)} leasing fee and is billed separately at
        $250 to $450.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/pricing/" class="btn btn-navy">See every fee we charge</a>
        <a href="/free-rent-evaluation/" class="btn btn-ghost">Price my Hilliard rental</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band-tight" aria-labelledby="faq-section">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <h2 id="faq-section" class="sr-only">Hilliard property management questions</h2>
      <Faq items={faq} heading="Hilliard property management questions" id="hilliard-faq" />
      <p class="mt-7 text-[15.5px] text-muted">
        Rent is due on {rentPolicy.dueDate}, late fees apply after {rentPolicy.lateFeesAfter}, and owner funds go
        out on the {rentPolicy.ownerDisbursementDay}th. More on the
        {' '}<a href="/owner-faqs/" class="text-crimson font-semibold no-underline hover:underline">owner FAQs page</a>.
      </p>
      <div class="mt-6"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/property-management-dublin-ohio/', label: 'Dublin property management', note: 'Directly north, similar stock, and it spans three counties.' },
    { href: '/property-management-upper-arlington-ohio/', label: 'Upper Arlington property management', note: 'East, pre-war and mid-century houses, median year built 1959.' },
    { href: '/property-management-worthington-ohio/', label: 'Worthington property management', note: 'Northeast, older stock and a tighter street grid.' },
    { href: '/property-management-columbus-ohio/', label: 'Columbus property management', note: 'The anchor page, with the full Franklin County process.' },
    { href: '/pricing/', label: 'Pricing and the full fee schedule', note: 'Every charge that can appear on an owner statement.' },
  ]} heading="Nearby markets and what to read next" />

  <Cta
    heading="Find out what your Hilliard rental should earn"
    body="Send the address. We will price it against the units we manage in Hilliard and live comparable listings. Free, no obligation."
    primary={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondary={{ label: 'Get a portfolio quote', href: '/property-management-consultation/' }}
  />
</Base>
