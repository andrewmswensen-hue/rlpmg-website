---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import Faq from '../../../components/Faq.astro';
import Verified from '../../../components/Verified.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import Cta from '../../../components/Cta.astro';
import { company, rentPolicy, pricing, kpis, usd } from '../../../data/facts';

/**
 * Search intent: "what to do before moving into a rental", "transfer utilities
 * columbus ohio", "move in inspection checklist renter".
 *
 * The single most valuable thing on this page is the condition report. Most
 * deposit disputes are decided by whether the resident documented the home in
 * their first week, so that section is written to be acted on, not skimmed.
 */

const title = 'Moving In | RL Property Management, Columbus Ohio';
const description =
  `What happens between signing a lease with ${company.name} and getting keys: utilities, renters ` +
  `insurance, the move-in condition report, and your first rent payment on ${rentPolicy.dueDate}.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Residents', path: '/residents/' },
  { name: 'Moving in', path: '/residents/moving-in/' },
];

const answer =
  `Before keys are released, the lease is signed, move-in funds have cleared, and utilities are in your ` +
  `name. In your first days, complete the move-in condition report. Rent is then due on ` +
  `${rentPolicy.dueDate} each month.`;

const keyFacts = [
  'Utilities must be in your name before keys are released',
  'The move-in condition report is what your deposit is measured against later',
  `Rent is due on ${rentPolicy.dueDate}, late fees after ${rentPolicy.lateFeesAfter}`,
  `Approved pets carry a monthly fee funding up to ${usd(pricing.petDamageCoverage.cap)} in pet damage coverage`,
];

/** Utility providers by service across the Columbus metro. Named, not numbered. */
const utilities = [
  ['Electric', 'AEP Ohio is the electric utility across most of the Columbus metro. You can choose a different supplier, but AEP Ohio still delivers it and reads the meter.'],
  ['Natural gas', 'Columbia Gas of Ohio serves most of the metro. You can choose a separate supplier.'],
  ['Water and sewer', 'Your municipality. In Columbus, the Department of Public Utilities; in suburbs such as Westerville and Dublin, the city itself.'],
  ['Trash', 'Usually municipal, billed with water or on the tax bill. Private in some townships and communities.'],
  ['Internet', 'Your choice. Book the install before move-in day; appointments fill up.'],
];

const firstWeek = [
  ['Complete the condition report', 'Room by room, in writing, with dated photos. Include small things: a scuffed baseboard, a stiff window, a carpet stain. Your deposit is measured against it.'],
  ['Find the shutoffs', 'Main water shutoff, electrical panel, gas shutoff. Find and photograph all three before you need them.'],
  ['Test the smoke and carbon monoxide alarms', 'Press and hold each test button. Report any that do not sound, right away.'],
  ['Check the furnace filter', 'Note the size and when it was last changed. A clogged filter is the top cause of heating and cooling complaints.'],
  ['Set up your rent payment', 'Log into the resident portal and set up how you will pay before the 1st.'],
  ['Save the emergency number', `Put ${company.phone} in your phone now, not while you are standing in water.`],
];

const faq = [
  { q: 'What do I need to do before I get keys?',
    a: 'Three things: sign the lease, pay the funds due at signing so they clear, and put the utilities you are responsible for into your name effective on your lease start date. Keys are released once those are done.' },
  { q: 'Which utilities am I responsible for?',
    a: 'It depends on the home, and your lease says which. Across the Columbus metro the usual providers are AEP Ohio for electric, Columbia Gas of Ohio for natural gas, and the municipality for water, sewer and trash.' },
  { q: 'Do I need renters insurance?',
    a: 'Your lease says whether it is required. Get it either way. The owner\'s insurance policy covers the building, never your belongings, and a renters policy usually costs a few dollars a month.' },
  { q: 'What is the move-in condition report and why does it matter?',
    a: 'A written record, with photos, of the home on the day you moved in. Your deposit is measured against it when you leave, so anything you do not note is hard to prove was there before you.' },
  { q: 'When is my first rent payment due?',
    a: `Rent is due on ${rentPolicy.dueDate} of each month. If you move in mid-month, the first month is usually prorated for the days you occupy the home. Late fees are assessed after ${rentPolicy.lateFeesAfter}.` },
  { q: 'Can I paint, mount a TV, or change the fixtures?',
    a: 'Ask in writing first, through the portal, and get the answer in writing. Unapproved alterations are the second most common source of deposit deductions after cleaning.' },
  { q: 'How do I get a second set of keys?',
    a: 'Ask through the portal rather than cutting your own, so the number of keys in circulation for the home stays known. We keep two working copies of every unit.' },
  { q: 'What if something is broken when I move in?',
    a: `Note it on the condition report and file a maintenance request the same day. The report protects your deposit; the request gets it fixed. Median time to close a repair is ${kpis.metrics.find((m) => m.id === 'repairDays')?.value} days.` },
];
---
<Base {title} {description} {faq} {breadcrumbs}>

  <PageHero
    eyebrow="For new residents"
    title="Moving in"
    answer={answer}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Go to the resident hub', href: '/residents/' }}
    secondaryCta={{ label: 'Submit a maintenance request', href: '/residents/maintenance-requests/' }}
  />

  <KeyFacts items={keyFacts} heading="Move-in, in short" />

  <!-- BEFORE KEYS -->
  <section class="band-tight" aria-labelledby="before-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Before keys</span>
      <h2 id="before-h" class="text-[clamp(28px,3.3vw,40px)]">What has to happen before I get keys?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Three things, in order. Keys are released after all three, not before.
      </p>
      <ol class="grid gap-4 mt-7">
        <li class="card !p-6">
          <span class="block font-serif text-[19px] font-semibold text-navy mb-1.5">1. Sign the lease</span>
          <span class="block text-[15.5px] text-muted">
            Read it first, especially utilities, alterations, pets, notice to vacate and the deposit. Ask
            about anything unclear.
          </span>
        </li>
        <li class="card !p-6">
          <span class="block font-serif text-[19px] font-semibold text-navy mb-1.5">2. Pay the funds due at signing</span>
          <span class="block text-[15.5px] text-muted">
            The home comes off the market when this clears, not when the application was approved.
          </span>
        </li>
        <li class="card !p-6">
          <span class="block font-serif text-[19px] font-semibold text-navy mb-1.5">3. Put the utilities in your name</span>
          <span class="block text-[15.5px] text-muted">
            Effective on your lease start date, not your move date, so the power is on when the movers arrive.
          </span>
        </li>
      </ol>
    </div>
  </section>

  <!-- UTILITIES -->
  <section class="band band-wash" aria-labelledby="util-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Who to call</span>
      <h2 id="util-h" class="text-[clamp(28px,3.3vw,40px)]">Which utilities do I need to set up?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Your lease says which ones you carry. These are the usual Columbus metro providers.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Utility providers across the Columbus metro</caption>
          <thead>
            <tr class="bg-white">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Service</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Who provides it</th>
            </tr>
          </thead>
          <tbody>
            {utilities.map(([service, who]) => (
              <tr>
                <th scope="row" class="text-left p-3.5 border border-line font-medium align-top whitespace-nowrap">{service}</th>
                <td class="p-3.5 border border-line align-top text-muted">{who}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CONDITION REPORT -->
  <section class="band" aria-labelledby="condition-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The one that matters</span>
      <h2 id="condition-h" class="text-[clamp(28px,3.3vw,40px)]">Why does the move-in condition report matter so much?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Your security deposit is measured against it when you leave, even years later. It answers the
        question behind most deposit disputes: was this here before you moved in?
      </p>
      <div class="card !border-2 !border-navy mt-7">
        <h3 class="text-[18.5px] mb-3">How to fill it in so it protects you</h3>
        <ul class="text-[15.5px] text-muted grid gap-2">
          <li>Go room by room and write down everything, even small things.</li>
          <li>Photograph every room wide, then every defect close up, with the date showing where you can.</li>
          <li>Check under sinks, behind doors, inside the oven, the top of the refrigerator, carpet corners.</li>
          <li>Note things that work badly: a sticking window, a door that does not latch, a burner that runs cool.</li>
          <li>Keep your own copy, not only the one in the portal.</li>
        </ul>
      </div>
      <p class="text-[15px] text-muted mt-5">
        Anything broken? Also file a
        {' '}<a href="/residents/maintenance-requests/" class="text-crimson font-semibold no-underline hover:underline">maintenance request</a>
        {' '}the same day.
      </p>
    </div>
  </section>

  <!-- FIRST WEEK -->
  <section class="band band-wash" aria-labelledby="week-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Your first week</span>
      <h2 id="week-h" class="text-[clamp(28px,3.3vw,40px)]">What should I do in my first week?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Six things, easier now than the first time something goes wrong.
      </p>
      <div class="grid gap-4 sm:grid-cols-2 mt-7">
        {firstWeek.map(([h, p]) => (
          <div class="card">
            <h3 class="text-[17.5px] mb-2">{h}</h3>
            <p class="text-[15px] text-muted m-0">{p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INSURANCE -->
  <section class="band" aria-labelledby="ins-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Your belongings</span>
      <h2 id="ins-h" class="text-[clamp(28px,3.3vw,40px)]">Do I need renters insurance?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Get a policy whether or not your lease requires it. The owner's policy does not cover your
        belongings, a hotel if the home becomes uninhabitable, or your liability for damage you cause.
      </p>
    </div>
  </section>

  <section class="band band-wash">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Move-in questions" id="movein-faq" />
      <div class="mt-8">
        <Verified date="2026-09-09" />
      </div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/residents/', label: 'Resident hub', note: 'Every resident task in one place.' },
    { href: '/residents/pay-rent/', label: 'Pay rent', note: `Due on ${rentPolicy.dueDate}, late fees after ${rentPolicy.lateFeesAfter}.` },
    { href: '/residents/maintenance-requests/', label: 'Maintenance requests', note: 'Emergency, urgent and routine repairs.' },
    { href: '/residents/moving-out/', label: 'Moving out', note: 'Read it before you need it. It affects your deposit.' },
    { href: '/resident-faqs/', label: 'Resident FAQs', note: 'The long list, grouped by topic.' },
  ]} />

  <Cta
    heading="Document the home in your first week"
    body="The condition report takes an hour, and your deposit is measured against it when you leave, even years later. Anything broken should also be filed as a maintenance request the same day."
    primary={{ label: 'Submit a maintenance request', href: '/residents/maintenance-requests/' }}
    secondary={{ label: 'Go to the resident hub', href: '/residents/' }}
  />
</Base>
