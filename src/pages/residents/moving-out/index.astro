---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import Faq from '../../../components/Faq.astro';
import Verified from '../../../components/Verified.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import Cta from '../../../components/Cta.astro';
import { company, kpis, rentPolicy } from '../../../data/facts';

/**
 * Search intent: "notice to vacate ohio", "how do I get my security deposit
 * back", "move out cleaning checklist rental".
 *
 * NOTE ON NUMBERS: the notice period and the deposit return timeline are the two
 * numbers a resident most wants from this page, and neither is in the fact bank.
 * Both are marked [SOURCE NEEDED]. Do not fill them in from general knowledge of
 * Ohio law; the lease and the statute both have to be checked against each other
 * before either number is published.
 */

const title = 'Moving Out | RL Property Management, Columbus Ohio';
const description =
  `How to end a tenancy with ${company.name}: giving written notice, the cleaning standard, the final ` +
  `walkthrough, and how your security deposit is returned.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Residents', path: '/residents/' },
  { name: 'Moving out', path: '/residents/moving-out/' },
];

const answer =
  `Ending a tenancy takes three things: written notice by the deadline in your lease, the home returned ` +
  `clean and empty, and a forwarding address so the security deposit can be sent. Renewing instead avoids ` +
  `the ${rentPolicy.monthToMonthIncreasePct}% month-to-month rent increase.`;

const renewal = kpis.metrics.find((m) => m.id === 'renewal')?.value;

const keyFacts = [
  'Notice to vacate must be in writing. A conversation is not notice',
  'A forwarding address in writing is required before a deposit can be sent',
  `Rent stays due on ${rentPolicy.dueDate} through the end of the lease term, including your last month`,
  `${renewal} of residents renew instead of moving`,
];

const deductionCauses = [
  ['Cleaning', 'The most common deduction, and the most avoidable. Return the home as clean as you got it and there is none.'],
  ['Unapproved alterations', 'Paint, mounted hardware, removed fixtures, anything done without written approval, plus the cost of undoing it.'],
  ['Damage beyond normal wear and tear', 'Holes, broken fixtures, pet damage, burns, and stains that will not clean.'],
  ['Items left behind', 'Furniture, appliances, trash and anything in the garage, basement or yard. Disposal is charged at cost.'],
  ['Unpaid balances', 'Rent, late fees and any chargebacks still owed on the ledger at move-out.'],
];

const checklist = [
  'Give written notice by the deadline in your lease, through the portal so it is timestamped.',
  'Give a forwarding address in writing. The deposit cannot be sent without one.',
  'Keep paying rent on the 1st through the end of the term. Notice does not end the rent obligation early.',
  'Remove everything, including from the garage, basement, attic, shed and yard.',
  'Clean fully: appliances inside and out, bathrooms, floors, windows, baseboards, light fixtures, inside cabinets.',
  'Replace burned out light bulbs and the furnace filter.',
  'Fill holes only where your lease says to. Do not paint without approval.',
  'Take dated photographs of every room after it is empty and clean. Keep them yourself.',
  'Return every key, fob, remote and mail key.',
  'End utilities on your lease end date, not before, so the walkthrough is not in the dark.',
];

const faq = [
  { q: 'How much notice do I have to give before moving out?',
    a: 'Written notice, by the deadline stated in your lease, delivered through the resident portal so it is timestamped. A conversation with a staff member is not notice.' },
  { q: 'How do I give notice?',
    a: 'In writing, through the resident portal, with the property address, every resident on the lease, and your move-out date. Keep the confirmation. Verbal notice, a text, or telling a technician does not count.' },
  { q: 'When do I get my security deposit back?',
    a: 'After move-out, once the home has been inspected and any deductions have been itemized in writing, sent to the forwarding address you provided.' },
  { q: 'What gets deducted from a security deposit?',
    a: 'Cleaning, unapproved alterations, damage beyond normal wear and tear, items left behind, and any unpaid balance on your ledger. Normal wear and tear (worn carpet, faded paint) is the owner\'s cost, not yours. Deductions are itemized in writing.' },
  { q: 'What counts as normal wear and tear?',
    a: 'Deterioration that happens from living in a home normally over time: traffic patterns in carpet, small nail holes from hanging pictures where the lease allows it, faded paint, minor scuffs on walls. Holes, pet damage, burns, broken fixtures and stains that will not clean are not wear and tear.' },
  { q: 'Can I break my lease early?',
    a: 'Talk to us before you do anything, in writing. A lease is a fixed obligation, and leaving early does not end it by itself.' },
  { q: 'Will people be shown through the home while I still live there?',
    a: 'The home is usually marketed during the notice period, which means showings while you are still in it. Ohio law requires reasonable notice before entry.' },
  { q: 'Do I still pay rent for my last month?',
    a: `Yes. Rent is due on ${rentPolicy.dueDate} for every month of the term, including your last, and a security deposit is not a rent payment. Withholding the last month's rent creates a balance owed, late fees, and a deduction from the deposit.` },
  { q: 'What if I want to stay instead?',
    a: `Renew. We reach out ahead of your end date with terms, and ${renewal} of residents renew. A tenancy that lapses into month-to-month rather than renewing carries a ${rentPolicy.monthToMonthIncreasePct}% higher rent.` },
];
---
<Base {title} {description} {faq} {breadcrumbs}>

  <PageHero
    eyebrow="For residents"
    title="Moving out"
    answer={answer}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Go to the resident hub', href: '/residents/' }}
    secondaryCta={{ label: 'View available homes', href: '/homes-for-rent/' }}
  />

  <KeyFacts items={keyFacts} heading="Move-out, in short" />

  <!-- NOTICE -->
  <section class="band-tight" aria-labelledby="notice-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Step one</span>
      <h2 id="notice-h" class="text-[clamp(28px,3.3vw,40px)]">How do I give notice that I am moving out?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        In writing, through the resident portal, by the deadline in your lease. A conversation, a text,
        or telling a technician is not notice.
      </p>
      <div class="card mt-7">
        <h3 class="text-[18.5px] mb-3">What the notice has to say</h3>
        <ul class="text-[15.5px] text-muted grid gap-2">
          <li>The property address, including the unit if there is one</li>
          <li>Every resident named on the lease</li>
          <li>The date you will be fully out and returning keys</li>
          <li>A forwarding address for the security deposit</li>
        </ul>
      </div>
      <p class="text-[15px] text-muted mt-5">
        Rent stays due on {rentPolicy.dueDate} through the end of the lease term. Late fees still apply
        after {rentPolicy.lateFeesAfter} in your final month.
      </p>
    </div>
  </section>

  <!-- CHECKLIST -->
  <section class="band band-wash" aria-labelledby="check-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The list</span>
      <h2 id="check-h" class="text-[clamp(28px,3.3vw,40px)]">What do I need to do before I hand back the keys?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Ten steps. Number 8, dated photos of the empty, clean home, settles most arguments.
      </p>
      <ol class="grid gap-2.5 mt-7">
        {checklist.map((item, i) => (
          <li class="flex gap-4 text-[15.5px] card !p-4">
            <span class="font-sans font-bold text-crimson tabular-nums shrink-0" aria-hidden="true">{i + 1}</span>
            <span class="text-muted">{item}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- DEPOSIT -->
  <section class="band" aria-labelledby="deposit-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Your money back</span>
      <h2 id="deposit-h" class="text-[clamp(28px,3.3vw,40px)]">How and when does my security deposit come back?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        We inspect the home against your move-in condition report, itemize any deductions in writing, and
        send the balance to your forwarding address. No forwarding address in writing, nothing can be sent.
      </p>
      <h3 class="text-[21px] mt-9 mb-3">What gets deducted</h3>
      <div class="scroll-x">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Common security deposit deductions and how to avoid them</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Cause</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Detail</th>
            </tr>
          </thead>
          <tbody>
            {deductionCauses.map(([cause, detail]) => (
              <tr>
                <th scope="row" class="text-left p-3.5 border border-line font-medium align-top whitespace-nowrap">{cause}</th>
                <td class="p-3.5 border border-line align-top text-muted">{detail}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[15px] text-muted mt-6">
        Normal wear and tear is not deductible: worn carpet in a traffic path, faded paint, minor scuffs are
        the owner's cost. Your photos from
        {' '}<a href="/residents/moving-in/" class="text-crimson font-semibold no-underline hover:underline">moving in</a>
        {' '}show the difference.
      </p>
    </div>
  </section>

  <!-- SHOWINGS -->
  <section class="band band-wash" aria-labelledby="showings-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">During your notice period</span>
      <h2 id="showings-h" class="text-[clamp(28px,3.3vw,40px)]">Will the home be shown while I still live here?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Usually yes. The home is marketed during your notice period so it can lease close to the day you
        leave. Ohio law requires reasonable notice before entry, including showings.
      </p>
    </div>
  </section>

  <!-- RENEW INSTEAD -->
  <section class="band" aria-labelledby="renew-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Before you go</span>
      <h2 id="renew-h" class="text-[clamp(28px,3.3vw,40px)]">Would renewing be cheaper than moving?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Often, yes, and {renewal} of our residents renew. Moving means a new deposit, movers, utility
        connection fees and time off work. We reach out with renewal terms ahead of your end date.
      </p>
      <p class="text-[16.5px] text-muted mt-4">
        Going month-to-month instead of renewing carries a {rentPolicy.monthToMonthIncreasePct}% higher rent.
      </p>
      <p class="text-[16.5px] text-muted mt-4">
        Moving within the metro? See what else we have open. Your rental history with us is already verified.
      </p>
    </div>
  </section>

  <section class="band band-wash">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Move-out questions" id="moveout-faq" />
      <div class="mt-8">
        <Verified date="2026-09-09" />
      </div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/residents/', label: 'Resident hub', note: 'Every resident task in one place.' },
    { href: '/residents/moving-in/', label: 'Moving in', note: 'The condition report your deposit is measured against.' },
    { href: '/residents/pay-rent/', label: 'Pay rent', note: 'Rent stays due through the end of the term.' },
    { href: '/homes-for-rent/', label: 'Homes for rent', note: 'Staying in the metro? See what else is open.' },
    { href: '/resident-faqs/', label: 'Resident FAQs', note: 'The long list, grouped by topic.' },
  ]} />

  <Cta
    heading="Give notice in writing, and take photos"
    body="Give written notice through the portal and a forwarding address, and take dated photos of the empty, clean home. Those three things carry the most weight when your deposit is settled."
    primary={{ label: 'Go to the resident hub', href: '/residents/' }}
    secondary={{ label: 'View available homes', href: '/homes-for-rent/' }}
  />
</Base>
