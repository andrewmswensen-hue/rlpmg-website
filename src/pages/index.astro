---
import Base from '../layouts/Base.astro';
import MotionScript from '../components/MotionScript.astro';
import Photo from '../components/Photo.astro';
import Stars from '../components/Stars.astro';
import PricingTable from '../components/PricingTable.astro';
import Faq from '../components/Faq.astro';
import { company, pricing, kpis, areas, areaUrl, areaRegions, usd, typicalManager } from '../data/facts';
import { partitionAreas } from '../lib/areas';
import { totalActiveDoors } from '../data/markets';
import { serviceNode } from '../lib/schema';

const title = 'Columbus Property Management | RL Property Management';
const description =
  `Columbus property management with published pricing and no leasing fee. ${company.unitsManaged} units under ` +
  `management, a ${usd(pricing.leasingFee)} leasing fee, and a performance scorecard we update monthly.`;

const { linked: linkedAreas, unlinked: namedAreas } = partitionAreas(areas, areaUrl);

const kpi = (id: string) => kpis.metrics.find((m) => m.id === id)!.value;
const avgRent = kpi('avgRent');
/** A typical manager's leasing fee (facts.ts typicalManager, 75% of a month) on our average rent. */
const leasingSaving = typicalManager.leasingFee(Number(avgRent.replace(/[^0-9.]/g, '')));
const heroStats = kpis.metrics.filter((m) => ['dom', 'collectedBy5', 'renewal', 'repairDays'].includes(m.id));
/**
 * Count-up settings for a scorecard value (motion.css .rv-count), read from the
 * value string itself: '72%' -> --to:72 with a % suffix, '20' -> --to:20. The
 * counter prints whole numbers with no thousands separator, so anything else
 * ('4.3', '$1,653') returns null and stays static.
 */
const countUp = (v: string) => {
  const m = v.match(/^(\$?)(\d{1,3})(%?)$/);
  return m ? { style: `--to:${m[2]}`, 'data-pre': m[1] || undefined, 'data-suf': m[3] || undefined } : null;
};

const services = [
  { h: 'Marketing and leasing', p: 'Listed on every major rental site and priced with current Columbus rental data.', href: '/services/marketing-and-leasing/', cta: 'How leasing works', icon: 'key' },
  { h: 'Tenant screening', p: 'Credit, income, rental history, and background checks to find the most qualified tenant for your rental.', href: '/services/tenant-screening/', cta: 'Our screening criteria', icon: 'userCheck' },
  { h: 'Maintenance', p: 'In-house maintenance team & vetted vendors, quarterly inspections, and 24/7 emergency coverage.', href: '/services/maintenance/', cta: 'Maintenance details', icon: 'wrench' },
  { h: 'Rent collection', p: 'Online payments and direct deposit. 96% of rent arrives by the 5th.', href: '/services/rent-collection/', cta: 'How we collect', icon: 'banknote' },
  { h: 'Owner reporting', p: 'Monthly statements, year-end reporting, and an owner portal you can check anytime.', href: '/services/owner-reporting/', cta: 'See a sample', icon: 'chart' },
  { h: 'Compliance and evictions', p: 'Ohio-compliant lease. Evictions handled when needed.', href: '/services/evictions/', cta: 'The process', icon: 'scale' },
];

/**
 * Decorative SOLID icons for the service cards (Andrew, 2026-11-16: filled, not
 * outlined, smaller, tucked into the lower-right corner). Simple filled shapes
 * drawn for this site on a 24-unit grid. Inline SVG, so no request and no JS.
 */
const serviceIcons: Record<string, string> = {
  key: '<path fill-rule="evenodd" d="M8 6.5a5.5 5.5 0 1 0 5.2 7.25H17v2.75h2.6v-2.75H21v2h2v-4.5h-9.8A5.5 5.5 0 0 0 8 6.5Zm0 3.4a2.1 2.1 0 1 0 0 4.2 2.1 2.1 0 0 0 0-4.2Z"/>',
  userCheck: '<circle cx="9" cy="7.5" r="4.2"/><path d="M1.5 21.5c0-4.3 3.4-7.6 7.5-7.6s7.5 3.3 7.5 7.6Z"/><circle cx="18.6" cy="10" r="4.4"/><path d="m16.6 10 1.4 1.4 2.6-2.8" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  banknote: '<path fill-rule="evenodd" d="M4 5.5h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Zm8 3.4a3.1 3.1 0 1 0 0 6.2 3.1 3.1 0 0 0 0-6.2ZM5.5 11a1 1 0 1 0 0 2 1 1 0 0 0 0-2Zm13 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"/>',
  chart: '<rect x="2.5" y="13" width="5" height="8.5" rx="1.2"/><rect x="9.5" y="8" width="5" height="13.5" rx="1.2"/><rect x="16.5" y="2.5" width="5" height="19" rx="1.2"/>',
  scale: '<rect x="11" y="3" width="2" height="17" rx="1"/><rect x="6.5" y="19.5" width="11" height="2.5" rx="1.25"/><rect x="2.5" y="5.5" width="19" height="2.2" rx="1.1"/><path d="M5.6 7.6 2.3 13.6h1.7l1.6-3.1 1.6 3.1h1.7Zm12.8 0-3.3 6h1.7l1.6-3.1 1.6 3.1h1.7Z"/><path d="M1.6 14.2h8a4 4 0 0 1-8 0Zm12.8 0h8a4 4 0 0 1-8 0Z"/>',
};

/**
 * The plan. Andrew asked for this after seeing a competitor's version, and it
 * earns its place: the most common reason an owner stalls is not price, it is
 * not knowing what happens after they call. Four steps, no jargon, and the
 * third one names the decision point rather than glossing over it.
 */
const howItWorks = [
  { h: 'Free consultation',
    p: 'Tell us about the property and your goals. No cost, no obligation.' },
  { h: 'Rent evaluation',
    p: 'We price it with our own Columbus data and flag anything it needs first.' },
  { h: 'Pick a plan',
    p: `Starting at ${usd(pricing.plans[0].monthly)} per month. You see the full cost before you sign.` },
  { h: 'We take it from here',
    p: 'Leasing, rent collection, and maintenance, with monthly statements and 24/7 portal access.' },
];

/**
 * The audience router. Three doors, owners first and visually primary.
 * "Resident" rather than "tenant" to match the rest of the site; the
 * residents page itself uses both, because "tenant portal" is what people search.
 */
const router = [
  { h: 'I own rentals', p: 'See services, pricing, & get a free consultation for management services.', href: '/property-management-consultation/' },
  { h: "I'm looking to rent", p: 'Available homes and how to apply', href: '/homes-for-rent/' },
  { h: "I'm a current resident", p: 'Pay rent, request a repair, find answers', href: '/residents/' },
];

const tools = [
  { h: 'Rent vs. sell', p: 'Worth keeping as a rental or better to sell?', cta: 'Compare rent vs. sell', href: '/rent-vs-sell-calculator/' },
  { h: 'Self-management', p: 'See what your time, vacancy, and repairs really cost you.', cta: 'Calculate your cost', href: '/self-management-calculator/' },
  { h: 'Vacancy cost', p: 'See what each empty day costs you, and what a faster lease saves.', cta: 'Calculate vacancy cost', href: '/tools/vacancy-cost-calculator/' },
  { h: 'Market report', p: 'Get 2026 Columbus rents, yields, and trends by neighborhood.', cta: 'Read the report', href: '/2026-columbus-market-report/' },
];


/** These answers are written to stand alone if an answer engine quotes just one. */
const faq = [
  { q: 'What does RL Property Management charge?',
    a: `Flat monthly management runs ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month across three plans. There is no leasing fee on any plan, lease renewals are ${usd(pricing.leaseRenewalFee)}, and there is no startup fee on occupied units.` },
  { q: 'Does RL Property Management charge a leasing fee?',
    a: `No. Placing a resident costs nothing on every plan, including listing syndication, showings, applicant screening and lease preparation. Most Columbus managers charge about ${typicalManager.leasingFeePhrase} for the same work.` },
  { q: 'What areas does RL Property Management serve?',
    a: `RL Property Management serves ${areas.length} communities across the Columbus, Ohio metro, including Columbus, Dublin, Upper Arlington, Westerville, Worthington, Gahanna, Hilliard, Powell, New Albany, Bexley, Grove City, Reynoldsburg and Pickerington.` },
  { q: 'How quickly does RL Property Management fill a vacancy?',
    a: `Median days on market across the portfolio is ${kpi('dom')} days, and median time to turn a unit is ${kpi('turn')} days, as of ${kpis.asOfLabel}.` },
  { q: 'How does RL Property Management bill repairs?',
    a: `In-house work is billed at ${usd(pricing.maintenance.inHouseHourly)} per hour plus a ${usd(pricing.maintenance.tripCharge)} trip charge, plus materials. Third-party vendor work is billed at vendor cost plus a ${pricing.maintenance.vendorProjectFeePct}% project management fee on vendor costs up to ${usd(pricing.maintenance.vendorProjectFeeAppliesUpTo)}, capped at ${usd(pricing.maintenance.vendorProjectFeeCap)} per project.` },
  { q: 'What insurance does RL Property Management require?',
    a: `A Rental Dwelling Policy or Commercial Policy with at least ${usd(pricing.insuranceRequired.liabilityMin)} in liability coverage, with ${company.name} listed as an additional insured.` },
];

const schemaNodes = [serviceNode({
  path: '/', name: 'Residential property management',
  description: `Full-service residential property management for single-family and small multifamily rental owners across the Columbus, Ohio metro.`,
})];
---
<Base {title} {description} {faq} {schemaNodes}>
  <MotionScript />

  <!-- HERO -->
  <!--
    HERO. Andrew, 2026-10-06: drop the rental-home photo (it read as a listing)
    for a full-width image behind two solid cards, and replace the photo slot
    with a router so each audience self-selects in one click.

    The skyline is an <img>, not a CSS background, so the browser's preload
    scanner finds it early. It is the largest thing above the fold, which makes
    it the LCP element, hence eager and fetchpriority high. It is decorative,
    because the cards carry all the content, so alt is empty.
  -->
  <section class="relative isolate overflow-hidden bg-navy">
    <img
      src="/images/photos/columbus-skyline-1400.webp"
      srcset="/images/photos/columbus-skyline-900.webp 900w, /images/photos/columbus-skyline-1400.webp 1400w, /images/photos/columbus-skyline-2000.webp 2000w"
      sizes="100vw" alt="" aria-hidden="true" width="2000" height="1125"
      loading="eager" fetchpriority="high" decoding="async"
      class="absolute inset-0 -z-10 w-full h-full object-cover" />
    <div class="absolute inset-0 -z-10" aria-hidden="true"
         style="background:linear-gradient(180deg, rgb(11 34 48 / .55) 0%, rgb(11 34 48 / .72) 100%)"></div>

    <div class="wrap pt-5 pb-10 sm:pt-12 lg:pt-16 lg:pb-12">
      <div class="grid gap-4 sm:gap-6 lg:grid-cols-[1.25fr_.75fr] lg:items-stretch">

        <!--
          LEFT CARD: the headline and the direct answer. Never displaced.
          On a phone it is trimmed to headline and answer only, so the router
          lands inside the first screen. The buttons, broker line and proof
          points are hidden below sm: the sticky bar carries the consultation
          CTA on mobile, and the proof points repeat in the scorecard.
        -->
        <div class="card !p-6 sm:!p-8 md:!p-10 !rounded-[22px]">
          <span class="eyebrow">Columbus, Ohio<span class="hidden sm:inline"> &nbsp;·&nbsp; Licensed brokerage since {company.founded}</span></span>
          <h1 class="text-[30px] sm:text-[clamp(36px,4.6vw,56px)] leading-[1.06] tracking-[-.022em]">
            Full-Service Columbus Property Management Company
          </h1>
          <p class="text-[17px] sm:text-[19px] text-muted mt-4 sm:mt-5 mb-0 sm:mb-2 max-w-[32em]">
            {company.unitsManaged} single-family and small multifamily rentals managed across Columbus.
            Flat pricing from {usd(pricing.plans[0].monthly)} per unit, investor rates from five units,
            and <strong class="text-navy font-semibold">no leasing fee</strong>.
          </p>
          <p class="hidden sm:block text-[15px] text-faint mb-6">
            {company.brokerOfRecord.name}, {company.brokerOfRecord.title}.
          </p>
          <div class="hidden sm:flex flex-wrap gap-3">
            <a href="/property-management-consultation/#consultation-form" class="btn btn-primary">Schedule a free consultation</a>
            <a href="/pricing/" class="btn btn-ghost">See our pricing</a>
          </div>
          <ul class="hidden sm:flex flex-wrap gap-x-7 gap-y-2 text-[14.5px] text-muted mt-7 pt-6 border-t border-line">
            <li class="flex items-center gap-2"><span class="text-crimson font-extrabold" aria-hidden="true">✓</span> {company.unitsManaged} units managed</li>
            <li class="flex items-center gap-2"><span class="text-crimson font-extrabold" aria-hidden="true">✓</span> {kpi('dom')}-day median time to lease</li>
            <li class="flex items-center gap-2"><span class="text-crimson font-extrabold" aria-hidden="true">✓</span> {usd(pricing.leasingFee)} leasing fee</li>
          </ul>
        </div>

        <!-- RIGHT CARD: the router. Owners first, because they are the business. -->
        <nav class="card !p-6 sm:!p-7 md:!p-8 !rounded-[22px] flex flex-col" aria-labelledby="router-h">
          <h2 id="router-h" class="text-[27px] sm:text-[30px] font-bold leading-tight mb-4">How can we help?</h2>
          <ul class="grid gap-3 flex-1 content-start sm:grid-rows-3 sm:content-stretch">
            {router.map((r, i) => (
              <li class="sm:h-full">
                <a href={r.href} class={`router-btn sm:h-full ${i === 0 ? 'router-primary' : ''}`}>
                  <span>
                    <span class="router-t">{r.h}</span>
                    <span class="router-s">{r.p}</span>
                  </span>
                  <span class="router-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
          <a href={company.reviews.url} target="_blank" rel="noopener"
             class="mt-6 pt-5 border-t border-line flex items-center gap-2 text-[13.5px] no-underline group">
            <Stars rating={company.reviews.rating} />
            <span class="font-semibold text-navy group-hover:underline">{company.reviews.rating} out of 5</span>
            <span class="text-muted group-hover:underline">&middot; {company.reviews.display} Google reviews</span>
          </a>
        </nav>
      </div>

      <!--
        Office, phone and hours under both cards, on the image. An owner wants
        to see a real address in their own city before they call, and it is the
        strongest local signal on the page.
      -->
      <div class="mt-7 grid gap-x-10 gap-y-3 text-[14.5px] text-white/90 sm:grid-cols-3">
        <p class="m-0">
          <span class="font-sans text-[11px] font-bold tracking-[.14em] uppercase text-white/60 block mb-1">Office</span>
          {company.address.street}, {company.address.city}, {company.address.region} {company.address.postalCode}
        </p>
        <p class="m-0">
          <span class="font-sans text-[11px] font-bold tracking-[.14em] uppercase text-white/60 block mb-1">Call us</span>
          <a href={`tel:${company.phoneE164}`} class="text-white font-semibold no-underline hover:underline">{company.phone}</a>
          <span class="text-white/70"> &middot; {company.email}</span>
        </p>
        <p class="m-0">
          <span class="font-sans text-[11px] font-bold tracking-[.14em] uppercase text-white/60 block mb-1">Hours</span>
          {company.officeHoursNote}
        </p>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="band band-wash">
    <div class="wrap">
      <div class="max-w-[660px] mx-auto text-center mb-11">
        <span class="eyebrow">Why choose RL Property Management</span>
        <h2 class="text-[clamp(28px,3.3vw,40px)]">Full-service property management with flat-rate, transparent pricing.</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <article class="card card-hover card-link flex flex-col relative overflow-hidden">
            <svg class="absolute right-3.5 bottom-3.5 w-[54px] h-[54px] text-crimson opacity-[.14] pointer-events-none"
                 viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"
                 set:html={serviceIcons[s.icon]} />
            <h3 class="relative text-[20px] mb-2">{s.h}</h3>
            <p class="relative text-[15px] text-muted mb-3.5 flex-1">{s.p}</p>
            <a href={s.href} class="card-link-a self-start pr-16 font-sans text-[14px] font-semibold text-crimson no-underline">{s.cta} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="band" aria-labelledby="how-h">
    <div class="wrap">
      <div class="max-w-[660px] mb-12">
        <span class="eyebrow">How to get started</span>
        <h2 id="how-h" class="text-[clamp(28px,3.3vw,40px)]">From first call to placed resident</h2>
        <p class="mt-3.5 text-[17.5px] text-muted">
          Before you commit to anything, talk with our team: find out what your property can rent for and
          get your questions answered.
        </p>
      </div>

      <ol class="grid gap-x-6 gap-y-10 sm:grid-cols-2 xl:grid-cols-4 relative">
        <!--
          The connector is a single line behind the numbered markers, drawn only
          on the wide layout where the steps sit in a row. It is decorative, so
          it is hidden from assistive technology and the list still reads as an
          ordered list of four steps.
        -->
        <div class="hidden xl:block absolute left-[12.5%] right-[12.5%] top-[26px] h-px bg-line rv-grow-x" aria-hidden="true"></div>
        {howItWorks.map((step, i) => (
          <li class="relative text-center rv" style={`--i:${i}`}>
            <div class="w-[52px] h-[52px] mx-auto rounded-full border-2 border-crimson bg-white
                        grid place-items-center font-serif text-[20px] font-semibold text-navy relative z-10">
              {i + 1}
            </div>
            <h3 class="text-[20px] mt-5 mb-2.5">{step.h}</h3>
            <p class="text-[15px] text-muted m-0 mx-auto max-w-[24em]">{step.p}</p>
          </li>
        ))}
      </ol>

      <div class="text-center mt-12">
        <a href="/property-management-consultation/" class="btn btn-primary">Schedule a free consultation</a>
      </div>
    </div>
  </section>

  <!--
    NO LEASING FEE BANNER. Andrew, 2026-11-05: a red band that names the
    differentiator and what it saves up front. 2026-11-16: moved to sit directly
    above Clear pricing, solid red with a shallow V along the bottom edge that
    points down at the pricing section. The saving
    is typicalManager.leasingFee (75% of a month) on the portfolio's average rent,
    so it moves on its own when kpis.avgRent is updated.
  -->
  <section class="lf-band text-white" aria-labelledby="noleasing-h">
    <div class="wrap pt-10 sm:pt-11 pb-14 sm:pb-16 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <!-- The typical fee struck through, then our $0. Static (with a plain
             line-through) wherever scroll animation is off; see the style block. -->
        <p class="font-sans m-0 mb-5 inline-flex flex-wrap items-baseline gap-x-6 gap-y-1 rounded-[14px] bg-white/10 px-4 py-2.5">
          <span class="inline-flex items-baseline gap-3 whitespace-nowrap">
            <span class="text-[11px] font-bold tracking-[.14em] uppercase text-[#f3c5cd]">Typical leasing fee</span>
            <s class="lf-was rv-strike text-[21px] font-bold text-[#f3c5cd] tabular-nums">{usd(leasingSaving)}</s>
          </span>
          <span class="inline-flex items-baseline gap-3 whitespace-nowrap">
            <span class="text-[11px] font-bold tracking-[.14em] uppercase text-[#f3c5cd]">Ours</span>
            <span class="rv-pop inline-block text-[26px] font-extrabold text-white leading-none tabular-nums">{usd(pricing.leasingFee)}</span>
          </span>
        </p>
        <h2 id="noleasing-h" class="!text-white text-[clamp(28px,3.4vw,42px)] mb-3">No leasing fees. On every plan.</h2>
        <p class="text-[17.5px] text-white/90 max-w-[40em] m-0">
          Most Columbus managers charge about {typicalManager.leasingFeePhrase} every time they place a resident. At our
          average rent of {avgRent}, that is roughly {usd(leasingSaving)} you keep at every turnover, and it is
          the first cost you skip when you switch.
        </p>
      </div>
      <a href="/pricing/" class="btn btn-on-dark justify-self-start lg:justify-self-end">See full pricing</a>
    </div>
  </section>

  <!-- PRICING -->
  <section class="band band-wash !pt-10" aria-labelledby="pricing-h">
    <div class="wrap">
      <div class="max-w-[660px] mx-auto text-center mb-11">
        <span class="eyebrow">Clear pricing</span>
        <h2 id="pricing-h" class="text-[clamp(28px,3.3vw,40px)]">A flat rate, not a slice of your rent</h2>
        <p class="mt-3.5 text-[17.5px] text-muted">
          Standard pricing for everyone. Even when your property's rent goes up, our pricing stays the same.
          Discounted rates for multiple units.
        </p>
      </div>
      <PricingTable id="home-pricing" />

      <div class="max-w-[760px] mx-auto text-center mt-10">
        <p class="text-[15px] text-muted">
          No startup cost on occupied units.
          <a href="/pricing/" class="text-crimson font-semibold no-underline hover:underline"> See exactly what management costs &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- SCORECARD SPLIT -->
  <section class="band">
    <div class="wrap grid gap-13 lg:grid-cols-2 lg:items-center">
      <div>
        <span class="eyebrow">Our scorecard</span>
        <h2 class="text-[clamp(28px,3.3vw,40px)]">We publish our numbers, monthly.</h2>
        <p class="text-[17.5px] text-muted mt-4 mb-6">
          Days to lease, repair times, renewals and rent collected, updated every month, good or bad.
        </p>
        <a href="/key-performance-indicators/" class="btn btn-navy">See the full scorecard</a>

        <div class="grid grid-cols-2 gap-4 mt-9">
          {heroStats.map((m) => {
            const cu = countUp(m.value);
            return (
            <div class="border-l-2 border-crimson pl-4">
              <div class="font-sans text-[30px] font-extrabold text-navy tracking-[-.035em] leading-none">
                {cu ? <span class="rv-count" {...cu}>{m.value}</span> : m.value}
              </div>
              <div class="text-[13.5px] text-muted mt-1.5">{m.label}</div>
            </div>
            );
          })}
        </div>
        <p class="text-[13px] text-faint mt-5 mb-0">As of {kpis.asOfLabel}.</p>
      </div>
      <div class="rounded-[18px] overflow-hidden aspect-[4/3] border border-line">
        <Photo src="aerial-autumn-suburb" widths={[640, 1000, 1400]} ratio={3 / 2}
               sizes="(max-width: 900px) 92vw, 46vw"
               alt="An aerial view of a Central Ohio residential neighborhood in autumn, streets of homes under orange and red trees at sunset"
               imgClass="w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="band band-wash">
    <div class="wrap">
      <div class="max-w-[660px] mx-auto text-center mb-11">
        <span class="eyebrow">Owner tools</span>
        <h2 class="text-[clamp(28px,3.3vw,40px)]">Run the numbers before you call us</h2>
        <p class="mt-3.5 text-[17.5px] text-muted">
          Free calculators built on our own Columbus data. No email required.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {tools.map((t) => (
          <article class="card card-hover card-link flex flex-col relative">
            <h3 class="text-[18px] mb-2">{t.h}</h3>
            <p class="text-[15px] text-muted mb-3 flex-1">{t.p}</p>
            <a href={t.href} class="card-link-a self-start font-sans text-[14px] font-semibold text-crimson no-underline">{t.cta} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- AREAS. Andrew, 2026-11-16: five regions instead of a 35-tile grid. Each
       column is a solid red card listing its communities, always open, each with
       an arrow link (Andrew's follow-up the same day). -->
  <section class="band" aria-labelledby="areas-h">
    <div class="wrap">
      <div class="max-w-[660px] mx-auto text-center mb-10">
        <span class="eyebrow">Where we work</span>
        <h2 id="areas-h" class="text-[clamp(28px,3.3vw,40px)]">{areas.length} communities across Central Ohio</h2>
        <p class="mt-3.5 text-[17.5px] text-muted">
          Each has its own page with the local court, utilities, and registration rules.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {areaRegions.map((r) => {
          const list = linkedAreas.filter((a) => a.region === r);
          const named = namedAreas.filter((a) => a.region === r);
          return (
            <div class="region-col">
              <h3 class="region-h">{r}</h3>
              <p class="region-n">{list.length + named.length} communities</p>
              <ul class="region-list">
                {list.map((a) => (
                  <li><a href={a.href}><span>{a.name}</span><span class="region-arrow" aria-hidden="true">&rarr;</span></a></li>
                ))}
                {named.map((a) => (<li><span>{a.name}</span></li>))}
              </ul>
            </div>
          );
        })}
      </div>
      <p class="text-center mt-8 mb-0">
        <a href="/areas-we-serve/" class="font-sans text-[15.5px] font-semibold text-crimson no-underline hover:underline">See all {areas.length} areas we serve &rarr;</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band band-wash">
    <div class="wrap">
      <div class="max-w-[660px] mx-auto text-center mb-9">
        <span class="eyebrow">Quick answers</span>
        <h2 class="text-[clamp(28px,3.3vw,40px)]">Common questions Columbus owners ask us</h2>
      </div>
      <div class="max-w-[800px] mx-auto"><Faq items={faq} id="home-faq" /></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-maroon text-white text-center py-[88px]">
    <div class="wrap">
      <h2 class="!text-white text-[clamp(30px,3.8vw,46px)] max-w-[16em] mx-auto mb-4">
        Find out what your Columbus rental should earn
      </h2>
      <p class="text-[#e2c8cc] text-[18px] max-w-[34em] mx-auto mb-7">
        A free rent evaluation based on our own portfolio and current comps.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/free-rent-evaluation/" class="btn btn-on-dark">Get a free rent evaluation</a>
        <a href={`tel:${company.phoneE164}`} class="btn btn-outline-light">Call {company.phone}</a>
      </div>
    </div>
  </section>
</Base>

