    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    padding: 9px 0; font-family: var(--font-sans); font-size: 15px; font-weight: 500;
    color: #fff; text-decoration: none;
  }
  .region-arrow { flex: 0 0 auto; opacity: .7; transition: transform .15s, opacity .15s; }
