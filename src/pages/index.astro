---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Stars from '../components/Stars.astro';
import Faq from '../components/Faq.astro';
import { company, pricing, kpis, areas, areaUrl, usd } from '../data/facts';
import { partitionAreas } from '../lib/areas';
import { totalActiveDoors } from '../data/markets';
import { serviceNode } from '../lib/schema';

const title = 'Columbus, Ohio Property Management | RL Property Management';
const description =
  `Columbus property management with published pricing and no leasing fee. ${company.unitsManaged} units under ` +
  `management, a ${usd(pricing.leasingFee)} leasing fee, and a performance scorecard we update monthly.`;

const { linked: linkedAreas, unlinked: namedAreas } = partitionAreas(areas, areaUrl);

const kpi = (id: string) => kpis.metrics.find((m) => m.id === id)!.value;
const heroStats = kpis.metrics.filter((m) => ['dom', 'collectedBy5', 'renewal', 'repairDays'].includes(m.id));

const services = [
  { h: 'Marketing and leasing', p: 'Syndication to every major rental portal, self-guided showings, and pricing set against our own Columbus portfolio data.', href: '/services/marketing-and-leasing/', cta: 'How leasing works' },
  { h: 'Resident screening', p: 'Credit, criminal, income, rental history and eviction checks, applied consistently and within fair housing law.', href: '/services/tenant-screening/', cta: 'Our screening criteria' },
  { h: 'Maintenance', p: `In-house technicians at ${usd(pricing.maintenance.inHouseHourly)} an hour, vetted vendors, quarterly inspections, and 24/7 emergency coverage.`, href: '/services/maintenance/', cta: 'Maintenance details' },
  { h: 'Rent collection', p: 'Online payment, automated late notices, and owner direct deposit. 96% of rent lands by the 5th.', href: '/services/rent-collection/', cta: 'How we collect' },
  { h: 'Owner reporting', p: 'Monthly statements, year-end reporting, and a real-time owner portal so you are never guessing.', href: '/services/owner-reporting/', cta: 'See a sample' },
  { h: 'Compliance and evictions', p: 'A custom lease reviewed by counsel, Ohio landlord-tenant compliance, and eviction handling when it is needed.', href: '/services/evictions/', cta: 'The process' },
];

/**
 * The plan. Andrew asked for this after seeing a competitor's version, and it
 * earns its place: the most common reason an owner stalls is not price, it is
 * not knowing what happens after they call. Four steps, no jargon, and the
 * third one names the decision point rather than glossing over it.
 */
const howItWorks = [
  { h: 'Free consultation',
    p: 'Tell us about the property, what you want out of it, and how involved you want to be. No charge and no obligation.' },
  { h: 'Rent evaluation',
    p: 'We price it against our own Columbus portfolio, not a public index, and tell you what it should rent for and what it needs first.' },
  { h: 'Pick a plan',
    p: `Three plans, ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month. You see the whole cost, including what we do not charge for, before you sign.` },
  { h: 'We take it from here',
    p: 'Marketing, showings, screening, the lease, rent collection and maintenance. You get monthly statements and a portal that is always current.' },
];

const tools = [
  { h: 'Rent vs. sell', p: 'Keep it as a rental, or sell now?', href: '/rent-vs-sell-calculator/' },
  { h: 'Self-management', p: 'What your own time is costing you.', href: '/self-management-calculator/' },
  { h: 'Vacancy cost', p: 'The daily cost of an empty unit.', href: '/tools/vacancy-cost-calculator/' },
  { h: 'Market report', p: '2026 Columbus single-family rental data.', href: '/2026-columbus-market-report/' },
];

const renterLinks = [
  { h: 'Available homes', p: 'Browse current vacancies.', href: '/homes-for-rent/' },
  { h: 'Apply online', p: 'Criteria and application.', href: '/residents/how-to-apply/' },
  { h: 'Pay rent', p: 'Your resident portal.', href: '/residents/pay-rent/' },
  { h: 'Maintenance', p: 'Submit a repair request.', href: '/residents/maintenance-requests/' },
];

/** These answers are written to stand alone if an answer engine quotes just one. */
const faq = [
  { q: 'What does RL Property Management charge?',
    a: `Flat monthly management runs ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month across three plans. There is no leasing fee on any plan, lease renewals are ${usd(pricing.leaseRenewalFee)}, and there is no startup fee on occupied units.` },
  { q: 'Does RL Property Management charge a leasing fee?',
    a: 'No. Placing a resident costs nothing on every plan, including listing syndication, showings, applicant screening and lease preparation. Most Columbus managers charge about half a month of rent for the same work.' },
  { q: 'What areas does RL Property Management serve?',
    a: `RL Property Management serves ${areas.length} communities across the Columbus, Ohio metro, including Columbus, Dublin, Upper Arlington, Westerville, Worthington, Gahanna, Hilliard, Powell, New Albany, Bexley, Grove City, Reynoldsburg and Pickerington.` },
  { q: 'How quickly does RL Property Management fill a vacancy?',
    a: `Median days on market across the portfolio is ${kpi('dom')} days, and median time to turn a unit is ${kpi('turn')} days, as of ${kpis.asOfLabel}.` },
  { q: 'How does RL Property Management bill repairs?',
    a: `In-house work is billed at ${usd(pricing.maintenance.inHouseHourly)} per hour plus a ${usd(pricing.maintenance.tripCharge)} trip charge, plus materials. Third-party vendor work is billed at vendor cost plus a ${pricing.maintenance.vendorProjectFeePct}% project management fee on vendor costs up to ${usd(pricing.maintenance.vendorProjectFeeAppliesUpTo)}, capped at ${usd(pricing.maintenance.vendorProjectFeeCap)} per project.` },
  { q: 'What insurance does RL Property Management require?',
    a: `A Rental Dwelling Policy or Commercial Policy with at least ${usd(pricing.insuranceRequired.liabilityMin)} in liability coverage, with ${company.name} listed as an additional insured.` },
];

const schemaNodes = [serviceNode({
  path: '/', name: 'Residential property management',
  description: `Full-service residential property management for single-family and small multifamily rental owners across the Columbus, Ohio metro.`,
})];
---
<Base {title} {description} {faq} {schemaNodes}>

  <!-- HERO -->
  <section class="pt-12 pb-14 lg:pt-14 lg:pb-16">
    <div class="wrap">
      <div class="grid gap-12 lg:grid-cols-[1.06fr_.94fr] lg:items-center">
        <div>
          <span class="eyebrow">Columbus, Ohio &nbsp;·&nbsp; Licensed brokerage since {company.founded}</span>
          <h1 class="text-[clamp(38px,5vw,58px)] leading-[1.06] tracking-[-.022em]">
            Columbus property management, run like a business.
          </h1>
          <p class="text-[19.5px] text-muted mt-5 mb-2 max-w-[32em]">
            We manage {company.unitsManaged} single-family and small multifamily rentals across the
            Columbus metro. Flat pricing from {usd(pricing.plans[0].monthly)} per unit, and no leasing fee.
          </p>
          <p class="text-[15.5px] text-faint mb-6">
            {company.brokerOfRecord.name}, {company.brokerOfRecord.title}.
          </p>

          <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
            <a href="/property-management-consultation/" class="btn btn-primary">Schedule a free consultation</a>
            <a href="/pricing/" class="btn btn-ghost">See our pricing</a>
            <a href="/homes-for-rent/" class="text-[15px] text-crimson font-semibold no-underline hover:underline">
              Looking to rent? See available homes &rarr;
            </a>
          </div>

          <ul class="flex flex-wrap gap-x-7 gap-y-2 text-[14.5px] text-muted mt-6 pt-6 border-t border-line">
            <li class="flex items-center gap-2"><span class="text-crimson font-extrabold" aria-hidden="true">✓</span> {company.unitsManaged} units managed</li>
            <li class="flex items-center gap-2"><span class="text-crimson font-extrabold" aria-hidden="true">✓</span> {kpi('dom')}-day median time to lease</li>
            <li class="flex items-center gap-2"><span class="text-crimson font-extrabold" aria-hidden="true">✓</span> {usd(pricing.leasingFee)} leasing fee</li>
          </ul>
        </div>

        <div class="relative grid place-items-center">
          <div class="w-full max-w-[390px] aspect-square rounded-full border-[3px] border-crimson overflow-hidden"
               style="box-shadow:0 14px 36px rgb(18 49 67 / .12)">
            <Photo src="hero-home-square" widths={[520, 800, 1100]} ratio={1} eager
                   sizes="(max-width: 900px) 84vw, 390px"
                   alt="A two-storey red rental home photographed head on, with a covered front porch and steps up from the pavement"
                   imgClass="w-full h-full object-cover" />
          </div>
          <div class="absolute bottom-2 right-[2%] bg-white border border-line rounded-full px-4 py-2.5 flex items-center gap-2"
               style="box-shadow:0 1px 2px rgb(18 49 67 / .05), 0 8px 24px rgb(18 49 67 / .06)">
            <Stars rating={company.reviews.rating} />
            <span class="text-[13px] font-bold text-navy">
              {company.reviews.rating} out of 5
              <span class="font-normal text-muted">&middot; {company.reviews.display} Google reviews</span>
            </span>
          </div>
        </div>
      </div>

      <!--
        Office, phone and hours run the full width under both columns rather
        than stacking inside the text column, which was making the hero tall.
        An owner deciding whether to call wants to see a real address in their
        own city, and it is the strongest local signal on the page.
      -->
      <div class="mt-12 pt-6 border-t border-line grid gap-x-10 gap-y-4 text-[14.5px] sm:grid-cols-3">
        <p class="m-0">
          <span class="font-sans text-[11.5px] font-bold tracking-[.14em] uppercase text-faint block mb-1">Office</span>
          <span class="text-navy">{company.address.street}, {company.address.city}, {company.address.region} {company.address.postalCode}</span>
        </p>
        <p class="m-0">
          <span class="font-sans text-[11.5px] font-bold tracking-[.14em] uppercase text-faint block mb-1">Call us</span>
          <a href={`tel:${company.phoneE164}`} class="text-crimson font-semibold no-underline hover:underline">{company.phone}</a>
          <span class="text-muted"> &middot; {company.email}</span>
        </p>
        <p class="m-0">
          <span class="font-sans text-[11.5px] font-bold tracking-[.14em] uppercase text-faint block mb-1">Hours</span>
          <span class="text-muted">{company.officeHoursNote}</span>
        </p>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="band band-wash">
    <div class="wrap">
      <div class="max-w-[660px] mx-auto text-center mb-11">
        <span class="eyebrow">What we do</span>
        <h2 class="text-[clamp(28px,3.3vw,40px)]">Full-service management, priced in the open</h2>
        <p class="mt-3.5 text-[17.5px] text-muted">
          Everything a Columbus rental needs, handled by a team that publishes its own numbers.
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <article class="card card-hover flex flex-col">
            <h3 class="text-[20px] mb-2">{s.h}</h3>
            <p class="text-[15px] text-muted mb-3.5 flex-1">{s.p}</p>
            <a href={s.href} class="font-sans text-[14px] font-semibold text-crimson no-underline hover:underline">{s.cta} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="band" aria-labelledby="how-h">
    <div class="wrap">
      <div class="max-w-[660px] mb-12">
        <span class="eyebrow">How it works</span>
        <h2 id="how-h" class="text-[clamp(28px,3.3vw,40px)]">From first call to placed resident</h2>
        <p class="mt-3.5 text-[17.5px] text-muted">
          Four steps, and you know the rent number and the full cost before you commit to anything.
        </p>
      </div>

      <ol class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4 relative">
        <!--
          The connector is a single line behind the numbered markers, drawn only
          on the wide layout where the steps sit in a row. It is decorative, so
          it is hidden from assistive technology and the list still reads as an
          ordered list of four steps.
        -->
        <div class="hidden lg:block absolute left-[12.5%] right-[12.5%] top-[26px] h-px bg-line" aria-hidden="true"></div>
        {howItWorks.map((step, i) => (
          <li class="relative text-center">
            <div class="w-[52px] h-[52px] mx-auto rounded-full border-2 border-crimson bg-white
                        grid place-items-center font-serif text-[20px] font-semibold text-navy relative z-10">
              {i + 1}
            </div>
            <h3 class="text-[20px] mt-5 mb-2.5">{step.h}</h3>
            <p class="text-[15px] text-muted m-0 mx-auto max-w-[26em]">{step.p}</p>
          </li>
        ))}
      </ol>

      <div class="text-center mt-12">
        <a href="/property-management-consultation/" class="btn btn-primary">Schedule a free consultation</a>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="band band-wash" aria-labelledby="pricing-h">
    <div class="wrap">
      <div class="max-w-[660px] mx-auto text-center mb-11">
        <span class="eyebrow">Clear pricing</span>
        <h2 id="pricing-h" class="text-[clamp(28px,3.3vw,40px)]">A flat rate, not a slice of your rent</h2>
        <p class="mt-3.5 text-[17.5px] text-muted">
          Published on the website, the same for everyone. A percentage manager earns more every time
          your rent goes up. We do not, so raising your rent is purely your gain.
        </p>
      </div>
      <div class="grid gap-6 lg:grid-cols-3">
        {pricing.plans.map((p, i) => (
          <div class="card flex flex-col">
            <div class="font-sans text-[12px] font-bold tracking-[.13em] uppercase text-faint mb-3">{p.name}</div>
            <div class="font-sans text-[48px] font-extrabold tracking-[-.045em] text-navy leading-none">{usd(p.monthly)}</div>
            <div class="font-sans text-[13.5px] text-faint mt-2 mb-5">per unit, per month</div>
            <ul class="border-t border-line pt-4.5 mb-6 flex-1 font-sans">
              <li class="text-[14.5px] py-1.5 text-muted"><b class="text-navy font-bold">{usd(pricing.leasingFee)}</b> leasing fee</li>
              <li class="text-[14.5px] py-1.5 text-muted"><b class="text-navy font-bold">{usd(pricing.leaseRenewalFee)}</b> lease renewal</li>
              <li class="text-[14.5px] py-1.5 text-muted"><b class="text-navy font-bold">{usd(p.repairApprovalLimit)}</b> repair approval limit</li>
              <li class="text-[14.5px] py-1.5 text-muted">Full screening and rent collection</li>
              <li class="text-[14.5px] py-1.5 text-muted">Monthly statements and owner portal</li>
            </ul>
            <a href="/pricing/" class="btn btn-ghost text-center">Compare plans</a>
          </div>
        ))}
      </div>
      <div class="max-w-[760px] mx-auto text-center mt-10">
        <p class="text-[17px] text-navy font-medium">
          Most Columbus managers charge half a month of rent every time they place a resident. On a
          {' '}{kpis.metrics.find((m) => m.id === 'avgRent')!.value} unit that is roughly $825 gone with each
          turnover. We charge {usd(pricing.leasingFee)}, on every plan, every time.
        </p>
        <p class="text-[15px] text-muted mt-3">
          No startup cost on occupied units, and portfolio owners are quoted at a discount.
          <a href="/pricing/" class="text-crimson font-semibold no-underline hover:underline"> See exactly what management costs &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- SCORECARD SPLIT -->
  <section class="band">
    <div class="wrap grid gap-13 lg:grid-cols-2 lg:items-center">
      <div>
        <span class="eyebrow">Our scorecard</span>
        <h2 class="text-[clamp(28px,3.3vw,40px)]">We publish our numbers, monthly.</h2>
        <p class="text-[17.5px] text-muted mt-4 mb-6">
          Most managers will tell you they are responsive and thorough. We would rather show you the
          median number of days a repair stays open, and update it whether the number flatters us or not.
        </p>
        <a href="/key-performance-indicators/" class="btn btn-navy">See the full scorecard</a>

        <div class="grid grid-cols-2 gap-4 mt-9">
          {heroStats.map((m) => (
            <div class="border-l-2 border-crimson pl-4">
              <div class="font-sans text-[30px] font-extrabold text-navy tracking-[-.035em] leading-none">{m.value}</div>
              <div class="text-[13.5px] text-muted mt-1.5">{m.label}</div>
            </div>
          ))}
        </div>
        <p class="text-[13px] text-faint mt-5 mb-0">As of {kpis.asOfLabel}.</p>
      </div>
      <div class="rounded-[18px] overflow-hidden aspect-[4/3] border border-line">
        <Photo src="new-townhomes" widths={[640, 1000, 1400]} ratio={3 / 2}
               sizes="(max-width: 900px) 92vw, 46vw"
               alt="A row of newly built townhomes with garages on a quiet residential street"
               imgClass="w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="band band-wash">
    <div class="wrap">
      <div class="max-w-[660px] mx-auto text-center mb-11">
        <span class="eyebrow">Owner tools</span>
        <h2 class="text-[clamp(28px,3.3vw,40px)]">Run the numbers before you call us</h2>
        <p class="mt-3.5 text-[17.5px] text-muted">
          Free calculators built on our own Columbus portfolio data. No email required.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {tools.map((t) => (
          <a href={t.href} class="card card-hover no-underline block">
            <h3 class="text-[18px] mb-2">{t.h}</h3>
            <p class="text-[15px] text-muted mb-3">{t.p}</p>
            <span class="font-sans text-[14px] font-semibold text-crimson">Run it →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- AREAS -->
  <section class="band">
    <div class="wrap">
      <div class="max-w-[660px] mx-auto text-center mb-11">
        <span class="eyebrow">Where we work</span>
        <h2 class="text-[clamp(28px,3.3vw,40px)]">{areas.length} communities across Central Ohio</h2>
        <p class="mt-3.5 text-[17.5px] text-muted">
          Every area has its own page with local rent data and what we manage there.
        </p>
      </div>
      <ul class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
        {linkedAreas.map((a) => (
          <li>
            <a href={a.href}
               class="block bg-white border border-line rounded-[12px] px-4 py-3.5 text-center no-underline font-sans text-[14.5px] font-medium text-navy hover:border-crimson hover:text-crimson transition-colors">
              {a.name}
            </a>
          </li>
        ))}
      </ul>
      {namedAreas.length > 0 && (
        <p class="text-center text-[15px] text-muted mt-6">
          We also manage in {namedAreas.map((a) => a.name).join(', ')}.
          <a href="/areas-we-serve/" class="text-crimson font-semibold no-underline hover:underline"> See the full service area →</a>
        </p>
      )}
    </div>
  </section>

  <!-- RENTERS -->
  <section class="band band-wash">
    <div class="wrap">
      <div class="max-w-[660px] mx-auto text-center mb-11">
        <span class="eyebrow">For renters</span>
        <h2 class="text-[clamp(28px,3.3vw,40px)]">Looking for a home in Columbus?</h2>
        <p class="mt-3.5 text-[17.5px] text-muted">
          Most of our homes offer self-guided tours. Applications are first come, first served.
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {renterLinks.map((r) => (
          <a href={r.href} class="card card-hover no-underline block">
            <h3 class="text-[18px] mb-2">{r.h}</h3>
            <p class="text-[15px] text-muted m-0">{r.p}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band">
    <div class="wrap">
      <div class="max-w-[660px] mx-auto text-center mb-9">
        <span class="eyebrow">Real answers</span>
        <h2 class="text-[clamp(28px,3.3vw,40px)]">Questions Columbus owners ask</h2>
      </div>
      <div class="max-w-[800px] mx-auto"><Faq items={faq} id="home-faq" /></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-maroon text-white text-center py-[88px]">
    <div class="wrap">
      <h2 class="!text-white text-[clamp(30px,3.8vw,46px)] max-w-[16em] mx-auto mb-4">
        Find out what your Columbus rental should earn
      </h2>
      <p class="text-[#e2c8cc] text-[18px] max-w-[34em] mx-auto mb-7">
        A free, data-backed rent evaluation using our own portfolio numbers and current market comps.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/free-rent-evaluation/" class="btn btn-on-dark">Get a free rent evaluation</a>
        <a href={`tel:${company.phoneE164}`} class="btn btn-outline-light">Call {company.phone}</a>
      </div>
    </div>
  </section>
</Base>
