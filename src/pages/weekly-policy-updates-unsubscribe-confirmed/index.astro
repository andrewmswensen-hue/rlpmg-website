---
import Base from '../../layouts/Base.astro';
import { company } from '../../data/facts';
const title = `Unsubscribed | ${company.name}`;
const description = 'You have been removed from the weekly policy update list.';
---
<Base {title} {description} noindex={true} markdownTwin={false}>
  <section class="band">
    <div class="wrap max-w-[640px]">
      <h1 class="text-[clamp(30px,3.6vw,42px)]">You are unsubscribed.</h1>
      <p class="text-[19px] text-muted mt-5">
        You will not receive further weekly policy updates. It can take a day or two for a message
        already in the queue to stop.
      </p>
      <p class="text-[17px] text-muted">
        If you were removed by mistake, or you would rather change what you receive than stop entirely,
        email <a href={`mailto:${company.email}`} class="text-crimson font-semibold no-underline hover:underline">{company.email}</a>
        or call {company.phone}.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/blog/" class="btn btn-ghost">Read the archive instead</a>
        <a href="/" class="btn btn-ghost">Back to the homepage</a>
      </div>
    </div>
  </section>
</Base>
