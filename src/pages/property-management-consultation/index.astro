---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import Stars from '../../components/Stars.astro';
import { company, pricing, kpis, rentPolicy, areas, usd } from '../../data/facts';
import { serviceNode } from '../../lib/schema';

/**
 * The conversion page. Every owner CTA on the site lands here.
 *
 * Andrew, 2026-10-06: hyper-optimize for lead generation, geared toward
 * intentional investors, and separate accidental landlords from intentional
 * or future investors before they become a lead.
 *
 * So the form sits at the top beside the headline rather than six sections
 * down, and asks two one-tap questions before anything else:
 *   1. which describes you: intentional investor, future investor, or
 *      accidental landlord. That is the ICP split, and it routes the lead.
 *   2. how many units, using the same bands as the pricing tiers, so a lead
 *      arriving from "Get this rate" on 10 to 19 units lands with it chosen.
 * Then four contact fields. Everything else is optional and collapsed.
 *
 * FORM: plain HTML post, works with no JavaScript. One small inline script
 * pre-selects the unit band from ?units= when someone arrives from a pricing
 * tier. Without it the form still works, the band just is not pre-selected.
 * The action endpoint is pending, see the comment on the <form> element.
 */

const title = 'Book a Property Management Consultation | RL Property Management, Columbus';
const description =
  `Book a free consultation with ${company.name}. Bring your addresses and current statements and leave with ` +
  `a written management quote, including portfolio pricing for owners with several units.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Owners', path: '/columbus-property-management/' },
  { name: 'Consultation', path: '/property-management-consultation/' },
];

const keyFacts = [
  'Free, and there is nothing to sign on the call',
  `Published per-unit pricing is ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per month`,
  pricing.portfolioDiscount.short,
  'You leave with a written number, not a callback promise',
  `Managing ${company.unitsManaged} units across the Columbus metro since ${company.founded}`,
  'Works for one unit or for a portfolio moving off another manager',
];

const agenda = [
  { h: 'What you own and where', p: 'Addresses, unit counts, bedroom counts and condition. If you own several, we look at the portfolio as one thing rather than a list.' },
  { h: 'What you want it to do', p: 'Hold for appreciation, maximize monthly cash flow, stabilize and sell in three years, or stop being the person who gets the 11pm call. These lead to different decisions.' },
  { h: 'What it should rent for', p: 'A rent range for each unit against our own leasing data and current comps, including whether anything on the property is holding the number down.' },
  { h: 'What we would charge', p: 'The plan that fits, the repair approval limit that goes with it, and for portfolio owners, a discounted number in writing.' },
  { h: 'What happens if you say yes', p: 'The sequence, the dates, and who your point of contact is. If you are leaving another manager, we build the transition plan on this call.' },
  { h: 'Whether this is a fit at all', p: 'If your property needs a renovation first, or sits outside where we can serve it well, we will say so on the call rather than after you sign.' },
];

const bring = [
  'Every address, with bedroom and bathroom counts',
  'Current rent and lease end date on each occupied unit',
  'Your last owner statement, if you have a manager now',
  'Your current management agreement, especially the termination clause',
  'Any deferred maintenance you already know about',
  'Your goal for the next three years',
];

const faq = [
  { q: 'What happens on a property management consultation?',
    a: `A call, usually about half an hour. We go through what you own, what you want it to do, what it should rent for, and what ${company.name} would charge to manage it. You leave with a written quote. Nothing is signed on the call.` },
  { q: 'Is the consultation free?',
    a: 'Yes. There is no fee and no obligation. If we are not the right manager for your property we will tell you on the call.' },
  { q: 'What does property management cost?',
    a: `A flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month depending on the plan, with a ${usd(pricing.leasingFee)} leasing fee, ${usd(pricing.leaseRenewalFee)} lease renewals and no startup fee on an occupied unit. The full fee schedule is published on the pricing page.` },
  { q: 'How does portfolio pricing work?',
    a: `${pricing.portfolioDiscount.line} For 40 units and up, this consultation is where the number gets built and put in writing.` },
  { q: 'I already have a property manager. Should I still book?',
    a: 'Yes, and bring your current management agreement. Owners lose money on a switch when the transfer is timed badly. We will read the termination clause with you and build a plan around your lease dates before anyone gives notice.' },
  { q: 'Do I have to commit to anything on the call?',
    a: 'No. The output of the call is a written quote and a plan. What you do with it is your decision, and plenty of owners take the rent range and keep self-managing.' },
  { q: 'How quickly can you take over a property?',
    a: 'That depends on your current agreement, your lease dates and whether the unit is occupied. We build the schedule on the consultation call rather than promising a date before we have seen the paperwork.' },
  { q: 'What if my property is outside the Columbus metro?',
    a: `We serve ${areas.length} communities across Franklin, Delaware, Fairfield, Licking, Union, Madison and Pickaway counties. If you are close to that footprint, ask. We would rather decline than manage a property badly from an hour away.` },
];

const schemaNodes = [
  serviceNode({
    path: '/property-management-consultation/',
    name: 'Property management consultation and portfolio quote',
    description: `A free consultation for Columbus, Ohio rental owners, ending in a written management quote including portfolio pricing.`,
  }),
];

/**
 * Question one is the ICP split. Intentional investors first, because they are
 * the priority; accidental landlords last but in plain words, so nobody feels
 * they picked the wrong door.
 */
const ownerTypes = [
  { v: 'intentional-investor', h: 'I own rentals and want to grow', p: 'Building a portfolio on purpose' },
  { v: 'future-investor',      h: 'I am buying, or about to buy',  p: 'Planning a first or next rental' },
  { v: 'accidental-landlord',  h: 'I ended up with a rental',      p: 'Inherited, relocated, or it did not sell' },
];

/** Question two uses the pricing tier bands, so a tier CTA can pre-select one. */
const unitBands = [
  { v: 'none',  label: 'None yet' },
  { v: '1-4',   label: '1 to 4' },
  ...pricing.portfolioDiscount.tiers.map((t) => ({ v: t.id, label: t.label.replace(' units', '') })),
  { v: '40+',   label: `${pricing.portfolioDiscount.customFrom}+` },
];

const choiceCls =
  'flex flex-col gap-0.5 rounded-[12px] border-[1.5px] border-line bg-white px-4 py-3 cursor-pointer ' +
  'transition-colors hover:border-navy has-[:checked]:border-crimson has-[:checked]:bg-[#fbeef1] ' +
  'has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-crimson has-[:focus-visible]:outline-offset-2';

const inputCls =
  'w-full rounded-[10px] border border-line bg-white px-3.5 py-2.5 text-[15.5px] text-navy ' +
  'focus:border-crimson focus:outline-none';
const labelCls = 'block font-sans text-[14px] font-semibold text-navy mb-1.5';
const hintCls = 'block text-[13px] text-faint mt-1.5';
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <section class="pt-12 pb-16 lg:pt-14" id="consultation-form">
    <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,.92fr)_minmax(0,1.08fr)] lg:items-start">

      <!-- LEFT: what they get, and why to trust it -->
      <div class="lg:sticky lg:top-[110px]">
        <nav aria-label="Breadcrumb" class="mb-5 text-[13px] text-faint">
          {breadcrumbs.map((b, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> / </span>}
              {i === breadcrumbs.length - 1
                ? <span aria-current="page">{b.name}</span>
                : <a href={b.path} class="no-underline hover:text-crimson">{b.name}</a>}
            </>
          ))}
        </nav>
        <span class="eyebrow">Free consultation</span>
        <h1 class="text-[clamp(32px,4.2vw,48px)] tracking-[-.022em]">Book a property management consultation</h1>
        <p class="text-[19px] text-muted mt-5">
          A free call with {company.name}. Tell us what you own and you leave with a written management
          quote, including investor pricing if you own five or more units. Nothing is signed on the call.
        </p>

        <ul class="grid gap-3 mt-7 text-[15.5px] text-navy">
          {keyFacts.slice(0, 4).map((k) => (
            <li class="flex gap-3"><span class="text-crimson font-extrabold shrink-0" aria-hidden="true">✓</span><span>{k}</span></li>
          ))}
        </ul>

        <div class="mt-8 pt-6 border-t border-line flex flex-wrap items-center gap-x-6 gap-y-3 text-[14.5px]">
          <span class="flex items-center gap-2">
            <Stars rating={company.reviews.rating} />
            <span class="font-semibold text-navy">{company.reviews.rating} out of 5</span>
            <span class="text-muted">{company.reviews.display} Google reviews</span>
          </span>
          <span class="text-muted">
            Rather talk now? Call our investor line,
            {' '}<a href={`tel:${company.salesPhoneE164}`} class="text-crimson font-semibold no-underline hover:underline">{company.salesPhone}</a>
          </span>
        </div>
      </div>

      <!-- RIGHT: the form -->
      <!--
        FORM ENDPOINT PENDING.
        The CRM is LeadSimple and submissions route by email. Set the `action`
        attribute to the LeadSimple inbound endpoint when it is issued, and keep
        `method="post"`. Do not hardcode a destination email address in the markup.
        Field names are unchanged from the previous version of this form, plus
        `owner_type`, so the CRM mapping only gains one field.
      -->
      <form method="post" action="" class="card !p-6 md:!p-8 grid gap-7" aria-labelledby="form-h">
        <div>
          <h2 id="form-h" class="text-[24px]">Tell us what you own</h2>
          <p class="text-[14.5px] text-muted mt-1.5 mb-0">Two quick questions, then how to reach you. About a minute.</p>
        </div>

        <fieldset class="border-0 p-0 m-0">
          <legend class={labelCls}>1. Which sounds most like you?</legend>
          <div class="grid gap-2.5 mt-1">
            {ownerTypes.map((o, i) => (
              <label class={choiceCls}>
                <span class="flex items-center gap-3">
                  <input type="radio" name="owner_type" value={o.v} required={i === 0} class="accent-crimson w-4 h-4 shrink-0" />
                  <span class="font-sans text-[15.5px] font-semibold text-navy">{o.h}</span>
                </span>
                <span class="text-[13.5px] text-muted pl-7">{o.p}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="border-0 p-0 m-0">
          <legend class={labelCls}>2. How many rental units do you own?</legend>
          <div class="grid grid-cols-3 gap-2.5 mt-1">
            {unitBands.map((u, i) => (
              <label class={`${choiceCls} !items-center !py-2.5 text-center`}>
                <input type="radio" name="units_owned" value={u.v} required={i === 0} class="sr-only" />
                <span class="font-sans text-[15px] font-semibold text-navy">{u.label}</span>
              </label>
            ))}
          </div>
          <span class={hintCls}>Five or more units sets your investor rate.</span>
        </fieldset>

        <fieldset class="border-0 p-0 m-0 grid gap-4">
          <legend class={labelCls}>3. How do we reach you?</legend>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="sr-only" for="c-first">First name</label>
              <input class={inputCls} id="c-first" name="first_name" type="text" autocomplete="given-name" placeholder="First name" required />
            </div>
            <div>
              <label class="sr-only" for="c-last">Last name</label>
              <input class={inputCls} id="c-last" name="last_name" type="text" autocomplete="family-name" placeholder="Last name" required />
            </div>
            <div>
              <label class="sr-only" for="c-email">Email</label>
              <input class={inputCls} id="c-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="Email" required />
            </div>
            <div>
              <label class="sr-only" for="c-phone">Phone</label>
              <input class={inputCls} id="c-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="Phone" required />
            </div>
          </div>
        </fieldset>

        <!-- Everything below is optional, and closed by default so the form reads short. -->
        <details class="group rounded-[12px] border border-line bg-wash-soft">
          <summary class="cursor-pointer list-none px-4 py-3 font-sans text-[14.5px] font-semibold text-navy flex justify-between items-center">
            <span>Add details now (optional)</span>
            <span class="text-crimson text-[20px] leading-none group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
          </summary>
          <div class="grid gap-5 px-4 pb-5 pt-1">
            <div>
              <label class={labelCls} for="c-company">Company or entity name</label>
              <input class={inputCls} id="c-company" name="company" type="text" autocomplete="organization" />
              <span class={hintCls}>If the properties are held in an LLC or a trust.</span>
            </div>
            <div>
              <label class={labelCls} for="c-type">Property type</label>
              <select class={inputCls} id="c-type" name="property_type">
                <option value="">Choose one</option>
                <option value="single-family">Single-family homes</option>
                <option value="small-multifamily">Small multifamily</option>
                <option value="mixed">A mix of both</option>
                <option value="other">Something else</option>
              </select>
            </div>
            <div>
              <label class={labelCls} for="c-situation">Where are you today?</label>
              <select class={inputCls} id="c-situation" name="current_situation">
                <option value="">Choose one</option>
                <option value="self-managing">Self-managing and want to stop</option>
                <option value="other-manager">With another manager and considering a change</option>
                <option value="multiple-managers">Consolidating from several managers</option>
                <option value="new-purchase">Buying now, or recently closed</option>
                <option value="first-rental">First rental, not managed yet</option>
                <option value="researching">Just researching for now</option>
              </select>
            </div>
            <div>
              <label class={labelCls} for="c-when">When would you want management to start?</label>
              <select class={inputCls} id="c-when" name="timeline">
                <option value="">Choose one</option>
                <option value="now">As soon as possible</option>
                <option value="30-days">Within 30 days</option>
                <option value="90-days">Within 90 days</option>
                <option value="lease-end">When the current lease ends</option>
                <option value="unsure">Not sure yet</option>
              </select>
            </div>
            <div>
              <label class={labelCls} for="c-addresses">Property addresses</label>
              <textarea class={inputCls} id="c-addresses" name="addresses" rows="3"></textarea>
              <span class={hintCls}>One per line. A partial list is fine, and so is a city and a count.</span>
            </div>
            <div>
              <label class={labelCls} for="c-goal">What are you trying to solve?</label>
              <textarea class={inputCls} id="c-goal" name="goal" rows="3"></textarea>
            </div>
          </div>
        </details>

        <div class="grid gap-4">
          <label class="flex gap-3 items-start text-[14px] text-muted cursor-pointer">
            <input type="checkbox" name="contact_consent" value="yes" required class="accent-crimson w-4 h-4 mt-0.5 shrink-0" />
            <span>I agree that {company.name} may contact me about this request by email or phone.</span>
          </label>
          <button type="submit" class="btn btn-primary w-full !py-3.5 !text-[16px]">Get my free consultation</button>
          <p class="text-[12.5px] text-faint m-0 text-center">
            Free, and no obligation. We do not sell or share your information.
            {' '}<a href="/privacy-policy/" class="text-crimson no-underline hover:underline">Privacy policy</a>.
          </p>
        </div>
      </form>
    </div>
  </section>

  <!--
    Progressive enhancement only. A visitor arriving from a pricing tier
    (?units=10-19) lands with that band already chosen. Without JavaScript
    the form works exactly the same, the band just is not pre-selected.
  -->
  <script is:inline>
    (function () {
      var u = new URLSearchParams(location.search).get('units');
      if (!u) return;
      var r = document.querySelector('input[name="units_owned"][value="' + u.replace(/"/g, '') + '"]');
      if (r) r.checked = true;
    })();
  </script>

  <!-- AGENDA -->
  <section class="band-tight" aria-labelledby="agenda-h">
    <div class="wrap max-w-[880px]">
      <h2 id="agenda-h" class="text-[clamp(26px,3.2vw,38px)]">What happens on the call?</h2>
      <p class="text-[17.5px] text-muted mt-4 mb-8">
        Six things, in this order. It is a working call with no presentation and no deck.
      </p>
      <div class="grid gap-5 sm:grid-cols-2">
        {agenda.map((a) => (
          <div class="card">
            <h3 class="text-[18.5px] mb-2">{a.h}</h3>
            <p class="text-[15px] text-muted m-0">{a.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PORTFOLIO -->
  <section class="band-tight" aria-labelledby="portfolio-h">
    <div class="wrap max-w-[880px]">
      <div class="card !border-2 !border-navy !p-9 md:!p-11">
        <span class="eyebrow">For portfolio owners</span>
        <h2 id="portfolio-h" class="text-[clamp(24px,2.9vw,34px)] mb-4">Investor pricing, and custom pricing at 40 units and up</h2>
        <p class="text-[17.5px] text-muted mb-5">
          {pricing.portfolioDiscount.line} At 40 units and up, the right number depends on your mix of
          properties and how close together they sit, so we build it around the portfolio.
        </p>
        <p class="text-[17.5px] text-muted mb-6">
          Tell us what you own on the form below and we will put a number in writing. If you are consolidating
          from several managers, say so, because that changes the transition plan more than it changes the price.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#consultation-form" class="btn btn-navy">Get custom pricing</a>
          <a href="/investors/#discount-h" class="btn btn-ghost">See investor pricing</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT TO BRING -->
  <section class="band band-wash" aria-labelledby="bring-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Come prepared</span>
      <h2 id="bring-h" class="text-[clamp(26px,3.2vw,38px)]">What should you bring?</h2>
      <p class="text-[17.5px] text-muted mt-4 mb-6">
        None of it is required, but the more you bring, the more likely you leave with an exact number
        instead of a range.
      </p>
      <ul class="grid gap-x-8 gap-y-1 sm:grid-cols-2">
        {bring.map((x) => (
          <li class="flex gap-3 py-1.5 text-[15.5px]">
            <span class="text-crimson font-extrabold shrink-0" aria-hidden="true">✓</span><span>{x}</span>
          </li>
        ))}
      </ul>
      <p class="text-[15.5px] text-muted mt-7">
        If you are currently with another manager, read
        {' '}<a href="/switching-property-managers/" class="text-crimson font-semibold no-underline hover:underline">how to switch property managers</a>
        {' '}before the call. The timing of a transfer matters more than most owners expect.
      </p>
    </div>
  </section>

  <!-- WHAT YOU ALREADY KNOW -->
  <section class="band-tight" aria-labelledby="known-h">
    <div class="wrap max-w-[880px]">
      <h2 id="known-h" class="text-[clamp(26px,3.2vw,38px)]">What can you find out before you even call?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Almost everything. The complete fee schedule is published, including the fees that only appear in bad
        months. So are the operating numbers: median {kpis.metrics[0].value} days on market,
        {' '}{kpis.metrics[6].value} of rent collected by the 5th, a {kpis.metrics[2].value} lease renewal rate,
        and owner funds out on the {rentPolicy.ownerDisbursementDay}th. Read all of it first, then use the call
        for the things a web page cannot answer about your specific property.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/pricing/" class="btn btn-ghost">The full fee schedule</a>
        <a href="/key-performance-indicators/" class="btn btn-ghost">The published scorecard</a>
        <a href="/owner-faqs/" class="btn btn-ghost">Owner FAQs</a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Consultation questions" id="consult-faq" />
      <div class="mt-7"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/pricing/', label: 'Pricing and the full fee schedule', note: 'Written to be read before the call.' },
    { href: '/investors/', label: 'Portfolio and investor services', note: 'How we operate for multi-unit owners.' },
    { href: '/switching-property-managers/', label: 'Switching property managers', note: 'The transfer, and how to time it.' },
    { href: '/how-to-choose-a-property-manager-columbus/', label: 'How to choose a property manager', note: 'The questions to ask us, and everyone else.' },
    { href: '/free-rent-evaluation/', label: 'Free rent evaluation', note: 'If you only want the rent number for now.' },
  ]} />

  <Cta
    heading="Bring the addresses, leave with a number"
    body="No deck, no pressure, and nothing to sign on the call. If we are not the right manager for your property, we will say so."
    primary={{ label: 'Request a consultation', href: '#consultation-form' }}
    secondary={{ label: `Call ${company.salesPhone}`, href: `tel:${company.phoneE164}` }}
  />
</Base>
