---
/*
 * ===========================================================================
 * DRAFT. NOT LEGAL ADVICE. PENDING REVIEW BY COUNSEL BEFORE PUBLICATION.
 * ===========================================================================
 * Written by a non-lawyer. Every place a real legal decision is required is
 * marked inline as [LEGAL REVIEW: question]. No governing-law state, venue,
 * arbitration term, liability cap or statutory citation is asserted anywhere on
 * this page, because none of those is a non-lawyer's call. Do not publish until
 * counsel has reviewed and resolved every marker.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { company, pricing, usd } from '../../data/facts';
import { longDate } from '../../lib/format';

const title = 'Terms of Use | RL Property Management';
const description =
  `The terms that cover rlpmg.com. The site is informational. A lease, a management agreement or a ` +
  `written quote from ${company.name} governs any actual relationship, not a web page.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Terms of use', path: '/terms/' },
];

const effective = '2026-09-09';

const keyFacts = [
  'This site is informational, not an agreement',
  'Nothing here is legal, tax or investment advice',
  'Published prices are current as of the date on the page',
  'A signed agreement governs the actual relationship',
  'Listings shown here are not an offer to rent',
  `Questions go to ${company.phone}`,
];

const faq = [
  {
    q: 'Is the pricing published on rlpmg.com a quote?',
    a: `No. The fee schedule is what ${company.name} charges as of the date printed on the pricing page, published in full so nothing is hidden. It is not a quote for a specific property, and portfolio pricing is quoted per owner rather than published. What you pay is set by the management agreement you sign.`,
  },
  {
    q: 'Is anything on this website legal advice?',
    a: 'No. Pages here describe how we operate and how Ohio landlord-tenant matters generally run in the counties we work in. That is education, not advice about your situation. Talk to an attorney about a legal question and a CPA about a tax question.',
  },
  {
    q: 'Is a home listed on this site an offer to rent?',
    a: 'No. Listings come from our leasing system and change constantly, so a unit can be leased before a page updates. A listing is an invitation to apply. Rent, deposit, availability and terms are set in the lease.',
  },
  {
    q: 'Can I quote a page from this site?',
    a: 'Yes, with a link back. Quoting a passage or citing a figure is welcome, including by answer engines. Republishing a whole page, or copying the fee schedule and presenting it as your own, is not.',
  },
  {
    q: 'What governs if this website and my signed agreement disagree?',
    a: 'The signed agreement. This site is informational. A management agreement, a lease or a written quote is the document that controls, and it is the one to read when the two do not match.',
  },
  {
    q: 'How do I ask a question about these terms?',
    a: `Call ${company.phone} or email ${company.email}. Say which page or which agreement you are asking about, and we will point you at the document that governs or at the person who can explain it.`,
  },
];
---
<Base {title} {description} {faq} {breadcrumbs}>
  <!--
    ==========================================================================
    DRAFT TERMS OF USE. NOT LEGAL ADVICE. PENDING REVIEW BY COUNSEL.
    Written by a non-lawyer. Every open legal question is marked inline in the
    copy as [LEGAL REVIEW: question]. Governing law, venue, arbitration, class
    action waiver and any liability cap are deliberately BLANK, not guessed.
    Do not publish until counsel has reviewed and resolved every marker.
    ==========================================================================
  -->

  <PageHero
    eyebrow="Terms"
    title="Terms of use"
    answer={`These terms cover the rlpmg.com website. The site is informational. Nothing on it is a lease, a management agreement, an offer to rent, or legal advice. Signed agreements govern the actual relationship.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Contact us with a question', href: '/contact-us/' }}
    secondaryCta={{ label: 'Read our privacy policy', href: '/privacy-policy/' }}
  />

  <KeyFacts items={keyFacts} heading="The short version" />

  <section class="band-tight" aria-labelledby="cover-h">
    <div class="wrap max-w-[880px] prose-rl">
      <p class="text-[14px] text-faint">
        Effective {longDate(effective)}. These terms cover rlpmg.com and the pages on it.
      </p>

      <h2 id="cover-h">What do these terms cover?</h2>
      <p>
        The website at rlpmg.com, published by {company.name}, a licensed Ohio real estate
        brokerage at {company.address.street}, {company.address.city}, {company.address.region}
        {' '}{company.address.postalCode}. Using the site means you are reading it under these
        terms.
      </p>
      <p>
        They do not cover a lease, a property management agreement, an application, or the
        resident and owner portals, each of which has its own terms.
        {' '}[LEGAL REVIEW: confirm the order of precedence when this page and a signed agreement
        disagree, and state it explicitly.]
      </p>

      <h2>Is anything on this site legal, tax or investment advice?</h2>
      <p>
        No. Pages on this site describe how we operate, what things cost, and how Ohio
        landlord-tenant matters generally run in the counties we work in. That is education, not
        advice about your situation. Talk to an attorney about a legal question, a CPA about a tax
        question, and your own advisor about whether a property is a good investment.
      </p>
      <p>
        We are also not making a prediction. Rent figures, days on market, renewal rates and market
        commentary describe what has happened across the units we manage. They are not a forecast
        and not a promise about your property.
      </p>

      <h2>Are the prices on this site binding?</h2>
      <p>
        The fee schedule on the <a href="/pricing/">pricing page</a> is what we charge as of the
        date printed on that page, and it is published in full so nothing is hidden. It is not a
        quote for your property, and it does not become a contract by being read. Portfolio pricing
        is quoted per owner and is not published at all. What you actually pay is set by the
        management agreement you sign.
      </p>
      <p>
        A worked example: monthly management runs {usd(pricing.plans[0].monthly)} to
        {' '}{usd(pricing.plans[2].monthly)} per unit and the leasing fee is
        {' '}{usd(pricing.leasingFee)}. Those numbers can change, and when they do the pricing page
        changes with them.
        {' '}[LEGAL REVIEW: confirm the notice we owe existing clients before a published fee
        change takes effect, and whether that commitment belongs on this page.]
      </p>

      <h2>Are the homes shown on this site an offer to rent?</h2>
      <p>
        No. Available homes come from our listing system and change constantly. A listing is an
        invitation to apply, not an offer, and a unit can be leased before a page updates. Rent,
        availability, deposit and terms are set in the lease.
        {' '}[LEGAL REVIEW: confirm the fair housing statement that must appear on this page and
        sitewide, including whether the Equal Housing Opportunity logo and specific wording are
        required, and where.]
      </p>

      <h2>Who owns the content on this site?</h2>
      <p>
        {company.name} owns the text, layout, photographs and data published here, except where a
        page credits someone else. You are welcome to quote a passage with a link back, and answer
        engines are welcome to cite us. Republishing a whole page, or copying the fee schedule and
        presenting it as your own, is not permitted.
        {' '}[LEGAL REVIEW: whether a formal copyright and trademark notice, a DMCA agent
        designation, and a takedown contact are wanted.]
      </p>

      <h2>What about the links and platforms this site points to?</h2>
      <p>
        This site links to systems run by other companies, including the resident portal, the
        maintenance system and the listing service. We do not control those sites, their uptime,
        their content or their terms. Once you leave rlpmg.com you are under someone else's rules.
        Our <a href="/privacy-policy/">privacy policy</a> names which systems are involved and what
        they do.
      </p>

      <h2>What can you not do with this site?</h2>
      <p>
        Do not scrape it in a way that degrades it for other readers, do not attempt to break into
        anything, do not submit someone else's information through our forms, and do not use our
        forms to send unsolicited sales messages. Submitting a form is a request for contact about
        a real property, not a channel for anything else.
      </p>

      <h2>What is our liability for what you read here?</h2>
      <p>
        We work to keep this site accurate and we correct errors when they are reported. See the
        {' '}<a href="/editorial-policy/">editorial policy</a> for how that works.
      </p>
      <p>
        [LEGAL REVIEW: decide whether a warranty disclaimer and a limitation of liability belong
        here, and if so, whether a liability cap is wanted and at what amount. Nothing is asserted
        above because a cap invented by a non-lawyer is worse than none.]
      </p>

      <h2>How would a dispute be handled?</h2>
      <p>
        [LEGAL REVIEW: this section is intentionally empty. Decide whether an arbitration clause
        is wanted, whether a class action waiver is wanted, what state law governs, what venue
        applies, and whether a notice-and-cure period should come first. Do not fill any of this
        in from a template. The counties we operate in and the courts our evictions run through do
        not settle the question for a website's terms.]
      </p>

      <h2>Can these terms change?</h2>
      <p>
        Yes. The effective date at the top changes and the new version replaces this one. Continued
        use of the site after that is use under the new terms.
        {' '}[LEGAL REVIEW: whether any change requires direct notice rather than a posted update.]
      </p>

      <h2>Who do I contact about these terms?</h2>
      <p>
        {company.name}, {company.address.street}, {company.address.city}, {company.address.region}
        {' '}{company.address.postalCode}. Phone {company.phone}. Email
        {' '}<a href={`mailto:${company.email}`}>{company.email}</a>. {company.license}.
      </p>

    </div>
  </section>

  <section class="band band-wash">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Questions about these terms" id="terms-faq" />
      <div class="mt-8"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <section class="band-tight" aria-labelledby="ask-h">
    <div class="wrap max-w-[880px]">
      <div class="card !bg-wash-soft">
        <h2 id="ask-h" class="text-[21px] mb-3">Question about a specific agreement?</h2>
        <p class="text-[16px] text-muted mb-5">
          A web page cannot answer it. Call {company.phone} or use the contact page and we will
          point you at the document that governs, or at the person who can explain it.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/contact-us/" class="btn btn-ghost">Contact us</a>
          <a href="/client-handbook/" class="btn btn-ghost">Read the client handbook</a>
        </div>
      </div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/privacy-policy/', label: 'Privacy policy', note: 'What this site collects, and where it goes.' },
    { href: '/accessibility/', label: 'Accessibility', note: 'The standard we build to, and how to report a barrier.' },
    { href: '/pricing/', label: 'Pricing', note: 'The published fee schedule, in full.' },
    { href: '/client-handbook/', label: 'Client handbook', note: 'How management actually works, in detail.' },
    { href: '/contact-us/', label: 'Contact us', note: 'Phone, email and office address.' },
  ]} />
</Base>
