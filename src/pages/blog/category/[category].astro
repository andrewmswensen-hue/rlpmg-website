---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import Cta from '../../../components/Cta.astro';
import { categoryIndex } from '../../../lib/blog';
import { company } from '../../../data/facts';

export async function getStaticPaths() {
  const cats = await categoryIndex();
  return [...cats.entries()].map(([slug, c]) => ({
    params: { category: slug },
    props: { name: c.name, posts: c.posts, slug, all: [...cats.entries()] },
  }));
}

const { name, posts, slug, all } = Astro.props;
const others = all.filter(([s]) => s !== slug).sort((a, b) => b[1].posts.length - a[1].posts.length).slice(0, 10);

const title = `${name} | ${company.name}`;
const description =
  `${posts.length} ${posts.length === 1 ? 'article' : 'articles'} on ${name.toLowerCase()} for rental property ` +
  `owners in Columbus, Ohio, from a licensed brokerage managing ${company.unitsManaged} units.`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Insights', path: '/blog/' },
  { name, path: `/blog/category/${slug}/` },
];
---
<Base {title} {description} {breadcrumbs}>
  <section class="pt-14 pb-8">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="mb-5 text-[13px] text-faint">
        <a href="/" class="no-underline hover:text-crimson">Home</a> <span aria-hidden="true">/</span>
        <a href="/blog/" class="no-underline hover:text-crimson">Insights</a> <span aria-hidden="true">/</span>
        <span aria-current="page">{name}</span>
      </nav>
      <span class="eyebrow">Insights</span>
      <h1 class="text-[clamp(30px,3.8vw,44px)] tracking-[-.02em]">{name}</h1>
      <p class="text-[19px] text-muted mt-4 max-w-[40em]">
        {posts.length} {posts.length === 1 ? 'article' : 'articles'} on {name.toLowerCase()}, written by the team
        that manages {company.unitsManaged} rental units across the Columbus metro.
      </p>
    </div>
  </section>

  <section class="pb-14">
    <div class="wrap">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <section class="band-tight band-wash">
    <div class="wrap">
      <h2 class="text-[21px] mb-4">Other topics</h2>
      <ul class="flex flex-wrap gap-2.5">
        {others.map(([s, c]) => (
          <li>
            <a href={`/blog/category/${s}/`}
               class="inline-flex items-baseline gap-2 bg-white border border-line rounded-full px-4 py-2 no-underline
                      text-[14.5px] font-medium text-navy hover:border-crimson hover:text-crimson">
              {c.name}<span class="text-[12px] text-faint">{c.posts.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Cta heading="Wondering what your Columbus rental should earn?"
       body="A free, data-backed rent evaluation using our own portfolio numbers and current market comps." />
</Base>
