---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, pricing, rentPolicy, typicalManager, usd } from '../../data/facts';
import { rentByMarketAndBedroom } from '../../data/markets';
import { serviceNode } from '../../lib/schema';

/**
 * Powell, Ohio. Target query: "property management powell ohio".
 *
 * The differentiating fact for Powell is that it is NOT in Franklin County. It
 * is in Delaware County, which means the eviction is filed at Delaware
 * Municipal Court and the R.C. 5323.02 owner filing goes to the Delaware County
 * Auditor, which runs its own registration entirely separate from Franklin's.
 * An owner or a national manager who assumes Franklin County files in the wrong
 * place and loses the filing fee and three weeks of calendar.
 *
 * SOURCES (verified 2026-09-09):
 *  - Powell is in Delaware County: en.wikipedia.org/wiki/Powell,_Ohio and the
 *    City of Powell site, cityofpowell.us.
 *  - Delaware Municipal Court, 70 N. Union St., 2nd floor, Delaware, OH 43015.
 *    Hears evictions, civil claims to $15,000:
 *    ohiolegalhelp.org/resource/delaware-municipal-court and
 *    delawareohio.net/government/departments/municipal-court.
 *  - Court jurisdiction follows the county under R.C. 1901.02.
 *  - Delaware County Auditor rental registration, 145 N. Union St., Delaware:
 *    auditor.co.delaware.oh.us/rental-registration/. Statute R.C. 5323.02,
 *    penalty R.C. 5323.99 ($50 to $150).
 *  - Utilities named by the City of Powell itself, at
 *    cityofpowell.us/Residents/Public-Service-Requests/Utilities:
 *    Del-Co Water Company, Inc. (water), Delaware County Regional Sewer
 *    District (sewer), AEP Ohio (electric), Columbia Gas (gas).
 *  - Powell does NOT appear on the City of Columbus water and sewer contract
 *    community list: columbus.gov Water & Sewer Contract Communities.
 *  - Median year structure built 2001: US Census, ACS 2024 5-year estimates.
 *
 * Rent: rentByMarketAndBedroom has a qualifying Powell entry at 2 bedrooms only
 * (sample 8). No 3 or 4 bedroom median is published because the sample is under
 * 5. No door counts, no per-market days on market.
 */

const CITY = 'Powell';
const PATH = '/property-management-powell-ohio/';

const title = 'Powell, Ohio Property Management | RL Property Management';
const description =
  `Flat-fee property management for Powell, Ohio rentals from ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} ` +
  `per unit per month with a ${usd(pricing.leasingFee)} leasing fee. Powell is in Delaware County, so evictions are filed at Delaware Municipal Court.`;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/areas-we-serve/' },
  { name: 'Powell', path: PATH },
];

const rent = rentByMarketAndBedroom[CITY];

const keyFacts = [
  'Powell is in Delaware County, not Franklin County',
  'Evictions are filed at Delaware Municipal Court, 70 N. Union St., Delaware',
  'The R.C. 5323 owner filing goes to the Delaware County Auditor, 145 N. Union St.',
  `Flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, not a percentage of rent`,
  `${usd(pricing.leasingFee)} leasing fee every time a Powell unit turns`,
  'Median Powell home was built in 2001, per US Census ACS 2024 5-year estimates',
];

const utilities = [
  { service: 'Water', provider: 'Del-Co Water Company, Inc.', pays: 'Resident, in their own name, on our standard lease' },
  { service: 'Sanitary sewer', provider: 'Delaware County Regional Sewer District', pays: 'Resident' },
  { service: 'Electricity', provider: 'AEP Ohio', pays: 'Resident' },
  { service: 'Natural gas', provider: 'Columbia Gas', pays: 'Resident' },
];

const faq = [
  { q: 'What county is Powell, Ohio in?',
    a: 'Delaware County, not Franklin, even though Powell sits directly north of Dublin and reads as a Columbus suburb. That sets the eviction court, the auditor for your rental registration, and the recorder and treasurer.' },
  { q: 'Which court hears an eviction in Powell, Ohio?',
    a: 'Delaware Municipal Court, 70 N. Union St., 2nd floor, Delaware, OH 43015, which hears forcible entry and detainer (eviction) cases and civil claims up to $15,000. Under R.C. 1901.02 a Powell case never goes to Franklin County Municipal Court; filing there costs the fee and the calendar time.' },
  { q: 'Where do I register a Powell rental property?',
    a: 'With the Delaware County Auditor, 145 N. Union St., Delaware, Ohio, under R.C. 5323.02: owner and property details within 60 days, updated within 60 days of any change. It is a separate registration from Franklin County, and filing with Franklin does not cover a Powell parcel.' },
  { q: 'What happens if I do not file the rental registration?',
    a: 'The county auditor can place a $50 to $150 special assessment on the property under R.C. 5323.99, which attaches to the tax bill and can go unnoticed for years. We file as your designated agent at onboarding.' },
  { q: 'Does the City of Powell require a separate rental license or inspection?',
    a: 'The Delaware County Auditor filing under R.C. 5323 applies to every Powell rental, and any city program would sit on top of it, not replace it. We track what applies to each address and handle the filings and renewals for you.' },
  { q: 'Who provides water and sewer in Powell?',
    a: 'Del-Co Water Company, Inc. for water and the Delaware County Regional Sewer District for sewer, with AEP Ohio electricity and Columbia Gas. Powell is not a Columbus contract community, so the Columbus rule making owners liable for a resident water balance does not govern it.' },
  { q: 'What does a rental in Powell, Ohio rent for?',
    a: `Across the units we manage in Powell, the median rent is ${usd(rent['2'].median)} for a two bedroom, our own portfolio figure. Larger Powell homes have under five units in our sample, so we publish no median for them.` },
  { q: 'How much does property management cost in Powell?',
    a: `A flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, a ${usd(pricing.leasingFee)} leasing fee and ${usd(pricing.leaseRenewalFee)} per renewal, so raising a Powell rent does not raise our fee. Photography is billed separately at $250 to $450.` },
];

const schemaNodes = [
  {
    ...serviceNode({
      path: PATH,
      name: 'Residential property management in Powell, Ohio',
      description,
    }),
    areaServed: {
      '@type': 'City',
      name: 'Powell, Ohio',
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Delaware County, Ohio' },
    },
  },
];
---
<Base {title} {description} {faq} {breadcrumbs} {schemaNodes}>

  <PageHero
    eyebrow="Where we work"
    title="Property management in Powell, Ohio"
    answer={`${company.name} manages single-family and small multifamily rentals in Powell for a flat ${usd(pricing.plans[0].monthly)} to ${usd(pricing.plans[2].monthly)} per unit per month, with a ${usd(pricing.leasingFee)} leasing fee. Powell is in Delaware County, so an eviction is filed in Delaware, not Columbus.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondaryCta={{ label: 'See the full fee schedule', href: '/pricing/' }}
  />

  <KeyFacts items={keyFacts} heading="Powell, at a glance" />

  <!-- THE DELAWARE COUNTY PROBLEM. The single most useful thing on this page. -->
  <section class="band-tight" aria-labelledby="county-h">
    <div class="wrap max-w-[880px]">
      <h2 id="county-h" class="text-[clamp(26px,3.2vw,38px)]">What county is Powell in, and which court hears an eviction?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Delaware County. A Powell eviction is filed at Delaware Municipal Court, 70 N. Union St., 2nd floor,
        Delaware, OH 43015, twenty-five minutes north of downtown Columbus. It hears forcible entry and detainer
        (eviction) actions and civil claims up to $15,000.
      </p>
      <p class="text-[17.5px] text-muted mt-5">
        Powell feels like Columbus, so managers working from a Columbus template file on High Street. Under
        Ohio Revised Code 1901.02 jurisdiction follows the county, and a wrong-court case is not transferred: you lose the fee
        and the hearing date, and a non-paying resident stays three more weeks while you refile.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Where a Powell, Ohio eviction is filed compared with a Franklin County address</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">If the property is in</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">You file at</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Where</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium align-top whitespace-nowrap">Powell (Delaware County)</th>
              <td class="p-3.5 border border-line align-top font-semibold text-navy">Delaware Municipal Court</td>
              <td class="p-3.5 border border-line align-top text-muted">70 N. Union St., 2nd floor, Delaware, OH 43015. Civil jurisdiction to $15,000.</td>
            </tr>
            <tr>
              <th scope="row" class="text-left p-3.5 border border-line font-medium align-top whitespace-nowrap">Columbus, Hilliard, Worthington (Franklin County)</th>
              <td class="p-3.5 border border-line align-top font-semibold text-navy">Franklin County Municipal Court</td>
              <td class="p-3.5 border border-line align-top text-muted">375 S. High St., Columbus, OH 43215. Eviction Court sits in Courtroom 11B.</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-[16px] text-muted mt-6">
        First comes a three-day notice under R.C. 1923.04 in the statutory wording, served by certified mail, by
        hand or left at the property; wrong wording means dismissal. Costs are on the
        {' '}<a href="/services/evictions/" class="text-crimson font-semibold no-underline hover:underline">evictions page</a>.
        {' '}Its {usd(pricing.eviction.countyFilingFee)} filing fee is Franklin County's; for Delaware Municipal Court
        we confirm the current filing deposit when we file.
      </p>
    </div>
  </section>

  <!-- REGISTRATION -->
  <section class="band band-wash" aria-labelledby="reg-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">Compliance</span>
      <h2 id="reg-h" class="text-[clamp(26px,3.2vw,38px)]">Where do you register a Powell rental property?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        With the Delaware County Auditor, 145 N. Union St., Delaware, Ohio, on its own forms, separate from
        Franklin County. Filing in Franklin with the rest of your portfolio leaves the Powell house unregistered.
        We file it for you as your designated agent at onboarding.
      </p>
      <ul class="text-[17px] text-muted mt-4 list-disc pl-6 grid gap-1.5">
        <li><strong>What:</strong> your name, address and phone, plus the property street address and permanent parcel number (R.C. 5323.02).</li>
        <li><strong>When:</strong> within 60 days, and within 60 days of any change. No fee.</li>
        <li><strong>LLC or trust:</strong> name the responsible officer, member or trustee, the step owners miss most because the deed shows only the LLC.</li>
        <li><strong>Penalty:</strong> a special assessment of $50 to $150 under R.C. 5323.99, appealable to the county board of revision.</li>
      </ul>
      <p class="text-[17.5px] text-muted mt-5">
        Any city program stacks on top of this filing (Columbus added a registry in April 2026 under City Code
        Chapter 4515), and we track which applies.
      </p>
    </div>
  </section>

  <!-- UTILITIES -->
  <section class="band-tight" aria-labelledby="util-h">
    <div class="wrap max-w-[880px]">
      <h2 id="util-h" class="text-[clamp(26px,3.2vw,38px)]">Who provides utilities in Powell, and who pays them?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Not the city. Powell's own utilities page names Del-Co Water Company, Inc. for water and the Delaware
        County Regional Sewer District for sewer. AEP Ohio distributes electricity and Columbia Gas supplies gas.
      </p>
      <div class="scroll-x mt-7">
        <table class="w-full border-collapse text-[15.5px]">
          <caption class="sr-only">Utility providers for Powell, Ohio rental property</caption>
          <thead>
            <tr class="bg-wash-soft">
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Service</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Provider</th>
              <th scope="col" class="text-left p-3.5 border border-line font-semibold">Who customarily pays</th>
            </tr>
          </thead>
          <tbody>
            {utilities.map((u) => (
              <tr>
                <th scope="row" class="text-left p-3.5 border border-line font-medium">{u.service}</th>
                <td class="p-3.5 border border-line text-navy font-semibold">{u.provider}</td>
                <td class="p-3.5 border border-line text-muted">{u.pays}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[16px] text-muted mt-6">
        Powell is not a City of Columbus water and sewer contract community, so the Columbus rule holding owners
        ultimately responsible for all charges under a Tenant Billing Agreement (a live exposure in Dublin,
        Hilliard, Worthington and Upper Arlington) does not reach it. Until that is confirmed in writing, we still
        put accounts in the resident's name at lease signing and verify them at move-out before the deposit is
        settled.
      </p>
    </div>
  </section>

  <!-- WHAT WE MANAGE -->
  <section class="band band-wash" aria-labelledby="stock-h">
    <div class="wrap max-w-[880px]">
      <span class="eyebrow">The market</span>
      <h2 id="stock-h" class="text-[clamp(26px,3.2vw,38px)]">What kind of rental property is there in Powell?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        Newer stock than almost anywhere in the metro. The median Powell home was built in 2001 (US Census ACS 2024
        5-year), a generation after Upper Arlington (1959) or Worthington (1963). Most of it is detached houses
        from the late 1990s and 2000s boom, plus a small nineteenth-century core at the Four Corners of Olentangy
        and Liberty.
      </p>
      <ul class="text-[17px] text-muted mt-4 list-disc pl-6 grid gap-1.5">
        <li><strong>Newer is not maintenance-free.</strong> A 2001 house is where the original furnace, condenser, water heater and roof all wear out together, often as several four-figure items inside two years. We record system ages at onboarding so you can set a real reserve.</li>
        <li><strong>Covenants.</strong> Many associations restrict parking, fencing, exterior color and lawn condition, and violation notices go to the owner. We route them to the resident with a cure date before the association escalates.</li>
      </ul>
      <h3 class="text-[21px] mt-9 mb-3">Where in Powell we work</h3>
      <p class="text-[16.5px] text-muted">
        Historic downtown Powell around the Four Corners, the Olentangy Street and Liberty Street corridors,
        Sawmill Parkway, Seldom Seen Road, Home Road, Steitz Road and the subdivisions along Presidential Parkway.
        Houses feed the Olentangy Local School District, a big reason Powell holds its rents. The Columbus Zoo and
        Aquarium and the Scioto River sit on the western edge. We also work Lewis Center and the city of Delaware,
        same county, same court.
      </p>
    </div>
  </section>

  <!-- RENT AND PRICING -->
  <section class="band-tight" aria-labelledby="rent-h">
    <div class="wrap max-w-[880px]">
      <h2 id="rent-h" class="text-[clamp(26px,3.2vw,38px)]">What does a Powell rental earn, and what does management cost?</h2>
      <p class="text-[17.5px] text-muted mt-4">
        {usd(rent['2'].median)} for a two bedroom: the median across the units we manage in Powell, our own
        portfolio, not a market survey. Larger Powell homes have under five units in our sample, so we stop there.
      </p>
      <div class="grid gap-5 sm:grid-cols-3 mt-8">
        {pricing.plans.map((p) => (
          <div class="card text-center">
            <div class="font-sans text-[12px] font-bold tracking-[.13em] uppercase text-faint mb-2">{p.name}</div>
            <div class="font-sans text-[42px] font-extrabold tracking-[-.045em] text-navy leading-none">{usd(p.monthly)}</div>
            <div class="font-sans text-[13px] text-faint mt-2">per unit, per month</div>
            <p class="text-[14.5px] text-muted mt-4 mb-0">{usd(p.repairApprovalLimit)} per-item repair approval limit</p>
          </div>
        ))}
      </div>
      <p class="text-[16.5px] text-muted mt-7">
        Plans differ only in how much we can spend on one repair before calling you. A percentage manager takes
        more with every rent increase and about {typicalManager.leasingFeePhrase} at each turn. Our fee stays flat, placement is
        {' '}{usd(pricing.leasingFee)} and a renewal is {usd(pricing.leaseRenewalFee)}.
      </p>
      <p class="text-[14px] text-faint mt-4">
        Percentage figures describe common Columbus market rates, not a quote from any named company.
        Photography is billed separately at $250 to $450.
      </p>
      <div class="flex flex-wrap gap-3 mt-7">
        <a href="/pricing/" class="btn btn-navy">See every fee we charge</a>
        <a href="/free-rent-evaluation/" class="btn btn-ghost">Price my Powell rental</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="band band-wash" aria-labelledby="faq-section">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <h2 id="faq-section" class="sr-only">Powell property management questions</h2>
      <Faq items={faq} heading="Powell property management questions" id="powell-faq" />
      <p class="mt-7 text-[15.5px] text-muted">
        Rent is due {rentPolicy.dueDate}; late fees follow after {rentPolicy.lateFeesAfter}. We pay owners on the
        {' '}{rentPolicy.ownerDisbursementDay}th. Read more on the
        {' '}<a href="/owner-faqs/" class="text-crimson font-semibold no-underline hover:underline">owner FAQs page</a>.
      </p>
      <div class="mt-6"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/property-management-dublin-ohio/', label: 'Dublin property management', note: 'Directly south. Parts of Dublin are in Delaware County too.' },
    { href: '/property-management-worthington-ohio/', label: 'Worthington property management', note: 'Southeast, Franklin County, housing a generation older.' },
    { href: '/property-management-westerville-ohio/', label: 'Westerville property management', note: 'East, and the one suburb with its own municipal electric utility.' },
    { href: '/property-management-lewis-center-ohio/', label: 'Lewis Center property management', note: 'Directly east, same county, same court, same auditor.' },
    { href: '/pricing/', label: 'Pricing and the full fee schedule', note: 'Every charge that can appear on an owner statement.' },
  ]} heading="Nearby markets and what to read next" />

  <Cta
    heading="Find out what your Powell rental should earn"
    body="Send the address and we will price it against our Delaware County units and live comparable listings. Free, no obligation."
    primary={{ label: 'Get a free rent evaluation', href: '/free-rent-evaluation/' }}
    secondary={{ label: 'Get a portfolio quote', href: '/property-management-consultation/' }}
  />
</Base>
