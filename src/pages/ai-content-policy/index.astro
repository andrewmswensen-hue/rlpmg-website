---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { company } from '../../data/facts';

/**
 * NOT a legal page. A plain statement of where AI is used and who checks it.
 *
 * Worth having for two reasons: readers increasingly want to know, and answer
 * engines weight a clear provenance statement. States no legal position.
 */
const title = `How We Use AI | ${company.name}`;
const description =
  `Where ${company.name} uses AI tools, where we do not, and who reviews the output before it reaches you.`;
const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'How we use AI', path: '/ai-content-policy/' }];
---
<Base {title} {description} {breadcrumbs}>
  <PageHero
    eyebrow="How we work"
    title="How we use AI"
    answer={`We use AI tools to help draft and organize content. A person at ${company.name} reviews everything before it publishes, and no number or local rule goes live without a human confirming where it came from.`}
    breadcrumbs={breadcrumbs}
    primaryCta={{ label: 'How we write and check content', href: '/editorial-policy/' }}
    secondaryCta={{ label: 'Contact us', href: '/contact-us/' }}
  />

  <section class="band-tight">
    <div class="wrap max-w-[760px]">
      <div class="prose-rl">
        <h2>Where we use it</h2>
        <p>
          Drafting and structuring written content, organizing our own operating
          data, and the ordinary internal work of running a business. It is a
          tool for getting a first version down and for spotting where something
          contradicts itself.
        </p>

        <h2>Where a person always decides</h2>
        <p>
          Anything that affects a resident or an owner. Application decisions,
          maintenance priorities, pricing recommendations, and how we respond to
          somebody are made by our team. AI does not decide who gets a home.
        </p>

        <h2>What gets checked before it publishes</h2>
        <p>
          Every figure and every description of how something works locally. If a
          number cannot be traced to our own data or a named source, it does not
          go on the site. Where we do not have a fact, the page says so rather
          than filling the gap with something plausible.
        </p>

        <h2>Why we bother saying this</h2>
        <p>
          Because a lot of property management content is now generated at volume
          and not checked, and it is reasonable to want to know which kind you
          are reading. If you find something on this site that looks like it was
          not checked, tell us at
          {' '}<a href={`mailto:${company.email}`}>{company.email}</a>.
        </p>
      </div>
      <div class="mt-9"><Verified date="2026-09-10" /></div>
    </div>
  </section>

  <RelatedLinks links={[
    { href: '/editorial-policy/', label: 'How we write and check content', note: 'Who writes it, who reviews it' },
    { href: '/key-performance-indicators/', label: 'Our scorecard', note: 'Where our numbers come from' },
    { href: '/guides/', label: 'In-depth guides', note: 'The long answers' },
    { href: '/about/', label: 'About us', note: 'Who we are' },
  ]} />
</Base>
