---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import Verified from '../../components/Verified.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Cta from '../../components/Cta.astro';
import { company, kpis, pricing, usd } from '../../data/facts';

/**
 * Reviews.
 *
 * DELIBERATELY NO AggregateRating SCHEMA. Google's review snippet policy
 * requires an aggregate rating in structured data to reflect reviews that are
 * actually displayed on the page. This page currently displays none, because
 * none have been collected with permission. Emitting the rating anyway is a
 * structured-data violation and risks a manual action on the whole domain.
 *
 * Add the AggregateRating node only once real, attributed quotes are on the
 * page. The count and rating are already in the fact bank and ready:
 * company.reviews.count, .rating, .display.
 *
 * NO QUOTE ON THIS PAGE IS INVENTED. The quote slots below are placeholders.
 */

const title = 'Reviews of RL Property Management | Columbus, Ohio';
const description =
  `${company.name} holds a ${company.reviews.rating} star average across ${company.reviews.display} ` +
  `Google reviews as of ${kpis.asOfLabel}. What a property management rating measures, and how to read one.`;
const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Reviews', path: '/reviews/' }];

const r = company.reviews;

/**
 * Placeholder slots. Each one stays empty until a real review is supplied with
 * the reviewer's first name and city. Do not fill these with paraphrases.
 */
const quoteSlots = [
  { audience: 'From an owner', note: 'A property owner, on reporting, communication or how a problem was handled.' },
  { audience: 'From an owner', note: 'A property owner, on leasing speed, maintenance cost control or switching from another manager.' },
  { audience: 'From a resident', note: 'A resident, on maintenance response or the leasing process.' },
  { audience: 'From a resident', note: 'A resident, on move-in, the portal or how a request was resolved.' },
];

const faq = [
  { q: 'How many reviews does RL Property Management have?',
    a: `${r.display} reviews on ${r.platform}, with a ${r.rating} star average, as of ${r.asOf}. Both owners and residents review us, and their interests are not identical.` },
  { q: 'What is RL Property Management’s rating?',
    a: `${r.rating} out of 5 across ${r.display} ${r.platform} reviews. That figure is a running average over more than a decade of operating, not a snapshot of a good month.` },
  { q: 'Why does a property management company get lower ratings than other businesses?',
    a: 'Because roughly half the reviews come from residents, and the property manager enforces the lease. A damage charge, a late fee, a declined application or an eviction filing are correct actions that reliably produce a one-star review.' },
  { q: 'How should I read property management reviews?',
    a: 'Separate owner reviews from resident reviews. Read the negative ones for pattern: one angry review about a deposit is normal, twenty about unreturned calls is a signal. Then check whether the company replies, and whether the replies are specific.' },
  { q: 'What do the operating numbers say, separately from the reviews?',
    a: `Resident satisfaction across the portfolio is ${kpis.metrics[7].value} out of 5 and the lease renewal rate is ${kpis.metrics[2].value}, both published on the scorecard and refreshed monthly. The renewal rate measures what residents did, not what they said.` },
];

const related = [
  { href: '/key-performance-indicators/', label: 'Our scorecard', note: 'Eight operating numbers, refreshed monthly.' },
  { href: '/pricing/', label: 'Pricing', note: 'The complete published fee schedule.' },
  { href: '/about/', label: 'About the company', note: `What ${company.shortName} does, and for whom.` },
  { href: '/team/', label: 'Our team', note: 'Every person here, with their role.' },
  { href: '/contact-us/', label: 'Contact us', note: 'Phone, email and the office address.' },
];
---
<Base {title} {description} {faq} {breadcrumbs}>

  <PageHero
    eyebrow="Reviews"
    title="Reviews of RL Property Management"
    answer={`${company.name} has a ${r.rating} star average across ${r.display} ${r.platform} reviews as of ${kpis.asOfLabel}. This page explains what a property management rating measures and how to read one.`}
    breadcrumbs={breadcrumbs}
    secondaryCta={{ label: 'See our scorecard', href: '/key-performance-indicators/' }}
  />

  <!-- THE RATING -->
  <section class="pb-4" aria-labelledby="rating-h">
    <div class="wrap max-w-[880px]">
      <div class="card !bg-wash-soft flex flex-col sm:flex-row sm:items-center gap-6">
        <div class="shrink-0 text-center sm:text-left sm:border-r sm:border-line sm:pr-7">
          <div class="font-sans text-[clamp(46px,6vw,64px)] font-extrabold leading-none tracking-[-.05em] text-navy">
            {r.rating}
          </div>
          <div class="font-sans text-[11.5px] font-bold tracking-[.14em] uppercase text-faint mt-2">
            Out of 5
          </div>
        </div>
        <div>
          <h2 id="rating-h" class="text-[19px] mb-2">{r.display} reviews on {r.platform}</h2>
          <p class="text-[16px] text-muted m-0">
            A running average built since {company.founded}, from owners and residents. Count and
            rating confirmed {r.asOf}.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE QUOTES, NOT YET FILLED -->
  <section class="band-tight" aria-labelledby="quotes-h">
    <div class="wrap max-w-[940px]">
      <span class="eyebrow">In their words</span>
      <h2 id="quotes-h" class="text-[clamp(28px,3.3vw,40px)]">What do clients and residents say?</h2>
      <p class="text-[17.5px] text-muted mt-4 mb-8 max-w-[44em]">
        Real quotes go here once collected, each with a first name and a city. We do not paraphrase
        reviews, and they will not all be five stars.
      </p>

      <div class="grid gap-5 sm:grid-cols-2">
        {quoteSlots.map((s) => (
          <div class="card !border-dashed">
            <div class="font-sans text-[11.5px] font-bold tracking-[.14em] uppercase text-faint mb-3">
              {s.audience}
            </div>
            <p class="text-[14px] text-muted mt-3 mb-0">{s.note}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- HOW TO READ THEM -->
  <section class="band band-wash" aria-labelledby="read-h">
    <div class="wrap max-w-[880px] prose-rl">
      <h2 id="read-h">What does a property management rating measure?</h2>
      <p>
        Two things at once, which is why property management ratings run lower than most local
        services. Owners rate the business: was the unit leased, did rent arrive, did anyone call back.
        Residents rate the living experience, and also the moments the manager enforces the lease: a
        damage deduction, a late fee, a declined application, an eviction filing. Each is the job the
        owner hired us to do, and each reliably produces a one-star review.
      </p>
      <p>
        A very high rating on a large portfolio usually means the company is new, the reviews are mostly
        owners, or the lease is not being enforced.
      </p>

      <h2>How should an owner read a manager's reviews?</h2>
      <ol>
        <li>
          <strong>Separate owners from residents.</strong> Owner reviews answer the business
          question, resident reviews the operational one.
        </li>
        <li>
          <strong>Read the negative reviews for pattern, not heat.</strong> One furious deposit review is
          normal. Fifteen about unreturned calls is a finding.
        </li>
        <li>
          <strong>Check the responses.</strong> A specific reply matters more than a
          reply. A template apology on every one-star review means they are managed, not read.
        </li>
        <li>
          <strong>Check the dates.</strong> Only recent reviews describe the
          current team.
        </li>
      </ol>

      <h2>What do reviews miss?</h2>
      <p>
        Most of what an owner is buying: time to lease, rent achieved, renewal rate, turn cost. We
        publish those on the
        {' '}<a href="/key-performance-indicators/">scorecard</a>. As of {kpis.asOfLabel}, median
        days on market is {kpis.metrics[0].value}, the lease renewal rate is
        {' '}{kpis.metrics[2].value}, and {kpis.metrics[6].value} of rent is collected by the 5th.
      </p>
      <p>
        Reviews also do not show what you will be charged. Every fee is on the
        {' '}<a href="/pricing/">pricing page</a>: a flat monthly rate per unit, and
        {' '}{usd(pricing.leasingFee)} to place a resident.
      </p>

    </div>
  </section>

  <section class="band-tight">
    <div class="wrap max-w-[820px]">
      <span class="eyebrow">Real answers</span>
      <Faq items={faq} heading="Questions about reviews" id="reviews-faq" />
      <div class="mt-8"><Verified date="2026-09-09" /></div>
    </div>
  </section>

  <RelatedLinks links={related} />

  <Cta
    heading="Judge us on the numbers too"
    body="Reviews are one input. A free rent evaluation tells you what your unit should earn and what we would do with it, which is the part reviews cannot cover."
    secondary={{ label: 'See our scorecard', href: '/key-performance-indicators/' }}
  />
</Base>
